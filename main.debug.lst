    5477/    91BA :                     
    5478/    91BA :                     ;sub_6514:
    5479/    91BA :                     ScrollHoriz:
    5480/    91BA : =>TRUE               	if FixBugs
    5481/    91BA :                     		; To prevent the bug that is described below, this caps the position
    5482/    91BA :                     		; array index offset so that it does not access position data from
    5483/    91BA :                     		; before the spin dash was performed. Note that this required
    5484/    91BA :                     		; modifications to 'Sonic_UpdateSpindash' and 'Tails_UpdateSpindash'.
    5485/    91BA : 1215                		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5486/    91BC : 6722                		beq.s	.scrollNotDelayed				; if not, branch
    5487/    91BE : E509                		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5488/    91C0 : 5315                		subq.b	#1,Horiz_scroll_delay_val-Camera_Delay(a5)	; reduce delay value
    5489/    91C2 : 102D 0003           		move.b	Sonic_Pos_Record_Index+1-Camera_Delay(a5),d0
    5490/    91C6 : 902D 0001           		sub.b	Horiz_scroll_delay_val+1-Camera_Delay(a5),d0
    5491/    91CA : B200                		cmp.b	d0,d1
    5492/    91CC : 6502                		blo.s	.doNotCap
    5493/    91CE : 1200                		move.b	d0,d1
    5494/    91D0 :                     .doNotCap:
    5495/    91D0 : =>FALSE              	else
    5496/    91D0 :                     		; The intent of this code is to make the camera briefly lag behind the
    5497/    91D0 :                     		; player right after releasing a spin dash, however it does this by
    5498/    91D0 :                     		; simply making the camera use position data from previous frames. This
    5499/    91D0 :                     		; means that if the camera had been moving recently enough, then
    5500/    91D0 :                     		; releasing a spin dash will cause the camera to jerk around instead of
    5501/    91D0 :                     		; remain still. This can be encountered by running into a wall, and
    5502/    91D0 :                     		; quickly turning around and spin dashing away. Sonic 3 would have had
    5503/    91D0 :                     		; this same issue with the Fire Shield's dash abiliity, but it shoddily
    5504/    91D0 :                     		; works around the issue by resetting the old position values to the
    5505/    91D0 :                     		; current position (see 'Reset_Player_Position_Array').
    5506/    91D0 :                     		move.w	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5507/    91D0 :                     		beq.s	.scrollNotDelayed				; if not, branch
    5508/    91D0 :                     		subi.w	#$100,d1					; reduce delay value
    5509/    91D0 :                     		move.w	d1,Horiz_scroll_delay_val-Camera_Delay(a5)
    5510/    91D0 :                     		moveq	#0,d1
    5511/    91D0 :                     		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; get delay value
    5512/    91D0 :                     		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5513/    91D0 :                     		addq.b	#4,d1
    5514/    91D0 : [5480]               	endif
