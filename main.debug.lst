(2)    5/   A72DE :                                             dc.b    s3TempotoS1($03)
(2)    5/   A72DE :                                     else;if SonicDriverVer==2
(2)    5/   A72DE :                                             dc.b    s3TempotoS2($03)
(2)    5/   A72DE : [5]                                  endif
(2)    5/   A72DE : [5]                          endif
