(1)  162/       0 :                     		move.w	(sp)+, sr
(1)  163/       0 :                     	endif
(1)  164/       0 :                     		endm
(1)  165/       0 :                     
(1)  166/       0 :                     ; Same as "assert", but doesn't save/restore CCR (can be used to save a few cycles)
