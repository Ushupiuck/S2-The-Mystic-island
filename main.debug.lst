    1288/    3814 :                     		include "_inc/DMA Queue.asm"
(1)    1/    3814 :                     ; ---------------------------------------------------------------------------
(1)    2/    3814 :                     ; MACRO ResetDMAQueue
(1)    3/    3814 :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    3814 :                     ; ---------------------------------------------------------------------------
(1)    5/    3814 :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    3814 :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    3814 :                     ;
(1)    8/    3814 :                     ; Output:
(1)    9/    3814 :                     ; 	a1,a5	trashed
(1)   10/    3814 :                     ; ---------------------------------------------------------------------------
(1)   11/    3814 :                     ; ROUTINE InitDMAQueue
(1)   12/    3814 :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    3814 :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    3814 :                     ; write to this region of RAM.
(1)   15/    3814 :                     ;
(1)   16/    3814 :                     ; Output:
(1)   17/    3814 :                     ; 	a0,d0,d1	trashed
(1)   18/    3814 :                     ; ---------------------------------------------------------------------------
(1)   19/    3814 :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    3814 :                     ; Queues a DMA with parameters given in registers.
(1)   21/    3814 :                     ;
(1)   22/    3814 :                     ; Options:
(1)   23/    3814 :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    3814 :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    3814 :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    3814 :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    3814 :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    3814 :                     ; Input:
(1)   29/    3814 :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    3814 :                     ; 		set to 0)
(1)   31/    3814 :                     ; 	d2	Destination address
(1)   32/    3814 :                     ; 	d3	Transfer length (in words)
(1)   33/    3814 :                     ; Output:
(1)   34/    3814 :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    3814 :                     ;
(1)   36/    3814 :                     ; With the default settings, runs in:
(1)   37/    3814 :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    3814 :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    3814 :                     ;
(1)   40/    3814 :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    3814 :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    3814 :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    3814 :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    3814 :                     ;   fills the queue (second piece is discarded)
(1)   45/    3814 :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    3814 :                     ;   space for both pieces (both pieces queued)
(1)   47/    3814 :                     ;
(1)   48/    3814 :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    3814 :                     ;
(1)   50/    3814 :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    3814 :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    3814 :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    3814 :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    3814 :                     ;
(1)   55/    3814 :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    3814 :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    3814 :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    3814 :                     ; in the correct form.
(1)   59/    3814 :                     ; ---------------------------------------------------------------------------
(1)   60/    3814 :                     ; MACRO QueueStaticDMA
(1)   61/    3814 :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    3814 :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    3814 :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    3814 :                     ;
(1)   65/    3814 :                     ; The destination parameter can be either:
(1)   66/    3814 :                     ; * a VRAM address literal;
(1)   67/    3814 :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    3814 :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    3814 :                     ;
(1)   70/    3814 :                     ; Options:
(1)   71/    3814 :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    3814 :                     ; Input:
(1)   73/    3814 :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    3814 :                     ; Output:
(1)   75/    3814 :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    3814 :                     ;
(1)   77/    3814 :                     ; With the default settings, runs in:
(1)   78/    3814 :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    3814 :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    3814 :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    3814 :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    3814 :                     ;
(1)   83/    3814 :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    3814 :                     ; ===========================================================================
(1)   85/    3814 :                     ; option: AssumeSourceAddressInBytes
(1)   86/    3814 :                     ;
(1)   87/    3814 :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    3814 :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    3814 :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    3814 : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    3814 :                     ; ===========================================================================
(1)   92/    3814 :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    3814 :                     ;
(1)   94/    3814 :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    3814 :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    3814 :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    3814 :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    3814 : =$1                  AssumeSourceAddressIsRAMSafe = 1
(1)   99/    3814 :                     ; ===========================================================================
(1)  100/    3814 :                     ; option: UseRAMSourceSafeDMA
(1)  101/    3814 :                     ;
(1)  102/    3814 :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    3814 :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    3814 :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    3814 : =$0                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    3814 :                     ; ===========================================================================
(1)  107/    3814 :                     ; option: Use128kbSafeDMA
(1)  108/    3814 :                     ;
(1)  109/    3814 :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    3814 :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    3814 :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    3814 :                     ; the job in situations where you can't align it in ROM.
(1)  113/    3814 : =$0                  Use128kbSafeDMA = 0
(1)  114/    3814 :                     ; ===========================================================================
(1)  115/    3814 :                     ; option UseVIntSafeDMA
(1)  116/    3814 :                     ;
(1)  117/    3814 :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    3814 :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    3814 :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    3814 :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    3814 :                     ; restore interrupts after.
(1)  122/    3814 : =$0                  UseVIntSafeDMA = 0
(1)  123/    3814 :                     ; ===========================================================================
(1)  124/    3814 :                     ; Convenience macros, for increased maintainability of the code.
(1)  125/    3814 : =>UNDEFINED          	ifndef DMA
(1)  126/    3814 : =$27                 		equ	DMA,%100111
(1)  127/    3814 : [125]                	endif
(1)  128/    3814 : =>UNDEFINED          	ifndef VRAM
(1)  129/    3814 : =$21                 		equ	VRAM,%100001
(1)  130/    3814 : [128]                	endif
(1)  131/    3814 : =>UNDEFINED          	ifndef vdpCommReg_defined
(1)  132/    3814 :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    3814 : =$1                  vdpCommReg_defined = 1
(1)  134/    3814 :                     vdpCommReg macro reg,type,rwd,clr
(1)  135/    3814 :                     	lsl.l	#2,reg							; Move high bits into (word-swapped) position, accidentally moving everything else
(1)  136/    3814 :                     	set .upperbits,(type&rwd)&3
(1)  137/    3814 :                     	if .upperbits<>0
(1)  138/    3814 :                     		addq.w	#.upperbits,reg				; Add upper access type bits
(1)  139/    3814 :                     	endif
(1)  140/    3814 :                     	ror.w	#2,reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
(1)  141/    3814 :                     	swap	reg								; Put all bits in proper places
(1)  142/    3814 :                     	if clr <> 0
(1)  143/    3814 :                     		andi.w	#3,reg						; Strip whatever junk was in upper word of reg
(1)  144/    3814 :                     	endif
(1)  145/    3814 :                     	set .lowerbits,(type&rwd)&$FC
(1)  146/    3814 :                     	if .lowerbits==$20
(1)  147/    3814 :                     		tas.b	reg							; Add in the DMA flag -- tas fails on memory, but works on registers
(1)  148/    3814 :                     	elseif .lowerbits<>0
(1)  149/    3814 :                     		ori.w	#(.lowerbits<<2),reg		; Add in missing access type bits
(1)  150/    3814 :                     	endif
(1)  151/    3814 :                     	endm
(1)  152/    3814 : [131]                	endif
(1)  153/    3814 :                     ; ---------------------------------------------------------------------------
