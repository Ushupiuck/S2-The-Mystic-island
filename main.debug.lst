    1902/    2CE2 :                     ; Subroutine to generate a pseudo-random number in d0
    1903/    2CE2 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1904/    2CE2 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1905/    2CE2 :                     ; ---------------------------------------------------------------------------
    1906/    2CE2 :                     
    1907/    2CE2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1908/    2CE2 :                     
    1909/    2CE2 :                     ; PseudoRandomNumber:
    1910/    2CE2 :                     RandomNumber:
    1911/    2CE2 : 2238 F672           		move.l	(v_random).w,d1
    1912/    2CE6 : 6606                		bne.s	loc_2C9C
    1913/    2CE8 : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1914/    2CEE :                     
    1915/    2CEE :                     loc_2C9C:
    1916/    2CEE :                     		; set the high word of d0 to be the high word of the RNG
    1917/    2CEE :                     		; and multiply the RNG by 41
    1918/    2CEE : 2001                		move.l	d1,d0
    1919/    2CF0 : E581                		asl.l	#2,d1
    1920/    2CF2 : D280                		add.l	d0,d1
    1921/    2CF4 : E781                		asl.l	#3,d1
    1922/    2CF6 : D280                		add.l	d0,d1
    1923/    2CF8 :                     
    1924/    2CF8 :                     		; add the low word of the RNG to the high word of the RNG
    1925/    2CF8 :                     		; and set the low word of d0 to be the result
    1926/    2CF8 :                     
    1927/    2CF8 : 3001                		move.w	d1,d0
    1928/    2CFA : 4841                		swap	d1
    1929/    2CFC : D041                		add.w	d1,d0
    1930/    2CFE : 3200                		move.w	d0,d1
    1931/    2D00 : 4841                		swap	d1
    1932/    2D02 :                     
    1933/    2D02 :                     ;		move.w	d1,d0
    1934/    2D02 :                     ;		abcd	d0,d1
    1935/    2D02 :                     ;		addx.w	d1,d0
    1936/    2D02 :                     ;		move.w	d0,d1
    1937/    2D02 :                     ;		swap	d1
    1938/    2D02 : 21C1 F672           		move.l	d1,(v_random).w
    1939/    2D06 : 4E75                		rts
