   22667/   1990E :                     ; ZONE ANIMATION SCRIPTS
   22668/   1990E :                     ;
   22669/   1990E :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
   22670/   1990E :                     ; thus animating them. All the relevant art must be uncompressed, because
   22671/   1990E :                     ; otherwise the subroutine would spend so much time waiting for the art to be
   22672/   1990E :                     ; decompressed that the VBLANK window would close before all the animating was done.
   22673/   1990E :                     ;
   22674/   1990E :                     ;    zoneanimdecl -1, Art_Flowers1, ArtTile_Art_Flowers1, 6, 2
   22675/   1990E :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
   22676/   1990E :                     ;	ArtUnc_Flowers1		Source address
   22677/   1990E :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
   22678/   1990E :                     ;	6			Number of frames
   22679/   1990E :                     ;	2			Number of tiles to load into VRAM for each frame
   22680/   1990E :                     ;
   22681/   1990E :                     ;    dc.b   0,$7F		; Start of the script proper
   22682/   1990E :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
   22683/   1990E :                     ;	$7F			Frame duration. Only here if global duration is -1
   22684/   1990E :                     
   22685/   1990E :                     
