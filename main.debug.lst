    1975/    46F0 : D040                		add.w	d0,d0
    1976/    46F2 : 0640 0080           		addi.w	#$80,d0
    1977/    46F6 : 323B 000C           		move.w	Sine_Data(pc,d0.w),d1		; cos
    1978/    46FA : 0440 0080           		subi.w	#$80,d0
    1979/    46FE : 303B 0004           		move.w	Sine_Data(pc,d0.w),d0		; sin
    1980/    4702 : 4E75                		rts
