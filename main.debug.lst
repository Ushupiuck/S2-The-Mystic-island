    1956/    47EE :                     ; Subroutine to calculate sine and cosine of an angle
    1957/    47EE :                     ; d0 = input byte = angle (360 degrees == 256)
    1958/    47EE :                     ; d0 = output word = 255 * sine(angle)
    1959/    47EE :                     ; d1 = output word = 255 * cosine(angle)
    1960/    47EE :                     ; ---------------------------------------------------------------------------
    1961/    47EE :                     
