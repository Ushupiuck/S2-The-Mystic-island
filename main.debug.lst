   22666/   1B3BE :                     ; ZONE ANIMATION SCRIPTS
   22667/   1B3BE :                     ;
   22668/   1B3BE :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
   22669/   1B3BE :                     ; thus animating them. All the relevant art must be uncompressed, because
   22670/   1B3BE :                     ; otherwise the subroutine would spend so much time waiting for the art to be
   22671/   1B3BE :                     ; decompressed that the VBLANK window would close before all the animating was done.
   22672/   1B3BE :                     ;
   22673/   1B3BE :                     ;    zoneanimdecl -1, Art_Flowers1, ArtTile_Art_Flowers1, 6, 2
   22674/   1B3BE :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
   22675/   1B3BE :                     ;	ArtUnc_Flowers1		Source address
   22676/   1B3BE :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
   22677/   1B3BE :                     ;	6			Number of frames
   22678/   1B3BE :                     ;	2			Number of tiles to load into VRAM for each frame
   22679/   1B3BE :                     ;
   22680/   1B3BE :                     ;    dc.b   0,$7F		; Start of the script proper
   22681/   1B3BE :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
   22682/   1B3BE :                     ;	$7F			Frame duration. Only here if global duration is -1
   22683/   1B3BE :                     
   22684/   1B3BE :                     
