(2)  159/   A72D8 :                     ; Channel IDs for SFX
(2)  160/   A72D8 : =$80                 cPSG1				EQU $80
(2)  161/   A72D8 : =$A0                 cPSG2				EQU $A0
(2)  162/   A72D8 : =$C0                 cPSG3				EQU $C0
(2)  163/   A72D8 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  164/   A72D8 : =$2                  cFM3				EQU $02
(2)  165/   A72D8 : =$4                  cFM4				EQU $04
(2)  166/   A72D8 : =$5                  cFM5				EQU $05
(2)  167/   A72D8 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  168/   A72D8 :                     ; ---------------------------------------------------------------------------
(2)  169/   A72D8 :                     ; Conversion macros and functions
(2)  170/   A72D8 :                     
(2)  171/   A72D8 :                     conv0To256  function n,((n==0)<<8)|n
(2)  172/   A72D8 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  173/   A72D8 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  174/   A72D8 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  175/   A72D8 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  176/   A72D8 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  177/   A72D8 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  178/   A72D8 :                     
(2)  179/   A72D8 :                     convertMainTempoMod macro mod
(2)  180/   A72D8 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  181/   A72D8 :                     		dc.b	mod
(2)  182/   A72D8 :                     	elseif SourceDriver==1
(2)  183/   A72D8 :                     		if mod==1
(2)  184/   A72D8 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  185/   A72D8 :                     		endif
(2)  186/   A72D8 :                     		if SonicDriverVer==2
(2)  187/   A72D8 :                     			dc.b	s1TempotoS2(mod)
(2)  188/   A72D8 :                     		else;if SonicDriverVer>=3
(2)  189/   A72D8 :                     			dc.b	s1TempotoS3(mod)
(2)  190/   A72D8 :                     		endif
(2)  191/   A72D8 :                     	elseif SourceDriver==2
(2)  192/   A72D8 :                     		if mod==0
(2)  193/   A72D8 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  194/   A72D8 :                     		endif
(2)  195/   A72D8 :                     		if SonicDriverVer==1
(2)  196/   A72D8 :                     			dc.b	s2TempotoS1(mod)
(2)  197/   A72D8 :                     		else;if SonicDriverVer>=3
(2)  198/   A72D8 :                     			dc.b	s2TempotoS3(mod)
(2)  199/   A72D8 :                     		endif
(2)  200/   A72D8 :                     	else;if SourceDriver>=3
(2)  201/   A72D8 :                     		if mod==0
(2)  202/   A72D8 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  203/   A72D8 :                     		endif
(2)  204/   A72D8 :                     		if SonicDriverVer==1
(2)  205/   A72D8 :                     			dc.b	s3TempotoS1(mod)
(2)  206/   A72D8 :                     		else;if SonicDriverVer==2
(2)  207/   A72D8 :                     			dc.b	s3TempotoS2(mod)
(2)  208/   A72D8 :                     		endif
(2)  209/   A72D8 :                     	endif
(2)  210/   A72D8 :                     	endm
(2)  211/   A72D8 :                     
(2)  212/   A72D8 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  213/   A72D8 :                     PSGPitchConvert macro pitch
(2)  214/   A72D8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  215/   A72D8 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  216/   A72D8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  217/   A72D8 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  218/   A72D8 :                     	else
(2)  219/   A72D8 :                     		dc.b	pitch
(2)  220/   A72D8 :                     	endif
(2)  221/   A72D8 :                     	endm
(2)  222/   A72D8 :                     
(2)  223/   A72D8 :                     CheckedChannelPointer macro loc
(2)  224/   A72D8 :                     	if SonicDriverVer<>1
(2)  225/   A72D8 :                     		dc.w	z80_ptr(loc)
(2)  226/   A72D8 :                     	else
(2)  227/   A72D8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  228/   A72D8 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  229/   A72D8 :                     		endif
(2)  230/   A72D8 :                     		dc.w	loc-songStart
(2)  231/   A72D8 :                     	endif
(2)  232/   A72D8 :                     	endm
