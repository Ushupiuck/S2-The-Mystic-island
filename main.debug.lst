(2)  577/   A72D8 :                     smpsModOff macro
(2)  578/   A72D8 :                     	if SonicDriverVer>=3
(2)  579/   A72D8 :                     		dc.b	$FA
(2)  580/   A72D8 :                     	else
(2)  581/   A72D8 :                     		dc.b	$F4
