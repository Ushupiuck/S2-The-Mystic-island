(2)   15/   1DAC2 :                     
(2)   16/   1DAC2 : =$1                  SMPS2ASMVer	= 1
(2)   17/   1DAC2 :                     
(2)   18/   1DAC2 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   1DAC2 : =$C                  psgdelta	EQU 12
(2)   20/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)   21/   1DAC2 :                     ; Standard Octave Pitch Equates
(2)   22/   1DAC2 :                     	enumconf	$C
(2)   23/   1DAC2 : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   1DAC2 : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   1DAC2 : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   1DAC2 : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   1DAC2 : =$78                 	nextenum	smpsPitch10hi
(2)   28/   1DAC2 :                     	enumconf	1
(2)   29/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)   30/   1DAC2 :                     ; Note Equates
(2)   31/   1DAC2 : =$80..$8F            	enum		nRst=$80,nC0,nCs0,nD0,nEb0,nE0,nF0,nFs0,nG0,nAb0,nA0,nBb0,nB0,nC1,nCs1,nD1
(2)   32/   1DAC2 : =$90..$9F            	nextenum	nEb1,nE1,nF1,nFs1,nG1,nAb1,nA1,nBb1,nB1,nC2,nCs2,nD2,nEb2,nE2,nF2,nFs2
(2)   33/   1DAC2 : =$A0..$AF            	nextenum	nG2,nAb2,nA2,nBb2,nB2,nC3,nCs3,nD3,nEb3,nE3,nF3,nFs3,nG3,nAb3,nA3,nBb3
(2)   34/   1DAC2 : =$B0..$BF            	nextenum	nB3,nC4,nCs4,nD4,nEb4,nE4,nF4,nFs4,nG4,nAb4,nA4,nBb4,nB4,nC5,nCs5,nD5
(2)   35/   1DAC2 : =$C0..$CF            	nextenum	nEb5,nE5,nF5,nFs5,nG5,nAb5,nA5,nBb5,nB5,nC6,nCs6,nD6,nEb6,nE6,nF6,nFs6
(2)   36/   1DAC2 : =$D0..$DF            	nextenum	nG6,nAb6,nA6,nBb6,nB6,nC7,nCs7,nD7,nEb7,nE7,nF7,nFs7,nG7,nAb7,nA7,nBb7
(2)   37/   1DAC2 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   38/   1DAC2 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   39/   1DAC2 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   40/   1DAC2 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   41/   1DAC2 : =>TRUE               	if SonicDriverVer<=2
(2)   42/   1DAC2 : =$C6                 nMaxPSG				EQU nA5
(2)   43/   1DAC2 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   44/   1DAC2 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   45/   1DAC2 : =>FALSE              	else
(2)   46/   1DAC2 :                     nMaxPSG				EQU nBb6-psgdelta
(2)   47/   1DAC2 :                     nMaxPSG1			EQU nBb6
(2)   48/   1DAC2 :                     nMaxPSG2			EQU nB6
(2)   49/   1DAC2 : [41]                 	endif
(2)   50/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)   51/   1DAC2 :                     ; PSG volume envelope equates
(2)   52/   1DAC2 : =$1                  	switch SonicDriverVer
(2)   53/   1DAC2 : =>TRUE               		case 1
(2)   54/   1DAC2 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   55/   1DAC2 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   56/   1DAC2 : =>FALSE              		case 2
(2)   57/   1DAC2 :                     			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   58/   1DAC2 :                     			nextenum	fTone_07,fTone_08,fTone_09,fTone_0A,fTone_0B,fTone_0C
(2)   59/   1DAC2 :                     			nextenum	fTone_0D
(2)   60/   1DAC2 : =>FALSE              		elsecase;SonicDriverVer>=3
(2)   61/   1DAC2 :                     			enum		sTone_01=$01,sTone_02,sTone_03,sTone_04,sTone_05,sTone_06
(2)   62/   1DAC2 :                     			nextenum	sTone_07,sTone_08,sTone_09,sTone_0A,sTone_0B,sTone_0C
(2)   63/   1DAC2 :                     			nextenum	sTone_0D,sTone_0E,sTone_0F,sTone_10,sTone_11,sTone_12
(2)   64/   1DAC2 :                     			nextenum	sTone_13,sTone_14,sTone_15,sTone_16,sTone_17,sTone_18
(2)   65/   1DAC2 :                     			nextenum	sTone_19,sTone_1A,sTone_1B,sTone_1C,sTone_1D,sTone_1E
(2)   66/   1DAC2 :                     			nextenum	sTone_1F,sTone_20,sTone_21,sTone_22,sTone_23,sTone_24
(2)   67/   1DAC2 :                     			nextenum	sTone_25,sTone_26,sTone_27
(2)   68/   1DAC2 :                     			; For conversions:
(2)   69/   1DAC2 :                     			if SonicDriverVer>=5
(2)   70/   1DAC2 :                     				nextenum	fTone_01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   71/   1DAC2 :                     				nextenum	fTone_07,fTone_08,fTone_09,fTone_0A,fTone_0B,fTone_0C
(2)   72/   1DAC2 :                     				nextenum	fTone_0D
(2)   73/   1DAC2 : [69]                 			endif
(2)   74/   1DAC2 : [52]                 	endcase
(2)   75/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)   76/   1DAC2 :                     ; DAC Equates
(2)   77/   1DAC2 : =$1                  	switch SonicDriverVer
(2)   78/   1DAC2 : =>TRUE               		case 1
(2)   79/   1DAC2 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   80/   1DAC2 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)   81/   1DAC2 : =>FALSE              		case 2
(2)   82/   1DAC2 :                     			enum		dKick=$81,dSnare,dClap,dScratch,dTimpani,dHiTom,dVLowClap,dHiTimpani,dMidTimpani
(2)   83/   1DAC2 :                     			nextenum	dLowTimpani,dVLowTimpani,dMidTom,dLowTom,dFloorTom,dHiClap
(2)   84/   1DAC2 :                     			nextenum	dMidClap,dLowClap
(2)   85/   1DAC2 : =>FALSE              		case 3
(2)   86/   1DAC2 :                     			enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)   87/   1DAC2 :                     			nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)   88/   1DAC2 :                     			nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)   89/   1DAC2 :                     			nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
(2)   90/   1DAC2 :                     			nextenum	dTightSnare,dMidpitchSnare,dLooseSnare,dLooserSnare
(2)   91/   1DAC2 :                     			nextenum	dHiTimpaniS3,dLowTimpaniS3,dMidTimpaniS3,dQuickLooseSnare
(2)   92/   1DAC2 :                     			nextenum	dClick,dPowerKick,dQuickGlassCrash
(2)   93/   1DAC2 :                     			nextenum	dGlassCrashSnare,dGlassCrash,dGlassCrashKick,dQuietGlassCrash
(2)   94/   1DAC2 :                     			nextenum	dOddSnareKick,dKickExtraBass,dComeOn,dDanceSnare,dLooseKick
(2)   95/   1DAC2 :                     			nextenum	dModLooseKick,dWoo,dGo,dSnareGo,dPowerTom,dHiWoodBlock,dLowWoodBlock
(2)   96/   1DAC2 :                     			nextenum	dHiHitDrum,dLowHitDrum,dMetalCrashHit,dEchoedClapHit_S3
(2)   97/   1DAC2 :                     			nextenum	dLowerEchoedClapHit_S3,dHipHopHitKick,dHipHopHitPowerKick
(2)   98/   1DAC2 :                     			nextenum	dBassHey,dDanceStyleKick,dHipHopHitKick2,dHipHopHitKick3
(2)   99/   1DAC2 :                     			nextenum	dReverseFadingWind,dScratchS3,dLooseSnareNoise,dPowerKick2
(2)  100/   1DAC2 :                     			nextenum	dCrashingNoiseWoo,dQuickHit,dKickHey,dPowerKickHit
(2)  101/   1DAC2 :                     			nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  102/   1DAC2 : =>FALSE              		case 4
(2)  103/   1DAC2 :                     			enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)  104/   1DAC2 :                     			nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)  105/   1DAC2 :                     			nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)  106/   1DAC2 :                     			nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
(2)  107/   1DAC2 :                     			nextenum	dTightSnare,dMidpitchSnare,dLooseSnare,dLooserSnare
(2)  108/   1DAC2 :                     			nextenum	dHiTimpaniS3,dLowTimpaniS3,dMidTimpaniS3,dQuickLooseSnare
(2)  109/   1DAC2 :                     			nextenum	dClick,dPowerKick,dQuickGlassCrash
(2)  110/   1DAC2 :                     			nextenum	dGlassCrashSnare,dGlassCrash,dGlassCrashKick,dQuietGlassCrash
(2)  111/   1DAC2 :                     			nextenum	dOddSnareKick,dKickExtraBass,dComeOn,dDanceSnare,dLooseKick
(2)  112/   1DAC2 :                     			nextenum	dModLooseKick,dWoo,dGo,dSnareGo,dPowerTom,dHiWoodBlock,dLowWoodBlock
(2)  113/   1DAC2 :                     			nextenum	dHiHitDrum,dLowHitDrum,dMetalCrashHit,dEchoedClapHit
(2)  114/   1DAC2 :                     			nextenum	dLowerEchoedClapHit,dHipHopHitKick,dHipHopHitPowerKick
(2)  115/   1DAC2 :                     			nextenum	dBassHey,dDanceStyleKick,dHipHopHitKick2,dHipHopHitKick3
(2)  116/   1DAC2 :                     			nextenum	dReverseFadingWind,dScratchS3,dLooseSnareNoise,dPowerKick2
(2)  117/   1DAC2 :                     			nextenum	dCrashingNoiseWoo,dQuickHit,dKickHey,dPowerKickHit
(2)  118/   1DAC2 :                     			nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  119/   1DAC2 : =>FALSE              		elsecase;SonicDriverVer>=5
(2)  120/   1DAC2 :                     			if (use_s3_samples<>0)||(use_sk_samples<>0)||(use_s3d_samples<>0)
(2)  121/   1DAC2 :                     				enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)  122/   1DAC2 :                     				nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)  123/   1DAC2 :                     				nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)  124/   1DAC2 :                     				nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
(2)  125/   1DAC2 :                     				nextenum	dTightSnare,dMidpitchSnare,dLooseSnare,dLooserSnare
(2)  126/   1DAC2 :                     				nextenum	dHiTimpaniS3,dLowTimpaniS3,dMidTimpaniS3,dQuickLooseSnare
(2)  127/   1DAC2 :                     				nextenum	dClick,dPowerKick,dQuickGlassCrash
(2)  128/   1DAC2 : [120]                			endif
