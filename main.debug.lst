(1)  125/   1C910 :                     
   23937/   1C910 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1C910 :                     ; ---------------------------------------------------------------------------
(1)    2/   1C910 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1C910 :                     ;
(1)    4/   1C910 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1C910 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1C910 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1C910 :                     ; bits). The assembled data looks something like this:
(1)    8/   1C910 :                     ;
(1)    9/   1C910 :                     ; aaBBBBBB
(1)   10/   1C910 :                     ; ccDDDDDD
(1)   11/   1C910 :                     ; EEEEEE
(1)   12/   1C910 :                     ; ffgghhii
(1)   13/   1C910 :                     ;
(1)   14/   1C910 :                     ; aa = index for primary pattern load request list
(1)   15/   1C910 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1C910 :                     ; cc = index for secondary pattern load request list
(1)   17/   1C910 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1C910 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1C910 :                     ; ff = unused, always 0
(1)   20/   1C910 :                     ; gg = unused, music track
(1)   21/   1C910 :                     ; hh = unused, palette
(1)   22/   1C910 :                     ; ii = palette
(1)   23/   1C910 :                     ;
(1)   24/   1C910 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1C910 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1C910 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1C910 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1C910 :                     ; ---------------------------------------------------------------------------
(1)   29/   1C910 :                     
(1)   30/   1C910 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1C910 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1C910 :                     	dc.l (plc1<<24)|art
(1)   33/   1C910 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1C910 :                     	dc.l map128x128
(1)   35/   1C910 :                     	dc.b 0,music,palette,palette
(1)   36/   1C910 :                     	endm
(1)   37/   1C910 :                     
(1)   38/   1C910 :                     ; MainLoadBlocks:
(1)   39/   1C910 :                     LevelArtPointers:
(1)   40/   1C910 : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Kosp_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ    ; GHZ  ; GREEN HILL ZONE
(1)   40/   1C910 : 0404 FCEA                   dc.l (plcid_GHZ<<24)|Kosp_GHZ
(1)   40/   1C914 : 0504 EF32                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1C918 : 0005 2270                   dc.l Map128_GHZ
(1)   40/   1C91C : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1C920 : (MACRO)              		levartptrs plcid_LZ,  plcid_LZ2,  Kosp_CPZ, Map16_CPZ, Map128_CPZ, bgm_LZ,  palid_LZ     ; LZ   ; LABYRINTH ZONE
(1)   41/   1C920 : 0605 99FE                   dc.l (plcid_LZ<<24)|Kosp_CPZ
(1)   41/   1C924 : 0705 81FE                   dc.l (plcid_LZ2<<24)|Map16_CPZ
(1)   41/   1C928 : 0005 C49E                   dc.l Map128_CPZ
(1)   41/   1C92C : 0082 0505                   dc.b 0,bgm_LZ,palid_LZ,palid_LZ
(1)   42/   1C930 : (MACRO)              		levartptrs plcid_CPZ, plcid_CPZ2, Kosp_CPZ, Map16_CPZ, Map128_CPZ, bgm_MZ,  palid_CPZ    ; CPZ  ; CHEMICAL PLANT ZONE
(1)   42/   1C930 : 0805 99FE                   dc.l (plcid_CPZ<<24)|Kosp_CPZ
