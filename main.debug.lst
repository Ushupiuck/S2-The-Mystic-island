(2)  769/   A72D8 :                     ; Macros for FM instruments
(2)  770/   A72D8 :                     ; Voices - Feedback
(2)  771/   A72D8 :                     smpsVcFeedback macro val
(2)  772/   A72D8 :                     vcFeedback set val
(2)  773/   A72D8 :                     	endm
(2)  774/   A72D8 :                     
(2)  775/   A72D8 :                     ; Voices - Algorithm
(2)  776/   A72D8 :                     smpsVcAlgorithm macro val
(2)  777/   A72D8 :                     vcAlgorithm set val
(2)  778/   A72D8 :                     	endm
(2)  779/   A72D8 :                     
(2)  780/   A72D8 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  781/   A72D8 :                     vcUnusedBits set val
(2)  782/   A72D8 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  783/   A72D8 :                     		set vcD1R1Unk,d1r1<<5
(2)  784/   A72D8 :                     		set vcD1R2Unk,d1r2<<5
(2)  785/   A72D8 :                     		set vcD1R3Unk,d1r3<<5
(2)  786/   A72D8 :                     		set vcD1R4Unk,d1r4<<5
(2)  787/   A72D8 :                     	else
(2)  788/   A72D8 :                     		set vcD1R1Unk,0
(2)  789/   A72D8 :                     		set vcD1R2Unk,0
(2)  790/   A72D8 :                     		set vcD1R3Unk,0
(2)  791/   A72D8 :                     		set vcD1R4Unk,0
(2)  792/   A72D8 :                     	endif
(2)  793/   A72D8 :                     	endm
(2)  794/   A72D8 :                     
(2)  795/   A72D8 :                     ; Voices - Detune
(2)  796/   A72D8 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  797/   A72D8 :                     	set vcDT1,op1
(2)  798/   A72D8 :                     	set vcDT2,op2
(2)  799/   A72D8 :                     	set vcDT3,op3
(2)  800/   A72D8 :                     	set vcDT4,op4
(2)  801/   A72D8 :                     	endm
(2)  802/   A72D8 :                     
(2)  803/   A72D8 :                     ; Voices - Coarse-Frequency
(2)  804/   A72D8 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  805/   A72D8 :                     	set vcCF1,op1
(2)  806/   A72D8 :                     	set vcCF2,op2
(2)  807/   A72D8 :                     	set vcCF3,op3
(2)  808/   A72D8 :                     	set vcCF4,op4
(2)  809/   A72D8 :                     	endm
(2)  810/   A72D8 :                     
(2)  811/   A72D8 :                     ; Voices - Rate Scale
(2)  812/   A72D8 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  813/   A72D8 :                     	set vcRS1,op1
(2)  814/   A72D8 :                     	set vcRS2,op2
(2)  815/   A72D8 :                     	set vcRS3,op3
(2)  816/   A72D8 :                     	set vcRS4,op4
(2)  817/   A72D8 :                     	endm
(2)  818/   A72D8 :                     
(2)  819/   A72D8 :                     ; Voices - Attack Rate
(2)  820/   A72D8 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  821/   A72D8 :                     	set vcAR1,op1
(2)  822/   A72D8 :                     	set vcAR2,op2
(2)  823/   A72D8 :                     	set vcAR3,op3
(2)  824/   A72D8 :                     	set vcAR4,op4
(2)  825/   A72D8 :                     	endm
(2)  826/   A72D8 :                     
(2)  827/   A72D8 :                     ; Voices - Amplitude Modulation
(2)  828/   A72D8 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  829/   A72D8 :                     ; were the Amplitude Modulation.
(2)  830/   A72D8 :                     ; According to several docs, however, it's actually the high bit.
(2)  831/   A72D8 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  832/   A72D8 :                     	if SourceSMPS2ASM==0
(2)  833/   A72D8 :                     		set vcAM1,op1<<5
(2)  834/   A72D8 :                     		set vcAM2,op2<<5
(2)  835/   A72D8 :                     		set vcAM3,op3<<5
(2)  836/   A72D8 :                     		set vcAM4,op4<<5
(2)  837/   A72D8 :                     	else
(2)  838/   A72D8 :                     		set vcAM1,op1<<7
(2)  839/   A72D8 :                     		set vcAM2,op2<<7
(2)  840/   A72D8 :                     		set vcAM3,op3<<7
(2)  841/   A72D8 :                     		set vcAM4,op4<<7
(2)  842/   A72D8 :                     	endif
(2)  843/   A72D8 :                     	endm
(2)  844/   A72D8 :                     
(2)  845/   A72D8 :                     ; Voices - First Decay Rate
(2)  846/   A72D8 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  847/   A72D8 :                     	set vcD1R1,op1
(2)  848/   A72D8 :                     	set vcD1R2,op2
(2)  849/   A72D8 :                     	set vcD1R3,op3
(2)  850/   A72D8 :                     	set vcD1R4,op4
(2)  851/   A72D8 :                     	endm
(2)  852/   A72D8 :                     
(2)  853/   A72D8 :                     ; Voices - Second Decay Rate
(2)  854/   A72D8 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  855/   A72D8 :                     	set vcD2R1,op1
(2)  856/   A72D8 :                     	set vcD2R2,op2
(2)  857/   A72D8 :                     	set vcD2R3,op3
(2)  858/   A72D8 :                     	set vcD2R4,op4
(2)  859/   A72D8 :                     	endm
(2)  860/   A72D8 :                     
(2)  861/   A72D8 :                     ; Voices - Decay Level
(2)  862/   A72D8 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  863/   A72D8 :                     	set vcDL1,op1
(2)  864/   A72D8 :                     	set vcDL2,op2
(2)  865/   A72D8 :                     	set vcDL3,op3
(2)  866/   A72D8 :                     	set vcDL4,op4
(2)  867/   A72D8 :                     	endm
(2)  868/   A72D8 :                     
(2)  869/   A72D8 :                     ; Voices - Release Rate
(2)  870/   A72D8 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  871/   A72D8 :                     	set vcRR1,op1
(2)  872/   A72D8 :                     	set vcRR2,op2
(2)  873/   A72D8 :                     	set vcRR3,op3
(2)  874/   A72D8 :                     	set vcRR4,op4
(2)  875/   A72D8 :                     	endm
(2)  876/   A72D8 :                     
(2)  877/   A72D8 :                     ; Voices - Total Level
(2)  878/   A72D8 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  879/   A72D8 :                     ; but later versions leave it up to the user.
(2)  880/   A72D8 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  881/   A72D8 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  882/   A72D8 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  883/   A72D8 :                     ; SMPS Z80 does the opposite.
(2)  884/   A72D8 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  885/   A72D8 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  886/   A72D8 :                     ; what we do, so we just print a warning.
(2)  887/   A72D8 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  888/   A72D8 :                     	set vcTL1,op1
(2)  889/   A72D8 :                     	set vcTL2,op2
(2)  890/   A72D8 :                     	set vcTL3,op3
(2)  891/   A72D8 :                     	set vcTL4,op4
(2)  892/   A72D8 :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  893/   A72D8 :                     ;   0     1     2     3     4     5     6     7
(2)  894/   A72D8 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  895/   A72D8 :                     	if SourceSMPS2ASM==0
(2)  896/   A72D8 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  897/   A72D8 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  898/   A72D8 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  899/   A72D8 :                     		set vcTLMask1,$80
(2)  900/   A72D8 :                     	else
(2)  901/   A72D8 :                     		set vcTLMask4,0
(2)  902/   A72D8 :                     		set vcTLMask3,0
(2)  903/   A72D8 :                     		set vcTLMask2,0
(2)  904/   A72D8 :                     		set vcTLMask1,0
(2)  905/   A72D8 :                     	endif
(2)  906/   A72D8 :                     
(2)  907/   A72D8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  908/   A72D8 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  909/   A72D8 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  910/   A72D8 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  911/   A72D8 :                     		set vcTLMask1,$80
(2)  912/   A72D8 :                     		set vcTL1,vcTL1&$7F
(2)  913/   A72D8 :                     		set vcTL2,vcTL2&$7F
(2)  914/   A72D8 :                     		set vcTL3,vcTL3&$7F
(2)  915/   A72D8 :                     		set vcTL4,vcTL4&$7F
(2)  916/   A72D8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&$80)<>$80)||(((vcTL2|vcTLMask2)&$80)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&$80)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&$80)<>((vcAlgorithm==7)<<7)))
(2)  917/   A72D8 :                     		if MOMPASS=1
(2)  918/   A72D8 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  919/   A72D8 :                     		endif
(2)  920/   A72D8 :                     	endif
(2)  921/   A72D8 :                     
(2)  922/   A72D8 :                     	if SonicDriverVer==2
(2)  923/   A72D8 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  924/   A72D8 :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  925/   A72D8 :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  926/   A72D8 :                     		dc.b	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  927/   A72D8 :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  928/   A72D8 :                     		dc.b	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  929/   A72D8 :                     	else
(2)  930/   A72D8 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  931/   A72D8 :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  932/   A72D8 :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  933/   A72D8 :                     		dc.b	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  934/   A72D8 :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  935/   A72D8 :                     		dc.b	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  936/   A72D8 :                     	endif
(2)  937/   A72D8 :                     	endm
(2)  938/   A72D8 :                     
(2)  939/   A72D8 :                     
