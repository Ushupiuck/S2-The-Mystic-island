   23916/   1AB26 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1AB26 :                     ; ---------------------------------------------------------------------------
(1)    2/   1AB26 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1AB26 :                     ;
(1)    4/   1AB26 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1AB26 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1AB26 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1AB26 :                     ; bits). The assembled data looks something like this:
(1)    8/   1AB26 :                     ;
(1)    9/   1AB26 :                     ; aaBBBBBB
(1)   10/   1AB26 :                     ; ccDDDDDD
(1)   11/   1AB26 :                     ; EEEEEE
(1)   12/   1AB26 :                     ; ffgghhii
(1)   13/   1AB26 :                     ;
(1)   14/   1AB26 :                     ; aa = index for primary pattern load request list
(1)   15/   1AB26 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1AB26 :                     ; cc = index for secondary pattern load request list
(1)   17/   1AB26 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1AB26 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1AB26 :                     ; ff = unused, always 0
(1)   20/   1AB26 :                     ; gg = unused, music track
(1)   21/   1AB26 :                     ; hh = unused, palette
(1)   22/   1AB26 :                     ; ii = palette
(1)   23/   1AB26 :                     ;
(1)   24/   1AB26 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1AB26 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1AB26 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1AB26 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1AB26 :                     ; ---------------------------------------------------------------------------
(1)   29/   1AB26 :                     
(1)   30/   1AB26 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1AB26 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1AB26 :                     	dc.l (plc1<<24)|art
(1)   33/   1AB26 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1AB26 :                     	dc.l map128x128
(1)   35/   1AB26 :                     	dc.b 0,music,palette,palette
(1)   36/   1AB26 :                     	endm
(1)   37/   1AB26 :                     
