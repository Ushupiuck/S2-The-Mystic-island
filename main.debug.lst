(2)   15/   A76F8 :                     
(2)   16/   A76F8 : =$1                  SMPS2ASMVer	= 1
(2)   17/   A76F8 :                     
(2)   18/   A76F8 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   A76F8 : =$C                  psgdelta	EQU 12
(2)   20/   A76F8 :                     ; ---------------------------------------------------------------------------
(2)   21/   A76F8 :                     ; Standard Octave Pitch Equates
(2)   22/   A76F8 :                     	enumconf	$C
(2)   23/   A76F8 : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   A76F8 : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   A76F8 : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   A76F8 : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   A76F8 : =$78                 	nextenum	smpsPitch10hi
(2)   28/   A76F8 :                     	enumconf	1
(2)   29/   A76F8 :                     ; ---------------------------------------------------------------------------
(2)   30/   A76F8 :                     ; Note Equates
(2)   31/   A76F8 : =$80..$8F            	enum		nRst=$80,nC0,nCs0,nD0,nEb0,nE0,nF0,nFs0,nG0,nAb0,nA0,nBb0,nB0,nC1,nCs1,nD1
(2)   32/   A76F8 : =$90..$9F            	nextenum	nEb1,nE1,nF1,nFs1,nG1,nAb1,nA1,nBb1,nB1,nC2,nCs2,nD2,nEb2,nE2,nF2,nFs2
(2)   33/   A76F8 : =$A0..$AF            	nextenum	nG2,nAb2,nA2,nBb2,nB2,nC3,nCs3,nD3,nEb3,nE3,nF3,nFs3,nG3,nAb3,nA3,nBb3
(2)   34/   A76F8 : =$B0..$BF            	nextenum	nB3,nC4,nCs4,nD4,nEb4,nE4,nF4,nFs4,nG4,nAb4,nA4,nBb4,nB4,nC5,nCs5,nD5
(2)   35/   A76F8 : =$C0..$CF            	nextenum	nEb5,nE5,nF5,nFs5,nG5,nAb5,nA5,nBb5,nB5,nC6,nCs6,nD6,nEb6,nE6,nF6,nFs6
(2)   36/   A76F8 : =$D0..$DF            	nextenum	nG6,nAb6,nA6,nBb6,nB6,nC7,nCs7,nD7,nEb7,nE7,nF7,nFs7,nG7,nAb7,nA7,nBb7
(2)   37/   A76F8 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   38/   A76F8 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   39/   A76F8 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   40/   A76F8 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   41/   A76F8 : =>TRUE               	if SonicDriverVer<=2
(2)   42/   A76F8 : =$C6                 nMaxPSG				EQU nA5
(2)   43/   A76F8 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   44/   A76F8 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   45/   A76F8 : =>FALSE              	else
(2)   46/   A76F8 :                     nMaxPSG				EQU nBb6-psgdelta
(2)   47/   A76F8 :                     nMaxPSG1			EQU nBb6
(2)   48/   A76F8 :                     nMaxPSG2			EQU nB6
(2)   49/   A76F8 : [41]                 	endif
(2)   50/   A76F8 :                     ; ---------------------------------------------------------------------------
(2)   51/   A76F8 :                     ; PSG volume envelope equates
(2)   52/   A76F8 : =$1                  	switch SonicDriverVer
(2)   53/   A76F8 : =>TRUE               		case 1
(2)   54/   A76F8 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   55/   A76F8 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   56/   A76F8 : =>FALSE              		case 2
(2)   57/   A76F8 :                     			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
