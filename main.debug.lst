(2)  234/   A72D8 :                     ; Header Macros
(2)  235/   A72D8 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  236/   A72D8 :                     
(2)  237/   A72D8 :                     SourceDriver set ver
(2)  238/   A72D8 :                     
(2)  239/   A72D8 :                     	if ("sourcesmps2asmver"<>"")
(2)  240/   A72D8 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  241/   A72D8 :                     	else
(2)  242/   A72D8 :                     		set SourceSMPS2ASM,0
(2)  243/   A72D8 :                     	endif
(2)  244/   A72D8 :                     
(2)  245/   A72D8 :                     songStart set *
(2)  246/   A72D8 :                     
(2)  247/   A72D8 :                     	if MOMPASS=1
(2)  248/   A72D8 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  249/   A72D8 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  250/   A72D8 :                     		endif
(2)  251/   A72D8 :                     	endif
(2)  252/   A72D8 :                     
(2)  253/   A72D8 :                     	endm
(2)  254/   A72D8 :                     
(2)  255/   A72D8 :                     smpsHeaderVoiceNull macro
(2)  256/   A72D8 :                     	if songStart<>*
(2)  257/   A72D8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  258/   A72D8 :                     	endif
(2)  259/   A72D8 :                     	dc.w	$0000
(2)  260/   A72D8 :                     	endm
(2)  261/   A72D8 :                     
(2)  262/   A72D8 :                     ; Header - Set up Voice Location
(2)  263/   A72D8 :                     ; Common to music and SFX
(2)  264/   A72D8 :                     smpsHeaderVoice macro loc
(2)  265/   A72D8 :                     	if songStart<>*
(2)  266/   A72D8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  267/   A72D8 :                     	endif
(2)  268/   A72D8 :                     	if SonicDriverVer<>1
(2)  269/   A72D8 :                     		dc.w	z80_ptr(loc)
(2)  270/   A72D8 :                     	else
(2)  271/   A72D8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  272/   A72D8 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  273/   A72D8 :                     		endif
(2)  274/   A72D8 :                     		dc.w	loc-songStart
(2)  275/   A72D8 :                     	endif
(2)  276/   A72D8 :                     	endm
(2)  277/   A72D8 :                     
(2)  278/   A72D8 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  279/   A72D8 :                     ; Common to music and SFX
(2)  280/   A72D8 :                     smpsHeaderVoiceUVB macro
(2)  281/   A72D8 :                     	if songStart<>*
(2)  282/   A72D8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  283/   A72D8 :                     	endif
(2)  284/   A72D8 :                     	if SonicDriverVer>=5
(2)  285/   A72D8 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  286/   A72D8 :                     	elseif SonicDriverVer>=3
(2)  287/   A72D8 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  288/   A72D8 :                     	else
(2)  289/   A72D8 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  290/   A72D8 :                     	endif
(2)  291/   A72D8 :                     	endm
(2)  292/   A72D8 :                     
(2)  293/   A72D8 :                     ; Header macros for music (not for SFX)
(2)  294/   A72D8 :                     ; Header - Set up Channel Usage
(2)  295/   A72D8 :                     smpsHeaderChan macro fm,psg
(2)  296/   A72D8 :                     	dc.b	fm,psg
(2)  297/   A72D8 :                     	endm
(2)  298/   A72D8 :                     
(2)  299/   A72D8 :                     ; Header - Set up Tempo
(2)  300/   A72D8 :                     smpsHeaderTempo macro div,mod
(2)  301/   A72D8 :                     	dc.b	div
(2)  302/   A72D8 :                     	convertMainTempoMod mod
(2)  303/   A72D8 :                     	endm
(2)  304/   A72D8 :                     
(2)  305/   A72D8 :                     ; Header - Set up DAC Channel
(2)  306/   A72D8 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  307/   A72D8 :                     	CheckedChannelPointer loc
(2)  308/   A72D8 :                     	if ("pitch"<>"")
(2)  309/   A72D8 :                     		dc.b	pitch
(2)  310/   A72D8 :                     		if ("vol"<>"")
(2)  311/   A72D8 :                     			dc.b	vol
(2)  312/   A72D8 :                     		else
(2)  313/   A72D8 :                     			dc.b	$00
(2)  314/   A72D8 :                     		endif
(2)  315/   A72D8 :                     	else
(2)  316/   A72D8 :                     		dc.w	$00
(2)  317/   A72D8 :                     	endif
(2)  318/   A72D8 :                     	endm
(2)  319/   A72D8 :                     
(2)  320/   A72D8 :                     ; Header - Set up FM Channel
(2)  321/   A72D8 :                     smpsHeaderFM macro loc,pitch,vol
(2)  322/   A72D8 :                     	CheckedChannelPointer loc
(2)  323/   A72D8 :                     	dc.b	pitch,vol
(2)  324/   A72D8 :                     	endm
(2)  325/   A72D8 :                     
(2)  326/   A72D8 :                     ; Header - Set up PSG Channel
(2)  327/   A72D8 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  328/   A72D8 :                     	CheckedChannelPointer loc
(2)  329/   A72D8 :                     	PSGPitchConvert pitch
(2)  330/   A72D8 :                     	dc.b	vol
(2)  331/   A72D8 :                     	; Frequency envelope
(2)  332/   A72D8 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  333/   A72D8 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  334/   A72D8 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  335/   A72D8 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  336/   A72D8 :                     		dc.b	0
(2)  337/   A72D8 :                     	else
(2)  338/   A72D8 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  339/   A72D8 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  340/   A72D8 :                     		endif
(2)  341/   A72D8 :                     		dc.b	mod
(2)  342/   A72D8 :                     	endif
(2)  343/   A72D8 :                     	; Volume envelope
(2)  344/   A72D8 :                     	dc.b	voice
(2)  345/   A72D8 :                     	endm
(2)  346/   A72D8 :                     
(2)  347/   A72D8 :                     ; Header macros for SFX (not for music)
(2)  348/   A72D8 :                     ; Header - Set up Tempo
(2)  349/   A72D8 :                     smpsHeaderTempoSFX macro div
(2)  350/   A72D8 :                     	dc.b	div
(2)  351/   A72D8 :                     	endm
(2)  352/   A72D8 :                     
(2)  353/   A72D8 :                     ; Header - Set up Channel Usage
(2)  354/   A72D8 :                     smpsHeaderChanSFX macro chan
(2)  355/   A72D8 :                     	dc.b	chan
(2)  356/   A72D8 :                     	endm
(2)  357/   A72D8 :                     
(2)  358/   A72D8 :                     ; Header - Set up FM Channel
(2)  359/   A72D8 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  360/   A72D8 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  361/   A72D8 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  362/   A72D8 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  363/   A72D8 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  364/   A72D8 :                     	endif
(2)  365/   A72D8 :                     	dc.b	$80,chanid
(2)  366/   A72D8 :                     	CheckedChannelPointer loc
(2)  367/   A72D8 :                     	if (chanid&$80)<>0
(2)  368/   A72D8 :                     		PSGPitchConvert pitch
(2)  369/   A72D8 :                     	else
(2)  370/   A72D8 :                     		dc.b	pitch
(2)  371/   A72D8 :                     	endif
(2)  372/   A72D8 :                     	dc.b	vol
(2)  373/   A72D8 :                     	endm
(2)  374/   A72D8 :                     ; ---------------------------------------------------------------------------
(2)  375/   A72D8 :                     ; Co-ord Flag Macros and Equates
(2)  376/   A72D8 :                     ; E0xx - Panning, AMS, FMS
(2)  377/   A72D8 :                     smpsPan macro direction,amsfms
(2)  378/   A72D8 :                     panNone set $00
(2)  379/   A72D8 :                     panRight set $40
(2)  380/   A72D8 :                     panLeft set $80
(2)  381/   A72D8 :                     panCentre set $C0
(2)  382/   A72D8 :                     panCenter set $C0 ; silly Americans :U
(2)  383/   A72D8 :                     	dc.b $E0,direction+amsfms
(2)  384/   A72D8 :                     	endm
(2)  385/   A72D8 :                     
(2)  386/   A72D8 :                     ; E1xx - Set channel detune to val
(2)  387/   A72D8 :                     smpsDetune macro val
(2)  388/   A72D8 :                     	dc.b	$E1,val
(2)  389/   A72D8 :                     	endm
(2)  390/   A72D8 :                     
(2)  391/   A72D8 :                     ; E2xx - Useless
(2)  392/   A72D8 :                     smpsNop macro val
(2)  393/   A72D8 :                     	if SonicDriverVer<3
(2)  394/   A72D8 :                     		dc.b	$E2,val
(2)  395/   A72D8 :                     	endif
(2)  396/   A72D8 :                     	endm
(2)  397/   A72D8 :                     
(2)  398/   A72D8 :                     ; Return (used after smpsCall)
(2)  399/   A72D8 :                     smpsReturn macro val
(2)  400/   A72D8 :                     	if SonicDriverVer>=3
(2)  401/   A72D8 :                     		dc.b	$F9
(2)  402/   A72D8 :                     	else
(2)  403/   A72D8 :                     		dc.b	$E3
(2)  404/   A72D8 :                     	endif
(2)  405/   A72D8 :                     	endm
(2)  406/   A72D8 :                     
(2)  407/   A72D8 :                     ; Fade in previous song (ie. 1-Up)
(2)  408/   A72D8 :                     smpsFade macro val
(2)  409/   A72D8 :                     	if SonicDriverVer>=3
(2)  410/   A72D8 :                     		dc.b	$E2
(2)  411/   A72D8 :                     		if ("val"<>"")
(2)  412/   A72D8 :                     			dc.b	val
(2)  413/   A72D8 :                     		else
(2)  414/   A72D8 :                     			dc.b	$FF
(2)  415/   A72D8 :                     		endif
(2)  416/   A72D8 :                     		if SourceDriver<3
(2)  417/   A72D8 :                     			smpsStop
(2)  418/   A72D8 :                     		endif
(2)  419/   A72D8 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  420/   A72D8 :                     		; This is one of those weird S3+ "fades" that we don't need
(2)  421/   A72D8 :                     	else
(2)  422/   A72D8 :                     		dc.b	$E4
(2)  423/   A72D8 :                     	endif
(2)  424/   A72D8 :                     	endm
(2)  425/   A72D8 :                     
(2)  426/   A72D8 :                     ; E5xx - Set channel tempo divider to xx
(2)  427/   A72D8 :                     smpsChanTempoDiv macro val
(2)  428/   A72D8 :                     	if SonicDriverVer>=5
(2)  429/   A72D8 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  430/   A72D8 :                     		dc.b	$FF,$08,val
(2)  431/   A72D8 :                     	elseif SonicDriverVer==3
(2)  432/   A72D8 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  433/   A72D8 :                     	else
(2)  434/   A72D8 :                     		dc.b	$E5,val
(2)  435/   A72D8 :                     	endif
(2)  436/   A72D8 :                     	endm
(2)  437/   A72D8 :                     
(2)  438/   A72D8 :                     ; E6xx - Alter Volume by xx
(2)  439/   A72D8 :                     smpsAlterVol macro val
(2)  440/   A72D8 :                     	dc.b	$E6,val
(2)  441/   A72D8 :                     	endm
(2)  442/   A72D8 :                     
(2)  443/   A72D8 :                     ; E7 - Prevent attack of next note
(2)  444/   A72D8 : =$E7                 smpsNoAttack	EQU $E7
(2)  445/   A72D8 :                     
(2)  446/   A72D8 :                     ; E8xx - Set note fill to xx
(2)  447/   A72D8 :                     smpsNoteFill macro val
(2)  448/   A72D8 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  449/   A72D8 :                     		; Unique to Flamewing's modified driver
(2)  450/   A72D8 :                     		dc.b	$FF,$0A,val
(2)  451/   A72D8 :                     	else
(2)  452/   A72D8 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  453/   A72D8 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  454/   A72D8 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  455/   A72D8 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  456/   A72D8 :                     		endif
(2)  457/   A72D8 :                     		dc.b	$E8,val
(2)  458/   A72D8 :                     	endif
(2)  459/   A72D8 :                     	endm
(2)  460/   A72D8 :                     
(2)  461/   A72D8 :                     ; Add xx to channel pitch
(2)  462/   A72D8 :                     smpsChangeTransposition macro val
(2)  463/   A72D8 :                     	if SonicDriverVer>=3
(2)  464/   A72D8 :                     		dc.b	$FB,val
(2)  465/   A72D8 :                     	else
(2)  466/   A72D8 :                     		dc.b	$E9,val
(2)  467/   A72D8 :                     	endif
(2)  468/   A72D8 :                     	endm
(2)  469/   A72D8 :                     
(2)  470/   A72D8 :                     ; Set music tempo modifier to xx
(2)  471/   A72D8 :                     smpsSetTempoMod macro mod
(2)  472/   A72D8 :                     	if SonicDriverVer>=3
(2)  473/   A72D8 :                     		dc.b	$FF,$00
(2)  474/   A72D8 :                     	else
(2)  475/   A72D8 :                     		dc.b	$EA
(2)  476/   A72D8 :                     	endif
(2)  477/   A72D8 :                     	convertMainTempoMod mod
(2)  478/   A72D8 :                     	endm
(2)  479/   A72D8 :                     
(2)  480/   A72D8 :                     ; Set music tempo divider to xx
(2)  481/   A72D8 :                     smpsSetTempoDiv macro val
(2)  482/   A72D8 :                     	if SonicDriverVer>=3
(2)  483/   A72D8 :                     		dc.b	$FF,$04,val
(2)  484/   A72D8 :                     	else
(2)  485/   A72D8 :                     		dc.b	$EB,val
(2)  486/   A72D8 :                     	endif
(2)  487/   A72D8 :                     	endm
(2)  488/   A72D8 :                     
(2)  489/   A72D8 :                     ; ECxx - Set Volume to xx
(2)  490/   A72D8 :                     smpsSetVol macro val
(2)  491/   A72D8 :                     	if SonicDriverVer>=3
(2)  492/   A72D8 :                     		dc.b	$E4,val
(2)  493/   A72D8 :                     	else
(2)  494/   A72D8 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  495/   A72D8 :                     	endif
(2)  496/   A72D8 :                     	endm
(2)  497/   A72D8 :                     
(2)  498/   A72D8 :                     ; Works on all drivers
(2)  499/   A72D8 :                     smpsPSGAlterVol macro vol
(2)  500/   A72D8 :                     	dc.b	$EC,vol
(2)  501/   A72D8 :                     	endm
(2)  502/   A72D8 :                     
(2)  503/   A72D8 :                     smpsPSGAlterVolS2 macro vol
(2)  504/   A72D8 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  505/   A72D8 :                     	if SonicDriverVer==2
(2)  506/   A72D8 :                     		smpsAlterVol vol
(2)  507/   A72D8 :                     	else
(2)  508/   A72D8 :                     		smpsPSGAlterVol vol
(2)  509/   A72D8 :                     	endif
(2)  510/   A72D8 :                     	endm
(2)  511/   A72D8 :                     
(2)  512/   A72D8 :                     ; Clears pushing sound flag in S1
(2)  513/   A72D8 :                     smpsClearPush macro
(2)  514/   A72D8 :                     	if SonicDriverVer==1
(2)  515/   A72D8 :                     		dc.b	$ED
(2)  516/   A72D8 :                     	else
(2)  517/   A72D8 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  518/   A72D8 :                     	endif
(2)  519/   A72D8 :                     	endm
(2)  520/   A72D8 :                     
(2)  521/   A72D8 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  522/   A72D8 :                     smpsStopSpecial macro
(2)  523/   A72D8 :                     	if SonicDriverVer==1
(2)  524/   A72D8 :                     		dc.b	$EE
(2)  525/   A72D8 :                     	else
(2)  526/   A72D8 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  527/   A72D8 :                     		smpsStop
(2)  528/   A72D8 :                     	endif
(2)  529/   A72D8 :                     	endm
(2)  530/   A72D8 :                     
(2)  531/   A72D8 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  532/   A72D8 :                     smpsFMvoice macro voice,songID
(2)  533/   A72D8 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  534/   A72D8 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  535/   A72D8 :                     	else
(2)  536/   A72D8 :                     		dc.b	$EF,voice
(2)  537/   A72D8 :                     	endif
(2)  538/   A72D8 :                     	endm
(2)  539/   A72D8 :                     
(2)  540/   A72D8 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  541/   A72D8 :                     smpsModSet macro wait,speed,change,step
(2)  542/   A72D8 :                     	dc.b	$F0
(2)  543/   A72D8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  544/   A72D8 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  545/   A72D8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  546/   A72D8 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  547/   A72D8 :                     	else
(2)  548/   A72D8 :                     		dc.b	wait,speed,change,step
(2)  549/   A72D8 :                     	endif
(2)  550/   A72D8 :                     	;dc.b	speed,change,step
(2)  551/   A72D8 :                     	endm
(2)  552/   A72D8 :                     
(2)  553/   A72D8 :                     ; Turn on Modulation
(2)  554/   A72D8 :                     smpsModOn macro type
(2)  555/   A72D8 :                     	if SonicDriverVer>=3
(2)  556/   A72D8 :                     		if "type"<>""
(2)  557/   A72D8 :                     			dc.b	$F4,type
(2)  558/   A72D8 :                     		else
(2)  559/   A72D8 :                     			dc.b	$F4,$80
(2)  560/   A72D8 :                     		endif
(2)  561/   A72D8 :                     	else
(2)  562/   A72D8 :                     		dc.b	$F1
(2)  563/   A72D8 :                     	endif
(2)  564/   A72D8 :                     	endm
