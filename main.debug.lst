(2)  720/   1DAC2 :                     
(2)  721/   1DAC2 :                     smpsPitchSlide macro enable
(2)  722/   1DAC2 :                     	dc.b	$FF,$0B,enable
(2)  723/   1DAC2 :                     	endm
(2)  724/   1DAC2 :                     
(2)  725/   1DAC2 :                     smpsSetLFO macro enable,amsfms
(2)  726/   1DAC2 :                     	dc.b	$FF,$0C,enable,amsfms
(2)  727/   1DAC2 :                     	endm
