    9170/    D674 :                     ; Routines to mark an enemy/monitor/ring/platform as destroyed
    9171/    D674 :                     ; a0 = the object
    9172/    D674 :                     ; ---------------------------------------------------------------------------
    9173/    D674 :                     RememberState:
    9174/    D674 :                     MarkObjGone:
    9175/    D674 : (MACRO)              		out_of_range.s	loc_CEB0
    9175/    D674 : =>FALSE                              if (""<>"")
    9175/    D674 :                                     move.w  ,d0              ; get object position (if specified as not obX)
    9175/    D674 : =>TRUE                               else
    9175/    D674 : 3028 0008                           move.w  obX(a0),d0      ; get object position
    9175/    D678 : [9175]                               endif
