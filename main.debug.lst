   23922/   1C4F8 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1C4F8 :                     ; ---------------------------------------------------------------------------
(1)    2/   1C4F8 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1C4F8 :                     ;
(1)    4/   1C4F8 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1C4F8 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1C4F8 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1C4F8 :                     ; bits). The assembled data looks something like this:
(1)    8/   1C4F8 :                     ;
(1)    9/   1C4F8 :                     ; aaBBBBBB
(1)   10/   1C4F8 :                     ; ccDDDDDD
(1)   11/   1C4F8 :                     ; EEEEEE
(1)   12/   1C4F8 :                     ; ffgghhii
(1)   13/   1C4F8 :                     ;
(1)   14/   1C4F8 :                     ; aa = index for primary pattern load request list
(1)   15/   1C4F8 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1C4F8 :                     ; cc = index for secondary pattern load request list
(1)   17/   1C4F8 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1C4F8 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1C4F8 :                     ; ff = unused, always 0
(1)   20/   1C4F8 :                     ; gg = unused, music track
(1)   21/   1C4F8 :                     ; hh = unused, palette
(1)   22/   1C4F8 :                     ; ii = palette
(1)   23/   1C4F8 :                     ;
(1)   24/   1C4F8 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1C4F8 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1C4F8 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1C4F8 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1C4F8 :                     ; ---------------------------------------------------------------------------
(1)   29/   1C4F8 :                     
(1)   30/   1C4F8 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1C4F8 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1C4F8 :                     	dc.l (plc1<<24)|art
(1)   33/   1C4F8 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1C4F8 :                     	dc.l map128x128
(1)   35/   1C4F8 :                     	dc.b 0,music,palette,palette
(1)   36/   1C4F8 :                     	endm
(1)   37/   1C4F8 :                     
(1)   38/   1C4F8 :                     ; MainLoadBlocks:
(1)   39/   1C4F8 :                     LevelArtPointers:
(1)   40/   1C4F8 : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Kosp_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ    ; GHZ  ; GREEN HILL ZONE
(1)   40/   1C4F8 : 0404 F8CA                   dc.l (plcid_GHZ<<24)|Kosp_GHZ
(1)   40/   1C4FC : 0504 EB12                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1C500 : 0005 1E50                   dc.l Map128_GHZ
(1)   40/   1C504 : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1C508 : (MACRO)              		levartptrs plcid_LZ,  plcid_LZ2,  Kosp_CPZ, Map16_CPZ, Map128_CPZ, bgm_LZ,  palid_LZ     ; LZ   ; LABYRINTH ZONE
(1)   41/   1C508 : 0605 95DE                   dc.l (plcid_LZ<<24)|Kosp_CPZ
(1)   41/   1C50C : 0705 7DDE                   dc.l (plcid_LZ2<<24)|Map16_CPZ
(1)   41/   1C510 : 0005 C07E                   dc.l Map128_CPZ
(1)   41/   1C514 : 0082 0505                   dc.b 0,bgm_LZ,palid_LZ,palid_LZ
(1)   42/   1C518 : (MACRO)              		levartptrs plcid_CPZ, plcid_CPZ2, Kosp_CPZ, Map16_CPZ, Map128_CPZ, bgm_MZ,  palid_CPZ    ; CPZ  ; CHEMICAL PLANT ZONE
(1)   42/   1C518 : 0805 95DE                   dc.l (plcid_CPZ<<24)|Kosp_CPZ
(1)   42/   1C51C : 0905 7DDE                   dc.l (plcid_CPZ2<<24)|Map16_CPZ
(1)   42/   1C520 : 0005 C07E                   dc.l Map128_CPZ
(1)   42/   1C524 : 0083 0606                   dc.b 0,bgm_MZ,palid_CPZ,palid_CPZ
(1)   43/   1C528 : (MACRO)              		levartptrs plcid_EHZ, plcid_EHZ2, Kosp_EHZ, Map16_EHZ, Map128_EHZ, bgm_SLZ, palid_EHZ    ; EHZ  ; EMERALD HILL ZONE
(1)   43/   1C528 : 0A06 4204                   dc.l (plcid_EHZ<<24)|Kosp_EHZ
(1)   43/   1C52C : 0B06 3264                   dc.l (plcid_EHZ2<<24)|Map16_EHZ
(1)   43/   1C530 : 0006 698C                   dc.l Map128_EHZ
(1)   43/   1C534 : 0084 0707                   dc.b 0,bgm_SLZ,palid_EHZ,palid_EHZ
(1)   44/   1C538 : (MACRO)              		levartptrs plcid_HPZ, plcid_HPZ2, Kosp_HPZ, Map16_HPZ, Map128_HPZ, bgm_SYZ, palid_HPZ    ; HPZ  ; HIDDEN PALACE ZONE
(1)   44/   1C538 : 0C05 EC7C                   dc.l (plcid_HPZ<<24)|Kosp_HPZ
(1)   44/   1C53C : 0D05 D69C                   dc.l (plcid_HPZ2<<24)|Map16_HPZ
(1)   44/   1C540 : 0006 173C                   dc.l Map128_HPZ
(1)   44/   1C544 : 0085 0808                   dc.b 0,bgm_SYZ,palid_HPZ,palid_HPZ
(1)   45/   1C548 : (MACRO)              		levartptrs plcid_HTZ, plcid_HTZ2, Kosp_HTZ, Map16_HTZ, Map128_HTZ, bgm_SBZ, palid_HTZ1   ; HTZ  ; HILL TOP ZONE
(1)   45/   1C548 : 0E06 B0DC                   dc.l (plcid_HTZ<<24)|Kosp_HTZ
(1)   45/   1C54C : 0F06 98DC                   dc.l (plcid_HTZ2<<24)|Map16_HTZ
(1)   45/   1C550 : 0006 D656                   dc.l Map128_HTZ
(1)   45/   1C554 : 0086 0909                   dc.b 0,bgm_SBZ,palid_HTZ1,palid_HTZ1
(1)   46/   1C558 : (MACRO)              		levartptrs 0,         0,          Kosp_GHZ, Map16_GHZ, Map128_GHZ, bgm_SBZ, palid_Ending ; LEV6 ; LEVEL 6 (UNUSED, SONIC 1 ENDING)
(1)   46/   1C558 : 0004 F8CA                   dc.l (0<<24)|Kosp_GHZ
