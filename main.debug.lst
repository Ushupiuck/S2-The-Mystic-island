   23942/   1F372 : =>FALSE                              if (*-1+($20)-((*-1+(-(0)))#($20))) < *
   23942/   1F372 :                                             error "too much stuff before org $\{(*-1+($20)-((*-1+(-(0)))#($20)))} ($\{(*-(*-1+($20)-((*-1+(-(0)))#($20))))} bytes)"
