   22573/   19876 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; LZ
   22574/   19878 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; LZ
   22575/   1987A : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; CPZ
