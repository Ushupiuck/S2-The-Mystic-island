     370/     37E :                     
     371/     37E :                     .loadgfx:
     372/     37E :                     		move.w	(a0)+,(a6)
     373/     37E :                     		dbf	d1,.loadgfx
     374/     37E :                     
     375/     37E :                     		moveq	#0,d0
     376/     37E :                     		move.b	(v_errortype).w,d0
     377/     37E :                     		move.w	ErrorText(pc,d0.w),d0
     378/     37E :                     		lea	ErrorText(pc,d0.w),a0
     379/     37E :                     		locVRAM	vram_fg+$604
     380/     37E :                     		moveq	#$13-1,d1
     381/     37E :                     
     382/     37E :                     .showchars:
     383/     37E :                     		moveq	#0,d0
     384/     37E :                     		move.b	(a0)+,d0
     385/     37E :                     		addi.w	#-'0'+ArtTile_Error_Handler_Font,d0 ; rebase from ASCII to a VRAM index
     386/     37E :                     		move.w	d0,(a6)
     387/     37E :                     		dbf	d1,.showchars	; repeat for number of characters
     388/     37E :                     		rts
