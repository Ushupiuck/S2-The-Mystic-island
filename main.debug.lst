   23942/   1F380 :                                     else
   23942/   1F380 :                                             while (*-1+($20)-((*-1+(-(0)))#($20))) > $
   23942/   1F380 :                                                     db 0
   23942/   1F380 :                                             endm
   23942/   1F380 : [23942]                              endif
   23942/   1F380 : [23942]                      endif
