   10889/   1134A :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
   10890/   1134A :                     		; coordinate system where the x origin is at the object's left edge.
   10891/   1134A : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
   10892/   1134E : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
   10893/   11352 : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
   10894/   11354 : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
   10895/   11358 : 3601                		move.w	d1,d3
