   22696/   1B6DA :                     ; ZONE ANIMATION SCRIPTS
   22697/   1B6DA :                     ;
   22698/   1B6DA :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
   22699/   1B6DA :                     ; thus animating them. All the relevant art must be uncompressed, because
   22700/   1B6DA :                     ; otherwise the subroutine would spend so much time waiting for the art to be
   22701/   1B6DA :                     ; decompressed that the VBLANK window would close before all the animating was done.
   22702/   1B6DA :                     ;
   22703/   1B6DA :                     ;    zoneanimdecl -1, Art_Flowers1, ArtTile_Art_Flowers1, 6, 2
   22704/   1B6DA :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
   22705/   1B6DA :                     ;	ArtUnc_Flowers1		Source address
   22706/   1B6DA :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
   22707/   1B6DA :                     ;	6			Number of frames
   22708/   1B6DA :                     ;	2			Number of tiles to load into VRAM for each frame
   22709/   1B6DA :                     ;
   22710/   1B6DA :                     ;    dc.b   0,$7F		; Start of the script proper
   22711/   1B6DA :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
   22712/   1B6DA :                     ;	$7F			Frame duration. Only here if global duration is -1
   22713/   1B6DA :                     
   22714/   1B6DA :                     
