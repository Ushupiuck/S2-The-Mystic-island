     460/     594 :                                     if (*-1+($594)-((*-1+(-(0)))#($594))) < $
     460/     594 :                                             error "too much stuff before org 0\{(*-1+($594)-((*-1+(-(0)))#($594)))}h (0\{($-(*-1+($594)-((*-1+(-(0)))#($594))))}h bytes)"
     460/     594 :                                     else
     460/     594 :                                             while (*-1+($594)-((*-1+(-(0)))#($594))) > $
     460/     594 :                                                     db 0
     460/     594 :                                             endm
     460/     594 : [460]                                endif
     460/     594 : [460]                        endif
     460/     594 : =>FALSE                      else
