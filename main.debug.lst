    1051/    13F6 : 34D9                		move.w	(a1)+,(a2)+		; Copy VRAM location
    1052/    13F8 : 51C8 FFFA           		dbf	d0,.Load		; Loop until all entries are queued
    1053/    13FC : 7000                		moveq	#0,d0
    1054/    13FE : 24C0                		move.l	d0,(a2)+		; clear the last cue to avoid overcopying it
    1055/    1400 : 34C0                		move.w	d0,(a2)+
    1056/    1402 :                     .End:
    1057/    1402 : 4CDF 0600           		movem.l	(sp)+,a1-a2		; Restore registers
    1058/    1406 : 4E75                		rts
