(2)  876/   1DAAE :                     
(2)  877/   1DAAE :                     ; Voices - Total Level
(2)  878/   1DAAE :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  879/   1DAAE :                     ; but later versions leave it up to the user.
(2)  880/   1DAAE :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  881/   1DAAE :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  882/   1DAAE :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  883/   1DAAE :                     ; SMPS Z80 does the opposite.
(2)  884/   1DAAE :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  885/   1DAAE :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  886/   1DAAE :                     ; what we do, so we just print a warning.
(2)  887/   1DAAE :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  888/   1DAAE :                     	set vcTL1,op1
(2)  889/   1DAAE :                     	set vcTL2,op2
(2)  890/   1DAAE :                     	set vcTL3,op3
(2)  891/   1DAAE :                     	set vcTL4,op4
(2)  892/   1DAAE :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  893/   1DAAE :                     ;   0     1     2     3     4     5     6     7
(2)  894/   1DAAE :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  895/   1DAAE :                     	if SourceSMPS2ASM==0
(2)  896/   1DAAE :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  897/   1DAAE :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  898/   1DAAE :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  899/   1DAAE :                     		set vcTLMask1,$80
(2)  900/   1DAAE :                     	else
(2)  901/   1DAAE :                     		set vcTLMask4,0
(2)  902/   1DAAE :                     		set vcTLMask3,0
(2)  903/   1DAAE :                     		set vcTLMask2,0
(2)  904/   1DAAE :                     		set vcTLMask1,0
(2)  905/   1DAAE :                     	endif
(2)  906/   1DAAE :                     
(2)  907/   1DAAE :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  908/   1DAAE :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  909/   1DAAE :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  910/   1DAAE :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  911/   1DAAE :                     		set vcTLMask1,$80
(2)  912/   1DAAE :                     		set vcTL1,vcTL1&$7F
(2)  913/   1DAAE :                     		set vcTL2,vcTL2&$7F
(2)  914/   1DAAE :                     		set vcTL3,vcTL3&$7F
(2)  915/   1DAAE :                     		set vcTL4,vcTL4&$7F
(2)  916/   1DAAE :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&$80)<>$80)||(((vcTL2|vcTLMask2)&$80)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&$80)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&$80)<>((vcAlgorithm==7)<<7)))
(2)  917/   1DAAE :                     		if MOMPASS=1
(2)  918/   1DAAE :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  919/   1DAAE :                     		endif
(2)  920/   1DAAE :                     	endif
(2)  921/   1DAAE :                     
(2)  922/   1DAAE :                     	if SonicDriverVer==2
(2)  923/   1DAAE :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  924/   1DAAE :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  925/   1DAAE :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  926/   1DAAE :                     		dc.b	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  927/   1DAAE :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  928/   1DAAE :                     		dc.b	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  929/   1DAAE :                     	else
(2)  930/   1DAAE :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  931/   1DAAE :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  932/   1DAAE :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  933/   1DAAE :                     		dc.b	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  934/   1DAAE :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  935/   1DAAE :                     		dc.b	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  936/   1DAAE :                     	endif
(2)  937/   1DAAE :                     	endm
