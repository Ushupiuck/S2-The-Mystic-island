(2)  223/      EE :                     zDAC_Kick:	include "sound/dac/dpcm/generated/kick.inc"
(3)    1/      EE : =203AH               .sample_rate = 8250
(3)    2/      EE : =352H                .size = 850
(3)    3/      EE :                     	binclude "sound/dac/dpcm/generated/kick.dpcm"
(3)    4/     440 :                     
