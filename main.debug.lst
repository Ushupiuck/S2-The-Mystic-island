     984/    13C0 :                     ; Subroutine to transfer a plane map to VRAM
     985/    13C0 :                     ; ---------------------------------------------------------------------------
     986/    13C0 :                     
     987/    13C0 :                     ; control register:
     988/    13C0 :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
     989/    13C0 :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
     990/    13C0 :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
     991/    13C0 :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
     992/    13C0 :                     ;
     993/    13C0 :                     ;	A00-A15 - address
     994/    13C0 :                     ;	CD0-CD3 - code
     995/    13C0 :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
     996/    13C0 :                     ;	CD5 - DMA operation
     997/    13C0 :                     ;
     998/    13C0 :                     ;	Bits CD3-CD0:
     999/    13C0 :                     ;	0000 - VRAM read
    1000/    13C0 :                     ;	0001 - VRAM write
    1001/    13C0 :                     ;	0011 - CRAM write
    1002/    13C0 :                     ;	0100 - VSRAM read
    1003/    13C0 :                     ;	0101 - VSRAM write
    1004/    13C0 :                     ;	1000 - CRAM read
    1005/    13C0 :                     ;
    1006/    13C0 :                     ; d0 = control register
    1007/    13C0 :                     ; d1 = width
    1008/    13C0 :                     ; d2 = heigth
    1009/    13C0 :                     ; a1 = source address
    1010/    13C0 :                     
    1011/    13C0 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
