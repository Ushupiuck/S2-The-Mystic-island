    1008/    1392 :                     ; Subroutine to load pattern load cues (aka to queue pattern load requests)
    1009/    1392 :                     ; ---------------------------------------------------------------------------
    1010/    1392 :                     
    1011/    1392 :                     ; ARGUMENTS
    1012/    1392 :                     ; d0 = index of PLC list (see ArtLoadCues)
    1013/    1392 :                     
    1014/    1392 :                     ; NOTICE: This subroutine does not check for buffer overruns. The programmer
    1015/    1392 :                     ;	  (or hacker) is responsible for making sure that no more than
    1016/    1392 :                     ;	  16 load requests are copied into the buffer.
    1017/    1392 :                     ;    _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
    1018/    1392 :                     ;         (or if you change the size of v_plc_buffer, the limit becomes (v_plc_buffer_Only_End-v_plc_buffer)/6)
    1019/    1392 :                     
    1020/    1392 :                     ; PLCLoad:
    1021/    1392 :                     LoadPLC:
    1022/    1392 : 48E7 0060           		movem.l	a1-a2,-(sp)		; Save registers
    1023/    1396 : 43F9 0001 AB96      		lea	(ArtLoadCues).l,a1	; Prepare PLC list index
    1024/    139C : D040                		add.w	d0,d0			; Get pointer to PLC list
    1025/    139E : 3031 0000           		move.w	(a1,d0.w),d0
    1026/    13A2 : 43F1 0000           		lea	(a1,d0.w),a1
    1027/    13A6 : 45F8 F6B4           		lea	(v_plc_buffer).w,a2	; Prepare PLC buffer
    1028/    13AA :                     
    1029/    13AA :                     .Loop:
    1030/    13AA : 4A92                		tst.l	(a2)			; Is this PLC entry free?
    1031/    13AC : 6704                		beq.s	.FoundFree		; If so, branch
    1032/    13AE : 5C4A                		addq.w	#6,a2			; Check next entry
    1033/    13B0 : 60F8                		bra.s	.Loop
    1034/    13B2 :                     
    1035/    13B2 :                     .FoundFree:
    1036/    13B2 : 3019                		move.w	(a1)+,d0		; Get number of PLC entries
    1037/    13B4 : 6B0E                		bmi.s	.End			; If it's 0 (or less), branch
    1038/    13B6 :                     
    1039/    13B6 :                     .Load:
    1040/    13B6 : 24D9                		move.l	(a1)+,(a2)+		; Copy art pointer
    1041/    13B8 : 34D9                		move.w	(a1)+,(a2)+		; Copy VRAM location
    1042/    13BA : 51C8 FFFA           		dbf	d0,.Load		; Loop until all entries are queued
    1043/    13BE : 7000                		moveq	#0,d0
    1044/    13C0 : 24C0                		move.l	d0,(a2)+		; clear the last cue to avoid overcopying it
    1045/    13C2 : 34C0                		move.w	d0,(a2)+
    1046/    13C4 :                     .End:
    1047/    13C4 : 4CDF 0600           		movem.l	(sp)+,a1-a2		; Restore registers
    1048/    13C8 : 4E75                		rts
