(2)  511/   A6FA4 :                     
(2)  512/   A6FA4 :                     ; Clears pushing sound flag in S1
(2)  513/   A6FA4 :                     smpsClearPush macro
(2)  514/   A6FA4 :                     	if SonicDriverVer==1
(2)  515/   A6FA4 :                     		dc.b	$ED
(2)  516/   A6FA4 :                     	else
