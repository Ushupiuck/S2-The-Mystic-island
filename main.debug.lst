(1)  125/   1C5D2 :                     
   23919/   1C5D2 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1C5D2 :                     ; ---------------------------------------------------------------------------
(1)    2/   1C5D2 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1C5D2 :                     ;
(1)    4/   1C5D2 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1C5D2 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1C5D2 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1C5D2 :                     ; bits). The assembled data looks something like this:
(1)    8/   1C5D2 :                     ;
(1)    9/   1C5D2 :                     ; aaBBBBBB
(1)   10/   1C5D2 :                     ; ccDDDDDD
(1)   11/   1C5D2 :                     ; EEEEEE
(1)   12/   1C5D2 :                     ; ffgghhii
(1)   13/   1C5D2 :                     ;
(1)   14/   1C5D2 :                     ; aa = index for primary pattern load request list
(1)   15/   1C5D2 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1C5D2 :                     ; cc = index for secondary pattern load request list
(1)   17/   1C5D2 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1C5D2 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1C5D2 :                     ; ff = unused, always 0
(1)   20/   1C5D2 :                     ; gg = unused, music track
(1)   21/   1C5D2 :                     ; hh = unused, palette
(1)   22/   1C5D2 :                     ; ii = palette
(1)   23/   1C5D2 :                     ;
(1)   24/   1C5D2 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1C5D2 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1C5D2 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1C5D2 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1C5D2 :                     ; ---------------------------------------------------------------------------
(1)   29/   1C5D2 :                     
(1)   30/   1C5D2 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1C5D2 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1C5D2 :                     	dc.l (plc1<<24)|art
(1)   33/   1C5D2 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1C5D2 :                     	dc.l map128x128
(1)   35/   1C5D2 :                     	dc.b 0,music,palette,palette
(1)   36/   1C5D2 :                     	endm
(1)   37/   1C5D2 :                     
