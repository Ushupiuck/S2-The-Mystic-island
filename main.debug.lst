(1) 1910/   A51DE :                     ; PSG Note Values: c-1 to a-6
(1) 1911/   A51DE :                     ;
(1) 1912/   A51DE :                     ; Each row is an octave, starting with C and ending with B. Sonic 3's driver
(1) 1913/   A51DE :                     ; adds another octave at the start, as well as two more notes and the end to
(1) 1914/   A51DE :                     ; complete the last octave. Notably, a-6 is changed from 0 to $10. These
(1) 1915/   A51DE :                     ; changes need to be applied here in order for ports of songs from Sonic 3
(1) 1916/   A51DE :                     ; and later to sound correct.
(1) 1917/   A51DE :                     ;
(1) 1918/   A51DE :                     ; Here is what Sonic 3's version of this table looks like:
(1) 1919/   A51DE :                     ;		dc.w $3FF, $3FF, $3FF, $3FF, $3FF, $3FF, $3FF, $3FF, $3FF, $3F7, $3BE, $388
(1) 1920/   A51DE :                     ;		dc.w $356, $326, $2F9, $2CE, $2A5, $280, $25C, $23A, $21A, $1FB, $1DF, $1C4
(1) 1921/   A51DE :                     ;		dc.w $1AB, $193, $17D, $167, $153, $140, $12E, $11D, $10D,  $FE,  $EF,  $E2
(1) 1922/   A51DE :                     ;		dc.w  $D6,  $C9,  $BE,  $B4,  $A9,  $A0,  $97,  $8F,  $87,  $7F,  $78,  $71
(1) 1923/   A51DE :                     ;		dc.w  $6B,  $65,  $5F,  $5A,  $55,  $50,  $4B,  $47,  $43,  $40,  $3C,  $39
(1) 1924/   A51DE :                     ;		dc.w  $36,  $33,  $30,  $2D,  $2B,  $28,  $26,  $24,  $22,  $20,  $1F,  $1D
(1) 1925/   A51DE :                     ;		dc.w  $1B,  $1A,  $18,  $17,  $16,  $15,  $13,  $12,  $11,  $10,    0,    0
