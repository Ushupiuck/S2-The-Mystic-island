(1)   50/   A4772 :                     ; ---------------------------------------------------------------------------
(1)   51/   A4772 :                     ; New tempos for songs during speed shoes
(1)   52/   A4772 :                     ; ---------------------------------------------------------------------------
(1)   53/   A4772 :                     ; DANGER! several songs will use the first few bytes of MusicIndex as their main
(1)   54/   A4772 :                     ; tempos while speed shoes are active. If you don't want that, you should add
(1)   55/   A4772 :                     ; their "correct" sped-up main tempos to the list.
(1)   56/   A4772 :                     ; byte_71A94:
(1)   57/   A4772 :                     SpeedUpIndex:
(1)   58/   A4772 : 07                  		dc.b 7		; GHZ
(1)   59/   A4773 : 72                  		dc.b $72	; LZ
(1)   60/   A4774 : 73                  		dc.b $73	; MZ
(1)   61/   A4775 : 26                  		dc.b $26	; SLZ
(1)   62/   A4776 : 15                  		dc.b $15	; SYZ
(1)   63/   A4777 : 08                  		dc.b 8		; SBZ
(1)   64/   A4778 : FF                  		dc.b $FF	; Invincibility
(1)   65/   A4779 : 05                  		dc.b 5		; Extra Life
(1)   66/   A477A :                     		;dc.b ?		; Special Stage
(1)   67/   A477A :                     		;dc.b ?		; Title Screen
