    1262/    167E :                     		include "_inc/DMA Queue.asm"
(1)    1/    167E :                     ; ---------------------------------------------------------------------------
(1)    2/    167E :                     ; MACRO ResetDMAQueue
(1)    3/    167E :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    167E :                     ; ---------------------------------------------------------------------------
(1)    5/    167E :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    167E :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    167E :                     ;
(1)    8/    167E :                     ; Output:
(1)    9/    167E :                     ; 	a1,a5	trashed
(1)   10/    167E :                     ; ---------------------------------------------------------------------------
(1)   11/    167E :                     ; ROUTINE InitDMAQueue
(1)   12/    167E :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    167E :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    167E :                     ; write to this region of RAM.
(1)   15/    167E :                     ;
(1)   16/    167E :                     ; Output:
(1)   17/    167E :                     ; 	a0,d0,d1	trashed
(1)   18/    167E :                     ; ---------------------------------------------------------------------------
(1)   19/    167E :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    167E :                     ; Queues a DMA with parameters given in registers.
(1)   21/    167E :                     ;
(1)   22/    167E :                     ; Options:
(1)   23/    167E :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    167E :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    167E :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    167E :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    167E :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    167E :                     ; Input:
(1)   29/    167E :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    167E :                     ; 		set to 0)
(1)   31/    167E :                     ; 	d2	Destination address
(1)   32/    167E :                     ; 	d3	Transfer length (in words)
(1)   33/    167E :                     ; Output:
(1)   34/    167E :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    167E :                     ;
(1)   36/    167E :                     ; With the default settings, runs in:
(1)   37/    167E :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    167E :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    167E :                     ;
(1)   40/    167E :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    167E :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    167E :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    167E :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    167E :                     ;   fills the queue (second piece is discarded)
(1)   45/    167E :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    167E :                     ;   space for both pieces (both pieces queued)
(1)   47/    167E :                     ;
(1)   48/    167E :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    167E :                     ;
(1)   50/    167E :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    167E :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    167E :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    167E :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    167E :                     ;
(1)   55/    167E :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    167E :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    167E :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    167E :                     ; in the correct form.
(1)   59/    167E :                     ; ---------------------------------------------------------------------------
(1)   60/    167E :                     ; MACRO QueueStaticDMA
(1)   61/    167E :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    167E :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    167E :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    167E :                     ;
(1)   65/    167E :                     ; The destination parameter can be either:
(1)   66/    167E :                     ; * a VRAM address literal;
(1)   67/    167E :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    167E :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    167E :                     ;
(1)   70/    167E :                     ; Options:
(1)   71/    167E :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    167E :                     ; Input:
(1)   73/    167E :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    167E :                     ; Output:
(1)   75/    167E :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    167E :                     ;
(1)   77/    167E :                     ; With the default settings, runs in:
(1)   78/    167E :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    167E :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    167E :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    167E :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    167E :                     ;
(1)   83/    167E :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    167E :                     ; ===========================================================================
(1)   85/    167E :                     ; option: AssumeSourceAddressInBytes
(1)   86/    167E :                     ;
(1)   87/    167E :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    167E :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    167E :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    167E : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    167E :                     ; ===========================================================================
(1)   92/    167E :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    167E :                     ;
(1)   94/    167E :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    167E :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    167E :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    167E :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    167E : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    167E :                     ; ===========================================================================
(1)  100/    167E :                     ; option: UseRAMSourceSafeDMA
(1)  101/    167E :                     ;
(1)  102/    167E :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    167E :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    167E :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    167E : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    167E :                     ; ===========================================================================
(1)  107/    167E :                     ; option: Use128kbSafeDMA
(1)  108/    167E :                     ;
(1)  109/    167E :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    167E :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    167E :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    167E :                     ; the job in situations where you can't align it in ROM.
(1)  113/    167E : =$1                  Use128kbSafeDMA = 1
(1)  114/    167E :                     ; ===========================================================================
(1)  115/    167E :                     ; option UseVIntSafeDMA
(1)  116/    167E :                     ;
(1)  117/    167E :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    167E :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    167E :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    167E :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    167E :                     ; restore interrupts after.
(1)  122/    167E : =$1                  UseVIntSafeDMA = 1
(1)  123/    167E :                     ; ===========================================================================
(1)  124/    167E :                     ; Convenience macros, for increased maintainability of the code.
(1)  125/    167E : =>DEFINED            	ifndef DMA
(1)  126/    167E :                     		equ	DMA,%100111
(1)  127/    167E : [125]                	endif
(1)  128/    167E : =>DEFINED            	ifndef VRAM
(1)  129/    167E :                     		equ	VRAM,%100001
(1)  130/    167E : [128]                	endif
(1)  131/    167E : =>UNDEFINED          	ifndef vdpCommReg_defined
(1)  132/    167E :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    167E : =$1                  vdpCommReg_defined = 1
(1)  134/    167E :                     vdpCommReg macro reg,type,rwd,clr
(1)  135/    167E :                     	lsl.l	#2,reg							; Move high bits into (word-swapped) position, accidentally moving everything else
(1)  136/    167E :                     	set .upperbits,(type&rwd)&3
(1)  137/    167E :                     	if .upperbits<>0
(1)  138/    167E :                     		addq.w	#.upperbits,reg				; Add upper access type bits
(1)  139/    167E :                     	endif
(1)  140/    167E :                     	ror.w	#2,reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
(1)  141/    167E :                     	swap	reg								; Put all bits in proper places
(1)  142/    167E :                     	if clr <> 0
(1)  143/    167E :                     		andi.w	#3,reg						; Strip whatever junk was in upper word of reg
(1)  144/    167E :                     	endif
(1)  145/    167E :                     	set .lowerbits,(type&rwd)&$FC
(1)  146/    167E :                     	if .lowerbits==$20
(1)  147/    167E :                     		tas.b	reg							; Add in the DMA flag -- tas fails on memory, but works on registers
(1)  148/    167E :                     	elseif .lowerbits<>0
(1)  149/    167E :                     		ori.w	#(.lowerbits<<2),reg		; Add in missing access type bits
(1)  150/    167E :                     	endif
(1)  151/    167E :                     	endm
(1)  152/    167E : [131]                	endif
