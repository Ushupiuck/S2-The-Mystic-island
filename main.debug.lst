     224/     2FA : 8F02                		dc.w $8F02				; VDP increment
     225/     2FC : C000 0000           		dc.l $C0000000				; value	for CRAM Write mode
     226/     300 : 4000 0010           		dc.l $40000010				; value	for VSRAM write	mode
