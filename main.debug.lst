(2)  158/   A6FA4 :                     ; ---------------------------------------------------------------------------
(2)  159/   A6FA4 :                     ; Channel IDs for SFX
(2)  160/   A6FA4 : =$80                 cPSG1				EQU $80
(2)  161/   A6FA4 : =$A0                 cPSG2				EQU $A0
(2)  162/   A6FA4 : =$C0                 cPSG3				EQU $C0
(2)  163/   A6FA4 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  164/   A6FA4 : =$2                  cFM3				EQU $02
(2)  165/   A6FA4 : =$4                  cFM4				EQU $04
(2)  166/   A6FA4 : =$5                  cFM5				EQU $05
(2)  167/   A6FA4 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  168/   A6FA4 :                     ; ---------------------------------------------------------------------------
(2)  169/   A6FA4 :                     ; Conversion macros and functions
(2)  170/   A6FA4 :                     
(2)  171/   A6FA4 :                     conv0To256  function n,((n==0)<<8)|n
(2)  172/   A6FA4 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  173/   A6FA4 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  174/   A6FA4 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  175/   A6FA4 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  176/   A6FA4 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  177/   A6FA4 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  178/   A6FA4 :                     
(2)  179/   A6FA4 :                     convertMainTempoMod macro mod
(2)  180/   A6FA4 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  181/   A6FA4 :                     		dc.b	mod
(2)  182/   A6FA4 :                     	elseif SourceDriver==1
(2)  183/   A6FA4 :                     		if mod==1
(2)  184/   A6FA4 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  185/   A6FA4 :                     		endif
(2)  186/   A6FA4 :                     		if SonicDriverVer==2
(2)  187/   A6FA4 :                     			dc.b	s1TempotoS2(mod)
(2)  188/   A6FA4 :                     		else;if SonicDriverVer>=3
(2)  189/   A6FA4 :                     			dc.b	s1TempotoS3(mod)
(2)  190/   A6FA4 :                     		endif
(2)  191/   A6FA4 :                     	elseif SourceDriver==2
(2)  192/   A6FA4 :                     		if mod==0
(2)  193/   A6FA4 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  194/   A6FA4 :                     		endif
(2)  195/   A6FA4 :                     		if SonicDriverVer==1
(2)  196/   A6FA4 :                     			dc.b	s2TempotoS1(mod)
(2)  197/   A6FA4 :                     		else;if SonicDriverVer>=3
(2)  198/   A6FA4 :                     			dc.b	s2TempotoS3(mod)
(2)  199/   A6FA4 :                     		endif
(2)  200/   A6FA4 :                     	else;if SourceDriver>=3
(2)  201/   A6FA4 :                     		if mod==0
(2)  202/   A6FA4 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  203/   A6FA4 :                     		endif
(2)  204/   A6FA4 :                     		if SonicDriverVer==1
(2)  205/   A6FA4 :                     			dc.b	s3TempotoS1(mod)
(2)  206/   A6FA4 :                     		else;if SonicDriverVer==2
(2)  207/   A6FA4 :                     			dc.b	s3TempotoS2(mod)
(2)  208/   A6FA4 :                     		endif
(2)  209/   A6FA4 :                     	endif
(2)  210/   A6FA4 :                     	endm
(2)  211/   A6FA4 :                     
(2)  212/   A6FA4 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  213/   A6FA4 :                     PSGPitchConvert macro pitch
(2)  214/   A6FA4 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  215/   A6FA4 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  216/   A6FA4 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  217/   A6FA4 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  218/   A6FA4 :                     	else
(2)  219/   A6FA4 :                     		dc.b	pitch
(2)  220/   A6FA4 :                     	endif
(2)  221/   A6FA4 :                     	endm
(2)  222/   A6FA4 :                     
(2)  223/   A6FA4 :                     CheckedChannelPointer macro loc
(2)  224/   A6FA4 :                     	if SonicDriverVer<>1
(2)  225/   A6FA4 :                     		dc.w	z80_ptr(loc)
(2)  226/   A6FA4 :                     	else
(2)  227/   A6FA4 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  228/   A6FA4 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  229/   A6FA4 :                     		endif
(2)  230/   A6FA4 :                     		dc.w	loc-songStart
(2)  231/   A6FA4 :                     	endif
(2)  232/   A6FA4 :                     	endm
(2)  233/   A6FA4 :                     ; ---------------------------------------------------------------------------
(2)  234/   A6FA4 :                     ; Header Macros
(2)  235/   A6FA4 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  236/   A6FA4 :                     
(2)  237/   A6FA4 :                     SourceDriver set ver
(2)  238/   A6FA4 :                     
(2)  239/   A6FA4 :                     	if ("sourcesmps2asmver"<>"")
(2)  240/   A6FA4 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  241/   A6FA4 :                     	else
(2)  242/   A6FA4 :                     		set SourceSMPS2ASM,0
(2)  243/   A6FA4 :                     	endif
(2)  244/   A6FA4 :                     
(2)  245/   A6FA4 :                     songStart set *
(2)  246/   A6FA4 :                     
(2)  247/   A6FA4 :                     	if MOMPASS=1
(2)  248/   A6FA4 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  249/   A6FA4 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  250/   A6FA4 :                     		endif
(2)  251/   A6FA4 :                     	endif
(2)  252/   A6FA4 :                     
(2)  253/   A6FA4 :                     	endm
(2)  254/   A6FA4 :                     
(2)  255/   A6FA4 :                     smpsHeaderVoiceNull macro
(2)  256/   A6FA4 :                     	if songStart<>*
(2)  257/   A6FA4 :                     		fatal "Missing smpsHeaderStartSong"
(2)  258/   A6FA4 :                     	endif
(2)  259/   A6FA4 :                     	dc.w	$0000
(2)  260/   A6FA4 :                     	endm
(2)  261/   A6FA4 :                     
(2)  262/   A6FA4 :                     ; Header - Set up Voice Location
(2)  263/   A6FA4 :                     ; Common to music and SFX
(2)  264/   A6FA4 :                     smpsHeaderVoice macro loc
(2)  265/   A6FA4 :                     	if songStart<>*
(2)  266/   A6FA4 :                     		fatal "Missing smpsHeaderStartSong"
(2)  267/   A6FA4 :                     	endif
(2)  268/   A6FA4 :                     	if SonicDriverVer<>1
(2)  269/   A6FA4 :                     		dc.w	z80_ptr(loc)
(2)  270/   A6FA4 :                     	else
(2)  271/   A6FA4 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  272/   A6FA4 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  273/   A6FA4 :                     		endif
(2)  274/   A6FA4 :                     		dc.w	loc-songStart
(2)  275/   A6FA4 :                     	endif
(2)  276/   A6FA4 :                     	endm
(2)  277/   A6FA4 :                     
(2)  278/   A6FA4 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  279/   A6FA4 :                     ; Common to music and SFX
(2)  280/   A6FA4 :                     smpsHeaderVoiceUVB macro
(2)  281/   A6FA4 :                     	if songStart<>*
(2)  282/   A6FA4 :                     		fatal "Missing smpsHeaderStartSong"
(2)  283/   A6FA4 :                     	endif
(2)  284/   A6FA4 :                     	if SonicDriverVer>=5
(2)  285/   A6FA4 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  286/   A6FA4 :                     	elseif SonicDriverVer>=3
(2)  287/   A6FA4 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  288/   A6FA4 :                     	else
(2)  289/   A6FA4 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  290/   A6FA4 :                     	endif
(2)  291/   A6FA4 :                     	endm
(2)  292/   A6FA4 :                     
(2)  293/   A6FA4 :                     ; Header macros for music (not for SFX)
(2)  294/   A6FA4 :                     ; Header - Set up Channel Usage
(2)  295/   A6FA4 :                     smpsHeaderChan macro fm,psg
(2)  296/   A6FA4 :                     	dc.b	fm,psg
(2)  297/   A6FA4 :                     	endm
(2)  298/   A6FA4 :                     
(2)  299/   A6FA4 :                     ; Header - Set up Tempo
(2)  300/   A6FA4 :                     smpsHeaderTempo macro div,mod
(2)  301/   A6FA4 :                     	dc.b	div
(2)  302/   A6FA4 :                     	convertMainTempoMod mod
(2)  303/   A6FA4 :                     	endm
(2)  304/   A6FA4 :                     
(2)  305/   A6FA4 :                     ; Header - Set up DAC Channel
(2)  306/   A6FA4 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  307/   A6FA4 :                     	CheckedChannelPointer loc
(2)  308/   A6FA4 :                     	if ("pitch"<>"")
(2)  309/   A6FA4 :                     		dc.b	pitch
(2)  310/   A6FA4 :                     		if ("vol"<>"")
(2)  311/   A6FA4 :                     			dc.b	vol
(2)  312/   A6FA4 :                     		else
(2)  313/   A6FA4 :                     			dc.b	$00
(2)  314/   A6FA4 :                     		endif
(2)  315/   A6FA4 :                     	else
(2)  316/   A6FA4 :                     		dc.w	$00
(2)  317/   A6FA4 :                     	endif
(2)  318/   A6FA4 :                     	endm
(2)  319/   A6FA4 :                     
(2)  320/   A6FA4 :                     ; Header - Set up FM Channel
(2)  321/   A6FA4 :                     smpsHeaderFM macro loc,pitch,vol
(2)  322/   A6FA4 :                     	CheckedChannelPointer loc
(2)  323/   A6FA4 :                     	dc.b	pitch,vol
(2)  324/   A6FA4 :                     	endm
(2)  325/   A6FA4 :                     
(2)  326/   A6FA4 :                     ; Header - Set up PSG Channel
(2)  327/   A6FA4 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  328/   A6FA4 :                     	CheckedChannelPointer loc
(2)  329/   A6FA4 :                     	PSGPitchConvert pitch
(2)  330/   A6FA4 :                     	dc.b	vol
(2)  331/   A6FA4 :                     	; Frequency envelope
(2)  332/   A6FA4 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  333/   A6FA4 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  334/   A6FA4 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  335/   A6FA4 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  336/   A6FA4 :                     		dc.b	0
(2)  337/   A6FA4 :                     	else
(2)  338/   A6FA4 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  339/   A6FA4 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  340/   A6FA4 :                     		endif
(2)  341/   A6FA4 :                     		dc.b	mod
(2)  342/   A6FA4 :                     	endif
(2)  343/   A6FA4 :                     	; Volume envelope
(2)  344/   A6FA4 :                     	dc.b	voice
(2)  345/   A6FA4 :                     	endm
(2)  346/   A6FA4 :                     
(2)  347/   A6FA4 :                     ; Header macros for SFX (not for music)
(2)  348/   A6FA4 :                     ; Header - Set up Tempo
(2)  349/   A6FA4 :                     smpsHeaderTempoSFX macro div
(2)  350/   A6FA4 :                     	dc.b	div
(2)  351/   A6FA4 :                     	endm
(2)  352/   A6FA4 :                     
(2)  353/   A6FA4 :                     ; Header - Set up Channel Usage
(2)  354/   A6FA4 :                     smpsHeaderChanSFX macro chan
(2)  355/   A6FA4 :                     	dc.b	chan
(2)  356/   A6FA4 :                     	endm
(2)  357/   A6FA4 :                     
(2)  358/   A6FA4 :                     ; Header - Set up FM Channel
(2)  359/   A6FA4 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  360/   A6FA4 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  361/   A6FA4 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  362/   A6FA4 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  363/   A6FA4 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  364/   A6FA4 :                     	endif
(2)  365/   A6FA4 :                     	dc.b	$80,chanid
(2)  366/   A6FA4 :                     	CheckedChannelPointer loc
(2)  367/   A6FA4 :                     	if (chanid&$80)<>0
(2)  368/   A6FA4 :                     		PSGPitchConvert pitch
(2)  369/   A6FA4 :                     	else
(2)  370/   A6FA4 :                     		dc.b	pitch
(2)  371/   A6FA4 :                     	endif
(2)  372/   A6FA4 :                     	dc.b	vol
(2)  373/   A6FA4 :                     	endm
(2)  374/   A6FA4 :                     ; ---------------------------------------------------------------------------
(2)  375/   A6FA4 :                     ; Co-ord Flag Macros and Equates
(2)  376/   A6FA4 :                     ; E0xx - Panning, AMS, FMS
(2)  377/   A6FA4 :                     smpsPan macro direction,amsfms
(2)  378/   A6FA4 :                     panNone set $00
(2)  379/   A6FA4 :                     panRight set $40
(2)  380/   A6FA4 :                     panLeft set $80
(2)  381/   A6FA4 :                     panCentre set $C0
(2)  382/   A6FA4 :                     panCenter set $C0 ; silly Americans :U
(2)  383/   A6FA4 :                     	dc.b $E0,direction+amsfms
(2)  384/   A6FA4 :                     	endm
(2)  385/   A6FA4 :                     
(2)  386/   A6FA4 :                     ; E1xx - Set channel detune to val
(2)  387/   A6FA4 :                     smpsDetune macro val
(2)  388/   A6FA4 :                     	dc.b	$E1,val
(2)  389/   A6FA4 :                     	endm
(2)  390/   A6FA4 :                     
(2)  391/   A6FA4 :                     ; E2xx - Useless
(2)  392/   A6FA4 :                     smpsNop macro val
(2)  393/   A6FA4 :                     	if SonicDriverVer<3
(2)  394/   A6FA4 :                     		dc.b	$E2,val
(2)  395/   A6FA4 :                     	endif
(2)  396/   A6FA4 :                     	endm
(2)  397/   A6FA4 :                     
(2)  398/   A6FA4 :                     ; Return (used after smpsCall)
(2)  399/   A6FA4 :                     smpsReturn macro val
(2)  400/   A6FA4 :                     	if SonicDriverVer>=3
(2)  401/   A6FA4 :                     		dc.b	$F9
(2)  402/   A6FA4 :                     	else
(2)  403/   A6FA4 :                     		dc.b	$E3
(2)  404/   A6FA4 :                     	endif
(2)  405/   A6FA4 :                     	endm
(2)  406/   A6FA4 :                     
(2)  407/   A6FA4 :                     ; Fade in previous song (ie. 1-Up)
(2)  408/   A6FA4 :                     smpsFade macro val
(2)  409/   A6FA4 :                     	if SonicDriverVer>=3
(2)  410/   A6FA4 :                     		dc.b	$E2
(2)  411/   A6FA4 :                     		if ("val"<>"")
(2)  412/   A6FA4 :                     			dc.b	val
(2)  413/   A6FA4 :                     		else
(2)  414/   A6FA4 :                     			dc.b	$FF
(2)  415/   A6FA4 :                     		endif
(2)  416/   A6FA4 :                     		if SourceDriver<3
(2)  417/   A6FA4 :                     			smpsStop
(2)  418/   A6FA4 :                     		endif
(2)  419/   A6FA4 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  420/   A6FA4 :                     		; This is one of those weird S3+ "fades" that we don't need
(2)  421/   A6FA4 :                     	else
(2)  422/   A6FA4 :                     		dc.b	$E4
(2)  423/   A6FA4 :                     	endif
(2)  424/   A6FA4 :                     	endm
(2)  425/   A6FA4 :                     
(2)  426/   A6FA4 :                     ; E5xx - Set channel tempo divider to xx
(2)  427/   A6FA4 :                     smpsChanTempoDiv macro val
(2)  428/   A6FA4 :                     	if SonicDriverVer>=5
(2)  429/   A6FA4 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  430/   A6FA4 :                     		dc.b	$FF,$08,val
(2)  431/   A6FA4 :                     	elseif SonicDriverVer==3
(2)  432/   A6FA4 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  433/   A6FA4 :                     	else
(2)  434/   A6FA4 :                     		dc.b	$E5,val
(2)  435/   A6FA4 :                     	endif
(2)  436/   A6FA4 :                     	endm
(2)  437/   A6FA4 :                     
(2)  438/   A6FA4 :                     ; E6xx - Alter Volume by xx
(2)  439/   A6FA4 :                     smpsAlterVol macro val
(2)  440/   A6FA4 :                     	dc.b	$E6,val
(2)  441/   A6FA4 :                     	endm
(2)  442/   A6FA4 :                     
(2)  443/   A6FA4 :                     ; E7 - Prevent attack of next note
(2)  444/   A6FA4 : =$E7                 smpsNoAttack	EQU $E7
(2)  445/   A6FA4 :                     
(2)  446/   A6FA4 :                     ; E8xx - Set note fill to xx
(2)  447/   A6FA4 :                     smpsNoteFill macro val
(2)  448/   A6FA4 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  449/   A6FA4 :                     		; Unique to Flamewing's modified driver
(2)  450/   A6FA4 :                     		dc.b	$FF,$0A,val
(2)  451/   A6FA4 :                     	else
(2)  452/   A6FA4 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  453/   A6FA4 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  454/   A6FA4 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  455/   A6FA4 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  456/   A6FA4 :                     		endif
(2)  457/   A6FA4 :                     		dc.b	$E8,val
(2)  458/   A6FA4 :                     	endif
(2)  459/   A6FA4 :                     	endm
(2)  460/   A6FA4 :                     
(2)  461/   A6FA4 :                     ; Add xx to channel pitch
(2)  462/   A6FA4 :                     smpsChangeTransposition macro val
(2)  463/   A6FA4 :                     	if SonicDriverVer>=3
(2)  464/   A6FA4 :                     		dc.b	$FB,val
(2)  465/   A6FA4 :                     	else
(2)  466/   A6FA4 :                     		dc.b	$E9,val
(2)  467/   A6FA4 :                     	endif
(2)  468/   A6FA4 :                     	endm
(2)  469/   A6FA4 :                     
(2)  470/   A6FA4 :                     ; Set music tempo modifier to xx
(2)  471/   A6FA4 :                     smpsSetTempoMod macro mod
(2)  472/   A6FA4 :                     	if SonicDriverVer>=3
(2)  473/   A6FA4 :                     		dc.b	$FF,$00
(2)  474/   A6FA4 :                     	else
