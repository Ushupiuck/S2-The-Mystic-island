     999/    137E :                     ; Subroutine to load pattern load cues (aka to queue pattern load requests)
    1000/    137E :                     ; ---------------------------------------------------------------------------
    1001/    137E :                     
    1002/    137E :                     ; ARGUMENTS
    1003/    137E :                     ; d0 = index of PLC list (see ArtLoadCues)
    1004/    137E :                     
    1005/    137E :                     ; NOTICE: This subroutine does not check for buffer overruns. The programmer
    1006/    137E :                     ;	  (or hacker) is responsible for making sure that no more than
    1007/    137E :                     ;	  16 load requests are copied into the buffer.
    1008/    137E :                     ;    _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
    1009/    137E :                     ;         (or if you change the size of v_plc_buffer, the limit becomes (v_plc_buffer_Only_End-v_plc_buffer)/6)
    1010/    137E :                     
    1011/    137E :                     ; PLCLoad:
    1012/    137E :                     LoadPLC:
    1013/    137E : 48E7 0060           		movem.l	a1-a2,-(sp)		; Save registers
    1014/    1382 : 43F9 0001 AB82      		lea	(ArtLoadCues).l,a1	; Prepare PLC list index
    1015/    1388 : D040                		add.w	d0,d0			; Get pointer to PLC list
    1016/    138A : 3031 0000           		move.w	(a1,d0.w),d0
    1017/    138E : 43F1 0000           		lea	(a1,d0.w),a1
    1018/    1392 : 45F8 F6B4           		lea	(v_plc_buffer).w,a2	; Prepare PLC buffer
    1019/    1396 :                     
    1020/    1396 :                     .Loop:
    1021/    1396 : 4A92                		tst.l	(a2)			; Is this PLC entry free?
    1022/    1398 : 6704                		beq.s	.FoundFree		; If so, branch
    1023/    139A : 5C4A                		addq.w	#6,a2			; Check next entry
    1024/    139C : 60F8                		bra.s	.Loop
    1025/    139E :                     
    1026/    139E :                     .FoundFree:
    1027/    139E : 3019                		move.w	(a1)+,d0		; Get number of PLC entries
    1028/    13A0 : 6B0E                		bmi.s	.End			; If it's 0 (or less), branch
    1029/    13A2 :                     
    1030/    13A2 :                     .Load:
    1031/    13A2 : 24D9                		move.l	(a1)+,(a2)+		; Copy art pointer
    1032/    13A4 : 34D9                		move.w	(a1)+,(a2)+		; Copy VRAM location
    1033/    13A6 : 51C8 FFFA           		dbf	d0,.Load		; Loop until all entries are queued
    1034/    13AA : 7000                		moveq	#0,d0
    1035/    13AC : 24C0                		move.l	d0,(a2)+		; clear the last cue to avoid overcopying it
    1036/    13AE : 34C0                		move.w	d0,(a2)+
    1037/    13B0 :                     .End:
    1038/    13B0 : 4CDF 0600           		movem.l	(sp)+,a1-a2		; Restore registers
    1039/    13B4 : 4E75                		rts
    1040/    13B6 :                     ; End of function LoadPLC
    1041/    13B6 :                     
    1042/    13B6 :                     
    1043/    13B6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1044/    13B6 :                     ; Queue pattern load requests, but clear the PLQ first
    1045/    13B6 :                     
    1046/    13B6 :                     ; ARGUMENTS
    1047/    13B6 :                     ; d0 = index of PLC list (see ArtLoadCues)
    1048/    13B6 :                     
    1049/    13B6 :                     ; NOTICE: This subroutine does not check for buffer overruns. The programmer
    1050/    13B6 :                     ;	  (or hacker) is responsible for making sure that no more than
    1051/    13B6 :                     ;	  16 load requests are copied into the buffer.
    1052/    13B6 :                     ;	  _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
    1053/    13B6 :                     ;         (or if you change the size of v_plc_buffer, the limit becomes (v_plc_buffer_Only_End-v_plc_buffer)/6)
    1054/    13B6 :                     
    1055/    13B6 :                     NewPLC:
    1056/    13B6 : 48E7 0060           		movem.l	a1-a2,-(sp)		; Save registers
    1057/    13BA : 43F9 0001 AB82      		lea	(ArtLoadCues).l,a1	; Prepare PLC list index
    1058/    13C0 : D040                		add.w	d0,d0
    1059/    13C2 : 3031 0000           		move.w	(a1,d0.w),d0
    1060/    13C6 : 43F1 0000           		lea	(a1,d0.w),a1
    1061/    13CA : 611C                		bsr.s	ClearPLC		; Clear PLCs
    1062/    13CC : 45F8 F6B4           		lea	(v_plc_buffer).w,a2	; Prepare PLC buffer
    1063/    13D0 : 3019                		move.w	(a1)+,d0		; Get number of PLC entries
    1064/    13D2 : 6B0E                		bmi.s	.End			; If it's 0 (or less), branch
    1065/    13D4 :                     
    1066/    13D4 :                     .Load:
    1067/    13D4 : 24D9                		move.l	(a1)+,(a2)+		; Copy art pointer
    1068/    13D6 : 34D9                		move.w	(a1)+,(a2)+		; Copy VRAM location
    1069/    13D8 : 51C8 FFFA           		dbf	d0,.Load		; Loop until all entries are queued
    1070/    13DC : 7000                		moveq	#0,d0
    1071/    13DE : 24C0                		move.l	d0,(a2)+		; clear the last cue to avoid overcopying it
    1072/    13E0 : 34C0                		move.w	d0,(a2)+
