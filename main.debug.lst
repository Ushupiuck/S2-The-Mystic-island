(1) 2486/   1DAC2 :                     
(1) 2487/   1DAC2 :                     ; ---------------------------------------------------------------------------
(1) 2488/   1DAC2 :                     ; SMPS2ASM - A collection of macros that make SMPS's bytecode human-readable.
(1) 2489/   1DAC2 :                     ; ---------------------------------------------------------------------------
(1) 2490/   1DAC2 : =$1                  FixMusicAndSFXDataBugs = FixBugs
(1) 2491/   1DAC2 : =$1                  SonicDriverVer = 1 ; Tell SMPS2ASM that we're using Sonic 1's driver.
(1) 2492/   1DAC2 :                     		include "sound/_smps2asm_inc.asm"
(2)    1/   1DAC2 :                     ; ===========================================================================
(2)    2/   1DAC2 :                     ; Created by Flamewing, based on S1SMPS2ASM version 1.1 by Marc Gordon (AKA Cinossu)
