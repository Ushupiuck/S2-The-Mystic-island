(1)  183/    1666 :                     ; ---------------------------------------------------------------------------
(1)  184/    1666 : =$12                 QueueSlotCount = (VDP_Command_Buffer_Slot-VDP_Command_Buffer)/DMAEntry.len
(1)  185/    1666 :                     ; ---------------------------------------------------------------------------
(1)  186/    1666 : =>UNDEFINED          	ifndef DMAfunctions_defined
(1)  187/    1666 : =$1                  		equ	DMAfunctions_defined,1
(1)  188/    1666 :                     dmaSource function addr,((addr>>1)&$7FFFFF)
(1)  189/    1666 :                     dmaLength function len,((len>>1)&$7FFF)
(1)  190/    1666 : [186]                	endif
(1)  191/    1666 :                     ; ---------------------------------------------------------------------------
(1)  192/    1666 : =>UNDEFINED          	ifndef QueueStaticDMA_defined
(1)  193/    1666 : =$1                  		equ	QueueStaticDMA_defined,1
(1)  194/    1666 :                     is68kRegister function expr,symtype(expr)==8
(1)  195/    1666 :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    1666 :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    1666 :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    1666 :                     QueueStaticDMA macro src,length,dest
(1)  199/    1666 :                     	if MOMPASS>1
(1)  200/    1666 :                     		if ((src)&1)<>0
(1)  201/    1666 :                     			fatal "DMA queued from odd source $\{src}!"
(1)  202/    1666 :                     		endif
(1)  203/    1666 :                     		if ((length)&1)<>0
(1)  204/    1666 :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    1666 :                     		endif
(1)  206/    1666 :                     		if (length)==0
(1)  207/    1666 :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    1666 :                     		endif
(1)  209/    1666 :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    1666 :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    1666 :                     		endif
(1)  212/    1666 :                     	endif
(1)  213/    1666 :                     	if UseVIntSafeDMA==1
(1)  214/    1666 :                     		move.w	sr,-(sp)										; Save current interrupt mask
(1)  215/    1666 :                     		disableInts												; Mask off interrupts
(1)  216/    1666 :                     	endif ; UseVIntSafeDMA==1
(1)  217/    1666 :                     	movea.w	(VDP_Command_Buffer_Slot).w,a1
(1)  218/    1666 :                     	cmpa.w	#VDP_Command_Buffer_Slot,a1
(1)  219/    1666 :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    1666 :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    1666 :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
(1)  222/    1666 :                     	movep.l	d0,DMAEntry.SizeL(a1)								; Write it all to the queue
(1)  223/    1666 :                     	lea	DMAEntry.Command(a1),a1									; Seek to correct RAM address to store VDP DMA command
(1)  224/    1666 :                     	if is68kRegister(dest)
(1)  225/    1666 :                     		move.l	dest,(a1)+
(1)  226/    1666 :                     	else
