   22678/   1B39C :                     ; ZONE ANIMATION SCRIPTS
   22679/   1B39C :                     ;
   22680/   1B39C :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
   22681/   1B39C :                     ; thus animating them. All the relevant art must be uncompressed, because
   22682/   1B39C :                     ; otherwise the subroutine would spend so much time waiting for the art to be
   22683/   1B39C :                     ; decompressed that the VBLANK window would close before all the animating was done.
   22684/   1B39C :                     ;
   22685/   1B39C :                     ;    zoneanimdecl -1, Art_Flowers1, ArtTile_Art_Flowers1, 6, 2
   22686/   1B39C :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
   22687/   1B39C :                     ;	ArtUnc_Flowers1		Source address
   22688/   1B39C :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
   22689/   1B39C :                     ;	6			Number of frames
   22690/   1B39C :                     ;	2			Number of tiles to load into VRAM for each frame
   22691/   1B39C :                     ;
   22692/   1B39C :                     ;    dc.b   0,$7F		; Start of the script proper
   22693/   1B39C :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
   22694/   1B39C :                     ;	$7F			Frame duration. Only here if global duration is -1
   22695/   1B39C :                     
   22696/   1B39C :                     
