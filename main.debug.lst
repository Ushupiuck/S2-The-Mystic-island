(1)  194/    167A :                     is68kRegister function expr,symtype(expr)==8
(1)  195/    167A :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    167A :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    167A :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    167A :                     QueueStaticDMA macro src,length,dest
(1)  199/    167A :                     	if MOMPASS>1
(1)  200/    167A :                     		if ((src)&1)<>0
(1)  201/    167A :                     			fatal "DMA queued from odd source $\{src}!"
(1)  202/    167A :                     		endif
(1)  203/    167A :                     		if ((length)&1)<>0
(1)  204/    167A :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    167A :                     		endif
(1)  206/    167A :                     		if (length)==0
(1)  207/    167A :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    167A :                     		endif
(1)  209/    167A :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    167A :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    167A :                     		endif
(1)  212/    167A :                     	endif
(1)  213/    167A :                     	if UseVIntSafeDMA==1
(1)  214/    167A :                     		move.w	sr,-(sp)										; Save current interrupt mask
(1)  215/    167A :                     		disableInts												; Mask off interrupts
(1)  216/    167A :                     	endif ; UseVIntSafeDMA==1
(1)  217/    167A :                     	movea.w	(VDP_Command_Buffer_Slot).w,a1
(1)  218/    167A :                     	cmpa.w	#VDP_Command_Buffer_Slot,a1
(1)  219/    167A :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    167A :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    167A :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
(1)  222/    167A :                     	movep.l	d0,DMAEntry.SizeL(a1)								; Write it all to the queue
(1)  223/    167A :                     	lea	DMAEntry.Command(a1),a1									; Seek to correct RAM address to store VDP DMA command
