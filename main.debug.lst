(1)  236/       0 :                     	jsr		MDDBG__ErrorHandler
(1)  237/       0 :                     	__FSTRING_GenerateDecodedString string
(1)  238/       0 :                     	if ("consoleprogram"<>"")			; if console program offset is specified ...
(1)  239/       0 :                     		.__align_flag:	set	((((*)&1)!1)*_eh_align_offset)
(1)  240/       0 :                     		if "opts"<>""
