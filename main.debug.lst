   23960/   1FA70 : =$238                paddingSoFar    set paddingSoFar + (*-1+($20)-((*-1+(-(0)))#($20))) - *
   23960/   1FA80 :                                             !org (*-1+($20)-((*-1+(-(0)))#($20)))
   23960/   1FA80 : [23960]                              endif
   23960/   1FA80 : =>FALSE                      else
   23960/   1FA80 :                                     if (*-1+($20)-((*-1+(-(0)))#($20))) < $
   23960/   1FA80 :                                             error "too much stuff before org 0\{(*-1+($20)-((*-1+(-(0)))#($20)))}h (0\{($-(*-1+($20)-((*-1+(-(0)))#($20))))}h bytes)"
   23960/   1FA80 :                                     else
   23960/   1FA80 :                                             while (*-1+($20)-((*-1+(-(0)))#($20))) > $
   23960/   1FA80 :                                                     db 0
   23960/   1FA80 :                                             endm
   23960/   1FA80 : [23960]                              endif
   23960/   1FA80 : [23960]                      endif
   23960/   1FA80 : =>FALSE                      else
   23960/   1FA80 :                                     org ($-1+($20)-(($-1+(-(0)))#($20)))
