(2)  827/   A6FA4 :                     ; Voices - Amplitude Modulation
(2)  828/   A6FA4 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  829/   A6FA4 :                     ; were the Amplitude Modulation.
(2)  830/   A6FA4 :                     ; According to several docs, however, it's actually the high bit.
(2)  831/   A6FA4 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  832/   A6FA4 :                     	if SourceSMPS2ASM==0
(2)  833/   A6FA4 :                     		set vcAM1,op1<<5
(2)  834/   A6FA4 :                     		set vcAM2,op2<<5
(2)  835/   A6FA4 :                     		set vcAM3,op3<<5
(2)  836/   A6FA4 :                     		set vcAM4,op4<<5
(2)  837/   A6FA4 :                     	else
(2)  838/   A6FA4 :                     		set vcAM1,op1<<7
(2)  839/   A6FA4 :                     		set vcAM2,op2<<7
(2)  840/   A6FA4 :                     		set vcAM3,op3<<7
(2)  841/   A6FA4 :                     		set vcAM4,op4<<7
(2)  842/   A6FA4 :                     	endif
(2)  843/   A6FA4 :                     	endm
(2)  844/   A6FA4 :                     
