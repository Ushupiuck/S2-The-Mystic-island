(2)  769/   A6DE8 :                     ; Macros for FM instruments
(2)  770/   A6DE8 :                     ; Voices - Feedback
(2)  771/   A6DE8 :                     smpsVcFeedback macro val
(2)  772/   A6DE8 :                     vcFeedback set val
(2)  773/   A6DE8 :                     	endm
(2)  774/   A6DE8 :                     
(2)  775/   A6DE8 :                     ; Voices - Algorithm
(2)  776/   A6DE8 :                     smpsVcAlgorithm macro val
(2)  777/   A6DE8 :                     vcAlgorithm set val
(2)  778/   A6DE8 :                     	endm
(2)  779/   A6DE8 :                     
(2)  780/   A6DE8 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  781/   A6DE8 :                     vcUnusedBits set val
(2)  782/   A6DE8 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  783/   A6DE8 :                     		set vcD1R1Unk,d1r1<<5
(2)  784/   A6DE8 :                     		set vcD1R2Unk,d1r2<<5
(2)  785/   A6DE8 :                     		set vcD1R3Unk,d1r3<<5
(2)  786/   A6DE8 :                     		set vcD1R4Unk,d1r4<<5
(2)  787/   A6DE8 :                     	else
(2)  788/   A6DE8 :                     		set vcD1R1Unk,0
(2)  789/   A6DE8 :                     		set vcD1R2Unk,0
(2)  790/   A6DE8 :                     		set vcD1R3Unk,0
(2)  791/   A6DE8 :                     		set vcD1R4Unk,0
(2)  792/   A6DE8 :                     	endif
(2)  793/   A6DE8 :                     	endm
(2)  794/   A6DE8 :                     
(2)  795/   A6DE8 :                     ; Voices - Detune
(2)  796/   A6DE8 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  797/   A6DE8 :                     	set vcDT1,op1
(2)  798/   A6DE8 :                     	set vcDT2,op2
(2)  799/   A6DE8 :                     	set vcDT3,op3
(2)  800/   A6DE8 :                     	set vcDT4,op4
(2)  801/   A6DE8 :                     	endm
(2)  802/   A6DE8 :                     
(2)  803/   A6DE8 :                     ; Voices - Coarse-Frequency
(2)  804/   A6DE8 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  805/   A6DE8 :                     	set vcCF1,op1
(2)  806/   A6DE8 :                     	set vcCF2,op2
(2)  807/   A6DE8 :                     	set vcCF3,op3
(2)  808/   A6DE8 :                     	set vcCF4,op4
(2)  809/   A6DE8 :                     	endm
(2)  810/   A6DE8 :                     
(2)  811/   A6DE8 :                     ; Voices - Rate Scale
(2)  812/   A6DE8 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  813/   A6DE8 :                     	set vcRS1,op1
(2)  814/   A6DE8 :                     	set vcRS2,op2
(2)  815/   A6DE8 :                     	set vcRS3,op3
(2)  816/   A6DE8 :                     	set vcRS4,op4
(2)  817/   A6DE8 :                     	endm
(2)  818/   A6DE8 :                     
(2)  819/   A6DE8 :                     ; Voices - Attack Rate
(2)  820/   A6DE8 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  821/   A6DE8 :                     	set vcAR1,op1
(2)  822/   A6DE8 :                     	set vcAR2,op2
(2)  823/   A6DE8 :                     	set vcAR3,op3
(2)  824/   A6DE8 :                     	set vcAR4,op4
(2)  825/   A6DE8 :                     	endm
(2)  826/   A6DE8 :                     
(2)  827/   A6DE8 :                     ; Voices - Amplitude Modulation
(2)  828/   A6DE8 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  829/   A6DE8 :                     ; were the Amplitude Modulation.
(2)  830/   A6DE8 :                     ; According to several docs, however, it's actually the high bit.
(2)  831/   A6DE8 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  832/   A6DE8 :                     	if SourceSMPS2ASM==0
(2)  833/   A6DE8 :                     		set vcAM1,op1<<5
(2)  834/   A6DE8 :                     		set vcAM2,op2<<5
(2)  835/   A6DE8 :                     		set vcAM3,op3<<5
(2)  836/   A6DE8 :                     		set vcAM4,op4<<5
(2)  837/   A6DE8 :                     	else
(2)  838/   A6DE8 :                     		set vcAM1,op1<<7
(2)  839/   A6DE8 :                     		set vcAM2,op2<<7
(2)  840/   A6DE8 :                     		set vcAM3,op3<<7
(2)  841/   A6DE8 :                     		set vcAM4,op4<<7
(2)  842/   A6DE8 :                     	endif
(2)  843/   A6DE8 :                     	endm
(2)  844/   A6DE8 :                     
(2)  845/   A6DE8 :                     ; Voices - First Decay Rate
(2)  846/   A6DE8 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  847/   A6DE8 :                     	set vcD1R1,op1
(2)  848/   A6DE8 :                     	set vcD1R2,op2
(2)  849/   A6DE8 :                     	set vcD1R3,op3
(2)  850/   A6DE8 :                     	set vcD1R4,op4
(2)  851/   A6DE8 :                     	endm
(2)  852/   A6DE8 :                     
(2)  853/   A6DE8 :                     ; Voices - Second Decay Rate
(2)  854/   A6DE8 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  855/   A6DE8 :                     	set vcD2R1,op1
(2)  856/   A6DE8 :                     	set vcD2R2,op2
(2)  857/   A6DE8 :                     	set vcD2R3,op3
(2)  858/   A6DE8 :                     	set vcD2R4,op4
(2)  859/   A6DE8 :                     	endm
(2)  860/   A6DE8 :                     
(2)  861/   A6DE8 :                     ; Voices - Decay Level
(2)  862/   A6DE8 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  863/   A6DE8 :                     	set vcDL1,op1
(2)  864/   A6DE8 :                     	set vcDL2,op2
(2)  865/   A6DE8 :                     	set vcDL3,op3
(2)  866/   A6DE8 :                     	set vcDL4,op4
(2)  867/   A6DE8 :                     	endm
(2)  868/   A6DE8 :                     
(2)  869/   A6DE8 :                     ; Voices - Release Rate
(2)  870/   A6DE8 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  871/   A6DE8 :                     	set vcRR1,op1
(2)  872/   A6DE8 :                     	set vcRR2,op2
(2)  873/   A6DE8 :                     	set vcRR3,op3
(2)  874/   A6DE8 :                     	set vcRR4,op4
(2)  875/   A6DE8 :                     	endm
(2)  876/   A6DE8 :                     
(2)  877/   A6DE8 :                     ; Voices - Total Level
(2)  878/   A6DE8 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  879/   A6DE8 :                     ; but later versions leave it up to the user.
(2)  880/   A6DE8 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  881/   A6DE8 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  882/   A6DE8 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  883/   A6DE8 :                     ; SMPS Z80 does the opposite.
(2)  884/   A6DE8 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  885/   A6DE8 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  886/   A6DE8 :                     ; what we do, so we just print a warning.
(2)  887/   A6DE8 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  888/   A6DE8 :                     	set vcTL1,op1
(2)  889/   A6DE8 :                     	set vcTL2,op2
(2)  890/   A6DE8 :                     	set vcTL3,op3
(2)  891/   A6DE8 :                     	set vcTL4,op4
(2)  892/   A6DE8 :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  893/   A6DE8 :                     ;   0     1     2     3     4     5     6     7
(2)  894/   A6DE8 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  895/   A6DE8 :                     	if SourceSMPS2ASM==0
(2)  896/   A6DE8 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  897/   A6DE8 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  898/   A6DE8 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  899/   A6DE8 :                     		set vcTLMask1,$80
(2)  900/   A6DE8 :                     	else
(2)  901/   A6DE8 :                     		set vcTLMask4,0
(2)  902/   A6DE8 :                     		set vcTLMask3,0
(2)  903/   A6DE8 :                     		set vcTLMask2,0
(2)  904/   A6DE8 :                     		set vcTLMask1,0
(2)  905/   A6DE8 :                     	endif
(2)  906/   A6DE8 :                     
(2)  907/   A6DE8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  908/   A6DE8 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  909/   A6DE8 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  910/   A6DE8 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  911/   A6DE8 :                     		set vcTLMask1,$80
(2)  912/   A6DE8 :                     		set vcTL1,vcTL1&$7F
(2)  913/   A6DE8 :                     		set vcTL2,vcTL2&$7F
(2)  914/   A6DE8 :                     		set vcTL3,vcTL3&$7F
(2)  915/   A6DE8 :                     		set vcTL4,vcTL4&$7F
(2)  916/   A6DE8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&$80)<>$80)||(((vcTL2|vcTLMask2)&$80)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&$80)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&$80)<>((vcAlgorithm==7)<<7)))
(2)  917/   A6DE8 :                     		if MOMPASS=1
(2)  918/   A6DE8 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  919/   A6DE8 :                     		endif
(2)  920/   A6DE8 :                     	endif
(2)  921/   A6DE8 :                     
(2)  922/   A6DE8 :                     	if SonicDriverVer==2
(2)  923/   A6DE8 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
