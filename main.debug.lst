     970/    13B0 :                     ; Subroutine to transfer a plane map to VRAM
     971/    13B0 :                     ; ---------------------------------------------------------------------------
     972/    13B0 :                     
     973/    13B0 :                     ; control register:
     974/    13B0 :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
     975/    13B0 :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
     976/    13B0 :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
     977/    13B0 :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
     978/    13B0 :                     ;
     979/    13B0 :                     ;	A00-A15 - address
     980/    13B0 :                     ;	CD0-CD3 - code
     981/    13B0 :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
     982/    13B0 :                     ;	CD5 - DMA operation
     983/    13B0 :                     ;
     984/    13B0 :                     ;	Bits CD3-CD0:
     985/    13B0 :                     ;	0000 - VRAM read
     986/    13B0 :                     ;	0001 - VRAM write
     987/    13B0 :                     ;	0011 - CRAM write
     988/    13B0 :                     ;	0100 - VSRAM read
     989/    13B0 :                     ;	0101 - VSRAM write
     990/    13B0 :                     ;	1000 - CRAM read
     991/    13B0 :                     ;
     992/    13B0 :                     ; d0 = control register
     993/    13B0 :                     ; d1 = width
     994/    13B0 :                     ; d2 = heigth
     995/    13B0 :                     ; a1 = source address
     996/    13B0 :                     
     997/    13B0 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
