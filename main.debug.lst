(2)  147/   1DAC2 :                     				nextenum	dSnare,dClap,dScratch,dTimpani,dHiTom,dVLowClap,dHiTimpani,dMidTimpani
(2)  148/   1DAC2 :                     				nextenum	dLowTimpani,dVLowTimpani,dMidTom,dLowTom,dFloorTom,dHiClap
(2)  149/   1DAC2 :                     				nextenum	dMidClap,dLowClap
(2)  150/   1DAC2 : [141]                			endif
(2)  151/   1DAC2 :                     			if (use_s3d_samples<>0)
(2)  152/   1DAC2 :                     				nextenum	dFinalFightMetalCrash,dIntroKick
(2)  153/   1DAC2 : [151]                			endif
(2)  154/   1DAC2 :                     			if (use_s3_samples<>0)
(2)  155/   1DAC2 :                     				nextenum	dEchoedClapHit_S3,dLowerEchoedClapHit_S3
(2)  156/   1DAC2 : [154]                			endif
(2)  157/   1DAC2 : [77]                 	endcase
(2)  158/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  159/   1DAC2 :                     ; Channel IDs for SFX
(2)  160/   1DAC2 : =$80                 cPSG1				EQU $80
(2)  161/   1DAC2 : =$A0                 cPSG2				EQU $A0
(2)  162/   1DAC2 : =$C0                 cPSG3				EQU $C0
(2)  163/   1DAC2 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  164/   1DAC2 : =$2                  cFM3				EQU $02
(2)  165/   1DAC2 : =$4                  cFM4				EQU $04
(2)  166/   1DAC2 : =$5                  cFM5				EQU $05
(2)  167/   1DAC2 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  168/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  169/   1DAC2 :                     ; Conversion macros and functions
(2)  170/   1DAC2 :                     
(2)  171/   1DAC2 :                     conv0To256  function n,((n==0)<<8)|n
(2)  172/   1DAC2 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  173/   1DAC2 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  174/   1DAC2 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  175/   1DAC2 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  176/   1DAC2 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  177/   1DAC2 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  178/   1DAC2 :                     
(2)  179/   1DAC2 :                     convertMainTempoMod macro mod
(2)  180/   1DAC2 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  181/   1DAC2 :                     		dc.b	mod
(2)  182/   1DAC2 :                     	elseif SourceDriver==1
(2)  183/   1DAC2 :                     		if mod==1
(2)  184/   1DAC2 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  185/   1DAC2 :                     		endif
(2)  186/   1DAC2 :                     		if SonicDriverVer==2
(2)  187/   1DAC2 :                     			dc.b	s1TempotoS2(mod)
(2)  188/   1DAC2 :                     		else;if SonicDriverVer>=3
(2)  189/   1DAC2 :                     			dc.b	s1TempotoS3(mod)
(2)  190/   1DAC2 :                     		endif
(2)  191/   1DAC2 :                     	elseif SourceDriver==2
(2)  192/   1DAC2 :                     		if mod==0
(2)  193/   1DAC2 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  194/   1DAC2 :                     		endif
(2)  195/   1DAC2 :                     		if SonicDriverVer==1
(2)  196/   1DAC2 :                     			dc.b	s2TempotoS1(mod)
(2)  197/   1DAC2 :                     		else;if SonicDriverVer>=3
(2)  198/   1DAC2 :                     			dc.b	s2TempotoS3(mod)
(2)  199/   1DAC2 :                     		endif
(2)  200/   1DAC2 :                     	else;if SourceDriver>=3
(2)  201/   1DAC2 :                     		if mod==0
(2)  202/   1DAC2 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  203/   1DAC2 :                     		endif
(2)  204/   1DAC2 :                     		if SonicDriverVer==1
(2)  205/   1DAC2 :                     			dc.b	s3TempotoS1(mod)
(2)  206/   1DAC2 :                     		else;if SonicDriverVer==2
(2)  207/   1DAC2 :                     			dc.b	s3TempotoS2(mod)
(2)  208/   1DAC2 :                     		endif
(2)  209/   1DAC2 :                     	endif
(2)  210/   1DAC2 :                     	endm
(2)  211/   1DAC2 :                     
(2)  212/   1DAC2 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  213/   1DAC2 :                     PSGPitchConvert macro pitch
(2)  214/   1DAC2 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  215/   1DAC2 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  216/   1DAC2 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  217/   1DAC2 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  218/   1DAC2 :                     	else
(2)  219/   1DAC2 :                     		dc.b	pitch
(2)  220/   1DAC2 :                     	endif
(2)  221/   1DAC2 :                     	endm
(2)  222/   1DAC2 :                     
(2)  223/   1DAC2 :                     CheckedChannelPointer macro loc
(2)  224/   1DAC2 :                     	if SonicDriverVer<>1
(2)  225/   1DAC2 :                     		dc.w	z80_ptr(loc)
(2)  226/   1DAC2 :                     	else
(2)  227/   1DAC2 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  228/   1DAC2 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  229/   1DAC2 :                     		endif
(2)  230/   1DAC2 :                     		dc.w	loc-songStart
(2)  231/   1DAC2 :                     	endif
(2)  232/   1DAC2 :                     	endm
(2)  233/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  234/   1DAC2 :                     ; Header Macros
(2)  235/   1DAC2 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  236/   1DAC2 :                     
(2)  237/   1DAC2 :                     SourceDriver set ver
(2)  238/   1DAC2 :                     
(2)  239/   1DAC2 :                     	if ("sourcesmps2asmver"<>"")
(2)  240/   1DAC2 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  241/   1DAC2 :                     	else
(2)  242/   1DAC2 :                     		set SourceSMPS2ASM,0
(2)  243/   1DAC2 :                     	endif
(2)  244/   1DAC2 :                     
(2)  245/   1DAC2 :                     songStart set *
(2)  246/   1DAC2 :                     
(2)  247/   1DAC2 :                     	if MOMPASS=1
(2)  248/   1DAC2 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  249/   1DAC2 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  250/   1DAC2 :                     		endif
(2)  251/   1DAC2 :                     	endif
(2)  252/   1DAC2 :                     
(2)  253/   1DAC2 :                     	endm
(2)  254/   1DAC2 :                     
(2)  255/   1DAC2 :                     smpsHeaderVoiceNull macro
(2)  256/   1DAC2 :                     	if songStart<>*
(2)  257/   1DAC2 :                     		fatal "Missing smpsHeaderStartSong"
(2)  258/   1DAC2 :                     	endif
(2)  259/   1DAC2 :                     	dc.w	$0000
(2)  260/   1DAC2 :                     	endm
(2)  261/   1DAC2 :                     
(2)  262/   1DAC2 :                     ; Header - Set up Voice Location
(2)  263/   1DAC2 :                     ; Common to music and SFX
(2)  264/   1DAC2 :                     smpsHeaderVoice macro loc
(2)  265/   1DAC2 :                     	if songStart<>*
(2)  266/   1DAC2 :                     		fatal "Missing smpsHeaderStartSong"
(2)  267/   1DAC2 :                     	endif
(2)  268/   1DAC2 :                     	if SonicDriverVer<>1
(2)  269/   1DAC2 :                     		dc.w	z80_ptr(loc)
(2)  270/   1DAC2 :                     	else
(2)  271/   1DAC2 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  272/   1DAC2 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  273/   1DAC2 :                     		endif
(2)  274/   1DAC2 :                     		dc.w	loc-songStart
(2)  275/   1DAC2 :                     	endif
(2)  276/   1DAC2 :                     	endm
(2)  277/   1DAC2 :                     
(2)  278/   1DAC2 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  279/   1DAC2 :                     ; Common to music and SFX
(2)  280/   1DAC2 :                     smpsHeaderVoiceUVB macro
(2)  281/   1DAC2 :                     	if songStart<>*
(2)  282/   1DAC2 :                     		fatal "Missing smpsHeaderStartSong"
(2)  283/   1DAC2 :                     	endif
(2)  284/   1DAC2 :                     	if SonicDriverVer>=5
(2)  285/   1DAC2 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  286/   1DAC2 :                     	elseif SonicDriverVer>=3
(2)  287/   1DAC2 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  288/   1DAC2 :                     	else
(2)  289/   1DAC2 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  290/   1DAC2 :                     	endif
(2)  291/   1DAC2 :                     	endm
(2)  292/   1DAC2 :                     
(2)  293/   1DAC2 :                     ; Header macros for music (not for SFX)
(2)  294/   1DAC2 :                     ; Header - Set up Channel Usage
(2)  295/   1DAC2 :                     smpsHeaderChan macro fm,psg
(2)  296/   1DAC2 :                     	dc.b	fm,psg
(2)  297/   1DAC2 :                     	endm
(2)  298/   1DAC2 :                     
(2)  299/   1DAC2 :                     ; Header - Set up Tempo
(2)  300/   1DAC2 :                     smpsHeaderTempo macro div,mod
(2)  301/   1DAC2 :                     	dc.b	div
(2)  302/   1DAC2 :                     	convertMainTempoMod mod
(2)  303/   1DAC2 :                     	endm
(2)  304/   1DAC2 :                     
(2)  305/   1DAC2 :                     ; Header - Set up DAC Channel
(2)  306/   1DAC2 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  307/   1DAC2 :                     	CheckedChannelPointer loc
(2)  308/   1DAC2 :                     	if ("pitch"<>"")
(2)  309/   1DAC2 :                     		dc.b	pitch
(2)  310/   1DAC2 :                     		if ("vol"<>"")
(2)  311/   1DAC2 :                     			dc.b	vol
(2)  312/   1DAC2 :                     		else
(2)  313/   1DAC2 :                     			dc.b	$00
(2)  314/   1DAC2 :                     		endif
(2)  315/   1DAC2 :                     	else
(2)  316/   1DAC2 :                     		dc.w	$00
(2)  317/   1DAC2 :                     	endif
(2)  318/   1DAC2 :                     	endm
(2)  319/   1DAC2 :                     
(2)  320/   1DAC2 :                     ; Header - Set up FM Channel
(2)  321/   1DAC2 :                     smpsHeaderFM macro loc,pitch,vol
(2)  322/   1DAC2 :                     	CheckedChannelPointer loc
(2)  323/   1DAC2 :                     	dc.b	pitch,vol
(2)  324/   1DAC2 :                     	endm
(2)  325/   1DAC2 :                     
(2)  326/   1DAC2 :                     ; Header - Set up PSG Channel
(2)  327/   1DAC2 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  328/   1DAC2 :                     	CheckedChannelPointer loc
(2)  329/   1DAC2 :                     	PSGPitchConvert pitch
(2)  330/   1DAC2 :                     	dc.b	vol
(2)  331/   1DAC2 :                     	; Frequency envelope
(2)  332/   1DAC2 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  333/   1DAC2 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  334/   1DAC2 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  335/   1DAC2 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  336/   1DAC2 :                     		dc.b	0
(2)  337/   1DAC2 :                     	else
(2)  338/   1DAC2 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  339/   1DAC2 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  340/   1DAC2 :                     		endif
(2)  341/   1DAC2 :                     		dc.b	mod
(2)  342/   1DAC2 :                     	endif
(2)  343/   1DAC2 :                     	; Volume envelope
(2)  344/   1DAC2 :                     	dc.b	voice
(2)  345/   1DAC2 :                     	endm
(2)  346/   1DAC2 :                     
(2)  347/   1DAC2 :                     ; Header macros for SFX (not for music)
(2)  348/   1DAC2 :                     ; Header - Set up Tempo
(2)  349/   1DAC2 :                     smpsHeaderTempoSFX macro div
(2)  350/   1DAC2 :                     	dc.b	div
(2)  351/   1DAC2 :                     	endm
(2)  352/   1DAC2 :                     
(2)  353/   1DAC2 :                     ; Header - Set up Channel Usage
(2)  354/   1DAC2 :                     smpsHeaderChanSFX macro chan
(2)  355/   1DAC2 :                     	dc.b	chan
(2)  356/   1DAC2 :                     	endm
(2)  357/   1DAC2 :                     
(2)  358/   1DAC2 :                     ; Header - Set up FM Channel
(2)  359/   1DAC2 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  360/   1DAC2 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  361/   1DAC2 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  362/   1DAC2 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  363/   1DAC2 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  364/   1DAC2 :                     	endif
(2)  365/   1DAC2 :                     	dc.b	$80,chanid
(2)  366/   1DAC2 :                     	CheckedChannelPointer loc
(2)  367/   1DAC2 :                     	if (chanid&$80)<>0
(2)  368/   1DAC2 :                     		PSGPitchConvert pitch
(2)  369/   1DAC2 :                     	else
(2)  370/   1DAC2 :                     		dc.b	pitch
(2)  371/   1DAC2 :                     	endif
(2)  372/   1DAC2 :                     	dc.b	vol
(2)  373/   1DAC2 :                     	endm
(2)  374/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  375/   1DAC2 :                     ; Co-ord Flag Macros and Equates
(2)  376/   1DAC2 :                     ; E0xx - Panning, AMS, FMS
(2)  377/   1DAC2 :                     smpsPan macro direction,amsfms
(2)  378/   1DAC2 :                     panNone set $00
(2)  379/   1DAC2 :                     panRight set $40
(2)  380/   1DAC2 :                     panLeft set $80
(2)  381/   1DAC2 :                     panCentre set $C0
(2)  382/   1DAC2 :                     panCenter set $C0 ; silly Americans :U
(2)  383/   1DAC2 :                     	dc.b $E0,direction+amsfms
(2)  384/   1DAC2 :                     	endm
(2)  385/   1DAC2 :                     
(2)  386/   1DAC2 :                     ; E1xx - Set channel detune to val
(2)  387/   1DAC2 :                     smpsDetune macro val
(2)  388/   1DAC2 :                     	dc.b	$E1,val
(2)  389/   1DAC2 :                     	endm
(2)  390/   1DAC2 :                     
(2)  391/   1DAC2 :                     ; E2xx - Useless
(2)  392/   1DAC2 :                     smpsNop macro val
(2)  393/   1DAC2 :                     	if SonicDriverVer<3
(2)  394/   1DAC2 :                     		dc.b	$E2,val
(2)  395/   1DAC2 :                     	endif
(2)  396/   1DAC2 :                     	endm
(2)  397/   1DAC2 :                     
(2)  398/   1DAC2 :                     ; Return (used after smpsCall)
(2)  399/   1DAC2 :                     smpsReturn macro val
(2)  400/   1DAC2 :                     	if SonicDriverVer>=3
(2)  401/   1DAC2 :                     		dc.b	$F9
(2)  402/   1DAC2 :                     	else
(2)  403/   1DAC2 :                     		dc.b	$E3
(2)  404/   1DAC2 :                     	endif
(2)  405/   1DAC2 :                     	endm
(2)  406/   1DAC2 :                     
(2)  407/   1DAC2 :                     ; Fade in previous song (ie. 1-Up)
(2)  408/   1DAC2 :                     smpsFade macro val
(2)  409/   1DAC2 :                     	if SonicDriverVer>=3
(2)  410/   1DAC2 :                     		dc.b	$E2
(2)  411/   1DAC2 :                     		if ("val"<>"")
(2)  412/   1DAC2 :                     			dc.b	val
(2)  413/   1DAC2 :                     		else
(2)  414/   1DAC2 :                     			dc.b	$FF
(2)  415/   1DAC2 :                     		endif
(2)  416/   1DAC2 :                     		if SourceDriver<3
(2)  417/   1DAC2 :                     			smpsStop
(2)  418/   1DAC2 :                     		endif
(2)  419/   1DAC2 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  420/   1DAC2 :                     		; This is one of those weird S3+ "fades" that we don't need
(2)  421/   1DAC2 :                     	else
(2)  422/   1DAC2 :                     		dc.b	$E4
(2)  423/   1DAC2 :                     	endif
(2)  424/   1DAC2 :                     	endm
(2)  425/   1DAC2 :                     
(2)  426/   1DAC2 :                     ; E5xx - Set channel tempo divider to xx
(2)  427/   1DAC2 :                     smpsChanTempoDiv macro val
(2)  428/   1DAC2 :                     	if SonicDriverVer>=5
(2)  429/   1DAC2 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  430/   1DAC2 :                     		dc.b	$FF,$08,val
(2)  431/   1DAC2 :                     	elseif SonicDriverVer==3
(2)  432/   1DAC2 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  433/   1DAC2 :                     	else
(2)  434/   1DAC2 :                     		dc.b	$E5,val
(2)  435/   1DAC2 :                     	endif
(2)  436/   1DAC2 :                     	endm
(2)  437/   1DAC2 :                     
(2)  438/   1DAC2 :                     ; E6xx - Alter Volume by xx
(2)  439/   1DAC2 :                     smpsAlterVol macro val
(2)  440/   1DAC2 :                     	dc.b	$E6,val
(2)  441/   1DAC2 :                     	endm
(2)  442/   1DAC2 :                     
(2)  443/   1DAC2 :                     ; E7 - Prevent attack of next note
(2)  444/   1DAC2 : =$E7                 smpsNoAttack	EQU $E7
(2)  445/   1DAC2 :                     
(2)  446/   1DAC2 :                     ; E8xx - Set note fill to xx
(2)  447/   1DAC2 :                     smpsNoteFill macro val
(2)  448/   1DAC2 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  449/   1DAC2 :                     		; Unique to Flamewing's modified driver
(2)  450/   1DAC2 :                     		dc.b	$FF,$0A,val
(2)  451/   1DAC2 :                     	else
(2)  452/   1DAC2 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  453/   1DAC2 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  454/   1DAC2 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  455/   1DAC2 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  456/   1DAC2 :                     		endif
(2)  457/   1DAC2 :                     		dc.b	$E8,val
(2)  458/   1DAC2 :                     	endif
(2)  459/   1DAC2 :                     	endm
(2)  460/   1DAC2 :                     
(2)  461/   1DAC2 :                     ; Add xx to channel pitch
(2)  462/   1DAC2 :                     smpsChangeTransposition macro val
(2)  463/   1DAC2 :                     	if SonicDriverVer>=3
(2)  464/   1DAC2 :                     		dc.b	$FB,val
(2)  465/   1DAC2 :                     	else
(2)  466/   1DAC2 :                     		dc.b	$E9,val
(2)  467/   1DAC2 :                     	endif
(2)  468/   1DAC2 :                     	endm
(2)  469/   1DAC2 :                     
(2)  470/   1DAC2 :                     ; Set music tempo modifier to xx
(2)  471/   1DAC2 :                     smpsSetTempoMod macro mod
(2)  472/   1DAC2 :                     	if SonicDriverVer>=3
(2)  473/   1DAC2 :                     		dc.b	$FF,$00
(2)  474/   1DAC2 :                     	else
(2)  475/   1DAC2 :                     		dc.b	$EA
(2)  476/   1DAC2 :                     	endif
(2)  477/   1DAC2 :                     	convertMainTempoMod mod
(2)  478/   1DAC2 :                     	endm
(2)  479/   1DAC2 :                     
(2)  480/   1DAC2 :                     ; Set music tempo divider to xx
(2)  481/   1DAC2 :                     smpsSetTempoDiv macro val
(2)  482/   1DAC2 :                     	if SonicDriverVer>=3
(2)  483/   1DAC2 :                     		dc.b	$FF,$04,val
(2)  484/   1DAC2 :                     	else
(2)  485/   1DAC2 :                     		dc.b	$EB,val
(2)  486/   1DAC2 :                     	endif
(2)  487/   1DAC2 :                     	endm
(2)  488/   1DAC2 :                     
(2)  489/   1DAC2 :                     ; ECxx - Set Volume to xx
(2)  490/   1DAC2 :                     smpsSetVol macro val
(2)  491/   1DAC2 :                     	if SonicDriverVer>=3
(2)  492/   1DAC2 :                     		dc.b	$E4,val
(2)  493/   1DAC2 :                     	else
(2)  494/   1DAC2 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  495/   1DAC2 :                     	endif
(2)  496/   1DAC2 :                     	endm
(2)  497/   1DAC2 :                     
(2)  498/   1DAC2 :                     ; Works on all drivers
(2)  499/   1DAC2 :                     smpsPSGAlterVol macro vol
(2)  500/   1DAC2 :                     	dc.b	$EC,vol
(2)  501/   1DAC2 :                     	endm
(2)  502/   1DAC2 :                     
(2)  503/   1DAC2 :                     smpsPSGAlterVolS2 macro vol
(2)  504/   1DAC2 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  505/   1DAC2 :                     	if SonicDriverVer==2
(2)  506/   1DAC2 :                     		smpsAlterVol vol
(2)  507/   1DAC2 :                     	else
(2)  508/   1DAC2 :                     		smpsPSGAlterVol vol
(2)  509/   1DAC2 :                     	endif
(2)  510/   1DAC2 :                     	endm
(2)  511/   1DAC2 :                     
(2)  512/   1DAC2 :                     ; Clears pushing sound flag in S1
(2)  513/   1DAC2 :                     smpsClearPush macro
(2)  514/   1DAC2 :                     	if SonicDriverVer==1
(2)  515/   1DAC2 :                     		dc.b	$ED
(2)  516/   1DAC2 :                     	else
(2)  517/   1DAC2 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  518/   1DAC2 :                     	endif
(2)  519/   1DAC2 :                     	endm
(2)  520/   1DAC2 :                     
(2)  521/   1DAC2 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  522/   1DAC2 :                     smpsStopSpecial macro
(2)  523/   1DAC2 :                     	if SonicDriverVer==1
(2)  524/   1DAC2 :                     		dc.b	$EE
(2)  525/   1DAC2 :                     	else
(2)  526/   1DAC2 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  527/   1DAC2 :                     		smpsStop
(2)  528/   1DAC2 :                     	endif
(2)  529/   1DAC2 :                     	endm
(2)  530/   1DAC2 :                     
(2)  531/   1DAC2 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  532/   1DAC2 :                     smpsFMvoice macro voice,songID
(2)  533/   1DAC2 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  534/   1DAC2 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  535/   1DAC2 :                     	else
(2)  536/   1DAC2 :                     		dc.b	$EF,voice
(2)  537/   1DAC2 :                     	endif
(2)  538/   1DAC2 :                     	endm
(2)  539/   1DAC2 :                     
(2)  540/   1DAC2 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  541/   1DAC2 :                     smpsModSet macro wait,speed,change,step
(2)  542/   1DAC2 :                     	dc.b	$F0
(2)  543/   1DAC2 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  544/   1DAC2 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  545/   1DAC2 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  546/   1DAC2 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  547/   1DAC2 :                     	else
(2)  548/   1DAC2 :                     		dc.b	wait,speed,change,step
(2)  549/   1DAC2 :                     	endif
(2)  550/   1DAC2 :                     	;dc.b	speed,change,step
(2)  551/   1DAC2 :                     	endm
(2)  552/   1DAC2 :                     
(2)  553/   1DAC2 :                     ; Turn on Modulation
(2)  554/   1DAC2 :                     smpsModOn macro type
(2)  555/   1DAC2 :                     	if SonicDriverVer>=3
(2)  556/   1DAC2 :                     		if "type"<>""
(2)  557/   1DAC2 :                     			dc.b	$F4,type
(2)  558/   1DAC2 :                     		else
(2)  559/   1DAC2 :                     			dc.b	$F4,$80
(2)  560/   1DAC2 :                     		endif
(2)  561/   1DAC2 :                     	else
(2)  562/   1DAC2 :                     		dc.b	$F1
(2)  563/   1DAC2 :                     	endif
(2)  564/   1DAC2 :                     	endm
(2)  565/   1DAC2 :                     
(2)  566/   1DAC2 :                     ; F2 - End of channel
(2)  567/   1DAC2 :                     smpsStop macro
(2)  568/   1DAC2 :                     	dc.b	$F2
(2)  569/   1DAC2 :                     	endm
(2)  570/   1DAC2 :                     
(2)  571/   1DAC2 :                     ; F3xx - PSG waveform to xx
(2)  572/   1DAC2 :                     smpsPSGform macro form
(2)  573/   1DAC2 :                     	dc.b	$F3,form
(2)  574/   1DAC2 :                     	endm
(2)  575/   1DAC2 :                     
(2)  576/   1DAC2 :                     ; Turn off Modulation
(2)  577/   1DAC2 :                     smpsModOff macro
(2)  578/   1DAC2 :                     	if SonicDriverVer>=3
(2)  579/   1DAC2 :                     		dc.b	$FA
(2)  580/   1DAC2 :                     	else
(2)  581/   1DAC2 :                     		dc.b	$F4
(2)  582/   1DAC2 :                     	endif
(2)  583/   1DAC2 :                     	endm
(2)  584/   1DAC2 :                     
(2)  585/   1DAC2 :                     ; F5xx - PSG voice to xx
(2)  586/   1DAC2 :                     smpsPSGvoice macro voice
(2)  587/   1DAC2 :                     	dc.b	$F5,voice
(2)  588/   1DAC2 :                     	endm
(2)  589/   1DAC2 :                     
(2)  590/   1DAC2 :                     ; F6xxxx - Jump to xxxx
(2)  591/   1DAC2 :                     smpsJump macro loc
(2)  592/   1DAC2 :                     	dc.b	$F6
(2)  593/   1DAC2 :                     	if SonicDriverVer<>1
(2)  594/   1DAC2 :                     		dc.w	z80_ptr(loc)
(2)  595/   1DAC2 :                     	else
(2)  596/   1DAC2 :                     		dc.w	loc-*-1
(2)  597/   1DAC2 :                     	endif
(2)  598/   1DAC2 :                     	endm
(2)  599/   1DAC2 :                     
(2)  600/   1DAC2 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  601/   1DAC2 :                     smpsLoop macro index,loops,loc
(2)  602/   1DAC2 :                     	dc.b	$F7
(2)  603/   1DAC2 :                     	dc.b	index,loops
(2)  604/   1DAC2 :                     	if SonicDriverVer<>1
(2)  605/   1DAC2 :                     		dc.w	z80_ptr(loc)
(2)  606/   1DAC2 :                     	else
(2)  607/   1DAC2 :                     		dc.w	loc-*-1
(2)  608/   1DAC2 :                     	endif
(2)  609/   1DAC2 :                     	endm
(2)  610/   1DAC2 :                     
(2)  611/   1DAC2 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  612/   1DAC2 :                     smpsCall macro loc
(2)  613/   1DAC2 :                     	dc.b	$F8
(2)  614/   1DAC2 :                     	if SonicDriverVer<>1
(2)  615/   1DAC2 :                     		dc.w	z80_ptr(loc)
(2)  616/   1DAC2 :                     	else
(2)  617/   1DAC2 :                     		dc.w	loc-*-1
(2)  618/   1DAC2 :                     	endif
(2)  619/   1DAC2 :                     	endm
(2)  620/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  621/   1DAC2 :                     ; Alter Volume
(2)  622/   1DAC2 :                     smpsFMAlterVol macro val1,val2
(2)  623/   1DAC2 :                     	if (SonicDriverVer>=3)&&("val2"<>"")
(2)  624/   1DAC2 :                     		dc.b	$E5,val1,val2
(2)  625/   1DAC2 :                     	else
(2)  626/   1DAC2 :                     		dc.b	$E6,val1
(2)  627/   1DAC2 :                     	endif
(2)  628/   1DAC2 :                     	endm
(2)  629/   1DAC2 :                     
(2)  630/   1DAC2 :                     ; S3/S&K/S3D-only coordination flags
(2)  631/   1DAC2 : =>FALSE              	if SonicDriverVer>=3
(2)  632/   1DAC2 :                     ; Silences FM channel then stops as per smpsStop
(2)  633/   1DAC2 :                     smpsStopFM macro
(2)  634/   1DAC2 :                     	dc.b	$E3
(2)  635/   1DAC2 :                     	endm
(2)  636/   1DAC2 :                     
(2)  637/   1DAC2 :                     ; Spindash Rev
(2)  638/   1DAC2 :                     smpsSpindashRev macro
(2)  639/   1DAC2 :                     	dc.b	$E9
(2)  640/   1DAC2 :                     	endm
(2)  641/   1DAC2 :                     
(2)  642/   1DAC2 :                     smpsPlayDACSample macro sample
(2)  643/   1DAC2 :                     	dc.b	$EA,(sample&$7F)
(2)  644/   1DAC2 :                     	endm
(2)  645/   1DAC2 :                     
(2)  646/   1DAC2 :                     smpsConditionalJump macro index,loc
(2)  647/   1DAC2 :                     	dc.b	$EB
(2)  648/   1DAC2 :                     	dc.b	index
(2)  649/   1DAC2 :                     	dc.w	z80_ptr(loc)
(2)  650/   1DAC2 :                     	endm
(2)  651/   1DAC2 :                     
(2)  652/   1DAC2 :                     ; Set note values to xx-$40
(2)  653/   1DAC2 :                     smpsSetNote macro val
(2)  654/   1DAC2 :                     	dc.b	$ED,val
(2)  655/   1DAC2 :                     	endm
(2)  656/   1DAC2 :                     
(2)  657/   1DAC2 :                     smpsFMICommand macro reg,val
(2)  658/   1DAC2 :                     	dc.b	$EE,reg,val
(2)  659/   1DAC2 :                     	endm
(2)  660/   1DAC2 :                     
(2)  661/   1DAC2 :                     ; Set Modulation
(2)  662/   1DAC2 :                     smpsModChange2 macro fmmod,psgmod
(2)  663/   1DAC2 :                     	dc.b	$F1,fmmod,psgmod
(2)  664/   1DAC2 :                     	endm
(2)  665/   1DAC2 :                     
(2)  666/   1DAC2 :                     ; Set Modulation
(2)  667/   1DAC2 :                     smpsModChange macro val
(2)  668/   1DAC2 :                     	dc.b	$F4,val
(2)  669/   1DAC2 :                     	endm
(2)  670/   1DAC2 :                     
(2)  671/   1DAC2 :                     ; FCxxxx - Jump to xxxx
(2)  672/   1DAC2 :                     smpsContinuousLoop macro loc
(2)  673/   1DAC2 :                     	dc.b	$FC
(2)  674/   1DAC2 :                     	dc.w	z80_ptr(loc)
(2)  675/   1DAC2 :                     	endm
(2)  676/   1DAC2 :                     
(2)  677/   1DAC2 :                     smpsAlternateSMPS macro flag
(2)  678/   1DAC2 :                     	dc.b	$FD,flag
(2)  679/   1DAC2 :                     	endm
(2)  680/   1DAC2 :                     
(2)  681/   1DAC2 :                     smpsFM3SpecialMode macro ind1,ind2,ind3,ind4
(2)  682/   1DAC2 :                     	dc.b	$FE,ind1,ind2,ind3,ind4
(2)  683/   1DAC2 :                     	endm
(2)  684/   1DAC2 :                     
(2)  685/   1DAC2 :                     smpsPlaySound macro index
(2)  686/   1DAC2 :                     	if SonicDriverVer>=5
(2)  687/   1DAC2 :                     		message "smpsPlaySound only plays SFX in Flamedriver; use smpsPlayMusic to play music or fade effects."
(2)  688/   1DAC2 :                     	endif
(2)  689/   1DAC2 :                     	dc.b	$FF,$01,index
(2)  690/   1DAC2 :                     	endm
(2)  691/   1DAC2 :                     
(2)  692/   1DAC2 :                     smpsHaltMusic macro flag
(2)  693/   1DAC2 :                     	dc.b	$FF,$02,flag
(2)  694/   1DAC2 :                     	endm
(2)  695/   1DAC2 :                     
(2)  696/   1DAC2 :                     smpsCopyData macro data,len
(2)  697/   1DAC2 :                     	fatal "Coord. Flag to copy data should not be used. Complain to Flamewing if any music uses it."
(2)  698/   1DAC2 :                     	dc.b	$FF,$03
(2)  699/   1DAC2 :                     	dc.w	little_endian(data)
(2)  700/   1DAC2 :                     	dc.b	len
(2)  701/   1DAC2 :                     	endm
(2)  702/   1DAC2 :                     
(2)  703/   1DAC2 :                     smpsSSGEG macro op1,op2,op3,op4
(2)  704/   1DAC2 :                     	dc.b	$FF,$05,op1,op3,op2,op4
