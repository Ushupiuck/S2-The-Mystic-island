     434/     37E :                     
     435/     37E :                     ShowErrDigit:
     436/     37E :                     		move.w	d0,d1
     437/     37E :                     		andi.w	#$F,d1
     438/     37E :                     		cmpi.w	#$A,d1
     439/     37E :                     		blo.s	ShowErrDigit_NoOverflow
     440/     37E :                     		addq.w	#7,d1		; add 7 for characters A-F
     441/     37E :                     
     442/     37E :                     ShowErrDigit_NoOverflow:
     443/     37E :                     		addi.w	#ArtTile_Error_Handler_Font,d1
     444/     37E :                     		move.w	d1,(a6)
     445/     37E :                     		rts
     446/     37E :                     ; End of function ShowErrDigit
