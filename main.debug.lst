   22579/   19882 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index	; HPZ
   22580/   19884 : 010E                		dc.w AnimCue_HPZ-DynArtCue_Index	; HPZ
   22581/   19886 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index	; HTZ
