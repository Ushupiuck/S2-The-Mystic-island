    1952/    2D1C :                     ; Subroutine to calculate sine and cosine of an angle
    1953/    2D1C :                     ; d0 = input byte = angle (360 degrees == 256)
    1954/    2D1C :                     ; d0 = output word = 255 * sine(angle)
    1955/    2D1C :                     ; d1 = output word = 255 * cosine(angle)
    1956/    2D1C :                     ; ---------------------------------------------------------------------------
    1957/    2D1C :                     
    1958/    2D1C :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
