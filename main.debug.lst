    9165/    D660 :                     MarkObjGone:
    9166/    D660 : (MACRO)              		out_of_range.s	loc_CEB0
    9166/    D660 : =>FALSE                              if (""<>"")
    9166/    D660 :                                     move.w  ,d0              ; get object position (if specified as not obX)
    9166/    D660 : =>TRUE                               else
