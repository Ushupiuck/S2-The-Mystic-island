     102/     23E :                     
     103/     23E :                     Z80StartupCodeBegin:
     104/     23E :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     105/     23E :                         save
     106/     23E :                         CPU Z80 ; start assembling Z80 code
     107/       0 :                         phase 0 ; pretend we're at address 0
     108/       0 : AF                  	xor	a	; clear a to 0
     109/       1 : 01 D9 1F            	ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     110/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     111/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     112/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     113/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     114/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     115/       E : DD E1               	pop	ix	; clear ix
     116/      10 : FD E1               	pop	iy	; clear iy
     117/      12 : ED 47               	ld	i,a	; clear i
     118/      14 : ED 4F               	ld	r,a	; clear r
     119/      16 : D1                  	pop	de	; clear de
     120/      17 : E1                  	pop	hl	; clear hl
     121/      18 : F1                  	pop	af	; clear af
     122/      19 : 08                  	ex	af,af'	; swap af with af'
     123/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     124/      1B : C1                  	pop	bc	; clear bc
     125/      1C : D1                  	pop	de	; clear de
     126/      1D : E1                  	pop	hl	; clear hl
     127/      1E : F1                  	pop	af	; clear af
     128/      1F : F9                  	ld	sp,hl	; clear sp
     129/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     130/      21 : ED 56               	im	1	; interrupt handling mode = 1
     131/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     132/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
     133/      26 :                     zStartupCodeEndLoc:
     134/     264 :                         dephase ; stop pretending
     135/     264 : ALL                  	restore
     136/     264 :                         padding off ; unfortunately our flags got reset so we have to set them again...
