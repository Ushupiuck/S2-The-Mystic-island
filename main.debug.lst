(2)  101/   A6FA4 :                     			nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  102/   A6FA4 : =>FALSE              		case 4
(2)  103/   A6FA4 :                     			enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)  104/   A6FA4 :                     			nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)  105/   A6FA4 :                     			nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)  106/   A6FA4 :                     			nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
