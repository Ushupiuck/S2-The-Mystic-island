   10652/    F3D6 :                     ; ---------------------------------------------------------------------------
   10653/    F3D6 :                     ; Solid object subroutines (includes spikes, blocks, rocks etc)
   10654/    F3D6 :                     ; These check collision of Sonic/Tails with objects on the screen
   10655/    F3D6 :                     ;
   10656/    F3D6 :                     ; input variables:
   10657/    F3D6 :                     ; d1 = object width
   10658/    F3D6 :                     ; d2 = object height / 2 (when jumping)
   10659/    F3D6 :                     ; d3 = object height / 2 (when walking)
   10660/    F3D6 :                     ; d4 = object x-axis position
   10661/    F3D6 :                     ;
   10662/    F3D6 :                     ; address registers:
   10663/    F3D6 :                     ; a0 = the object to check collision with
