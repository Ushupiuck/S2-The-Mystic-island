(2)  147/   A6FA4 :                     				nextenum	dSnare,dClap,dScratch,dTimpani,dHiTom,dVLowClap,dHiTimpani,dMidTimpani
(2)  148/   A6FA4 :                     				nextenum	dLowTimpani,dVLowTimpani,dMidTom,dLowTom,dFloorTom,dHiClap
(2)  149/   A6FA4 :                     				nextenum	dMidClap,dLowClap
(2)  150/   A6FA4 : [141]                			endif
