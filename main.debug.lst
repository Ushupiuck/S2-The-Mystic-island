    9062/    F0C2 :                     ; ---------------------------------------------------------------------------
    9063/    F0C2 :                     ; Subroutine to make an object move and fall downward increasingly fast
    9064/    F0C2 :                     ; This moves the object horizontally and vertically
    9065/    F0C2 :                     ; and also applies gravity to its speed
    9066/    F0C2 :                     ; ---------------------------------------------------------------------------
    9067/    F0C2 :                     
    9068/    F0C2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    9069/    F0C2 :                     
    9070/    F0C2 :                     ObjectFall:
    9071/    F0C2 :                     ObjectMoveAndFall:
    9072/    F0C2 : 3028 0010           		move.w	obVelX(a0),d0	; load x speed
    9073/    F0C6 : 48C0                		ext.l	d0
    9074/    F0C8 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9075/    F0CA : D1A8 0008           		add.l	d0,obX(a0)	; add x speed to x position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
    9076/    F0CE : 3028 0012           		move.w	obVelY(a0),d0	; load y speed
    9077/    F0D2 : 0668 0038 0012      		addi.w	#$38,obVelY(a0)	; increase vertical speed (apply gravity)
    9078/    F0D8 : 48C0                		ext.l	d0
    9079/    F0DA : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9080/    F0DC : D1A8 000C           		add.l	d0,obY(a0)	; add old y speed to y position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
    9081/    F0E0 : 4E75                		rts
    9082/    F0E2 :                     ; End of function ObjectMoveAndFall
    9083/    F0E2 :                     
    9084/    F0E2 :                     ; ---------------------------------------------------------------------------
    9085/    F0E2 :                     ; Subroutine translating object speed to update object position
    9086/    F0E2 :                     ; This moves the object horizontally and vertically
    9087/    F0E2 :                     ; but does not apply gravity to it
    9088/    F0E2 :                     ; ---------------------------------------------------------------------------
    9089/    F0E2 :                     
    9090/    F0E2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    9091/    F0E2 :                     
    9092/    F0E2 :                     ObjectMove:
    9093/    F0E2 :                     SpeedToPos:
    9094/    F0E2 : 3028 0010           		move.w	obVelX(a0),d0	; load horizontal speed
    9095/    F0E6 : 48C0                		ext.l	d0
    9096/    F0E8 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9097/    F0EA : D1A8 0008           		add.l	d0,obX(a0)	; add to x-axis position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
    9098/    F0EE : 3028 0012           		move.w	obVelY(a0),d0	; load vertical speed
    9099/    F0F2 : 48C0                		ext.l	d0
    9100/    F0F4 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9101/    F0F6 : D1A8 000C           		add.l	d0,obY(a0)	; add to y-axis position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
    9102/    F0FA : 4E75                		rts
    9103/    F0FC :                     ; End of function ObjectMove
    9104/    F0FC :                     
