(2)  599/   A6FA4 :                     
(2)  600/   A6FA4 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  601/   A6FA4 :                     smpsLoop macro index,loops,loc
(2)  602/   A6FA4 :                     	dc.b	$F7
(2)  603/   A6FA4 :                     	dc.b	index,loops
(2)  604/   A6FA4 :                     	if SonicDriverVer<>1
(2)  605/   A6FA4 :                     		dc.w	z80_ptr(loc)
