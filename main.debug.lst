   22676/   19922 :                     ; ZONE ANIMATION SCRIPTS
   22677/   19922 :                     ;
   22678/   19922 :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
   22679/   19922 :                     ; thus animating them. All the relevant art must be uncompressed, because
   22680/   19922 :                     ; otherwise the subroutine would spend so much time waiting for the art to be
   22681/   19922 :                     ; decompressed that the VBLANK window would close before all the animating was done.
   22682/   19922 :                     ;
   22683/   19922 :                     ;    zoneanimdecl -1, Art_Flowers1, ArtTile_Art_Flowers1, 6, 2
   22684/   19922 :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
   22685/   19922 :                     ;	ArtUnc_Flowers1		Source address
   22686/   19922 :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
   22687/   19922 :                     ;	6			Number of frames
   22688/   19922 :                     ;	2			Number of tiles to load into VRAM for each frame
   22689/   19922 :                     ;
   22690/   19922 :                     ;    dc.b   0,$7F		; Start of the script proper
   22691/   19922 :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
   22692/   19922 :                     ;	$7F			Frame duration. Only here if global duration is -1
   22693/   19922 :                     
   22694/   19922 :                     
   22695/   19922 : (MACRO)              AnimCue_EHZ:	zoneanimstart
