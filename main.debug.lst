   24820/   A466E :                     ; ---------------------------------------------------------------------------
   24821/   A466E :                     ; Modified Type 1b 68000 Sound Driver
   24822/   A466E :                     ; ---------------------------------------------------------------------------
   24823/   A466E :                     		include	"s1.sounddriver.asm"
(1)    1/   A466E :                     ; ---------------------------------------------------------------------------
(1)    2/   A466E :                     ; Modified SMPS 68k Type 1b sound driver
(1)    3/   A466E :                     ; The source code to a similar version of the driver can be found here:
(1)    4/   A466E :                     ; https://hiddenpalace.org/News/Sega_of_Japan_Sound_Documents_and_Source_Code
(1)    5/   A466E :                     ; ---------------------------------------------------------------------------
(1)    6/   A466E :                     ; Constants
(1)    7/   A466E : =$12                 SMPS_TRACK_COUNT = (SMPS_RAM.v_track_ram_end-SMPS_RAM.v_track_ram)/SMPS_Track.len
(1)    8/   A466E : =$A                  SMPS_MUSIC_TRACK_COUNT = (SMPS_RAM.v_music_track_ram_end-SMPS_RAM.v_music_track_ram)/SMPS_Track.len
(1)    9/   A466E : =$7                  SMPS_MUSIC_FM_DAC_TRACK_COUNT = (SMPS_RAM.v_music_fmdac_tracks_end-SMPS_RAM.v_music_fmdac_tracks)/SMPS_Track.len
(1)   10/   A466E : =$6                  SMPS_MUSIC_FM_TRACK_COUNT = (SMPS_RAM.v_music_fm_tracks_end-SMPS_RAM.v_music_fm_tracks)/SMPS_Track.len
(1)   11/   A466E : =$3                  SMPS_MUSIC_PSG_TRACK_COUNT = (SMPS_RAM.v_music_psg_tracks_end-SMPS_RAM.v_music_psg_tracks)/SMPS_Track.len
(1)   12/   A466E : =$6                  SMPS_SFX_TRACK_COUNT = (SMPS_RAM.v_sfx_track_ram_end-SMPS_RAM.v_sfx_track_ram)/SMPS_Track.len
(1)   13/   A466E : =$3                  SMPS_SFX_FM_TRACK_COUNT = (SMPS_RAM.v_sfx_fm_tracks_end-SMPS_RAM.v_sfx_fm_tracks)/SMPS_Track.len
(1)   14/   A466E : =$3                  SMPS_SFX_PSG_TRACK_COUNT = (SMPS_RAM.v_sfx_psg_tracks_end-SMPS_RAM.v_sfx_psg_tracks)/SMPS_Track.len
(1)   15/   A466E : =$2                  SMPS_SPECIAL_SFX_TRACK_COUNT = (SMPS_RAM.v_spcsfx_track_ram_end-SMPS_RAM.v_spcsfx_track_ram)/SMPS_Track.len
(1)   16/   A466E : =$1                  SMPS_SPECIAL_SFX_FM_TRACK_COUNT = (SMPS_RAM.v_spcsfx_fm_tracks_end-SMPS_RAM.v_spcsfx_fm_tracks)/SMPS_Track.len
(1)   17/   A466E : =$1                  SMPS_SPECIAL_SFX_PSG_TRACK_COUNT = (SMPS_RAM.v_spcsfx_psg_tracks_end-SMPS_RAM.v_spcsfx_psg_tracks)/SMPS_Track.len
(1)   18/   A466E :                     ; ---------------------------------------------------------------------------
(1)   19/   A466E :                     ; Macros
(1)   20/   A466E :                     ; turn a sample rate into a djnz loop counter
(1)   21/   A466E :                     pcmLoopCounterBase function sampleRate,baseCycles, 1+(Z80_Clock/(sampleRate)-(baseCycles)+(13/2))/13
(1)   22/   A466E :                     pcmLoopCounter function sampleRate, pcmLoopCounterBase(sampleRate,90) ; 90 is the number of cycles zPlaySEGAPCMLoop takes to deliver one sample.
(1)   23/   A466E :                     dpcmLoopCounter function sampleRate, pcmLoopCounterBase(sampleRate,301/2) ; 301 is the number of cycles zPlayPCMLoop takes to deliver two samples.
(1)   24/   A466E :                     ; ---------------------------------------------------------------------------
