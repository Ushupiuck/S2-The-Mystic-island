(2)  482/   A6FA4 :                     	if SonicDriverVer>=3
(2)  483/   A6FA4 :                     		dc.b	$FF,$04,val
(2)  484/   A6FA4 :                     	else
(2)  485/   A6FA4 :                     		dc.b	$EB,val
(2)  486/   A6FA4 :                     	endif
(2)  487/   A6FA4 :                     	endm
(2)  488/   A6FA4 :                     
(2)  489/   A6FA4 :                     ; ECxx - Set Volume to xx
