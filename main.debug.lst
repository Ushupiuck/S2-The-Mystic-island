     181/     2D2 :                     
     182/     2D2 :                     Z80StartupCodeBegin:
     183/     2D2 :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     184/     2D2 : =>TRUE                   if (*)+$26 < $10000
     185/     2D2 :                         save
     186/     2D2 :                         CPU Z80 ; start assembling Z80 code
     187/       0 :                         phase 0 ; pretend we're at address 0
     188/       0 : AF                  	xor	a	; clear a to 0
     189/       1 : 01 D9 1F            	ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     190/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     191/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     192/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     193/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     194/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     195/       E : DD E1               	pop	ix	; clear ix
     196/      10 : FD E1               	pop	iy	; clear iy
     197/      12 : ED 47               	ld	i,a	; clear i
     198/      14 : ED 4F               	ld	r,a	; clear r
     199/      16 : D1                  	pop	de	; clear de
     200/      17 : E1                  	pop	hl	; clear hl
     201/      18 : F1                  	pop	af	; clear af
     202/      19 : 08                  	ex	af,af'	; swap af with af'
     203/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     204/      1B : C1                  	pop	bc	; clear bc
     205/      1C : D1                  	pop	de	; clear de
     206/      1D : E1                  	pop	hl	; clear hl
     207/      1E : F1                  	pop	af	; clear af
     208/      1F : F9                  	ld	sp,hl	; clear sp
     209/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     210/      21 : ED 56               	im	1	; interrupt handling mode = 1
     211/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     212/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
     213/      26 :                     zStartupCodeEndLoc:
     214/     2F8 :                         dephase ; stop pretending
     215/     2F8 : ALL                  	restore
     216/     2F8 :                         padding off ; unfortunately our flags got reset so we have to set them again...
     217/     2F8 : =>FALSE                  else ; due to an address range limitation I could work around but don't think is worth doing so:
     218/     2F8 :                     	message "Warning: using pre-assembled Z80 startup code."
     219/     2F8 :                     	dc.w $AF01,$D91F,$1127,$0021,$2600,$F977,$EDB0,$DDE1,$FDE1,$ED47,$ED4F,$D1E1,$F108,$D9C1,$D1E1,$F1F9,$F3ED,$5636,$E9E9
     220/     2F8 : [184]                    endif
