    3614/    720C :                     SSBGData:	macro time,anim,vram,index,flag1,flag2
    3615/    720C :                     		dc.b	(time), (anim), ((vram)*tile_size)>>13
    3616/    720C :                     	if flag1
    3617/    720C :                     		dc.b	(index)|$80|(flag2)
    3618/    720C :                     	else
    3619/    720C :                     		dc.b	(index)*12
    3620/    720C :                     	endif
    3621/    720C :                     		endm
    3622/    720C :                     
