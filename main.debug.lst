(1)  315/       0 :                     			lea		4*4(sp), a2
(1)  316/       0 :                     			lea		.__data(pc), a1
(1)  317/       0 :                     			jsr		MDDBG__Console_Write_Formatted
(1)  318/       0 :                     			movem.l	(sp)+, a0-a2/d7
