    1943/    2D08 :                     ; Subroutine to calculate sine and cosine of an angle
    1944/    2D08 :                     ; d0 = input byte = angle (360 degrees == 256)
    1945/    2D08 :                     ; d0 = output word = 255 * sine(angle)
    1946/    2D08 :                     ; d1 = output word = 255 * cosine(angle)
    1947/    2D08 :                     ; ---------------------------------------------------------------------------
