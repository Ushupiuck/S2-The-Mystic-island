(1) 2490/   A6DE8 : =$1                  FixMusicAndSFXDataBugs = FixBugs
(1) 2491/   A6DE8 : =$1                  SonicDriverVer = 1 ; Tell SMPS2ASM that we're using Sonic 1's driver.
(1) 2492/   A6DE8 :                     		include "sound/_smps2asm_inc.asm"
