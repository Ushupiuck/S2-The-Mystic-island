   10874/   11002 : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
   10875/   11006 : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
   10876/   11008 : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
