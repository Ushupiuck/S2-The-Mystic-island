(1)  264/    169A : =>TRUE               	if Use128kbSafeDMA<>0
(1)  265/    169A :                     		; Detect if transfer crosses 128KB boundary
(1)  266/    169A :                     		; Using sub+sub instead of move+add handles the following edge cases:
(1)  267/    169A :                     		; (1) d3.w == 0 => 128kB transfer
(1)  268/    169A :                     		;   (a) d1.w == 0 => no carry, don't split the DMA
(1)  269/    169A :                     		;   (b) d1.w != 0 => carry, need to split the DMA
(1)  270/    169A :                     		; (2) d3.w != 0
(1)  271/    169A :                     		;   (a) if there is carry on d1.w + d3.w
(1)  272/    169A :                     		;     (* ) if d1.w + d3.w == 0 => transfer comes entirely from current 128kB block, don't split the DMA
(1)  273/    169A :                     		;     (**) if d1.w + d3.w != 0 => need to split the DMA
(1)  274/    169A :                     		;   (b) if there is no carry on d1.w + d3.w => don't split the DMA
(1)  275/    169A :                     		; The reason this works is that carry on d1.w + d3.w means that
(1)  276/    169A :                     		; d1.w + d3.w >= $10000, whereas carry on (-d3.w) - (d1.w) means that
(1)  277/    169A :                     		; d1.w + d3.w > $10000.
(1)  278/    169A : 9043                		sub.w	d3,d0										; Using sub instead of move and add allows checking edge cases
(1)  279/    169C : 9041                		sub.w	d1,d0										; Does the transfer cross over to the next 128kB block?
(1)  280/    169E : 651E                		bcs.s	.doubletransfer								; Branch if yes
(1)  281/    16A0 : [264]                	endif	; Use128kbSafeDMA
(1)  282/    16A0 :                     	; It does not cross a 128kB boundary. So just finish writing it.
