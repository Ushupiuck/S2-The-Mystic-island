   22580/   1B2FA : 00B0                		dc.w AnimCue_EHZ-DynArtCue_Index	; EHZ
   22581/   1B2FC : 0044                		dc.w Dynamic_Normal-DynArtCue_Index	; HPZ
   22582/   1B2FE : 010E                		dc.w AnimCue_HPZ-DynArtCue_Index	; HPZ
   22583/   1B300 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index	; HTZ
   22584/   1B302 : 00B0                		dc.w AnimCue_EHZ-DynArtCue_Index	; HTZ
   22585/   1B304 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; 06
   22586/   1B306 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; 06
