(2)  735/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  736/   1DAC2 :                     ; S1/S2 only coordination flag
(2)  737/   1DAC2 :                     ; Sets D1L to maximum volume (minimum attenuation) and RR to maximum for operators 3 and 4 of FM1
(2)  738/   1DAC2 :                     smpsMaxRelRate macro
(2)  739/   1DAC2 :                     	if SonicDriverVer>=3
(2)  740/   1DAC2 :                     		; Emulate it in S3/S&K/S3D driver
(2)  741/   1DAC2 :                     		smpsFMICommand $88,$0F
(2)  742/   1DAC2 :                     		smpsFMICommand $8C,$0F
(2)  743/   1DAC2 :                     	else
(2)  744/   1DAC2 :                     		dc.b	$F9
(2)  745/   1DAC2 :                     	endif
(2)  746/   1DAC2 :                     	endm
(2)  747/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  748/   1DAC2 :                     ; Backwards compatibility
(2)  749/   1DAC2 :                     smpsAlterNote macro
(2)  750/   1DAC2 :                     	smpsDetune	ALLARGS
(2)  751/   1DAC2 :                     	endm
(2)  752/   1DAC2 :                     
(2)  753/   1DAC2 :                     smpsAlterPitch macro
(2)  754/   1DAC2 :                     	smpsChangeTransposition	ALLARGS
(2)  755/   1DAC2 :                     	endm
(2)  756/   1DAC2 :                     
(2)  757/   1DAC2 :                     smpsFMFlutter macro
(2)  758/   1DAC2 :                     	smpsFMVolEnv	ALLARGS
(2)  759/   1DAC2 :                     	endm
(2)  760/   1DAC2 :                     
(2)  761/   1DAC2 :                     smpsWeirdD1LRR macro
(2)  762/   1DAC2 :                     	smpsMaxRelRate ALLARGS
(2)  763/   1DAC2 :                     	endm
(2)  764/   1DAC2 :                     
(2)  765/   1DAC2 :                     smpsSetvoice macro
(2)  766/   1DAC2 :                     	smpsFMvoice ALLARGS
(2)  767/   1DAC2 :                     	endm
(2)  768/   1DAC2 :                     ; ---------------------------------------------------------------------------
(2)  769/   1DAC2 :                     ; Macros for FM instruments
(2)  770/   1DAC2 :                     ; Voices - Feedback
(2)  771/   1DAC2 :                     smpsVcFeedback macro val
(2)  772/   1DAC2 :                     vcFeedback set val
(2)  773/   1DAC2 :                     	endm
(2)  774/   1DAC2 :                     
(2)  775/   1DAC2 :                     ; Voices - Algorithm
(2)  776/   1DAC2 :                     smpsVcAlgorithm macro val
(2)  777/   1DAC2 :                     vcAlgorithm set val
(2)  778/   1DAC2 :                     	endm
(2)  779/   1DAC2 :                     
(2)  780/   1DAC2 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  781/   1DAC2 :                     vcUnusedBits set val
(2)  782/   1DAC2 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  783/   1DAC2 :                     		set vcD1R1Unk,d1r1<<5
(2)  784/   1DAC2 :                     		set vcD1R2Unk,d1r2<<5
(2)  785/   1DAC2 :                     		set vcD1R3Unk,d1r3<<5
(2)  786/   1DAC2 :                     		set vcD1R4Unk,d1r4<<5
(2)  787/   1DAC2 :                     	else
(2)  788/   1DAC2 :                     		set vcD1R1Unk,0
(2)  789/   1DAC2 :                     		set vcD1R2Unk,0
(2)  790/   1DAC2 :                     		set vcD1R3Unk,0
(2)  791/   1DAC2 :                     		set vcD1R4Unk,0
(2)  792/   1DAC2 :                     	endif
(2)  793/   1DAC2 :                     	endm
(2)  794/   1DAC2 :                     
(2)  795/   1DAC2 :                     ; Voices - Detune
(2)  796/   1DAC2 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  797/   1DAC2 :                     	set vcDT1,op1
(2)  798/   1DAC2 :                     	set vcDT2,op2
(2)  799/   1DAC2 :                     	set vcDT3,op3
(2)  800/   1DAC2 :                     	set vcDT4,op4
(2)  801/   1DAC2 :                     	endm
(2)  802/   1DAC2 :                     
(2)  803/   1DAC2 :                     ; Voices - Coarse-Frequency
(2)  804/   1DAC2 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  805/   1DAC2 :                     	set vcCF1,op1
(2)  806/   1DAC2 :                     	set vcCF2,op2
(2)  807/   1DAC2 :                     	set vcCF3,op3
(2)  808/   1DAC2 :                     	set vcCF4,op4
(2)  809/   1DAC2 :                     	endm
(2)  810/   1DAC2 :                     
(2)  811/   1DAC2 :                     ; Voices - Rate Scale
(2)  812/   1DAC2 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  813/   1DAC2 :                     	set vcRS1,op1
(2)  814/   1DAC2 :                     	set vcRS2,op2
(2)  815/   1DAC2 :                     	set vcRS3,op3
(2)  816/   1DAC2 :                     	set vcRS4,op4
(2)  817/   1DAC2 :                     	endm
(2)  818/   1DAC2 :                     
(2)  819/   1DAC2 :                     ; Voices - Attack Rate
(2)  820/   1DAC2 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  821/   1DAC2 :                     	set vcAR1,op1
(2)  822/   1DAC2 :                     	set vcAR2,op2
(2)  823/   1DAC2 :                     	set vcAR3,op3
(2)  824/   1DAC2 :                     	set vcAR4,op4
(2)  825/   1DAC2 :                     	endm
(2)  826/   1DAC2 :                     
(2)  827/   1DAC2 :                     ; Voices - Amplitude Modulation
(2)  828/   1DAC2 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  829/   1DAC2 :                     ; were the Amplitude Modulation.
(2)  830/   1DAC2 :                     ; According to several docs, however, it's actually the high bit.
(2)  831/   1DAC2 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  832/   1DAC2 :                     	if SourceSMPS2ASM==0
(2)  833/   1DAC2 :                     		set vcAM1,op1<<5
(2)  834/   1DAC2 :                     		set vcAM2,op2<<5
(2)  835/   1DAC2 :                     		set vcAM3,op3<<5
(2)  836/   1DAC2 :                     		set vcAM4,op4<<5
(2)  837/   1DAC2 :                     	else
(2)  838/   1DAC2 :                     		set vcAM1,op1<<7
(2)  839/   1DAC2 :                     		set vcAM2,op2<<7
(2)  840/   1DAC2 :                     		set vcAM3,op3<<7
(2)  841/   1DAC2 :                     		set vcAM4,op4<<7
(2)  842/   1DAC2 :                     	endif
(2)  843/   1DAC2 :                     	endm
(2)  844/   1DAC2 :                     
(2)  845/   1DAC2 :                     ; Voices - First Decay Rate
(2)  846/   1DAC2 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  847/   1DAC2 :                     	set vcD1R1,op1
(2)  848/   1DAC2 :                     	set vcD1R2,op2
(2)  849/   1DAC2 :                     	set vcD1R3,op3
(2)  850/   1DAC2 :                     	set vcD1R4,op4
(2)  851/   1DAC2 :                     	endm
(2)  852/   1DAC2 :                     
(2)  853/   1DAC2 :                     ; Voices - Second Decay Rate
(2)  854/   1DAC2 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  855/   1DAC2 :                     	set vcD2R1,op1
(2)  856/   1DAC2 :                     	set vcD2R2,op2
(2)  857/   1DAC2 :                     	set vcD2R3,op3
(2)  858/   1DAC2 :                     	set vcD2R4,op4
(2)  859/   1DAC2 :                     	endm
(2)  860/   1DAC2 :                     
(2)  861/   1DAC2 :                     ; Voices - Decay Level
(2)  862/   1DAC2 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  863/   1DAC2 :                     	set vcDL1,op1
(2)  864/   1DAC2 :                     	set vcDL2,op2
(2)  865/   1DAC2 :                     	set vcDL3,op3
(2)  866/   1DAC2 :                     	set vcDL4,op4
(2)  867/   1DAC2 :                     	endm
(2)  868/   1DAC2 :                     
(2)  869/   1DAC2 :                     ; Voices - Release Rate
(2)  870/   1DAC2 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  871/   1DAC2 :                     	set vcRR1,op1
(2)  872/   1DAC2 :                     	set vcRR2,op2
(2)  873/   1DAC2 :                     	set vcRR3,op3
(2)  874/   1DAC2 :                     	set vcRR4,op4
(2)  875/   1DAC2 :                     	endm
(2)  876/   1DAC2 :                     
(2)  877/   1DAC2 :                     ; Voices - Total Level
(2)  878/   1DAC2 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  879/   1DAC2 :                     ; but later versions leave it up to the user.
(2)  880/   1DAC2 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  881/   1DAC2 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  882/   1DAC2 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  883/   1DAC2 :                     ; SMPS Z80 does the opposite.
(2)  884/   1DAC2 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  885/   1DAC2 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  886/   1DAC2 :                     ; what we do, so we just print a warning.
(2)  887/   1DAC2 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  888/   1DAC2 :                     	set vcTL1,op1
(2)  889/   1DAC2 :                     	set vcTL2,op2
(2)  890/   1DAC2 :                     	set vcTL3,op3
(2)  891/   1DAC2 :                     	set vcTL4,op4
(2)  892/   1DAC2 :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  893/   1DAC2 :                     ;   0     1     2     3     4     5     6     7
(2)  894/   1DAC2 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  895/   1DAC2 :                     	if SourceSMPS2ASM==0
(2)  896/   1DAC2 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  897/   1DAC2 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  898/   1DAC2 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  899/   1DAC2 :                     		set vcTLMask1,$80
(2)  900/   1DAC2 :                     	else
(2)  901/   1DAC2 :                     		set vcTLMask4,0
(2)  902/   1DAC2 :                     		set vcTLMask3,0
(2)  903/   1DAC2 :                     		set vcTLMask2,0
(2)  904/   1DAC2 :                     		set vcTLMask1,0
(2)  905/   1DAC2 :                     	endif
(2)  906/   1DAC2 :                     
(2)  907/   1DAC2 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  908/   1DAC2 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  909/   1DAC2 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  910/   1DAC2 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  911/   1DAC2 :                     		set vcTLMask1,$80
(2)  912/   1DAC2 :                     		set vcTL1,vcTL1&$7F
(2)  913/   1DAC2 :                     		set vcTL2,vcTL2&$7F
(2)  914/   1DAC2 :                     		set vcTL3,vcTL3&$7F
(2)  915/   1DAC2 :                     		set vcTL4,vcTL4&$7F
(2)  916/   1DAC2 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&$80)<>$80)||(((vcTL2|vcTLMask2)&$80)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&$80)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&$80)<>((vcAlgorithm==7)<<7)))
(2)  917/   1DAC2 :                     		if MOMPASS=1
(2)  918/   1DAC2 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  919/   1DAC2 :                     		endif
(2)  920/   1DAC2 :                     	endif
(2)  921/   1DAC2 :                     
(2)  922/   1DAC2 :                     	if SonicDriverVer==2
(2)  923/   1DAC2 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  924/   1DAC2 :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  925/   1DAC2 :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  926/   1DAC2 :                     		dc.b	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  927/   1DAC2 :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  928/   1DAC2 :                     		dc.b	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  929/   1DAC2 :                     	else
