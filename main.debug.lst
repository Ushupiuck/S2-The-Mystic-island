    9057/    D5E4 :                     ; Subroutine to make an object move and fall downward increasingly fast
    9058/    D5E4 :                     ; This moves the object horizontally and vertically
    9059/    D5E4 :                     ; and also applies gravity to its speed
    9060/    D5E4 :                     ; ---------------------------------------------------------------------------
    9061/    D5E4 :                     
    9062/    D5E4 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    9063/    D5E4 :                     
    9064/    D5E4 :                     ObjectFall:
    9065/    D5E4 :                     ObjectMoveAndFall:
    9066/    D5E4 : 3028 0010           		move.w	obVelX(a0),d0	; load x speed
    9067/    D5E8 : 48C0                		ext.l	d0
    9068/    D5EA : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9069/    D5EC : D1A8 0008           		add.l	d0,obX(a0)	; add x speed to x position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
    9070/    D5F0 : 3028 0012           		move.w	obVelY(a0),d0	; load y speed
    9071/    D5F4 : 0668 0038 0012      		addi.w	#$38,obVelY(a0)	; increase vertical speed (apply gravity)
    9072/    D5FA : 48C0                		ext.l	d0
    9073/    D5FC : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9074/    D5FE : D1A8 000C           		add.l	d0,obY(a0)	; add old y speed to y position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
    9075/    D602 : 4E75                		rts
    9076/    D604 :                     ; End of function ObjectMoveAndFall
    9077/    D604 :                     
    9078/    D604 :                     ; ---------------------------------------------------------------------------
    9079/    D604 :                     ; Subroutine translating object speed to update object position
    9080/    D604 :                     ; This moves the object horizontally and vertically
    9081/    D604 :                     ; but does not apply gravity to it
    9082/    D604 :                     ; ---------------------------------------------------------------------------
    9083/    D604 :                     
    9084/    D604 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    9085/    D604 :                     
    9086/    D604 :                     ObjectMove:
    9087/    D604 :                     SpeedToPos:
    9088/    D604 : 3028 0010           		move.w	obVelX(a0),d0	; load horizontal speed
    9089/    D608 : 48C0                		ext.l	d0
    9090/    D60A : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9091/    D60C : D1A8 0008           		add.l	d0,obX(a0)	; add to x-axis position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
    9092/    D610 : 3028 0012           		move.w	obVelY(a0),d0	; load vertical speed
    9093/    D614 : 48C0                		ext.l	d0
    9094/    D616 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9095/    D618 : D1A8 000C           		add.l	d0,obY(a0)	; add to y-axis position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
    9096/    D61C : 4E75                		rts
    9097/    D61E :                     ; End of function ObjectMove
