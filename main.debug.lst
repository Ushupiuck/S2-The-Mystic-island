(2)    4/   A72DA : 0603                        dc.b    $06,$03
(2)    5/   A72DC : (MACRO)              	smpsHeaderTempo     $01, $03
(2)    5/   A72DC : 01                          dc.b    $01
(2)    5/   A72DD :  (MACRO-2)                   convertMainTempoMod $03
(2)    5/   A72DD : =>TRUE                       if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)    5/   A72DD : 03                                  dc.b    $03
(2)    5/   A72DE : =>FALSE                      elseif SourceDriver==1
(2)    5/   A72DE :                                     if $03==1
(2)    5/   A72DE :                                             fatal "Invalid main tempo of 1 in song from Sonic 1"
