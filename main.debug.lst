    1915/    47C8 :                     ; Subroutine to generate a pseudo-random number in d0
    1916/    47C8 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1917/    47C8 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1918/    47C8 :                     ; ---------------------------------------------------------------------------
    1919/    47C8 :                     
    1920/    47C8 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1921/    47C8 :                     
    1922/    47C8 :                     ; PseudoRandomNumber:
    1923/    47C8 :                     RandomNumber:
    1924/    47C8 : 2238 F672           		move.l	(v_random).w,d1
    1925/    47CC : 6606                		bne.s	loc_2C9C
    1926/    47CE : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1927/    47D4 :                     
    1928/    47D4 :                     loc_2C9C:
    1929/    47D4 :                     		; set the high word of d0 to be the high word of the RNG
    1930/    47D4 :                     		; and multiply the RNG by 41
    1931/    47D4 : 2001                		move.l	d1,d0
    1932/    47D6 : E581                		asl.l	#2,d1
    1933/    47D8 : D280                		add.l	d0,d1
    1934/    47DA : E781                		asl.l	#3,d1
    1935/    47DC : D280                		add.l	d0,d1
    1936/    47DE :                     
    1937/    47DE :                     		; add the low word of the RNG to the high word of the RNG
    1938/    47DE :                     		; and set the low word of d0 to be the result
    1939/    47DE :                     
    1940/    47DE : 3001                		move.w	d1,d0
    1941/    47E0 : 4841                		swap	d1
    1942/    47E2 : D041                		add.w	d1,d0
    1943/    47E4 : 3200                		move.w	d0,d1
    1944/    47E6 : 4841                		swap	d1
    1945/    47E8 :                     
    1946/    47E8 :                     ;		move.w	d1,d0
    1947/    47E8 :                     ;		abcd	d0,d1
    1948/    47E8 :                     ;		addx.w	d1,d0
    1949/    47E8 :                     ;		move.w	d0,d1
    1950/    47E8 :                     ;		swap	d1
    1951/    47E8 : 21C1 F672           		move.l	d1,(v_random).w
    1952/    47EC : 4E75                		rts
    1953/    47EE :                     ; End of function RandomNumber
