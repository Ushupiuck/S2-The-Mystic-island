(2)   42/       0 :                     ;Z80Driver_Start:
(2)   43/       0 : F3                  	di					; Disable interrupts. Interrupts will never be reenabled
(2)   44/       1 : F3                  	di					; for the z80, so that no code will be executed on V-Int.
