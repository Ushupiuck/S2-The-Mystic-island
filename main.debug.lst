     963/    1376 :                     ; Subroutine to transfer a plane map to VRAM
     964/    1376 :                     ; ---------------------------------------------------------------------------
     965/    1376 :                     
     966/    1376 :                     ; control register:
     967/    1376 :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
     968/    1376 :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
     969/    1376 :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
     970/    1376 :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
     971/    1376 :                     ;
     972/    1376 :                     ;	A00-A15 - address
     973/    1376 :                     ;	CD0-CD3 - code
     974/    1376 :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
     975/    1376 :                     ;	CD5 - DMA operation
     976/    1376 :                     ;
     977/    1376 :                     ;	Bits CD3-CD0:
     978/    1376 :                     ;	0000 - VRAM read
     979/    1376 :                     ;	0001 - VRAM write
     980/    1376 :                     ;	0011 - CRAM write
     981/    1376 :                     ;	0100 - VSRAM read
     982/    1376 :                     ;	0101 - VSRAM write
     983/    1376 :                     ;	1000 - CRAM read
     984/    1376 :                     ;
     985/    1376 :                     ; d0 = control register
     986/    1376 :                     ; d1 = width
     987/    1376 :                     ; d2 = heigth
     988/    1376 :                     ; a1 = source address
     989/    1376 :                     
     990/    1376 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
     991/    1376 :                     
