(2)  848/   1DAAE :                     	set vcD1R2,op2
(2)  849/   1DAAE :                     	set vcD1R3,op3
(2)  850/   1DAAE :                     	set vcD1R4,op4
(2)  851/   1DAAE :                     	endm
(2)  852/   1DAAE :                     
(2)  853/   1DAAE :                     ; Voices - Second Decay Rate
(2)  854/   1DAAE :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  855/   1DAAE :                     	set vcD2R1,op1
(2)  856/   1DAAE :                     	set vcD2R2,op2
(2)  857/   1DAAE :                     	set vcD2R3,op3
(2)  858/   1DAAE :                     	set vcD2R4,op4
(2)  859/   1DAAE :                     	endm
(2)  860/   1DAAE :                     
(2)  861/   1DAAE :                     ; Voices - Decay Level
(2)  862/   1DAAE :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  863/   1DAAE :                     	set vcDL1,op1
(2)  864/   1DAAE :                     	set vcDL2,op2
(2)  865/   1DAAE :                     	set vcDL3,op3
(2)  866/   1DAAE :                     	set vcDL4,op4
(2)  867/   1DAAE :                     	endm
(2)  868/   1DAAE :                     
(2)  869/   1DAAE :                     ; Voices - Release Rate
(2)  870/   1DAAE :                     smpsVcReleaseRate macro op1,op2,op3,op4
