    1923/    46C6 :                     ; Subroutine to generate a pseudo-random number in d0
    1924/    46C6 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1925/    46C6 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1926/    46C6 :                     ; ---------------------------------------------------------------------------
    1927/    46C6 :                     
    1928/    46C6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1929/    46C6 :                     
    1930/    46C6 :                     ; PseudoRandomNumber:
    1931/    46C6 :                     RandomNumber:
    1932/    46C6 : 2238 F674           		move.l	(v_random).w,d1
    1933/    46CA : 6606                		bne.s	loc_2C9C
    1934/    46CC : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1935/    46D2 :                     
    1936/    46D2 :                     loc_2C9C:
    1937/    46D2 :                     		; set the high word of d0 to be the high word of the RNG
    1938/    46D2 :                     		; and multiply the RNG by 41
    1939/    46D2 : 2001                		move.l	d1,d0
    1940/    46D4 : E581                		asl.l	#2,d1
    1941/    46D6 : D280                		add.l	d0,d1
    1942/    46D8 : E781                		asl.l	#3,d1
    1943/    46DA : D280                		add.l	d0,d1
    1944/    46DC :                     
    1945/    46DC :                     		; add the low word of the RNG to the high word of the RNG
    1946/    46DC :                     		; and set the low word of d0 to be the result
    1947/    46DC :                     
    1948/    46DC : 3001                		move.w	d1,d0
    1949/    46DE : 4841                		swap	d1
    1950/    46E0 : D041                		add.w	d1,d0
    1951/    46E2 : 3200                		move.w	d0,d1
    1952/    46E4 : 4841                		swap	d1
    1953/    46E6 :                     
    1954/    46E6 :                     ;		move.w	d1,d0
    1955/    46E6 :                     ;		abcd	d0,d1
    1956/    46E6 :                     ;		addx.w	d1,d0
    1957/    46E6 :                     ;		move.w	d0,d1
    1958/    46E6 :                     ;		swap	d1
    1959/    46E6 : 21C1 F674           		move.l	d1,(v_random).w
    1960/    46EA : 4E75                		rts
    1961/    46EC :                     ; End of function RandomNumber
