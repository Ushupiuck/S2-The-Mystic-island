(2)  146/   1DAAE : [142]                				endif
(2)  147/   1DAAE :                     				nextenum	dSnare,dClap,dScratch,dTimpani,dHiTom,dVLowClap,dHiTimpani,dMidTimpani
(2)  148/   1DAAE :                     				nextenum	dLowTimpani,dVLowTimpani,dMidTom,dLowTom,dFloorTom,dHiClap
