(1)    2/   A417E :                     ; Modified SMPS 68k Type 1b sound driver
(1)    3/   A417E :                     ; The source code to a similar version of the driver can be found here:
(1)    4/   A417E :                     ; https://hiddenpalace.org/News/Sega_of_Japan_Sound_Documents_and_Source_Code
(1)    5/   A417E :                     ; ---------------------------------------------------------------------------
(1)    6/   A417E :                     ; Constants
(1)    7/   A417E : =$12                 SMPS_TRACK_COUNT = (SMPS_RAM.v_track_ram_end-SMPS_RAM.v_track_ram)/SMPS_Track.len
(1)    8/   A417E : =$A                  SMPS_MUSIC_TRACK_COUNT = (SMPS_RAM.v_music_track_ram_end-SMPS_RAM.v_music_track_ram)/SMPS_Track.len
(1)    9/   A417E : =$7                  SMPS_MUSIC_FM_DAC_TRACK_COUNT = (SMPS_RAM.v_music_fmdac_tracks_end-SMPS_RAM.v_music_fmdac_tracks)/SMPS_Track.len
(1)   10/   A417E : =$6                  SMPS_MUSIC_FM_TRACK_COUNT = (SMPS_RAM.v_music_fm_tracks_end-SMPS_RAM.v_music_fm_tracks)/SMPS_Track.len
(1)   11/   A417E : =$3                  SMPS_MUSIC_PSG_TRACK_COUNT = (SMPS_RAM.v_music_psg_tracks_end-SMPS_RAM.v_music_psg_tracks)/SMPS_Track.len
(1)   12/   A417E : =$6                  SMPS_SFX_TRACK_COUNT = (SMPS_RAM.v_sfx_track_ram_end-SMPS_RAM.v_sfx_track_ram)/SMPS_Track.len
(1)   13/   A417E : =$3                  SMPS_SFX_FM_TRACK_COUNT = (SMPS_RAM.v_sfx_fm_tracks_end-SMPS_RAM.v_sfx_fm_tracks)/SMPS_Track.len
(1)   14/   A417E : =$3                  SMPS_SFX_PSG_TRACK_COUNT = (SMPS_RAM.v_sfx_psg_tracks_end-SMPS_RAM.v_sfx_psg_tracks)/SMPS_Track.len
(1)   15/   A417E : =$2                  SMPS_SPECIAL_SFX_TRACK_COUNT = (SMPS_RAM.v_spcsfx_track_ram_end-SMPS_RAM.v_spcsfx_track_ram)/SMPS_Track.len
