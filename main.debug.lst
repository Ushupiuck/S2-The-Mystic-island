(1)  264/    1682 : =>TRUE               	if Use128kbSafeDMA<>0
(1)  265/    1682 :                     		; Detect if transfer crosses 128KB boundary
(1)  266/    1682 :                     		; Using sub+sub instead of move+add handles the following edge cases:
(1)  267/    1682 :                     		; (1) d3.w == 0 => 128kB transfer
(1)  268/    1682 :                     		;   (a) d1.w == 0 => no carry, don't split the DMA
(1)  269/    1682 :                     		;   (b) d1.w != 0 => carry, need to split the DMA
(1)  270/    1682 :                     		; (2) d3.w != 0
(1)  271/    1682 :                     		;   (a) if there is carry on d1.w + d3.w
(1)  272/    1682 :                     		;     (* ) if d1.w + d3.w == 0 => transfer comes entirely from current 128kB block, don't split the DMA
(1)  273/    1682 :                     		;     (**) if d1.w + d3.w != 0 => need to split the DMA
(1)  274/    1682 :                     		;   (b) if there is no carry on d1.w + d3.w => don't split the DMA
(1)  275/    1682 :                     		; The reason this works is that carry on d1.w + d3.w means that
(1)  276/    1682 :                     		; d1.w + d3.w >= $10000, whereas carry on (-d3.w) - (d1.w) means that
(1)  277/    1682 :                     		; d1.w + d3.w > $10000.
(1)  278/    1682 : 9043                		sub.w	d3,d0										; Using sub instead of move and add allows checking edge cases
(1)  279/    1684 : 9041                		sub.w	d1,d0										; Does the transfer cross over to the next 128kB block?
