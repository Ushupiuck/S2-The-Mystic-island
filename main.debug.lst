    2004/    4992 : 674C                		beq.s	CalcAngle_Zero			; special case return if x and y are both 0
    2005/    4994 : 3802                		move.w	d2,d4
    2006/    4996 : 4A43                		tst.w	d3				; calculate absolute value of x
    2007/    4998 : 6A00 0004           		bpl.w	loc_2F68
    2008/    499C : 4443                		neg.w	d3
    2009/    499E :                     
