     951/    135E :                     ; Subroutine to transfer a plane map to VRAM
     952/    135E :                     ; ---------------------------------------------------------------------------
     953/    135E :                     
     954/    135E :                     ; control register:
     955/    135E :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
     956/    135E :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
     957/    135E :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
     958/    135E :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
     959/    135E :                     ;
     960/    135E :                     ;	A00-A15 - address
     961/    135E :                     ;	CD0-CD3 - code
     962/    135E :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
     963/    135E :                     ;	CD5 - DMA operation
     964/    135E :                     ;
     965/    135E :                     ;	Bits CD3-CD0:
     966/    135E :                     ;	0000 - VRAM read
     967/    135E :                     ;	0001 - VRAM write
     968/    135E :                     ;	0011 - CRAM write
     969/    135E :                     ;	0100 - VSRAM read
     970/    135E :                     ;	0101 - VSRAM write
     971/    135E :                     ;	1000 - CRAM read
     972/    135E :                     ;
     973/    135E :                     ; d0 = control register
     974/    135E :                     ; d1 = width
     975/    135E :                     ; d2 = heigth
     976/    135E :                     ; a1 = source address
     977/    135E :                     
     978/    135E :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
     979/    135E :                     
