   23945/   1F658 : (MACRO)              		align $20
   23945/   1F658 :  (MACRO-2)                   cnop 0,$20
   23945/   1F658 : =>TRUE                       if notZ80(MOMCPU)
   23945/   1F658 :   (MACRO-3)                          org (*-1+($20)-((*-1+(-(0)))#($20)))
   23945/   1F658 : =>TRUE                       if notZ80(MOMCPU)
   23945/   1F658 : =>FALSE                              if (*-1+($20)-((*-1+(-(0)))#($20))) < *
   23945/   1F658 :                                             error "too much stuff before org $\{(*-1+($20)-((*-1+(-(0)))#($20)))} ($\{(*-(*-1+($20)-((*-1+(-(0)))#($20))))} bytes)"
   23945/   1F658 : =>TRUE                               elseif (*-1+($20)-((*-1+(-(0)))#($20))) > *
   23945/   1F658 : =$234                paddingSoFar    set paddingSoFar + (*-1+($20)-((*-1+(-(0)))#($20))) - *
   23945/   1F660 :                                             !org (*-1+($20)-((*-1+(-(0)))#($20)))
   23945/   1F660 : [23945]                              endif
   23945/   1F660 : =>FALSE                      else
   23945/   1F660 :                                     if (*-1+($20)-((*-1+(-(0)))#($20))) < $
   23945/   1F660 :                                             error "too much stuff before org 0\{(*-1+($20)-((*-1+(-(0)))#($20)))}h (0\{($-(*-1+($20)-((*-1+(-(0)))#($20))))}h bytes)"
   23945/   1F660 :                                     else
   23945/   1F660 :                                             while (*-1+($20)-((*-1+(-(0)))#($20))) > $
   23945/   1F660 :                                                     db 0
   23945/   1F660 :                                             endm
   23945/   1F660 : [23945]                              endif
   23945/   1F660 : [23945]                      endif
   23945/   1F660 : =>FALSE                      else
   23945/   1F660 :                                     org ($-1+($20)-(($-1+(-(0)))#($20)))
   23945/   1F660 : [23945]                      endif
