   22695/   19922 : =$0                  zoneanimcount := 0
   22695/   19922 : ="AnimCue_EHZ"       zoneanimcur := "AnimCue_EHZ"
   22695/   19922 : 0004                        dc.w zoneanimcount_AnimCue_EHZ    ; Number of scripts for a zone (-1)
   22696/   19924 :                     		; Flowers
