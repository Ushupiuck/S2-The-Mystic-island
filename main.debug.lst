    5446/    73C0 :                     ScrollHoriz:
    5447/    73C0 : =>TRUE               	if FixBugs
    5448/    73C0 :                     		; To prevent the bug that is described below, this caps the position
    5449/    73C0 :                     		; array index offset so that it does not access position data from
    5450/    73C0 :                     		; before the spin dash was performed. Note that this required
    5451/    73C0 :                     		; modifications to 'Sonic_UpdateSpindash' and 'Tails_UpdateSpindash'.
    5452/    73C0 : 1215                		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5453/    73C2 : 6722                		beq.s	.scrollNotDelayed				; if not, branch
    5454/    73C4 : E509                		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5455/    73C6 : 5315                		subq.b	#1,Horiz_scroll_delay_val-Camera_Delay(a5)	; reduce delay value
    5456/    73C8 : 102D 0003           		move.b	Sonic_Pos_Record_Index+1-Camera_Delay(a5),d0
    5457/    73CC : 902D 0001           		sub.b	Horiz_scroll_delay_val+1-Camera_Delay(a5),d0
    5458/    73D0 : B200                		cmp.b	d0,d1
    5459/    73D2 : 6502                		blo.s	.doNotCap
    5460/    73D4 : 1200                		move.b	d0,d1
    5461/    73D6 :                     .doNotCap:
    5462/    73D6 : =>FALSE              	else
    5463/    73D6 :                     		; The intent of this code is to make the camera briefly lag behind the
    5464/    73D6 :                     		; player right after releasing a spin dash, however it does this by
    5465/    73D6 :                     		; simply making the camera use position data from previous frames. This
    5466/    73D6 :                     		; means that if the camera had been moving recently enough, then
    5467/    73D6 :                     		; releasing a spin dash will cause the camera to jerk around instead of
    5468/    73D6 :                     		; remain still. This can be encountered by running into a wall, and
    5469/    73D6 :                     		; quickly turning around and spin dashing away. Sonic 3 would have had
    5470/    73D6 :                     		; this same issue with the Fire Shield's dash abiliity, but it shoddily
    5471/    73D6 :                     		; works around the issue by resetting the old position values to the
    5472/    73D6 :                     		; current position (see 'Reset_Player_Position_Array').
    5473/    73D6 :                     		move.w	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5474/    73D6 :                     		beq.s	.scrollNotDelayed				; if not, branch
    5475/    73D6 :                     		subi.w	#$100,d1					; reduce delay value
    5476/    73D6 :                     		move.w	d1,Horiz_scroll_delay_val-Camera_Delay(a5)
    5477/    73D6 :                     		moveq	#0,d1
    5478/    73D6 :                     		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; get delay value
    5479/    73D6 :                     		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5480/    73D6 :                     		addq.b	#4,d1
    5481/    73D6 : [5447]               	endif
