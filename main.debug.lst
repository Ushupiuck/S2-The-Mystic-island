(2)  586/   A72D8 :                     smpsPSGvoice macro voice
(2)  587/   A72D8 :                     	dc.b	$F5,voice
(2)  588/   A72D8 :                     	endm
(2)  589/   A72D8 :                     
(2)  590/   A72D8 :                     ; F6xxxx - Jump to xxxx
(2)  591/   A72D8 :                     smpsJump macro loc
(2)  592/   A72D8 :                     	dc.b	$F6
(2)  593/   A72D8 :                     	if SonicDriverVer<>1
(2)  594/   A72D8 :                     		dc.w	z80_ptr(loc)
(2)  595/   A72D8 :                     	else
(2)  596/   A72D8 :                     		dc.w	loc-*-1
(2)  597/   A72D8 :                     	endif
(2)  598/   A72D8 :                     	endm
(2)  599/   A72D8 :                     
(2)  600/   A72D8 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  601/   A72D8 :                     smpsLoop macro index,loops,loc
(2)  602/   A72D8 :                     	dc.b	$F7
(2)  603/   A72D8 :                     	dc.b	index,loops
(2)  604/   A72D8 :                     	if SonicDriverVer<>1
(2)  605/   A72D8 :                     		dc.w	z80_ptr(loc)
(2)  606/   A72D8 :                     	else
(2)  607/   A72D8 :                     		dc.w	loc-*-1
(2)  608/   A72D8 :                     	endif
(2)  609/   A72D8 :                     	endm
(2)  610/   A72D8 :                     
(2)  611/   A72D8 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  612/   A72D8 :                     smpsCall macro loc
(2)  613/   A72D8 :                     	dc.b	$F8
(2)  614/   A72D8 :                     	if SonicDriverVer<>1
(2)  615/   A72D8 :                     		dc.w	z80_ptr(loc)
(2)  616/   A72D8 :                     	else
(2)  617/   A72D8 :                     		dc.w	loc-*-1
(2)  618/   A72D8 :                     	endif
(2)  619/   A72D8 :                     	endm
