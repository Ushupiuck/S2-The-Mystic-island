     995/    137C : 283C 0080 0000      		move.l	#$800000,d4
     996/    1382 :                     
     997/    1382 :                     PlaneMapToVRAM_H40_LineLoop:
     998/    1382 : 2D40 0004           		move.l	d0,4(a6)
     999/    1386 : 3601                		move.w	d1,d3
    1000/    1388 :                     
    1001/    1388 :                     PlaneMapToVRAM_H40_TileLoop:
    1002/    1388 : 3C99                		move.w	(a1)+,(a6)
    1003/    138A : 51CB FFFC           		dbf	d3,PlaneMapToVRAM_H40_TileLoop
