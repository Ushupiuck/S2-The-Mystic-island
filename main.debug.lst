(1)  264/    3826 : =>FALSE              	if Use128kbSafeDMA<>0
(1)  265/    3826 :                     		; Detect if transfer crosses 128KB boundary
(1)  266/    3826 :                     		; Using sub+sub instead of move+add handles the following edge cases:
(1)  267/    3826 :                     		; (1) d3.w == 0 => 128kB transfer
(1)  268/    3826 :                     		;   (a) d1.w == 0 => no carry, don't split the DMA
(1)  269/    3826 :                     		;   (b) d1.w != 0 => carry, need to split the DMA
(1)  270/    3826 :                     		; (2) d3.w != 0
(1)  271/    3826 :                     		;   (a) if there is carry on d1.w + d3.w
(1)  272/    3826 :                     		;     (* ) if d1.w + d3.w == 0 => transfer comes entirely from current 128kB block, don't split the DMA
(1)  273/    3826 :                     		;     (**) if d1.w + d3.w != 0 => need to split the DMA
(1)  274/    3826 :                     		;   (b) if there is no carry on d1.w + d3.w => don't split the DMA
(1)  275/    3826 :                     		; The reason this works is that carry on d1.w + d3.w means that
(1)  276/    3826 :                     		; d1.w + d3.w >= $10000, whereas carry on (-d3.w) - (d1.w) means that
(1)  277/    3826 :                     		; d1.w + d3.w > $10000.
(1)  278/    3826 :                     		sub.w	d3,d0										; Using sub instead of move and add allows checking edge cases
(1)  279/    3826 :                     		sub.w	d1,d0										; Does the transfer cross over to the next 128kB block?
(1)  280/    3826 :                     		bcs.s	.doubletransfer								; Branch if yes
(1)  281/    3826 : [264]                	endif	; Use128kbSafeDMA
(1)  282/    3826 :                     	; It does not cross a 128kB boundary. So just finish writing it.
