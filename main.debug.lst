    1923/    47BC :                     ; Subroutine to generate a pseudo-random number in d0
    1924/    47BC :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1925/    47BC :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1926/    47BC :                     ; ---------------------------------------------------------------------------
    1927/    47BC :                     
    1928/    47BC :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1929/    47BC :                     
    1930/    47BC :                     ; PseudoRandomNumber:
    1931/    47BC :                     RandomNumber:
    1932/    47BC : 2238 F674           		move.l	(v_random).w,d1
    1933/    47C0 : 6606                		bne.s	loc_2C9C
    1934/    47C2 : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1935/    47C8 :                     
    1936/    47C8 :                     loc_2C9C:
    1937/    47C8 :                     		; set the high word of d0 to be the high word of the RNG
    1938/    47C8 :                     		; and multiply the RNG by 41
    1939/    47C8 : 2001                		move.l	d1,d0
    1940/    47CA : E581                		asl.l	#2,d1
    1941/    47CC : D280                		add.l	d0,d1
    1942/    47CE : E781                		asl.l	#3,d1
    1943/    47D0 : D280                		add.l	d0,d1
    1944/    47D2 :                     
    1945/    47D2 :                     		; add the low word of the RNG to the high word of the RNG
    1946/    47D2 :                     		; and set the low word of d0 to be the result
    1947/    47D2 :                     
    1948/    47D2 : 3001                		move.w	d1,d0
    1949/    47D4 : 4841                		swap	d1
    1950/    47D6 : D041                		add.w	d1,d0
    1951/    47D8 : 3200                		move.w	d0,d1
    1952/    47DA : 4841                		swap	d1
    1953/    47DC :                     
    1954/    47DC :                     ;		move.w	d1,d0
    1955/    47DC :                     ;		abcd	d0,d1
    1956/    47DC :                     ;		addx.w	d1,d0
    1957/    47DC :                     ;		move.w	d0,d1
    1958/    47DC :                     ;		swap	d1
    1959/    47DC : 21C1 F674           		move.l	d1,(v_random).w
    1960/    47E0 : 4E75                		rts
    1961/    47E2 :                     ; End of function RandomNumber
