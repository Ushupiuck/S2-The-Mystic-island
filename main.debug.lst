     420/     37E :                     ShowErrAddress:
     421/     37E :                     		move.w	#ArtTile_Error_Handler_Font+10,(a6)	; display "$" symbol
     422/     37E :                     		moveq	#8-1,d2
     423/     37E :                     
     424/     37E :                     ShowErrAddress_DigitLoop:
     425/     37E :                     		rol.l	#4,d0
     426/     37E :                     		bsr.s	ShowErrDigit
     427/     37E :                     		dbf	d2,ShowErrAddress_DigitLoop
     428/     37E :                     		rts
     429/     37E :                     ; End of function ShowErrAddress
     430/     37E :                     
     431/     37E :                     
     432/     37E :                     ; =============== S U B	R O U T	I N E =======================================
     433/     37E :                     
     434/     37E :                     
     435/     37E :                     ShowErrDigit:
     436/     37E :                     		move.w	d0,d1
     437/     37E :                     		andi.w	#$F,d1
     438/     37E :                     		cmpi.w	#$A,d1
     439/     37E :                     		blo.s	ShowErrDigit_NoOverflow
     440/     37E :                     		addq.w	#7,d1		; add 7 for characters A-F
     441/     37E :                     
     442/     37E :                     ShowErrDigit_NoOverflow:
     443/     37E :                     		addi.w	#ArtTile_Error_Handler_Font,d1
     444/     37E :                     		move.w	d1,(a6)
     445/     37E :                     		rts
     446/     37E :                     ; End of function ShowErrDigit
