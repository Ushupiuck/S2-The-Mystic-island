   23908/   1AB82 :                     		include	"_inc/Pattern Load Cues.asm"
(1)    1/   1AB82 :                     ; ---------------------------------------------------------------------------
(1)    2/   1AB82 :                     ; PATTERN LOAD REQUEST LISTS
(1)    3/   1AB82 :                     ;
(1)    4/   1AB82 :                     ; Pattern load request lists are simple structures used to load
(1)    5/   1AB82 :                     ; Nemesis-compressed art for sprites.
(1)    6/   1AB82 :                     ;
(1)    7/   1AB82 :                     ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
(1)    8/   1AB82 :                     ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
(1)    9/   1AB82 :                     ;
(1)   10/   1AB82 :                     
(1)   11/   1AB82 :                     ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
(1)   12/   1AB82 :                     ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
(1)   13/   1AB82 :                     ; overflow and completely screw up the variables stored directly after the queue buffer.
(1)   14/   1AB82 :                     ; (in my experience this is a guaranteed crash or hang)
(1)   15/   1AB82 :                     ;
(1)   16/   1AB82 :                     ; Many levels queue more than 16 items overall, but they don't exceed the limit because
(1)   17/   1AB82 :                     ; their PLRs are split into multiple parts (like PLC_GHZ and PLC_GHZ2) and they fully
(1)   18/   1AB82 :                     ; process the first part before requesting the rest.
(1)   19/   1AB82 :                     ; ---------------------------------------------------------------------------
(1)   20/   1AB82 :                     
(1)   21/   1AB82 :                     ;---------------------------------------------------------------------------------------
(1)   22/   1AB82 :                     ; Table of pattern load request lists. Remember to use word-length data when adding lists
(1)   23/   1AB82 :                     ; otherwise you'll break the array.
(1)   24/   1AB82 :                     ;---------------------------------------------------------------------------------------
(1)   25/   1AB82 :                     ArtLoadCues:
