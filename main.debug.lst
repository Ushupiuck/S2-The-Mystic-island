   10872/   10F2C :                     ; loc_F598:
   10873/   10F2C :                     SolidObject_cont:
   10874/   10F2C :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
   10875/   10F2C :                     		; coordinate system where the x origin is at the object's left edge.
   10876/   10F2C : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
   10877/   10F30 : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
   10878/   10F34 : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
   10879/   10F36 : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
   10880/   10F3A : 3601                		move.w	d1,d3
   10881/   10F3C : D643                		add.w	d3,d3				; calculate object's width
   10882/   10F3E : B043                		cmp.w	d3,d0
   10883/   10F40 : 6200 00BA           		bhi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's right edge
   10884/   10F44 :                     		; We now perform the y portion of a bounding box check.  To do this, we assume a
   10885/   10F44 :                     		; coordinate system where the y origin is at the highest y position relative to the object
   10886/   10F44 :                     		; at which Sonic would still collide with it.  This point is
   10887/   10F44 :                     		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
   10888/   10F44 :                     		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
   10889/   10F44 :                     		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
