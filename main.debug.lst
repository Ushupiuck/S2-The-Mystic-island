(2)  530/   A6FA4 :                     
(2)  531/   A6FA4 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  532/   A6FA4 :                     smpsFMvoice macro voice,songID
(2)  533/   A6FA4 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  534/   A6FA4 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  535/   A6FA4 :                     	else
(2)  536/   A6FA4 :                     		dc.b	$EF,voice
(2)  537/   A6FA4 :                     	endif
(2)  538/   A6FA4 :                     	endm
(2)  539/   A6FA4 :                     
(2)  540/   A6FA4 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  541/   A6FA4 :                     smpsModSet macro wait,speed,change,step
(2)  542/   A6FA4 :                     	dc.b	$F0
(2)  543/   A6FA4 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  544/   A6FA4 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  545/   A6FA4 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  546/   A6FA4 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  547/   A6FA4 :                     	else
(2)  548/   A6FA4 :                     		dc.b	wait,speed,change,step
(2)  549/   A6FA4 :                     	endif
(2)  550/   A6FA4 :                     	;dc.b	speed,change,step
(2)  551/   A6FA4 :                     	endm
(2)  552/   A6FA4 :                     
(2)  553/   A6FA4 :                     ; Turn on Modulation
