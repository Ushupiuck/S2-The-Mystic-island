(2)  558/   A6FA4 :                     		else
(2)  559/   A6FA4 :                     			dc.b	$F4,$80
(2)  560/   A6FA4 :                     		endif
(2)  561/   A6FA4 :                     	else
(2)  562/   A6FA4 :                     		dc.b	$F1
(2)  563/   A6FA4 :                     	endif
(2)  564/   A6FA4 :                     	endm
