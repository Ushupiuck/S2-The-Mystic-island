(2)   15/   A6DE8 :                     
(2)   16/   A6DE8 : =$1                  SMPS2ASMVer	= 1
(2)   17/   A6DE8 :                     
(2)   18/   A6DE8 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   A6DE8 : =$C                  psgdelta	EQU 12
(2)   20/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)   21/   A6DE8 :                     ; Standard Octave Pitch Equates
(2)   22/   A6DE8 :                     	enumconf	$C
(2)   23/   A6DE8 : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   A6DE8 : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   A6DE8 : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   A6DE8 : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   A6DE8 : =$78                 	nextenum	smpsPitch10hi
(2)   28/   A6DE8 :                     	enumconf	1
(2)   29/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)   30/   A6DE8 :                     ; Note Equates
(2)   31/   A6DE8 : =$80..$8F            	enum		nRst=$80,nC0,nCs0,nD0,nEb0,nE0,nF0,nFs0,nG0,nAb0,nA0,nBb0,nB0,nC1,nCs1,nD1
(2)   32/   A6DE8 : =$90..$9F            	nextenum	nEb1,nE1,nF1,nFs1,nG1,nAb1,nA1,nBb1,nB1,nC2,nCs2,nD2,nEb2,nE2,nF2,nFs2
(2)   33/   A6DE8 : =$A0..$AF            	nextenum	nG2,nAb2,nA2,nBb2,nB2,nC3,nCs3,nD3,nEb3,nE3,nF3,nFs3,nG3,nAb3,nA3,nBb3
(2)   34/   A6DE8 : =$B0..$BF            	nextenum	nB3,nC4,nCs4,nD4,nEb4,nE4,nF4,nFs4,nG4,nAb4,nA4,nBb4,nB4,nC5,nCs5,nD5
(2)   35/   A6DE8 : =$C0..$CF            	nextenum	nEb5,nE5,nF5,nFs5,nG5,nAb5,nA5,nBb5,nB5,nC6,nCs6,nD6,nEb6,nE6,nF6,nFs6
(2)   36/   A6DE8 : =$D0..$DF            	nextenum	nG6,nAb6,nA6,nBb6,nB6,nC7,nCs7,nD7,nEb7,nE7,nF7,nFs7,nG7,nAb7,nA7,nBb7
(2)   37/   A6DE8 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   38/   A6DE8 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   39/   A6DE8 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   40/   A6DE8 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   41/   A6DE8 : =>TRUE               	if SonicDriverVer<=2
(2)   42/   A6DE8 : =$C6                 nMaxPSG				EQU nA5
(2)   43/   A6DE8 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   44/   A6DE8 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   45/   A6DE8 : =>FALSE              	else
(2)   46/   A6DE8 :                     nMaxPSG				EQU nBb6-psgdelta
(2)   47/   A6DE8 :                     nMaxPSG1			EQU nBb6
(2)   48/   A6DE8 :                     nMaxPSG2			EQU nB6
(2)   49/   A6DE8 : [41]                 	endif
(2)   50/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)   51/   A6DE8 :                     ; PSG volume envelope equates
(2)   52/   A6DE8 : =$1                  	switch SonicDriverVer
(2)   53/   A6DE8 : =>TRUE               		case 1
(2)   54/   A6DE8 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   55/   A6DE8 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   56/   A6DE8 : =>FALSE              		case 2
(2)   57/   A6DE8 :                     			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   58/   A6DE8 :                     			nextenum	fTone_07,fTone_08,fTone_09,fTone_0A,fTone_0B,fTone_0C
(2)   59/   A6DE8 :                     			nextenum	fTone_0D
(2)   60/   A6DE8 : =>FALSE              		elsecase;SonicDriverVer>=3
(2)   61/   A6DE8 :                     			enum		sTone_01=$01,sTone_02,sTone_03,sTone_04,sTone_05,sTone_06
(2)   62/   A6DE8 :                     			nextenum	sTone_07,sTone_08,sTone_09,sTone_0A,sTone_0B,sTone_0C
(2)   63/   A6DE8 :                     			nextenum	sTone_0D,sTone_0E,sTone_0F,sTone_10,sTone_11,sTone_12
(2)   64/   A6DE8 :                     			nextenum	sTone_13,sTone_14,sTone_15,sTone_16,sTone_17,sTone_18
(2)   65/   A6DE8 :                     			nextenum	sTone_19,sTone_1A,sTone_1B,sTone_1C,sTone_1D,sTone_1E
(2)   66/   A6DE8 :                     			nextenum	sTone_1F,sTone_20,sTone_21,sTone_22,sTone_23,sTone_24
(2)   67/   A6DE8 :                     			nextenum	sTone_25,sTone_26,sTone_27
(2)   68/   A6DE8 :                     			; For conversions:
(2)   69/   A6DE8 :                     			if SonicDriverVer>=5
(2)   70/   A6DE8 :                     				nextenum	fTone_01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   71/   A6DE8 :                     				nextenum	fTone_07,fTone_08,fTone_09,fTone_0A,fTone_0B,fTone_0C
(2)   72/   A6DE8 :                     				nextenum	fTone_0D
(2)   73/   A6DE8 : [69]                 			endif
(2)   74/   A6DE8 : [52]                 	endcase
(2)   75/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)   76/   A6DE8 :                     ; DAC Equates
(2)   77/   A6DE8 : =$1                  	switch SonicDriverVer
(2)   78/   A6DE8 : =>TRUE               		case 1
(2)   79/   A6DE8 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   80/   A6DE8 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)   81/   A6DE8 : =>FALSE              		case 2
(2)   82/   A6DE8 :                     			enum		dKick=$81,dSnare,dClap,dScratch,dTimpani,dHiTom,dVLowClap,dHiTimpani,dMidTimpani
(2)   83/   A6DE8 :                     			nextenum	dLowTimpani,dVLowTimpani,dMidTom,dLowTom,dFloorTom,dHiClap
(2)   84/   A6DE8 :                     			nextenum	dMidClap,dLowClap
(2)   85/   A6DE8 : =>FALSE              		case 3
(2)   86/   A6DE8 :                     			enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)   87/   A6DE8 :                     			nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)   88/   A6DE8 :                     			nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)   89/   A6DE8 :                     			nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
(2)   90/   A6DE8 :                     			nextenum	dTightSnare,dMidpitchSnare,dLooseSnare,dLooserSnare
(2)   91/   A6DE8 :                     			nextenum	dHiTimpaniS3,dLowTimpaniS3,dMidTimpaniS3,dQuickLooseSnare
(2)   92/   A6DE8 :                     			nextenum	dClick,dPowerKick,dQuickGlassCrash
(2)   93/   A6DE8 :                     			nextenum	dGlassCrashSnare,dGlassCrash,dGlassCrashKick,dQuietGlassCrash
(2)   94/   A6DE8 :                     			nextenum	dOddSnareKick,dKickExtraBass,dComeOn,dDanceSnare,dLooseKick
(2)   95/   A6DE8 :                     			nextenum	dModLooseKick,dWoo,dGo,dSnareGo,dPowerTom,dHiWoodBlock,dLowWoodBlock
(2)   96/   A6DE8 :                     			nextenum	dHiHitDrum,dLowHitDrum,dMetalCrashHit,dEchoedClapHit_S3
(2)   97/   A6DE8 :                     			nextenum	dLowerEchoedClapHit_S3,dHipHopHitKick,dHipHopHitPowerKick
(2)   98/   A6DE8 :                     			nextenum	dBassHey,dDanceStyleKick,dHipHopHitKick2,dHipHopHitKick3
(2)   99/   A6DE8 :                     			nextenum	dReverseFadingWind,dScratchS3,dLooseSnareNoise,dPowerKick2
(2)  100/   A6DE8 :                     			nextenum	dCrashingNoiseWoo,dQuickHit,dKickHey,dPowerKickHit
(2)  101/   A6DE8 :                     			nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  102/   A6DE8 : =>FALSE              		case 4
(2)  103/   A6DE8 :                     			enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)  104/   A6DE8 :                     			nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)  105/   A6DE8 :                     			nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)  106/   A6DE8 :                     			nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
(2)  107/   A6DE8 :                     			nextenum	dTightSnare,dMidpitchSnare,dLooseSnare,dLooserSnare
(2)  108/   A6DE8 :                     			nextenum	dHiTimpaniS3,dLowTimpaniS3,dMidTimpaniS3,dQuickLooseSnare
(2)  109/   A6DE8 :                     			nextenum	dClick,dPowerKick,dQuickGlassCrash
(2)  110/   A6DE8 :                     			nextenum	dGlassCrashSnare,dGlassCrash,dGlassCrashKick,dQuietGlassCrash
(2)  111/   A6DE8 :                     			nextenum	dOddSnareKick,dKickExtraBass,dComeOn,dDanceSnare,dLooseKick
(2)  112/   A6DE8 :                     			nextenum	dModLooseKick,dWoo,dGo,dSnareGo,dPowerTom,dHiWoodBlock,dLowWoodBlock
(2)  113/   A6DE8 :                     			nextenum	dHiHitDrum,dLowHitDrum,dMetalCrashHit,dEchoedClapHit
(2)  114/   A6DE8 :                     			nextenum	dLowerEchoedClapHit,dHipHopHitKick,dHipHopHitPowerKick
(2)  115/   A6DE8 :                     			nextenum	dBassHey,dDanceStyleKick,dHipHopHitKick2,dHipHopHitKick3
(2)  116/   A6DE8 :                     			nextenum	dReverseFadingWind,dScratchS3,dLooseSnareNoise,dPowerKick2
(2)  117/   A6DE8 :                     			nextenum	dCrashingNoiseWoo,dQuickHit,dKickHey,dPowerKickHit
(2)  118/   A6DE8 :                     			nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  119/   A6DE8 : =>FALSE              		elsecase;SonicDriverVer>=5
(2)  120/   A6DE8 :                     			if (use_s3_samples<>0)||(use_sk_samples<>0)||(use_s3d_samples<>0)
(2)  121/   A6DE8 :                     				enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)  122/   A6DE8 :                     				nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)  123/   A6DE8 :                     				nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)  124/   A6DE8 :                     				nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
(2)  125/   A6DE8 :                     				nextenum	dTightSnare,dMidpitchSnare,dLooseSnare,dLooserSnare
(2)  126/   A6DE8 :                     				nextenum	dHiTimpaniS3,dLowTimpaniS3,dMidTimpaniS3,dQuickLooseSnare
(2)  127/   A6DE8 :                     				nextenum	dClick,dPowerKick,dQuickGlassCrash
(2)  128/   A6DE8 : [120]                			endif
(2)  129/   A6DE8 :                     			if (use_s3_samples<>0)||(use_sk_samples<>0)
(2)  130/   A6DE8 :                     				nextenum	dGlassCrashSnare,dGlassCrash,dGlassCrashKick,dQuietGlassCrash
(2)  131/   A6DE8 :                     				nextenum	dOddSnareKick,dKickExtraBass,dComeOn,dDanceSnare,dLooseKick
(2)  132/   A6DE8 :                     				nextenum	dModLooseKick,dWoo,dGo,dSnareGo,dPowerTom,dHiWoodBlock,dLowWoodBlock
(2)  133/   A6DE8 :                     				nextenum	dHiHitDrum,dLowHitDrum,dMetalCrashHit,dEchoedClapHit
(2)  134/   A6DE8 :                     				nextenum	dLowerEchoedClapHit,dHipHopHitKick,dHipHopHitPowerKick
(2)  135/   A6DE8 :                     				nextenum	dBassHey,dDanceStyleKick,dHipHopHitKick2,dHipHopHitKick3
(2)  136/   A6DE8 :                     				nextenum	dReverseFadingWind,dScratchS3,dLooseSnareNoise,dPowerKick2
(2)  137/   A6DE8 :                     				nextenum	dCrashingNoiseWoo,dQuickHit,dKickHey,dPowerKickHit
(2)  138/   A6DE8 :                     				nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  139/   A6DE8 : [129]                			endif
(2)  140/   A6DE8 :                     			; For conversions:
(2)  141/   A6DE8 :                     			if (use_s2_samples<>0)
(2)  142/   A6DE8 :                     				if (use_s3_samples<>0)||(use_sk_samples<>0)||(use_s3d_samples<>0)
(2)  143/   A6DE8 :                     					nextenum	dKick
(2)  144/   A6DE8 :                     				else
(2)  145/   A6DE8 :                     					enum		dKick=$81
(2)  146/   A6DE8 : [142]                				endif
(2)  147/   A6DE8 :                     				nextenum	dSnare,dClap,dScratch,dTimpani,dHiTom,dVLowClap,dHiTimpani,dMidTimpani
(2)  148/   A6DE8 :                     				nextenum	dLowTimpani,dVLowTimpani,dMidTom,dLowTom,dFloorTom,dHiClap
(2)  149/   A6DE8 :                     				nextenum	dMidClap,dLowClap
(2)  150/   A6DE8 : [141]                			endif
(2)  151/   A6DE8 :                     			if (use_s3d_samples<>0)
(2)  152/   A6DE8 :                     				nextenum	dFinalFightMetalCrash,dIntroKick
(2)  153/   A6DE8 : [151]                			endif
(2)  154/   A6DE8 :                     			if (use_s3_samples<>0)
(2)  155/   A6DE8 :                     				nextenum	dEchoedClapHit_S3,dLowerEchoedClapHit_S3
(2)  156/   A6DE8 : [154]                			endif
(2)  157/   A6DE8 : [77]                 	endcase
(2)  158/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)  159/   A6DE8 :                     ; Channel IDs for SFX
(2)  160/   A6DE8 : =$80                 cPSG1				EQU $80
(2)  161/   A6DE8 : =$A0                 cPSG2				EQU $A0
(2)  162/   A6DE8 : =$C0                 cPSG3				EQU $C0
(2)  163/   A6DE8 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  164/   A6DE8 : =$2                  cFM3				EQU $02
(2)  165/   A6DE8 : =$4                  cFM4				EQU $04
(2)  166/   A6DE8 : =$5                  cFM5				EQU $05
(2)  167/   A6DE8 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  168/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)  169/   A6DE8 :                     ; Conversion macros and functions
(2)  170/   A6DE8 :                     
(2)  171/   A6DE8 :                     conv0To256  function n,((n==0)<<8)|n
(2)  172/   A6DE8 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  173/   A6DE8 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  174/   A6DE8 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  175/   A6DE8 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  176/   A6DE8 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  177/   A6DE8 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  178/   A6DE8 :                     
(2)  179/   A6DE8 :                     convertMainTempoMod macro mod
(2)  180/   A6DE8 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  181/   A6DE8 :                     		dc.b	mod
(2)  182/   A6DE8 :                     	elseif SourceDriver==1
(2)  183/   A6DE8 :                     		if mod==1
(2)  184/   A6DE8 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  185/   A6DE8 :                     		endif
(2)  186/   A6DE8 :                     		if SonicDriverVer==2
(2)  187/   A6DE8 :                     			dc.b	s1TempotoS2(mod)
(2)  188/   A6DE8 :                     		else;if SonicDriverVer>=3
(2)  189/   A6DE8 :                     			dc.b	s1TempotoS3(mod)
(2)  190/   A6DE8 :                     		endif
(2)  191/   A6DE8 :                     	elseif SourceDriver==2
(2)  192/   A6DE8 :                     		if mod==0
(2)  193/   A6DE8 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  194/   A6DE8 :                     		endif
(2)  195/   A6DE8 :                     		if SonicDriverVer==1
(2)  196/   A6DE8 :                     			dc.b	s2TempotoS1(mod)
(2)  197/   A6DE8 :                     		else;if SonicDriverVer>=3
(2)  198/   A6DE8 :                     			dc.b	s2TempotoS3(mod)
(2)  199/   A6DE8 :                     		endif
(2)  200/   A6DE8 :                     	else;if SourceDriver>=3
(2)  201/   A6DE8 :                     		if mod==0
(2)  202/   A6DE8 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  203/   A6DE8 :                     		endif
(2)  204/   A6DE8 :                     		if SonicDriverVer==1
(2)  205/   A6DE8 :                     			dc.b	s3TempotoS1(mod)
(2)  206/   A6DE8 :                     		else;if SonicDriverVer==2
(2)  207/   A6DE8 :                     			dc.b	s3TempotoS2(mod)
(2)  208/   A6DE8 :                     		endif
(2)  209/   A6DE8 :                     	endif
(2)  210/   A6DE8 :                     	endm
(2)  211/   A6DE8 :                     
(2)  212/   A6DE8 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  213/   A6DE8 :                     PSGPitchConvert macro pitch
(2)  214/   A6DE8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  215/   A6DE8 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  216/   A6DE8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  217/   A6DE8 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  218/   A6DE8 :                     	else
(2)  219/   A6DE8 :                     		dc.b	pitch
(2)  220/   A6DE8 :                     	endif
(2)  221/   A6DE8 :                     	endm
(2)  222/   A6DE8 :                     
(2)  223/   A6DE8 :                     CheckedChannelPointer macro loc
(2)  224/   A6DE8 :                     	if SonicDriverVer<>1
(2)  225/   A6DE8 :                     		dc.w	z80_ptr(loc)
(2)  226/   A6DE8 :                     	else
(2)  227/   A6DE8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  228/   A6DE8 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  229/   A6DE8 :                     		endif
(2)  230/   A6DE8 :                     		dc.w	loc-songStart
(2)  231/   A6DE8 :                     	endif
(2)  232/   A6DE8 :                     	endm
(2)  233/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)  234/   A6DE8 :                     ; Header Macros
(2)  235/   A6DE8 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  236/   A6DE8 :                     
(2)  237/   A6DE8 :                     SourceDriver set ver
(2)  238/   A6DE8 :                     
(2)  239/   A6DE8 :                     	if ("sourcesmps2asmver"<>"")
(2)  240/   A6DE8 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  241/   A6DE8 :                     	else
(2)  242/   A6DE8 :                     		set SourceSMPS2ASM,0
(2)  243/   A6DE8 :                     	endif
(2)  244/   A6DE8 :                     
(2)  245/   A6DE8 :                     songStart set *
(2)  246/   A6DE8 :                     
(2)  247/   A6DE8 :                     	if MOMPASS=1
(2)  248/   A6DE8 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  249/   A6DE8 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  250/   A6DE8 :                     		endif
(2)  251/   A6DE8 :                     	endif
(2)  252/   A6DE8 :                     
(2)  253/   A6DE8 :                     	endm
(2)  254/   A6DE8 :                     
(2)  255/   A6DE8 :                     smpsHeaderVoiceNull macro
(2)  256/   A6DE8 :                     	if songStart<>*
(2)  257/   A6DE8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  258/   A6DE8 :                     	endif
(2)  259/   A6DE8 :                     	dc.w	$0000
(2)  260/   A6DE8 :                     	endm
(2)  261/   A6DE8 :                     
(2)  262/   A6DE8 :                     ; Header - Set up Voice Location
(2)  263/   A6DE8 :                     ; Common to music and SFX
(2)  264/   A6DE8 :                     smpsHeaderVoice macro loc
(2)  265/   A6DE8 :                     	if songStart<>*
(2)  266/   A6DE8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  267/   A6DE8 :                     	endif
(2)  268/   A6DE8 :                     	if SonicDriverVer<>1
(2)  269/   A6DE8 :                     		dc.w	z80_ptr(loc)
(2)  270/   A6DE8 :                     	else
(2)  271/   A6DE8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  272/   A6DE8 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  273/   A6DE8 :                     		endif
(2)  274/   A6DE8 :                     		dc.w	loc-songStart
(2)  275/   A6DE8 :                     	endif
(2)  276/   A6DE8 :                     	endm
(2)  277/   A6DE8 :                     
(2)  278/   A6DE8 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  279/   A6DE8 :                     ; Common to music and SFX
(2)  280/   A6DE8 :                     smpsHeaderVoiceUVB macro
(2)  281/   A6DE8 :                     	if songStart<>*
(2)  282/   A6DE8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  283/   A6DE8 :                     	endif
(2)  284/   A6DE8 :                     	if SonicDriverVer>=5
(2)  285/   A6DE8 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  286/   A6DE8 :                     	elseif SonicDriverVer>=3
(2)  287/   A6DE8 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  288/   A6DE8 :                     	else
(2)  289/   A6DE8 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  290/   A6DE8 :                     	endif
(2)  291/   A6DE8 :                     	endm
(2)  292/   A6DE8 :                     
(2)  293/   A6DE8 :                     ; Header macros for music (not for SFX)
(2)  294/   A6DE8 :                     ; Header - Set up Channel Usage
(2)  295/   A6DE8 :                     smpsHeaderChan macro fm,psg
(2)  296/   A6DE8 :                     	dc.b	fm,psg
(2)  297/   A6DE8 :                     	endm
(2)  298/   A6DE8 :                     
(2)  299/   A6DE8 :                     ; Header - Set up Tempo
(2)  300/   A6DE8 :                     smpsHeaderTempo macro div,mod
(2)  301/   A6DE8 :                     	dc.b	div
(2)  302/   A6DE8 :                     	convertMainTempoMod mod
(2)  303/   A6DE8 :                     	endm
(2)  304/   A6DE8 :                     
(2)  305/   A6DE8 :                     ; Header - Set up DAC Channel
(2)  306/   A6DE8 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  307/   A6DE8 :                     	CheckedChannelPointer loc
(2)  308/   A6DE8 :                     	if ("pitch"<>"")
(2)  309/   A6DE8 :                     		dc.b	pitch
(2)  310/   A6DE8 :                     		if ("vol"<>"")
(2)  311/   A6DE8 :                     			dc.b	vol
(2)  312/   A6DE8 :                     		else
(2)  313/   A6DE8 :                     			dc.b	$00
(2)  314/   A6DE8 :                     		endif
(2)  315/   A6DE8 :                     	else
(2)  316/   A6DE8 :                     		dc.w	$00
(2)  317/   A6DE8 :                     	endif
(2)  318/   A6DE8 :                     	endm
(2)  319/   A6DE8 :                     
(2)  320/   A6DE8 :                     ; Header - Set up FM Channel
(2)  321/   A6DE8 :                     smpsHeaderFM macro loc,pitch,vol
(2)  322/   A6DE8 :                     	CheckedChannelPointer loc
(2)  323/   A6DE8 :                     	dc.b	pitch,vol
(2)  324/   A6DE8 :                     	endm
(2)  325/   A6DE8 :                     
(2)  326/   A6DE8 :                     ; Header - Set up PSG Channel
(2)  327/   A6DE8 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  328/   A6DE8 :                     	CheckedChannelPointer loc
(2)  329/   A6DE8 :                     	PSGPitchConvert pitch
(2)  330/   A6DE8 :                     	dc.b	vol
(2)  331/   A6DE8 :                     	; Frequency envelope
(2)  332/   A6DE8 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  333/   A6DE8 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  334/   A6DE8 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  335/   A6DE8 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  336/   A6DE8 :                     		dc.b	0
(2)  337/   A6DE8 :                     	else
(2)  338/   A6DE8 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  339/   A6DE8 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  340/   A6DE8 :                     		endif
(2)  341/   A6DE8 :                     		dc.b	mod
(2)  342/   A6DE8 :                     	endif
(2)  343/   A6DE8 :                     	; Volume envelope
(2)  344/   A6DE8 :                     	dc.b	voice
(2)  345/   A6DE8 :                     	endm
(2)  346/   A6DE8 :                     
(2)  347/   A6DE8 :                     ; Header macros for SFX (not for music)
(2)  348/   A6DE8 :                     ; Header - Set up Tempo
(2)  349/   A6DE8 :                     smpsHeaderTempoSFX macro div
(2)  350/   A6DE8 :                     	dc.b	div
(2)  351/   A6DE8 :                     	endm
(2)  352/   A6DE8 :                     
(2)  353/   A6DE8 :                     ; Header - Set up Channel Usage
(2)  354/   A6DE8 :                     smpsHeaderChanSFX macro chan
(2)  355/   A6DE8 :                     	dc.b	chan
(2)  356/   A6DE8 :                     	endm
(2)  357/   A6DE8 :                     
(2)  358/   A6DE8 :                     ; Header - Set up FM Channel
(2)  359/   A6DE8 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  360/   A6DE8 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  361/   A6DE8 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  362/   A6DE8 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  363/   A6DE8 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  364/   A6DE8 :                     	endif
(2)  365/   A6DE8 :                     	dc.b	$80,chanid
(2)  366/   A6DE8 :                     	CheckedChannelPointer loc
(2)  367/   A6DE8 :                     	if (chanid&$80)<>0
(2)  368/   A6DE8 :                     		PSGPitchConvert pitch
(2)  369/   A6DE8 :                     	else
(2)  370/   A6DE8 :                     		dc.b	pitch
(2)  371/   A6DE8 :                     	endif
(2)  372/   A6DE8 :                     	dc.b	vol
(2)  373/   A6DE8 :                     	endm
(2)  374/   A6DE8 :                     ; ---------------------------------------------------------------------------
(2)  375/   A6DE8 :                     ; Co-ord Flag Macros and Equates
(2)  376/   A6DE8 :                     ; E0xx - Panning, AMS, FMS
(2)  377/   A6DE8 :                     smpsPan macro direction,amsfms
(2)  378/   A6DE8 :                     panNone set $00
(2)  379/   A6DE8 :                     panRight set $40
(2)  380/   A6DE8 :                     panLeft set $80
(2)  381/   A6DE8 :                     panCentre set $C0
(2)  382/   A6DE8 :                     panCenter set $C0 ; silly Americans :U
(2)  383/   A6DE8 :                     	dc.b $E0,direction+amsfms
(2)  384/   A6DE8 :                     	endm
(2)  385/   A6DE8 :                     
(2)  386/   A6DE8 :                     ; E1xx - Set channel detune to val
(2)  387/   A6DE8 :                     smpsDetune macro val
(2)  388/   A6DE8 :                     	dc.b	$E1,val
(2)  389/   A6DE8 :                     	endm
(2)  390/   A6DE8 :                     
(2)  391/   A6DE8 :                     ; E2xx - Useless
(2)  392/   A6DE8 :                     smpsNop macro val
(2)  393/   A6DE8 :                     	if SonicDriverVer<3
(2)  394/   A6DE8 :                     		dc.b	$E2,val
(2)  395/   A6DE8 :                     	endif
(2)  396/   A6DE8 :                     	endm
(2)  397/   A6DE8 :                     
(2)  398/   A6DE8 :                     ; Return (used after smpsCall)
(2)  399/   A6DE8 :                     smpsReturn macro val
(2)  400/   A6DE8 :                     	if SonicDriverVer>=3
(2)  401/   A6DE8 :                     		dc.b	$F9
(2)  402/   A6DE8 :                     	else
(2)  403/   A6DE8 :                     		dc.b	$E3
(2)  404/   A6DE8 :                     	endif
(2)  405/   A6DE8 :                     	endm
(2)  406/   A6DE8 :                     
(2)  407/   A6DE8 :                     ; Fade in previous song (ie. 1-Up)
(2)  408/   A6DE8 :                     smpsFade macro val
(2)  409/   A6DE8 :                     	if SonicDriverVer>=3
(2)  410/   A6DE8 :                     		dc.b	$E2
(2)  411/   A6DE8 :                     		if ("val"<>"")
(2)  412/   A6DE8 :                     			dc.b	val
(2)  413/   A6DE8 :                     		else
(2)  414/   A6DE8 :                     			dc.b	$FF
(2)  415/   A6DE8 :                     		endif
(2)  416/   A6DE8 :                     		if SourceDriver<3
(2)  417/   A6DE8 :                     			smpsStop
(2)  418/   A6DE8 :                     		endif
(2)  419/   A6DE8 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  420/   A6DE8 :                     		; This is one of those weird S3+ "fades" that we don't need
(2)  421/   A6DE8 :                     	else
(2)  422/   A6DE8 :                     		dc.b	$E4
(2)  423/   A6DE8 :                     	endif
(2)  424/   A6DE8 :                     	endm
(2)  425/   A6DE8 :                     
(2)  426/   A6DE8 :                     ; E5xx - Set channel tempo divider to xx
(2)  427/   A6DE8 :                     smpsChanTempoDiv macro val
(2)  428/   A6DE8 :                     	if SonicDriverVer>=5
(2)  429/   A6DE8 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  430/   A6DE8 :                     		dc.b	$FF,$08,val
(2)  431/   A6DE8 :                     	elseif SonicDriverVer==3
(2)  432/   A6DE8 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  433/   A6DE8 :                     	else
(2)  434/   A6DE8 :                     		dc.b	$E5,val
(2)  435/   A6DE8 :                     	endif
(2)  436/   A6DE8 :                     	endm
(2)  437/   A6DE8 :                     
(2)  438/   A6DE8 :                     ; E6xx - Alter Volume by xx
(2)  439/   A6DE8 :                     smpsAlterVol macro val
(2)  440/   A6DE8 :                     	dc.b	$E6,val
(2)  441/   A6DE8 :                     	endm
(2)  442/   A6DE8 :                     
(2)  443/   A6DE8 :                     ; E7 - Prevent attack of next note
(2)  444/   A6DE8 : =$E7                 smpsNoAttack	EQU $E7
(2)  445/   A6DE8 :                     
(2)  446/   A6DE8 :                     ; E8xx - Set note fill to xx
(2)  447/   A6DE8 :                     smpsNoteFill macro val
(2)  448/   A6DE8 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  449/   A6DE8 :                     		; Unique to Flamewing's modified driver
(2)  450/   A6DE8 :                     		dc.b	$FF,$0A,val
(2)  451/   A6DE8 :                     	else
(2)  452/   A6DE8 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  453/   A6DE8 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  454/   A6DE8 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  455/   A6DE8 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  456/   A6DE8 :                     		endif
(2)  457/   A6DE8 :                     		dc.b	$E8,val
(2)  458/   A6DE8 :                     	endif
(2)  459/   A6DE8 :                     	endm
(2)  460/   A6DE8 :                     
(2)  461/   A6DE8 :                     ; Add xx to channel pitch
(2)  462/   A6DE8 :                     smpsChangeTransposition macro val
(2)  463/   A6DE8 :                     	if SonicDriverVer>=3
(2)  464/   A6DE8 :                     		dc.b	$FB,val
(2)  465/   A6DE8 :                     	else
(2)  466/   A6DE8 :                     		dc.b	$E9,val
(2)  467/   A6DE8 :                     	endif
(2)  468/   A6DE8 :                     	endm
(2)  469/   A6DE8 :                     
(2)  470/   A6DE8 :                     ; Set music tempo modifier to xx
(2)  471/   A6DE8 :                     smpsSetTempoMod macro mod
(2)  472/   A6DE8 :                     	if SonicDriverVer>=3
(2)  473/   A6DE8 :                     		dc.b	$FF,$00
(2)  474/   A6DE8 :                     	else
(2)  475/   A6DE8 :                     		dc.b	$EA
(2)  476/   A6DE8 :                     	endif
(2)  477/   A6DE8 :                     	convertMainTempoMod mod
(2)  478/   A6DE8 :                     	endm
(2)  479/   A6DE8 :                     
(2)  480/   A6DE8 :                     ; Set music tempo divider to xx
(2)  481/   A6DE8 :                     smpsSetTempoDiv macro val
(2)  482/   A6DE8 :                     	if SonicDriverVer>=3
(2)  483/   A6DE8 :                     		dc.b	$FF,$04,val
(2)  484/   A6DE8 :                     	else
(2)  485/   A6DE8 :                     		dc.b	$EB,val
(2)  486/   A6DE8 :                     	endif
(2)  487/   A6DE8 :                     	endm
(2)  488/   A6DE8 :                     
(2)  489/   A6DE8 :                     ; ECxx - Set Volume to xx
(2)  490/   A6DE8 :                     smpsSetVol macro val
(2)  491/   A6DE8 :                     	if SonicDriverVer>=3
(2)  492/   A6DE8 :                     		dc.b	$E4,val
(2)  493/   A6DE8 :                     	else
(2)  494/   A6DE8 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  495/   A6DE8 :                     	endif
(2)  496/   A6DE8 :                     	endm
(2)  497/   A6DE8 :                     
(2)  498/   A6DE8 :                     ; Works on all drivers
(2)  499/   A6DE8 :                     smpsPSGAlterVol macro vol
(2)  500/   A6DE8 :                     	dc.b	$EC,vol
(2)  501/   A6DE8 :                     	endm
(2)  502/   A6DE8 :                     
(2)  503/   A6DE8 :                     smpsPSGAlterVolS2 macro vol
(2)  504/   A6DE8 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  505/   A6DE8 :                     	if SonicDriverVer==2
(2)  506/   A6DE8 :                     		smpsAlterVol vol
(2)  507/   A6DE8 :                     	else
(2)  508/   A6DE8 :                     		smpsPSGAlterVol vol
(2)  509/   A6DE8 :                     	endif
(2)  510/   A6DE8 :                     	endm
(2)  511/   A6DE8 :                     
(2)  512/   A6DE8 :                     ; Clears pushing sound flag in S1
(2)  513/   A6DE8 :                     smpsClearPush macro
(2)  514/   A6DE8 :                     	if SonicDriverVer==1
(2)  515/   A6DE8 :                     		dc.b	$ED
(2)  516/   A6DE8 :                     	else
(2)  517/   A6DE8 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  518/   A6DE8 :                     	endif
(2)  519/   A6DE8 :                     	endm
(2)  520/   A6DE8 :                     
(2)  521/   A6DE8 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  522/   A6DE8 :                     smpsStopSpecial macro
(2)  523/   A6DE8 :                     	if SonicDriverVer==1
(2)  524/   A6DE8 :                     		dc.b	$EE
(2)  525/   A6DE8 :                     	else
(2)  526/   A6DE8 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  527/   A6DE8 :                     		smpsStop
(2)  528/   A6DE8 :                     	endif
(2)  529/   A6DE8 :                     	endm
(2)  530/   A6DE8 :                     
(2)  531/   A6DE8 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  532/   A6DE8 :                     smpsFMvoice macro voice,songID
(2)  533/   A6DE8 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  534/   A6DE8 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  535/   A6DE8 :                     	else
(2)  536/   A6DE8 :                     		dc.b	$EF,voice
(2)  537/   A6DE8 :                     	endif
(2)  538/   A6DE8 :                     	endm
(2)  539/   A6DE8 :                     
(2)  540/   A6DE8 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  541/   A6DE8 :                     smpsModSet macro wait,speed,change,step
(2)  542/   A6DE8 :                     	dc.b	$F0
(2)  543/   A6DE8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  544/   A6DE8 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  545/   A6DE8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  546/   A6DE8 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  547/   A6DE8 :                     	else
(2)  548/   A6DE8 :                     		dc.b	wait,speed,change,step
(2)  549/   A6DE8 :                     	endif
(2)  550/   A6DE8 :                     	;dc.b	speed,change,step
(2)  551/   A6DE8 :                     	endm
(2)  552/   A6DE8 :                     
(2)  553/   A6DE8 :                     ; Turn on Modulation
(2)  554/   A6DE8 :                     smpsModOn macro type
(2)  555/   A6DE8 :                     	if SonicDriverVer>=3
(2)  556/   A6DE8 :                     		if "type"<>""
(2)  557/   A6DE8 :                     			dc.b	$F4,type
(2)  558/   A6DE8 :                     		else
(2)  559/   A6DE8 :                     			dc.b	$F4,$80
(2)  560/   A6DE8 :                     		endif
(2)  561/   A6DE8 :                     	else
(2)  562/   A6DE8 :                     		dc.b	$F1
(2)  563/   A6DE8 :                     	endif
(2)  564/   A6DE8 :                     	endm
(2)  565/   A6DE8 :                     
(2)  566/   A6DE8 :                     ; F2 - End of channel
(2)  567/   A6DE8 :                     smpsStop macro
(2)  568/   A6DE8 :                     	dc.b	$F2
(2)  569/   A6DE8 :                     	endm
(2)  570/   A6DE8 :                     
(2)  571/   A6DE8 :                     ; F3xx - PSG waveform to xx
(2)  572/   A6DE8 :                     smpsPSGform macro form
(2)  573/   A6DE8 :                     	dc.b	$F3,form
(2)  574/   A6DE8 :                     	endm
(2)  575/   A6DE8 :                     
(2)  576/   A6DE8 :                     ; Turn off Modulation
(2)  577/   A6DE8 :                     smpsModOff macro
(2)  578/   A6DE8 :                     	if SonicDriverVer>=3
(2)  579/   A6DE8 :                     		dc.b	$FA
(2)  580/   A6DE8 :                     	else
(2)  581/   A6DE8 :                     		dc.b	$F4
(2)  582/   A6DE8 :                     	endif
(2)  583/   A6DE8 :                     	endm
(2)  584/   A6DE8 :                     
(2)  585/   A6DE8 :                     ; F5xx - PSG voice to xx
(2)  586/   A6DE8 :                     smpsPSGvoice macro voice
(2)  587/   A6DE8 :                     	dc.b	$F5,voice
(2)  588/   A6DE8 :                     	endm
(2)  589/   A6DE8 :                     
(2)  590/   A6DE8 :                     ; F6xxxx - Jump to xxxx
(2)  591/   A6DE8 :                     smpsJump macro loc
(2)  592/   A6DE8 :                     	dc.b	$F6
(2)  593/   A6DE8 :                     	if SonicDriverVer<>1
(2)  594/   A6DE8 :                     		dc.w	z80_ptr(loc)
(2)  595/   A6DE8 :                     	else
(2)  596/   A6DE8 :                     		dc.w	loc-*-1
(2)  597/   A6DE8 :                     	endif
(2)  598/   A6DE8 :                     	endm
(2)  599/   A6DE8 :                     
(2)  600/   A6DE8 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  601/   A6DE8 :                     smpsLoop macro index,loops,loc
(2)  602/   A6DE8 :                     	dc.b	$F7
(2)  603/   A6DE8 :                     	dc.b	index,loops
(2)  604/   A6DE8 :                     	if SonicDriverVer<>1
(2)  605/   A6DE8 :                     		dc.w	z80_ptr(loc)
(2)  606/   A6DE8 :                     	else
(2)  607/   A6DE8 :                     		dc.w	loc-*-1
(2)  608/   A6DE8 :                     	endif
(2)  609/   A6DE8 :                     	endm
(2)  610/   A6DE8 :                     
(2)  611/   A6DE8 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  612/   A6DE8 :                     smpsCall macro loc
(2)  613/   A6DE8 :                     	dc.b	$F8
(2)  614/   A6DE8 :                     	if SonicDriverVer<>1
(2)  615/   A6DE8 :                     		dc.w	z80_ptr(loc)
(2)  616/   A6DE8 :                     	else
(2)  617/   A6DE8 :                     		dc.w	loc-*-1
(2)  618/   A6DE8 :                     	endif
(2)  619/   A6DE8 :                     	endm
