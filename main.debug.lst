(2)  736/   1DAAE :                     ; S1/S2 only coordination flag
(2)  737/   1DAAE :                     ; Sets D1L to maximum volume (minimum attenuation) and RR to maximum for operators 3 and 4 of FM1
(2)  738/   1DAAE :                     smpsMaxRelRate macro
(2)  739/   1DAAE :                     	if SonicDriverVer>=3
(2)  740/   1DAAE :                     		; Emulate it in S3/S&K/S3D driver
(2)  741/   1DAAE :                     		smpsFMICommand $88,$0F
(2)  742/   1DAAE :                     		smpsFMICommand $8C,$0F
(2)  743/   1DAAE :                     	else
(2)  744/   1DAAE :                     		dc.b	$F9
(2)  745/   1DAAE :                     	endif
(2)  746/   1DAAE :                     	endm
