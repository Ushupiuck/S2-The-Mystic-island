(1)  102/   A4492 :                     ; ---------------------------------------------------------------------------
(1)  103/   A4492 :                     ; Priority of sound. New music or SFX must have a priority higher than or equal
(1)  104/   A4492 :                     ; to what is stored in v_sndprio or it won't play. If bit 7 of new priority is
(1)  105/   A4492 :                     ; set ($80 and up), the new music or SFX will not set its priority -- meaning
(1)  106/   A4492 :                     ; any music or SFX can override it (as long as it can override whatever was
(1)  107/   A4492 :                     ; playing before). Usually, SFX will only override SFX, special SFX ($D0-$DF)
(1)  108/   A4492 :                     ; will only override special SFX and music will only override music.
(1)  109/   A4492 :                     ; ---------------------------------------------------------------------------
(1)  110/   A4492 :                     ; SoundTypes:
(1)  111/   A4492 :                     SoundPriorities:
(1)  112/   A4492 : 9090 9090 9090      		dc.b     $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $81
            A4498 : 9090 9090 9090 
            A449E : 9090 90          
(1)  113/   A44A1 : 9090 9090 9090      		dc.b $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $90
            A44A7 : 9090 9090 9090 
            A44AD : 9090 9090          
(1)  114/   A44B1 : 8070 7070 7070      		dc.b $80,$70,$70,$70,$70,$70,$70,$70,$70,$70,$68,$70,$70,$70,$60,$70	; $A0
