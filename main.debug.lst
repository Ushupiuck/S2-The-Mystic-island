(2)  870/   A6FA4 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  871/   A6FA4 :                     	set vcRR1,op1
(2)  872/   A6FA4 :                     	set vcRR2,op2
(2)  873/   A6FA4 :                     	set vcRR3,op3
(2)  874/   A6FA4 :                     	set vcRR4,op4
(2)  875/   A6FA4 :                     	endm
(2)  876/   A6FA4 :                     
(2)  877/   A6FA4 :                     ; Voices - Total Level
(2)  878/   A6FA4 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  879/   A6FA4 :                     ; but later versions leave it up to the user.
(2)  880/   A6FA4 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  881/   A6FA4 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  882/   A6FA4 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  883/   A6FA4 :                     ; SMPS Z80 does the opposite.
(2)  884/   A6FA4 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  885/   A6FA4 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  886/   A6FA4 :                     ; what we do, so we just print a warning.
(2)  887/   A6FA4 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  888/   A6FA4 :                     	set vcTL1,op1
(2)  889/   A6FA4 :                     	set vcTL2,op2
(2)  890/   A6FA4 :                     	set vcTL3,op3
(2)  891/   A6FA4 :                     	set vcTL4,op4
(2)  892/   A6FA4 :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  893/   A6FA4 :                     ;   0     1     2     3     4     5     6     7
(2)  894/   A6FA4 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  895/   A6FA4 :                     	if SourceSMPS2ASM==0
(2)  896/   A6FA4 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  897/   A6FA4 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  898/   A6FA4 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  899/   A6FA4 :                     		set vcTLMask1,$80
(2)  900/   A6FA4 :                     	else
(2)  901/   A6FA4 :                     		set vcTLMask4,0
(2)  902/   A6FA4 :                     		set vcTLMask3,0
(2)  903/   A6FA4 :                     		set vcTLMask2,0
(2)  904/   A6FA4 :                     		set vcTLMask1,0
(2)  905/   A6FA4 :                     	endif
(2)  906/   A6FA4 :                     
(2)  907/   A6FA4 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  908/   A6FA4 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  909/   A6FA4 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  910/   A6FA4 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  911/   A6FA4 :                     		set vcTLMask1,$80
(2)  912/   A6FA4 :                     		set vcTL1,vcTL1&$7F
(2)  913/   A6FA4 :                     		set vcTL2,vcTL2&$7F
(2)  914/   A6FA4 :                     		set vcTL3,vcTL3&$7F
(2)  915/   A6FA4 :                     		set vcTL4,vcTL4&$7F
(2)  916/   A6FA4 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&$80)<>$80)||(((vcTL2|vcTLMask2)&$80)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&$80)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&$80)<>((vcAlgorithm==7)<<7)))
(2)  917/   A6FA4 :                     		if MOMPASS=1
(2)  918/   A6FA4 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  919/   A6FA4 :                     		endif
(2)  920/   A6FA4 :                     	endif
(2)  921/   A6FA4 :                     
(2)  922/   A6FA4 :                     	if SonicDriverVer==2
(2)  923/   A6FA4 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  924/   A6FA4 :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  925/   A6FA4 :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  926/   A6FA4 :                     		dc.b	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  927/   A6FA4 :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  928/   A6FA4 :                     		dc.b	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  929/   A6FA4 :                     	else
(2)  930/   A6FA4 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  931/   A6FA4 :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  932/   A6FA4 :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  933/   A6FA4 :                     		dc.b	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  934/   A6FA4 :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  935/   A6FA4 :                     		dc.b	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  936/   A6FA4 :                     	endif
(2)  937/   A6FA4 :                     	endm
