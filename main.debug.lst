(2)    5/   A72DE : [5]                                  endif
(2)    5/   A72DE : =>FALSE                      elseif SourceDriver==2
(2)    5/   A72DE :                                     if $03==0
(2)    5/   A72DE :                                             fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)    5/   A72DE : [5]                                  endif
