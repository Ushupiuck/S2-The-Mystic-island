     983/    1364 : 283C 0080 0000      		move.l	#$800000,d4
     984/    136A :                     
     985/    136A :                     PlaneMapToVRAM_H40_LineLoop:
     986/    136A : 2D40 0004           		move.l	d0,4(a6)
     987/    136E : 3601                		move.w	d1,d3
     988/    1370 :                     
     989/    1370 :                     PlaneMapToVRAM_H40_TileLoop:
     990/    1370 : 3C99                		move.w	(a1)+,(a6)
     991/    1372 : 51CB FFFC           		dbf	d3,PlaneMapToVRAM_H40_TileLoop
     992/    1376 : D084                		add.l	d4,d0
     993/    1378 : 51CA FFF0           		dbf	d2,PlaneMapToVRAM_H40_LineLoop
