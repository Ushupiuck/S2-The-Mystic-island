    9048/    D5D0 :                     ; Subroutine to make an object move and fall downward increasingly fast
    9049/    D5D0 :                     ; This moves the object horizontally and vertically
    9050/    D5D0 :                     ; and also applies gravity to its speed
    9051/    D5D0 :                     ; ---------------------------------------------------------------------------
    9052/    D5D0 :                     
    9053/    D5D0 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    9054/    D5D0 :                     
    9055/    D5D0 :                     ObjectFall:
    9056/    D5D0 :                     ObjectMoveAndFall:
    9057/    D5D0 : 3028 0010           		move.w	obVelX(a0),d0	; load x speed
    9058/    D5D4 : 48C0                		ext.l	d0
    9059/    D5D6 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9060/    D5D8 : D1A8 0008           		add.l	d0,obX(a0)	; add x speed to x position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
    9061/    D5DC : 3028 0012           		move.w	obVelY(a0),d0	; load y speed
    9062/    D5E0 : 0668 0038 0012      		addi.w	#$38,obVelY(a0)	; increase vertical speed (apply gravity)
    9063/    D5E6 : 48C0                		ext.l	d0
    9064/    D5E8 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9065/    D5EA : D1A8 000C           		add.l	d0,obY(a0)	; add old y speed to y position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
    9066/    D5EE : 4E75                		rts
    9067/    D5F0 :                     ; End of function ObjectMoveAndFall
    9068/    D5F0 :                     
    9069/    D5F0 :                     ; ---------------------------------------------------------------------------
    9070/    D5F0 :                     ; Subroutine translating object speed to update object position
    9071/    D5F0 :                     ; This moves the object horizontally and vertically
    9072/    D5F0 :                     ; but does not apply gravity to it
    9073/    D5F0 :                     ; ---------------------------------------------------------------------------
    9074/    D5F0 :                     
    9075/    D5F0 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    9076/    D5F0 :                     
    9077/    D5F0 :                     ObjectMove:
    9078/    D5F0 :                     SpeedToPos:
    9079/    D5F0 : 3028 0010           		move.w	obVelX(a0),d0	; load horizontal speed
    9080/    D5F4 : 48C0                		ext.l	d0
    9081/    D5F6 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9082/    D5F8 : D1A8 0008           		add.l	d0,obX(a0)	; add to x-axis position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
    9083/    D5FC : 3028 0012           		move.w	obVelY(a0),d0	; load vertical speed
    9084/    D600 : 48C0                		ext.l	d0
    9085/    D602 : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9086/    D604 : D1A8 000C           		add.l	d0,obY(a0)	; add to y-axis position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
    9087/    D608 : 4E75                		rts
    9088/    D60A :                     ; End of function ObjectMove
