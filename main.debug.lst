(1)  271/       0 :                     ; ---------------------------------------------------------------
(1)  272/       0 :                     ; Console interface
(1)  273/       0 :                     ; ---------------------------------------------------------------
(1)  274/       0 :                     ; EXAMPLES:
(1)  275/       0 :                     ;	Console.Run	YourConsoleProgram
(1)  276/       0 :                     ;	Console.Write "Hello "
(1)  277/       0 :                     ;	Console.WriteLine "...world!"
(1)  278/       0 :                     ;	Console.WriteLine "Your data is %<.b d0>"
