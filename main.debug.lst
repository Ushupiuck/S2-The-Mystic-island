(2)    5/   A72DE :                                     else;if SonicDriverVer>=3
(2)    5/   A72DE :                                             dc.b    s2TempotoS3($03)
(2)    5/   A72DE : [5]                                  endif
(2)    5/   A72DE : =>FALSE                      else;if SourceDriver>=3
(2)    5/   A72DE :                                     if $03==0
