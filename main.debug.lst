(1)  302/       0 :                     		move.w	(sp)+, sr
(1)  303/       0 :                     	endcase
(1)  304/       0 :                     	endm
(1)  305/       0 :                     
(1)  306/       0 :                     ; Same as "Console", but doesn't save/restore CCR (can be used to save a few cycles)
(1)  307/       0 :                     _Console:	macro	argument1, argument2
(1)  308/       0 :                     	switch lowstring("ATTRIBUTE")
(1)  309/       0 :                     	case "write"
