    1259/    167A :                     		include "_inc/DMA Queue.asm"
(1)    1/    167A :                     ; ---------------------------------------------------------------------------
(1)    2/    167A :                     ; MACRO ResetDMAQueue
(1)    3/    167A :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    167A :                     ; ---------------------------------------------------------------------------
(1)    5/    167A :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    167A :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    167A :                     ;
(1)    8/    167A :                     ; Output:
(1)    9/    167A :                     ; 	a1,a5	trashed
(1)   10/    167A :                     ; ---------------------------------------------------------------------------
(1)   11/    167A :                     ; ROUTINE InitDMAQueue
(1)   12/    167A :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    167A :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    167A :                     ; write to this region of RAM.
(1)   15/    167A :                     ;
(1)   16/    167A :                     ; Output:
(1)   17/    167A :                     ; 	a0,d0,d1	trashed
(1)   18/    167A :                     ; ---------------------------------------------------------------------------
(1)   19/    167A :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    167A :                     ; Queues a DMA with parameters given in registers.
(1)   21/    167A :                     ;
(1)   22/    167A :                     ; Options:
(1)   23/    167A :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    167A :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    167A :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    167A :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    167A :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    167A :                     ; Input:
(1)   29/    167A :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    167A :                     ; 		set to 0)
(1)   31/    167A :                     ; 	d2	Destination address
(1)   32/    167A :                     ; 	d3	Transfer length (in words)
(1)   33/    167A :                     ; Output:
(1)   34/    167A :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    167A :                     ;
(1)   36/    167A :                     ; With the default settings, runs in:
(1)   37/    167A :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    167A :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    167A :                     ;
(1)   40/    167A :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    167A :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    167A :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    167A :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    167A :                     ;   fills the queue (second piece is discarded)
(1)   45/    167A :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    167A :                     ;   space for both pieces (both pieces queued)
(1)   47/    167A :                     ;
(1)   48/    167A :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    167A :                     ;
(1)   50/    167A :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    167A :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    167A :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    167A :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    167A :                     ;
(1)   55/    167A :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    167A :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    167A :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    167A :                     ; in the correct form.
(1)   59/    167A :                     ; ---------------------------------------------------------------------------
(1)   60/    167A :                     ; MACRO QueueStaticDMA
(1)   61/    167A :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    167A :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    167A :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    167A :                     ;
(1)   65/    167A :                     ; The destination parameter can be either:
(1)   66/    167A :                     ; * a VRAM address literal;
(1)   67/    167A :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    167A :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    167A :                     ;
(1)   70/    167A :                     ; Options:
(1)   71/    167A :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    167A :                     ; Input:
(1)   73/    167A :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    167A :                     ; Output:
(1)   75/    167A :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    167A :                     ;
(1)   77/    167A :                     ; With the default settings, runs in:
(1)   78/    167A :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    167A :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    167A :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    167A :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    167A :                     ;
(1)   83/    167A :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    167A :                     ; ===========================================================================
(1)   85/    167A :                     ; option: AssumeSourceAddressInBytes
(1)   86/    167A :                     ;
(1)   87/    167A :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    167A :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    167A :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    167A : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    167A :                     ; ===========================================================================
(1)   92/    167A :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    167A :                     ;
(1)   94/    167A :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    167A :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    167A :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    167A :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    167A : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    167A :                     ; ===========================================================================
(1)  100/    167A :                     ; option: UseRAMSourceSafeDMA
(1)  101/    167A :                     ;
(1)  102/    167A :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    167A :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    167A :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    167A : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    167A :                     ; ===========================================================================
(1)  107/    167A :                     ; option: Use128kbSafeDMA
(1)  108/    167A :                     ;
(1)  109/    167A :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    167A :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    167A :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    167A :                     ; the job in situations where you can't align it in ROM.
(1)  113/    167A : =$1                  Use128kbSafeDMA = 1
(1)  114/    167A :                     ; ===========================================================================
(1)  115/    167A :                     ; option UseVIntSafeDMA
(1)  116/    167A :                     ;
(1)  117/    167A :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    167A :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    167A :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    167A :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    167A :                     ; restore interrupts after.
(1)  122/    167A : =$1                  UseVIntSafeDMA = 1
(1)  123/    167A :                     ; ===========================================================================
(1)  124/    167A :                     ; Convenience macros, for increased maintainability of the code.
(1)  125/    167A : =>DEFINED            	ifndef DMA
(1)  126/    167A :                     		equ	DMA,%100111
(1)  127/    167A : [125]                	endif
(1)  128/    167A : =>DEFINED            	ifndef VRAM
(1)  129/    167A :                     		equ	VRAM,%100001
(1)  130/    167A : [128]                	endif
(1)  131/    167A : =>UNDEFINED          	ifndef vdpCommReg_defined
(1)  132/    167A :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    167A : =$1                  vdpCommReg_defined = 1
(1)  134/    167A :                     vdpCommReg macro reg,type,rwd,clr
(1)  135/    167A :                     	lsl.l	#2,reg							; Move high bits into (word-swapped) position, accidentally moving everything else
(1)  136/    167A :                     	set .upperbits,(type&rwd)&3
(1)  137/    167A :                     	if .upperbits<>0
(1)  138/    167A :                     		addq.w	#.upperbits,reg				; Add upper access type bits
(1)  139/    167A :                     	endif
(1)  140/    167A :                     	ror.w	#2,reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
(1)  141/    167A :                     	swap	reg								; Put all bits in proper places
(1)  142/    167A :                     	if clr <> 0
(1)  143/    167A :                     		andi.w	#3,reg						; Strip whatever junk was in upper word of reg
(1)  144/    167A :                     	endif
(1)  145/    167A :                     	set .lowerbits,(type&rwd)&$FC
(1)  146/    167A :                     	if .lowerbits==$20
(1)  147/    167A :                     		tas.b	reg							; Add in the DMA flag -- tas fails on memory, but works on registers
(1)  148/    167A :                     	elseif .lowerbits<>0
(1)  149/    167A :                     		ori.w	#(.lowerbits<<2),reg		; Add in missing access type bits
(1)  150/    167A :                     	endif
(1)  151/    167A :                     	endm
(1)  152/    167A : [131]                	endif
(1)  153/    167A :                     ; ---------------------------------------------------------------------------
