    5464/    8D9E :                     ScrollHoriz:
    5465/    8D9E : =>TRUE               	if FixBugs
    5466/    8D9E :                     		; To prevent the bug that is described below, this caps the position
    5467/    8D9E :                     		; array index offset so that it does not access position data from
    5468/    8D9E :                     		; before the spin dash was performed. Note that this required
    5469/    8D9E :                     		; modifications to 'Sonic_UpdateSpindash' and 'Tails_UpdateSpindash'.
    5470/    8D9E : 1215                		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5471/    8DA0 : 6722                		beq.s	.scrollNotDelayed				; if not, branch
    5472/    8DA2 : E509                		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5473/    8DA4 : 5315                		subq.b	#1,Horiz_scroll_delay_val-Camera_Delay(a5)	; reduce delay value
    5474/    8DA6 : 102D 0003           		move.b	Sonic_Pos_Record_Index+1-Camera_Delay(a5),d0
    5475/    8DAA : 902D 0001           		sub.b	Horiz_scroll_delay_val+1-Camera_Delay(a5),d0
    5476/    8DAE : B200                		cmp.b	d0,d1
    5477/    8DB0 : 6502                		blo.s	.doNotCap
    5478/    8DB2 : 1200                		move.b	d0,d1
    5479/    8DB4 :                     .doNotCap:
    5480/    8DB4 : =>FALSE              	else
    5481/    8DB4 :                     		; The intent of this code is to make the camera briefly lag behind the
    5482/    8DB4 :                     		; player right after releasing a spin dash, however it does this by
    5483/    8DB4 :                     		; simply making the camera use position data from previous frames. This
    5484/    8DB4 :                     		; means that if the camera had been moving recently enough, then
    5485/    8DB4 :                     		; releasing a spin dash will cause the camera to jerk around instead of
    5486/    8DB4 :                     		; remain still. This can be encountered by running into a wall, and
    5487/    8DB4 :                     		; quickly turning around and spin dashing away. Sonic 3 would have had
    5488/    8DB4 :                     		; this same issue with the Fire Shield's dash abiliity, but it shoddily
    5489/    8DB4 :                     		; works around the issue by resetting the old position values to the
    5490/    8DB4 :                     		; current position (see 'Reset_Player_Position_Array').
    5491/    8DB4 :                     		move.w	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5492/    8DB4 :                     		beq.s	.scrollNotDelayed				; if not, branch
    5493/    8DB4 :                     		subi.w	#$100,d1					; reduce delay value
    5494/    8DB4 :                     		move.w	d1,Horiz_scroll_delay_val-Camera_Delay(a5)
    5495/    8DB4 :                     		moveq	#0,d1
    5496/    8DB4 :                     		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; get delay value
    5497/    8DB4 :                     		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5498/    8DB4 :                     		addq.b	#4,d1
    5499/    8DB4 : [5465]               	endif
