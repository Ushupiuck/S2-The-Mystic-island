   10911/   11374 : D642                		add.w	d2,d3				; assume the highest position where Sonic would still be colliding with the object to be (0,0)
   10912/   11376 : 6B00 00A2           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is above this point
   10913/   1137A : 3802                		move.w	d2,d4
   10914/   1137C : D844                		add.w	d4,d4				; calculate minimum distance for a bottom collision
   10915/   1137E : B644                		cmp.w	d4,d3
