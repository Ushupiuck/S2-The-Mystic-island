    1963/    46EC :                     ; ---------------------------------------------------------------------------
    1964/    46EC :                     ; Subroutine to calculate sine and cosine of an angle
    1965/    46EC :                     ; d0 = input byte = angle (360 degrees == 256)
    1966/    46EC :                     ; d0 = output word = 255 * sine(angle)
    1967/    46EC :                     ; d1 = output word = 255 * cosine(angle)
    1968/    46EC :                     ; ---------------------------------------------------------------------------
    1969/    46EC :                     
    1970/    46EC :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1971/    46EC :                     
    1972/    46EC :                     
    1973/    46EC :                     CalcSine:
