   22575/   1B2F0 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; LZ
   22576/   1B2F2 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; LZ
   22577/   1B2F4 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; CPZ
   22578/   1B2F6 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; CPZ
