     460/     37E :   (MACRO-3)                          org (*-1+($594)-((*-1+(-(0)))#($594)))
     460/     37E : =>TRUE                       if notZ80(MOMCPU)
     460/     37E : =>FALSE                              if (*-1+($594)-((*-1+(-(0)))#($594))) < *
     460/     37E :                                             error "too much stuff before org $\{(*-1+($594)-((*-1+(-(0)))#($594)))} ($\{(*-(*-1+($594)-((*-1+(-(0)))#($594))))} bytes)"
