    1024/    13D0 :                     ; NOTICE: This subroutine does not check for buffer overruns. The programmer
    1025/    13D0 :                     ;	  (or hacker) is responsible for making sure that no more than
    1026/    13D0 :                     ;	  16 load requests are copied into the buffer.
    1027/    13D0 :                     ;    _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
    1028/    13D0 :                     ;         (or if you change the size of v_plc_buffer, the limit becomes (v_plc_buffer_Only_End-v_plc_buffer)/6)
    1029/    13D0 :                     
