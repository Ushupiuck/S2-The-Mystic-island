    9554/    D9B8 :                     DrawSprite_Loop:
    9555/    D9B8 :                     	; In a rather overzealous optimisation, this game doesn't check if
    9556/    D9B8 :                     	; the sprite limit has been reached every time it processes a sprite
    9557/    D9B8 :                     	; piece. Naturally, this leads to the 'Sprite_Table' buffer being
    9558/    D9B8 :                     	; overflowed if too many sprites are processed. To mitigate this, the
    9559/    D9B8 :                     	; developers placed an $80 byte large spill buffer after
    9560/    D9B8 :                     	; 'Sprite_Table', to 'catch' the overflow. Unfortunately, this spill
    9561/    D9B8 :                     	; buffer is not big enough to catch all overflow: this oversight is
    9562/    D9B8 :                     	; responsible for the famous 'Ashua' bug. To fix this, we'll just
    9563/    D9B8 :                     	; undo this optimistaion. Sonic 3 & Knuckles undid this optimistaion
    9564/    D9B8 :                     	; too, but heavily optimised the rest of 'BuildSprites' to make up
    9565/    D9B8 :                     	; for it.
    9566/    D9B8 : 0C05 0050           		cmpi.b	#$50,d5		; has the sprite limit been reached?
