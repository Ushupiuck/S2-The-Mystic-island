    5460/    8E6E :                     ;sub_6514:
    5461/    8E6E :                     ScrollHoriz:
    5462/    8E6E : =>TRUE               	if FixBugs
    5463/    8E6E :                     		; To prevent the bug that is described below, this caps the position
    5464/    8E6E :                     		; array index offset so that it does not access position data from
    5465/    8E6E :                     		; before the spin dash was performed. Note that this required
    5466/    8E6E :                     		; modifications to 'Sonic_UpdateSpindash' and 'Tails_UpdateSpindash'.
    5467/    8E6E : 1215                		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5468/    8E70 : 6722                		beq.s	.scrollNotDelayed				; if not, branch
    5469/    8E72 : E509                		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5470/    8E74 : 5315                		subq.b	#1,Horiz_scroll_delay_val-Camera_Delay(a5)	; reduce delay value
    5471/    8E76 : 102D 0003           		move.b	Sonic_Pos_Record_Index+1-Camera_Delay(a5),d0
    5472/    8E7A : 902D 0001           		sub.b	Horiz_scroll_delay_val+1-Camera_Delay(a5),d0
    5473/    8E7E : B200                		cmp.b	d0,d1
    5474/    8E80 : 6502                		blo.s	.doNotCap
    5475/    8E82 : 1200                		move.b	d0,d1
    5476/    8E84 :                     .doNotCap:
    5477/    8E84 : =>FALSE              	else
    5478/    8E84 :                     		; The intent of this code is to make the camera briefly lag behind the
    5479/    8E84 :                     		; player right after releasing a spin dash, however it does this by
    5480/    8E84 :                     		; simply making the camera use position data from previous frames. This
    5481/    8E84 :                     		; means that if the camera had been moving recently enough, then
    5482/    8E84 :                     		; releasing a spin dash will cause the camera to jerk around instead of
    5483/    8E84 :                     		; remain still. This can be encountered by running into a wall, and
    5484/    8E84 :                     		; quickly turning around and spin dashing away. Sonic 3 would have had
    5485/    8E84 :                     		; this same issue with the Fire Shield's dash abiliity, but it shoddily
    5486/    8E84 :                     		; works around the issue by resetting the old position values to the
    5487/    8E84 :                     		; current position (see 'Reset_Player_Position_Array').
    5488/    8E84 :                     		move.w	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5489/    8E84 :                     		beq.s	.scrollNotDelayed				; if not, branch
    5490/    8E84 :                     		subi.w	#$100,d1					; reduce delay value
    5491/    8E84 :                     		move.w	d1,Horiz_scroll_delay_val-Camera_Delay(a5)
    5492/    8E84 :                     		moveq	#0,d1
    5493/    8E84 :                     		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; get delay value
    5494/    8E84 :                     		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5495/    8E84 :                     		addq.b	#4,d1
    5496/    8E84 : [5462]               	endif
    5497/    8E84 : 302D 0002           		move.w	Sonic_Pos_Record_Index-Camera_Delay(a5),d0
    5498/    8E88 : 9001                		sub.b	d1,d0
