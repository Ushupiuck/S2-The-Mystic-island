(1)   30/    194C : 2649                		movea.l	a1,a3		; a1 will be changed by Kos_Decomp, so we're backing it up to a3
(1)   31/    194E : 611C                		bsr.s	KosPlusDec
(1)   32/    1950 : 220B                		move.l	a3,d1		; move the backed-up a1 to d1
(1)   33/    1952 : 0281 00FF FFFF      		andi.l	#$FFFFFF,d1	; d1 will be used in the DMA transfer as the Source Address
(1)   34/    1958 : 2609                		move.l	a1,d3		; move end address of decompressed art to d3
