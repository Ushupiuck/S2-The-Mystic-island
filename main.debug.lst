(2)  139/   1DAAE : [129]                			endif
(2)  140/   1DAAE :                     			; For conversions:
(2)  141/   1DAAE :                     			if (use_s2_samples<>0)
(2)  142/   1DAAE :                     				if (use_s3_samples<>0)||(use_sk_samples<>0)||(use_s3d_samples<>0)
(2)  143/   1DAAE :                     					nextenum	dKick
(2)  144/   1DAAE :                     				else
