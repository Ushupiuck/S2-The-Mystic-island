   10843/    F536 :                     SolidObject_cont:
   10844/    F536 :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
   10845/    F536 :                     		; coordinate system where the x origin is at the object's left edge.
   10846/    F536 : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
   10847/    F53A : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
   10848/    F53E : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
   10849/    F540 : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
   10850/    F544 : 3601                		move.w	d1,d3
   10851/    F546 : D643                		add.w	d3,d3				; calculate object's width
   10852/    F548 : B043                		cmp.w	d3,d0
   10853/    F54A : 6200 00BA           		bhi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's right edge
   10854/    F54E :                     		; We now perform the y portion of a bounding box check.  To do this, we assume a
   10855/    F54E :                     		; coordinate system where the y origin is at the highest y position relative to the object
   10856/    F54E :                     		; at which Sonic would still collide with it.  This point is
   10857/    F54E :                     		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
   10858/    F54E :                     		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
   10859/    F54E :                     		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
   10860/    F54E : 1629 0016           		move.b	obHeight(a1),d3			; load Sonic's y radius
   10861/    F552 : 4883                		ext.w	d3
   10862/    F554 : D443                		add.w	d3,d2				; calculate maximum distance for a top collision
   10863/    F556 : 3629 000C           		move.w	obY(a1),d3			; load Sonic's y position
   10864/    F55A : 9668 000C           		sub.w	obY(a0),d3			; ... and calculate his y position relative to the object
   10865/    F55E : 5843                		addq.w	#4,d3				; assume a slightly lower position for Sonic
   10866/    F560 : D642                		add.w	d2,d3				; assume the highest position where Sonic would still be colliding with the object to be (0,0)
   10867/    F562 : 6B00 00A2           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is above this point
   10868/    F566 : 3802                		move.w	d2,d4
   10869/    F568 : D844                		add.w	d4,d4				; calculate minimum distance for a bottom collision
   10870/    F56A : B644                		cmp.w	d4,d3
   10871/    F56C : 6400 0098           		bhs.w	SolidObject_TestClearPush	; branch, if Sonic is below this point
