(2)  192/      C1 :                     zPlaySEGAPCMLoop:
(2)  193/      C1 : 1A                  	ld	a,(de)			; 7	; a = next byte from SEGA PCM
(2)  194/      C2 : DD 71 00            	ld	(ix+0),c		; 19	; Select DAC output register
(2)  195/      C5 : DD 77 01            	ld	(ix+1),a		; 19	; Send current data
(2)  196/      C8 :                     
(2)  197/      C8 : 06 0B               	ld	b,pcmLoopCounter(16000)	; 7	; b = pitch of the SEGA sample
(2)  198/      CA : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  199/      CC :                     
(2)  200/      CC : 13                  	inc	de			; 6	; Point to next byte of DAC sample
(2)  201/      CD : 2B                  	dec	hl			; 6	; Decrement remaining bytes on DAC sample
(2)  202/      CE : 7D                  	ld	a,l			; 4	; a = low byte of remainig bytes
(2)  203/      CF : B4                  	or	h			; 4	; Are there any bytes left?
(2)  204/      D0 : C2 C1 00            	jp	nz,zPlaySEGAPCMLoop	; 10	; If yes, keep playing sample
(2)  205/      D3 :                     					; 90 in total
(2)  206/      D3 : C3 32 00            	jp	zCheckForSamples		; SEGA sound is done; wait for new samples
(2)  207/      D6 :                     
(2)  208/      D6 :                     zPCMMetadata macro label
(2)  209/      D6 :                     	dw	label					; Start
(2)  210/      D6 :                     	dw	label.size				; Length
(2)  211/      D6 :                     	dw	dpcmLoopCounter(label.sample_rate)	; Pitch
(2)  212/      D6 :                     	dw	0					; Padding
(2)  213/      D6 :                         endm
(2)  214/      D6 :                     
(2)  215/      D6 :                     ; DPCM metadata
(2)  216/      D6 :                     zPCM_Table:
(2)  217/      D6 : (MACRO)              	zPCMMetadata zDAC_Kick
(2)  217/      D6 : EE 00                       dw      zDAC_Kick                                   ; Start
(2)  217/      D8 : 52 03                       dw      zDAC_Kick.size                              ; Length
(2)  217/      DA : 17 00                       dw      dpcmLoopCounter(zDAC_Kick.sample_rate)      ; Pitch
(2)  217/      DC : 00 00                       dw      0                                       ; Padding
(2)  218/      DE : (MACRO)              	zPCMMetadata zDAC_Snare
(2)  218/      DE : 40 04                       dw      zDAC_Snare                                   ; Start
(2)  218/      E0 : 70 07                       dw      zDAC_Snare.size                              ; Length
(2)  218/      E2 : 01 00                       dw      dpcmLoopCounter(zDAC_Snare.sample_rate)      ; Pitch
(2)  218/      E4 : 00 00                       dw      0                                       ; Padding
(2)  219/      E6 : =0EAH                zTimpani_Pitch = $+4
(2)  220/      E6 : (MACRO)              	zPCMMetadata zDAC_Timpani
(2)  220/      E6 : B0 0B                       dw      zDAC_Timpani                                   ; Start
(2)  220/      E8 : 16 10                       dw      zDAC_Timpani.size                              ; Length
(2)  220/      EA : 1B 00                       dw      dpcmLoopCounter(zDAC_Timpani.sample_rate)      ; Pitch
(2)  220/      EC : 00 00                       dw      0                                       ; Padding
(2)  221/      EE :                     
