     181/     2D2 :                     
     182/     2D2 :                     Z80StartupCodeBegin:
     183/     2D2 :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     184/     2D2 :                         save
     185/     2D2 :                         CPU Z80 ; start assembling Z80 code
     186/       0 :                         phase 0 ; pretend we're at address 0
     187/       0 : AF                  	xor	a	; clear a to 0
     188/       1 : 01 D9 1F            	ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     189/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     190/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     191/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     192/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     193/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     194/       E : DD E1               	pop	ix	; clear ix
     195/      10 : FD E1               	pop	iy	; clear iy
     196/      12 : ED 47               	ld	i,a	; clear i
     197/      14 : ED 4F               	ld	r,a	; clear r
     198/      16 : D1                  	pop	de	; clear de
     199/      17 : E1                  	pop	hl	; clear hl
     200/      18 : F1                  	pop	af	; clear af
     201/      19 : 08                  	ex	af,af'	; swap af with af'
     202/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     203/      1B : C1                  	pop	bc	; clear bc
     204/      1C : D1                  	pop	de	; clear de
     205/      1D : E1                  	pop	hl	; clear hl
     206/      1E : F1                  	pop	af	; clear af
     207/      1F : F9                  	ld	sp,hl	; clear sp
     208/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     209/      21 : ED 56               	im	1	; interrupt handling mode = 1
     210/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     211/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
     212/      26 :                     zStartupCodeEndLoc:
     213/     2F8 :                         dephase ; stop pretending
     214/     2F8 : ALL                  	restore
     215/     2F8 :                         padding off ; unfortunately our flags got reset so we have to set them again...
     216/     2F8 :                     Z80StartupCodeEnd:
     217/     2F8 :                     
     218/     2F8 : 8104                		dc.w $8104				; VDP display mode
     219/     2FA : 8F02                		dc.w $8F02				; VDP increment
