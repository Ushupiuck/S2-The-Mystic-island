    3624/    720C :                     		; Time, anim, BG VRAM, palette cycle index & flags
    3625/    720C : (MACRO)              		SSBGData  3,  0, ArtTile_SS_Plane_6, 18, TRUE , FALSE
    3625/    720C : 0300 07                             dc.b    (3), (0), ((ArtTile_SS_Plane_6)*tile_size)>>13
    3625/    720F : =>TRUE                       if TRUE
    3625/    720F : 92                                  dc.b    (18)|$80|(FALSE)
    3625/    7210 : =>FALSE                      else
