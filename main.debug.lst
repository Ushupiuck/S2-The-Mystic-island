   23907/   1AB12 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1AB12 :                     ; ---------------------------------------------------------------------------
(1)    2/   1AB12 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1AB12 :                     ;
(1)    4/   1AB12 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1AB12 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1AB12 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1AB12 :                     ; bits). The assembled data looks something like this:
(1)    8/   1AB12 :                     ;
(1)    9/   1AB12 :                     ; aaBBBBBB
(1)   10/   1AB12 :                     ; ccDDDDDD
(1)   11/   1AB12 :                     ; EEEEEE
(1)   12/   1AB12 :                     ; ffgghhii
(1)   13/   1AB12 :                     ;
(1)   14/   1AB12 :                     ; aa = index for primary pattern load request list
(1)   15/   1AB12 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1AB12 :                     ; cc = index for secondary pattern load request list
(1)   17/   1AB12 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1AB12 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1AB12 :                     ; ff = unused, always 0
(1)   20/   1AB12 :                     ; gg = unused, music track
(1)   21/   1AB12 :                     ; hh = unused, palette
(1)   22/   1AB12 :                     ; ii = palette
(1)   23/   1AB12 :                     ;
(1)   24/   1AB12 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1AB12 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1AB12 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1AB12 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1AB12 :                     ; ---------------------------------------------------------------------------
(1)   29/   1AB12 :                     
(1)   30/   1AB12 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1AB12 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1AB12 :                     	dc.l (plc1<<24)|art
(1)   33/   1AB12 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1AB12 :                     	dc.l map128x128
(1)   35/   1AB12 :                     	dc.b 0,music,palette,palette
(1)   36/   1AB12 :                     	endm
(1)   37/   1AB12 :                     
(1)   38/   1AB12 :                     ; MainLoadBlocks:
(1)   39/   1AB12 :                     LevelArtPointers:
(1)   40/   1AB12 : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Kosp_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ    ; GHZ  ; GREEN HILL ZONE
(1)   40/   1AB12 : 0406 5AEE                   dc.l (plcid_GHZ<<24)|Kosp_GHZ
(1)   40/   1AB16 : 0506 8074                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1AB1A : 0006 8B8E                   dc.l Map128_GHZ
(1)   40/   1AB1E : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1AB22 : (MACRO)              		levartptrs plcid_LZ,  plcid_LZ2,  Kosp_LZ,  Map16_LZ,  Map128_LZ,  bgm_LZ,  palid_LZ     ; LZ   ; LABYRINTH ZONE
(1)   41/   1AB22 : 0606 AA74                   dc.l (plcid_LZ<<24)|Kosp_LZ
(1)   41/   1AB26 : 0706 C5D2                   dc.l (plcid_LZ2<<24)|Map16_LZ
