    1011/    1396 :                     ; Subroutine to load pattern load cues (aka to queue pattern load requests)
    1012/    1396 :                     ; ---------------------------------------------------------------------------
    1013/    1396 :                     
    1014/    1396 :                     ; ARGUMENTS
    1015/    1396 :                     ; d0 = index of PLC list (see ArtLoadCues)
    1016/    1396 :                     
    1017/    1396 :                     ; NOTICE: This subroutine does not check for buffer overruns. The programmer
    1018/    1396 :                     ;	  (or hacker) is responsible for making sure that no more than
    1019/    1396 :                     ;	  16 load requests are copied into the buffer.
    1020/    1396 :                     ;    _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
    1021/    1396 :                     ;         (or if you change the size of v_plc_buffer, the limit becomes (v_plc_buffer_Only_End-v_plc_buffer)/6)
    1022/    1396 :                     
    1023/    1396 :                     ; PLCLoad:
    1024/    1396 :                     LoadPLC:
    1025/    1396 : 48E7 0060           		movem.l	a1-a2,-(sp)		; Save registers
    1026/    139A : 43F9 0001 C664      		lea	(ArtLoadCues).l,a1	; Prepare PLC list index
    1027/    13A0 : D040                		add.w	d0,d0			; Get pointer to PLC list
    1028/    13A2 : 3031 0000           		move.w	(a1,d0.w),d0
    1029/    13A6 : 43F1 0000           		lea	(a1,d0.w),a1
    1030/    13AA : 45F8 F6B4           		lea	(v_plc_buffer).w,a2	; Prepare PLC buffer
    1031/    13AE :                     
    1032/    13AE :                     .Loop:
    1033/    13AE : 4A92                		tst.l	(a2)			; Is this PLC entry free?
    1034/    13B0 : 6704                		beq.s	.FoundFree		; If so, branch
    1035/    13B2 : 5C4A                		addq.w	#6,a2			; Check next entry
    1036/    13B4 : 60F8                		bra.s	.Loop
    1037/    13B6 :                     
    1038/    13B6 :                     .FoundFree:
    1039/    13B6 : 3019                		move.w	(a1)+,d0		; Get number of PLC entries
    1040/    13B8 : 6B0E                		bmi.s	.End			; If it's 0 (or less), branch
    1041/    13BA :                     
    1042/    13BA :                     .Load:
    1043/    13BA : 24D9                		move.l	(a1)+,(a2)+		; Copy art pointer
    1044/    13BC : 34D9                		move.w	(a1)+,(a2)+		; Copy VRAM location
    1045/    13BE : 51C8 FFFA           		dbf	d0,.Load		; Loop until all entries are queued
    1046/    13C2 : 7000                		moveq	#0,d0
    1047/    13C4 : 24C0                		move.l	d0,(a2)+		; clear the last cue to avoid overcopying it
    1048/    13C6 : 34C0                		move.w	d0,(a2)+
    1049/    13C8 :                     .End:
    1050/    13C8 : 4CDF 0600           		movem.l	(sp)+,a1-a2		; Restore registers
    1051/    13CC : 4E75                		rts
    1052/    13CE :                     ; End of function LoadPLC
    1053/    13CE :                     
    1054/    13CE :                     
    1055/    13CE :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1056/    13CE :                     ; Queue pattern load requests, but clear the PLQ first
    1057/    13CE :                     
    1058/    13CE :                     ; ARGUMENTS
    1059/    13CE :                     ; d0 = index of PLC list (see ArtLoadCues)
    1060/    13CE :                     
