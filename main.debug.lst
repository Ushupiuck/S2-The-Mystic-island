(2)  159/   1DAAE :                     ; Channel IDs for SFX
(2)  160/   1DAAE : =$80                 cPSG1				EQU $80
(2)  161/   1DAAE : =$A0                 cPSG2				EQU $A0
(2)  162/   1DAAE : =$C0                 cPSG3				EQU $C0
(2)  163/   1DAAE : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  164/   1DAAE : =$2                  cFM3				EQU $02
(2)  165/   1DAAE : =$4                  cFM4				EQU $04
(2)  166/   1DAAE : =$5                  cFM5				EQU $05
(2)  167/   1DAAE : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  168/   1DAAE :                     ; ---------------------------------------------------------------------------
(2)  169/   1DAAE :                     ; Conversion macros and functions
(2)  170/   1DAAE :                     
(2)  171/   1DAAE :                     conv0To256  function n,((n==0)<<8)|n
(2)  172/   1DAAE :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  173/   1DAAE :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  174/   1DAAE :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  175/   1DAAE :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  176/   1DAAE :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  177/   1DAAE :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  178/   1DAAE :                     
(2)  179/   1DAAE :                     convertMainTempoMod macro mod
(2)  180/   1DAAE :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  181/   1DAAE :                     		dc.b	mod
(2)  182/   1DAAE :                     	elseif SourceDriver==1
(2)  183/   1DAAE :                     		if mod==1
(2)  184/   1DAAE :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  185/   1DAAE :                     		endif
(2)  186/   1DAAE :                     		if SonicDriverVer==2
(2)  187/   1DAAE :                     			dc.b	s1TempotoS2(mod)
(2)  188/   1DAAE :                     		else;if SonicDriverVer>=3
(2)  189/   1DAAE :                     			dc.b	s1TempotoS3(mod)
(2)  190/   1DAAE :                     		endif
(2)  191/   1DAAE :                     	elseif SourceDriver==2
(2)  192/   1DAAE :                     		if mod==0
(2)  193/   1DAAE :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  194/   1DAAE :                     		endif
(2)  195/   1DAAE :                     		if SonicDriverVer==1
(2)  196/   1DAAE :                     			dc.b	s2TempotoS1(mod)
(2)  197/   1DAAE :                     		else;if SonicDriverVer>=3
(2)  198/   1DAAE :                     			dc.b	s2TempotoS3(mod)
(2)  199/   1DAAE :                     		endif
(2)  200/   1DAAE :                     	else;if SourceDriver>=3
(2)  201/   1DAAE :                     		if mod==0
(2)  202/   1DAAE :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  203/   1DAAE :                     		endif
(2)  204/   1DAAE :                     		if SonicDriverVer==1
(2)  205/   1DAAE :                     			dc.b	s3TempotoS1(mod)
(2)  206/   1DAAE :                     		else;if SonicDriverVer==2
(2)  207/   1DAAE :                     			dc.b	s3TempotoS2(mod)
(2)  208/   1DAAE :                     		endif
(2)  209/   1DAAE :                     	endif
(2)  210/   1DAAE :                     	endm
(2)  211/   1DAAE :                     
(2)  212/   1DAAE :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  213/   1DAAE :                     PSGPitchConvert macro pitch
(2)  214/   1DAAE :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  215/   1DAAE :                     		dc.b	(pitch+psgdelta)&$FF
(2)  216/   1DAAE :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  217/   1DAAE :                     		dc.b	(pitch-psgdelta)&$FF
(2)  218/   1DAAE :                     	else
(2)  219/   1DAAE :                     		dc.b	pitch
(2)  220/   1DAAE :                     	endif
(2)  221/   1DAAE :                     	endm
(2)  222/   1DAAE :                     
(2)  223/   1DAAE :                     CheckedChannelPointer macro loc
(2)  224/   1DAAE :                     	if SonicDriverVer<>1
(2)  225/   1DAAE :                     		dc.w	z80_ptr(loc)
(2)  226/   1DAAE :                     	else
(2)  227/   1DAAE :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  228/   1DAAE :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  229/   1DAAE :                     		endif
(2)  230/   1DAAE :                     		dc.w	loc-songStart
(2)  231/   1DAAE :                     	endif
(2)  232/   1DAAE :                     	endm
(2)  233/   1DAAE :                     ; ---------------------------------------------------------------------------
(2)  234/   1DAAE :                     ; Header Macros
(2)  235/   1DAAE :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  236/   1DAAE :                     
(2)  237/   1DAAE :                     SourceDriver set ver
(2)  238/   1DAAE :                     
(2)  239/   1DAAE :                     	if ("sourcesmps2asmver"<>"")
(2)  240/   1DAAE :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  241/   1DAAE :                     	else
(2)  242/   1DAAE :                     		set SourceSMPS2ASM,0
(2)  243/   1DAAE :                     	endif
(2)  244/   1DAAE :                     
(2)  245/   1DAAE :                     songStart set *
(2)  246/   1DAAE :                     
(2)  247/   1DAAE :                     	if MOMPASS=1
(2)  248/   1DAAE :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  249/   1DAAE :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  250/   1DAAE :                     		endif
(2)  251/   1DAAE :                     	endif
(2)  252/   1DAAE :                     
(2)  253/   1DAAE :                     	endm
(2)  254/   1DAAE :                     
(2)  255/   1DAAE :                     smpsHeaderVoiceNull macro
(2)  256/   1DAAE :                     	if songStart<>*
(2)  257/   1DAAE :                     		fatal "Missing smpsHeaderStartSong"
(2)  258/   1DAAE :                     	endif
(2)  259/   1DAAE :                     	dc.w	$0000
(2)  260/   1DAAE :                     	endm
(2)  261/   1DAAE :                     
(2)  262/   1DAAE :                     ; Header - Set up Voice Location
(2)  263/   1DAAE :                     ; Common to music and SFX
(2)  264/   1DAAE :                     smpsHeaderVoice macro loc
(2)  265/   1DAAE :                     	if songStart<>*
(2)  266/   1DAAE :                     		fatal "Missing smpsHeaderStartSong"
(2)  267/   1DAAE :                     	endif
(2)  268/   1DAAE :                     	if SonicDriverVer<>1
(2)  269/   1DAAE :                     		dc.w	z80_ptr(loc)
(2)  270/   1DAAE :                     	else
(2)  271/   1DAAE :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  272/   1DAAE :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  273/   1DAAE :                     		endif
(2)  274/   1DAAE :                     		dc.w	loc-songStart
(2)  275/   1DAAE :                     	endif
(2)  276/   1DAAE :                     	endm
(2)  277/   1DAAE :                     
(2)  278/   1DAAE :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  279/   1DAAE :                     ; Common to music and SFX
(2)  280/   1DAAE :                     smpsHeaderVoiceUVB macro
(2)  281/   1DAAE :                     	if songStart<>*
(2)  282/   1DAAE :                     		fatal "Missing smpsHeaderStartSong"
(2)  283/   1DAAE :                     	endif
(2)  284/   1DAAE :                     	if SonicDriverVer>=5
(2)  285/   1DAAE :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  286/   1DAAE :                     	elseif SonicDriverVer>=3
(2)  287/   1DAAE :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  288/   1DAAE :                     	else
(2)  289/   1DAAE :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  290/   1DAAE :                     	endif
(2)  291/   1DAAE :                     	endm
(2)  292/   1DAAE :                     
(2)  293/   1DAAE :                     ; Header macros for music (not for SFX)
(2)  294/   1DAAE :                     ; Header - Set up Channel Usage
(2)  295/   1DAAE :                     smpsHeaderChan macro fm,psg
(2)  296/   1DAAE :                     	dc.b	fm,psg
(2)  297/   1DAAE :                     	endm
(2)  298/   1DAAE :                     
(2)  299/   1DAAE :                     ; Header - Set up Tempo
(2)  300/   1DAAE :                     smpsHeaderTempo macro div,mod
(2)  301/   1DAAE :                     	dc.b	div
(2)  302/   1DAAE :                     	convertMainTempoMod mod
(2)  303/   1DAAE :                     	endm
(2)  304/   1DAAE :                     
(2)  305/   1DAAE :                     ; Header - Set up DAC Channel
(2)  306/   1DAAE :                     smpsHeaderDAC macro loc,pitch,vol
(2)  307/   1DAAE :                     	CheckedChannelPointer loc
(2)  308/   1DAAE :                     	if ("pitch"<>"")
(2)  309/   1DAAE :                     		dc.b	pitch
(2)  310/   1DAAE :                     		if ("vol"<>"")
(2)  311/   1DAAE :                     			dc.b	vol
(2)  312/   1DAAE :                     		else
(2)  313/   1DAAE :                     			dc.b	$00
(2)  314/   1DAAE :                     		endif
(2)  315/   1DAAE :                     	else
(2)  316/   1DAAE :                     		dc.w	$00
(2)  317/   1DAAE :                     	endif
(2)  318/   1DAAE :                     	endm
(2)  319/   1DAAE :                     
(2)  320/   1DAAE :                     ; Header - Set up FM Channel
(2)  321/   1DAAE :                     smpsHeaderFM macro loc,pitch,vol
(2)  322/   1DAAE :                     	CheckedChannelPointer loc
(2)  323/   1DAAE :                     	dc.b	pitch,vol
(2)  324/   1DAAE :                     	endm
(2)  325/   1DAAE :                     
(2)  326/   1DAAE :                     ; Header - Set up PSG Channel
(2)  327/   1DAAE :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  328/   1DAAE :                     	CheckedChannelPointer loc
(2)  329/   1DAAE :                     	PSGPitchConvert pitch
(2)  330/   1DAAE :                     	dc.b	vol
(2)  331/   1DAAE :                     	; Frequency envelope
(2)  332/   1DAAE :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  333/   1DAAE :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  334/   1DAAE :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  335/   1DAAE :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  336/   1DAAE :                     		dc.b	0
(2)  337/   1DAAE :                     	else
(2)  338/   1DAAE :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  339/   1DAAE :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  340/   1DAAE :                     		endif
(2)  341/   1DAAE :                     		dc.b	mod
(2)  342/   1DAAE :                     	endif
(2)  343/   1DAAE :                     	; Volume envelope
(2)  344/   1DAAE :                     	dc.b	voice
(2)  345/   1DAAE :                     	endm
(2)  346/   1DAAE :                     
(2)  347/   1DAAE :                     ; Header macros for SFX (not for music)
(2)  348/   1DAAE :                     ; Header - Set up Tempo
(2)  349/   1DAAE :                     smpsHeaderTempoSFX macro div
(2)  350/   1DAAE :                     	dc.b	div
(2)  351/   1DAAE :                     	endm
(2)  352/   1DAAE :                     
(2)  353/   1DAAE :                     ; Header - Set up Channel Usage
(2)  354/   1DAAE :                     smpsHeaderChanSFX macro chan
(2)  355/   1DAAE :                     	dc.b	chan
(2)  356/   1DAAE :                     	endm
(2)  357/   1DAAE :                     
(2)  358/   1DAAE :                     ; Header - Set up FM Channel
(2)  359/   1DAAE :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  360/   1DAAE :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  361/   1DAAE :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  362/   1DAAE :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  363/   1DAAE :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  364/   1DAAE :                     	endif
(2)  365/   1DAAE :                     	dc.b	$80,chanid
(2)  366/   1DAAE :                     	CheckedChannelPointer loc
(2)  367/   1DAAE :                     	if (chanid&$80)<>0
(2)  368/   1DAAE :                     		PSGPitchConvert pitch
(2)  369/   1DAAE :                     	else
(2)  370/   1DAAE :                     		dc.b	pitch
(2)  371/   1DAAE :                     	endif
(2)  372/   1DAAE :                     	dc.b	vol
(2)  373/   1DAAE :                     	endm
(2)  374/   1DAAE :                     ; ---------------------------------------------------------------------------
(2)  375/   1DAAE :                     ; Co-ord Flag Macros and Equates
(2)  376/   1DAAE :                     ; E0xx - Panning, AMS, FMS
(2)  377/   1DAAE :                     smpsPan macro direction,amsfms
(2)  378/   1DAAE :                     panNone set $00
(2)  379/   1DAAE :                     panRight set $40
(2)  380/   1DAAE :                     panLeft set $80
(2)  381/   1DAAE :                     panCentre set $C0
(2)  382/   1DAAE :                     panCenter set $C0 ; silly Americans :U
(2)  383/   1DAAE :                     	dc.b $E0,direction+amsfms
(2)  384/   1DAAE :                     	endm
(2)  385/   1DAAE :                     
(2)  386/   1DAAE :                     ; E1xx - Set channel detune to val
(2)  387/   1DAAE :                     smpsDetune macro val
(2)  388/   1DAAE :                     	dc.b	$E1,val
(2)  389/   1DAAE :                     	endm
(2)  390/   1DAAE :                     
(2)  391/   1DAAE :                     ; E2xx - Useless
(2)  392/   1DAAE :                     smpsNop macro val
(2)  393/   1DAAE :                     	if SonicDriverVer<3
(2)  394/   1DAAE :                     		dc.b	$E2,val
(2)  395/   1DAAE :                     	endif
(2)  396/   1DAAE :                     	endm
(2)  397/   1DAAE :                     
(2)  398/   1DAAE :                     ; Return (used after smpsCall)
(2)  399/   1DAAE :                     smpsReturn macro val
(2)  400/   1DAAE :                     	if SonicDriverVer>=3
(2)  401/   1DAAE :                     		dc.b	$F9
(2)  402/   1DAAE :                     	else
(2)  403/   1DAAE :                     		dc.b	$E3
(2)  404/   1DAAE :                     	endif
(2)  405/   1DAAE :                     	endm
(2)  406/   1DAAE :                     
(2)  407/   1DAAE :                     ; Fade in previous song (ie. 1-Up)
(2)  408/   1DAAE :                     smpsFade macro val
(2)  409/   1DAAE :                     	if SonicDriverVer>=3
(2)  410/   1DAAE :                     		dc.b	$E2
(2)  411/   1DAAE :                     		if ("val"<>"")
(2)  412/   1DAAE :                     			dc.b	val
(2)  413/   1DAAE :                     		else
(2)  414/   1DAAE :                     			dc.b	$FF
(2)  415/   1DAAE :                     		endif
(2)  416/   1DAAE :                     		if SourceDriver<3
(2)  417/   1DAAE :                     			smpsStop
(2)  418/   1DAAE :                     		endif
(2)  419/   1DAAE :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  420/   1DAAE :                     		; This is one of those weird S3+ "fades" that we don't need
(2)  421/   1DAAE :                     	else
(2)  422/   1DAAE :                     		dc.b	$E4
(2)  423/   1DAAE :                     	endif
(2)  424/   1DAAE :                     	endm
(2)  425/   1DAAE :                     
(2)  426/   1DAAE :                     ; E5xx - Set channel tempo divider to xx
(2)  427/   1DAAE :                     smpsChanTempoDiv macro val
(2)  428/   1DAAE :                     	if SonicDriverVer>=5
(2)  429/   1DAAE :                     		; New flag unique to Flamewing's modified S&K driver
(2)  430/   1DAAE :                     		dc.b	$FF,$08,val
(2)  431/   1DAAE :                     	elseif SonicDriverVer==3
(2)  432/   1DAAE :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  433/   1DAAE :                     	else
(2)  434/   1DAAE :                     		dc.b	$E5,val
(2)  435/   1DAAE :                     	endif
(2)  436/   1DAAE :                     	endm
(2)  437/   1DAAE :                     
(2)  438/   1DAAE :                     ; E6xx - Alter Volume by xx
(2)  439/   1DAAE :                     smpsAlterVol macro val
(2)  440/   1DAAE :                     	dc.b	$E6,val
(2)  441/   1DAAE :                     	endm
(2)  442/   1DAAE :                     
(2)  443/   1DAAE :                     ; E7 - Prevent attack of next note
(2)  444/   1DAAE : =$E7                 smpsNoAttack	EQU $E7
(2)  445/   1DAAE :                     
(2)  446/   1DAAE :                     ; E8xx - Set note fill to xx
(2)  447/   1DAAE :                     smpsNoteFill macro val
(2)  448/   1DAAE :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  449/   1DAAE :                     		; Unique to Flamewing's modified driver
(2)  450/   1DAAE :                     		dc.b	$FF,$0A,val
(2)  451/   1DAAE :                     	else
(2)  452/   1DAAE :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  453/   1DAAE :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  454/   1DAAE :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  455/   1DAAE :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  456/   1DAAE :                     		endif
(2)  457/   1DAAE :                     		dc.b	$E8,val
(2)  458/   1DAAE :                     	endif
(2)  459/   1DAAE :                     	endm
(2)  460/   1DAAE :                     
(2)  461/   1DAAE :                     ; Add xx to channel pitch
(2)  462/   1DAAE :                     smpsChangeTransposition macro val
(2)  463/   1DAAE :                     	if SonicDriverVer>=3
(2)  464/   1DAAE :                     		dc.b	$FB,val
(2)  465/   1DAAE :                     	else
(2)  466/   1DAAE :                     		dc.b	$E9,val
(2)  467/   1DAAE :                     	endif
(2)  468/   1DAAE :                     	endm
(2)  469/   1DAAE :                     
(2)  470/   1DAAE :                     ; Set music tempo modifier to xx
(2)  471/   1DAAE :                     smpsSetTempoMod macro mod
(2)  472/   1DAAE :                     	if SonicDriverVer>=3
(2)  473/   1DAAE :                     		dc.b	$FF,$00
(2)  474/   1DAAE :                     	else
(2)  475/   1DAAE :                     		dc.b	$EA
(2)  476/   1DAAE :                     	endif
(2)  477/   1DAAE :                     	convertMainTempoMod mod
(2)  478/   1DAAE :                     	endm
(2)  479/   1DAAE :                     
(2)  480/   1DAAE :                     ; Set music tempo divider to xx
(2)  481/   1DAAE :                     smpsSetTempoDiv macro val
(2)  482/   1DAAE :                     	if SonicDriverVer>=3
(2)  483/   1DAAE :                     		dc.b	$FF,$04,val
(2)  484/   1DAAE :                     	else
(2)  485/   1DAAE :                     		dc.b	$EB,val
(2)  486/   1DAAE :                     	endif
(2)  487/   1DAAE :                     	endm
(2)  488/   1DAAE :                     
(2)  489/   1DAAE :                     ; ECxx - Set Volume to xx
(2)  490/   1DAAE :                     smpsSetVol macro val
(2)  491/   1DAAE :                     	if SonicDriverVer>=3
(2)  492/   1DAAE :                     		dc.b	$E4,val
(2)  493/   1DAAE :                     	else
(2)  494/   1DAAE :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  495/   1DAAE :                     	endif
(2)  496/   1DAAE :                     	endm
(2)  497/   1DAAE :                     
(2)  498/   1DAAE :                     ; Works on all drivers
(2)  499/   1DAAE :                     smpsPSGAlterVol macro vol
(2)  500/   1DAAE :                     	dc.b	$EC,vol
(2)  501/   1DAAE :                     	endm
(2)  502/   1DAAE :                     
(2)  503/   1DAAE :                     smpsPSGAlterVolS2 macro vol
(2)  504/   1DAAE :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  505/   1DAAE :                     	if SonicDriverVer==2
(2)  506/   1DAAE :                     		smpsAlterVol vol
(2)  507/   1DAAE :                     	else
(2)  508/   1DAAE :                     		smpsPSGAlterVol vol
(2)  509/   1DAAE :                     	endif
(2)  510/   1DAAE :                     	endm
(2)  511/   1DAAE :                     
(2)  512/   1DAAE :                     ; Clears pushing sound flag in S1
(2)  513/   1DAAE :                     smpsClearPush macro
(2)  514/   1DAAE :                     	if SonicDriverVer==1
(2)  515/   1DAAE :                     		dc.b	$ED
(2)  516/   1DAAE :                     	else
(2)  517/   1DAAE :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  518/   1DAAE :                     	endif
(2)  519/   1DAAE :                     	endm
(2)  520/   1DAAE :                     
(2)  521/   1DAAE :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  522/   1DAAE :                     smpsStopSpecial macro
(2)  523/   1DAAE :                     	if SonicDriverVer==1
(2)  524/   1DAAE :                     		dc.b	$EE
(2)  525/   1DAAE :                     	else
(2)  526/   1DAAE :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  527/   1DAAE :                     		smpsStop
(2)  528/   1DAAE :                     	endif
(2)  529/   1DAAE :                     	endm
(2)  530/   1DAAE :                     
(2)  531/   1DAAE :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  532/   1DAAE :                     smpsFMvoice macro voice,songID
(2)  533/   1DAAE :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  534/   1DAAE :                     		dc.b	$EF,voice|$80,songID+$81
(2)  535/   1DAAE :                     	else
(2)  536/   1DAAE :                     		dc.b	$EF,voice
(2)  537/   1DAAE :                     	endif
(2)  538/   1DAAE :                     	endm
(2)  539/   1DAAE :                     
(2)  540/   1DAAE :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  541/   1DAAE :                     smpsModSet macro wait,speed,change,step
(2)  542/   1DAAE :                     	dc.b	$F0
(2)  543/   1DAAE :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  544/   1DAAE :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  545/   1DAAE :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  546/   1DAAE :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  547/   1DAAE :                     	else
(2)  548/   1DAAE :                     		dc.b	wait,speed,change,step
(2)  549/   1DAAE :                     	endif
(2)  550/   1DAAE :                     	;dc.b	speed,change,step
(2)  551/   1DAAE :                     	endm
(2)  552/   1DAAE :                     
(2)  553/   1DAAE :                     ; Turn on Modulation
(2)  554/   1DAAE :                     smpsModOn macro type
(2)  555/   1DAAE :                     	if SonicDriverVer>=3
(2)  556/   1DAAE :                     		if "type"<>""
(2)  557/   1DAAE :                     			dc.b	$F4,type
(2)  558/   1DAAE :                     		else
(2)  559/   1DAAE :                     			dc.b	$F4,$80
(2)  560/   1DAAE :                     		endif
(2)  561/   1DAAE :                     	else
(2)  562/   1DAAE :                     		dc.b	$F1
(2)  563/   1DAAE :                     	endif
(2)  564/   1DAAE :                     	endm
(2)  565/   1DAAE :                     
(2)  566/   1DAAE :                     ; F2 - End of channel
(2)  567/   1DAAE :                     smpsStop macro
(2)  568/   1DAAE :                     	dc.b	$F2
(2)  569/   1DAAE :                     	endm
(2)  570/   1DAAE :                     
(2)  571/   1DAAE :                     ; F3xx - PSG waveform to xx
(2)  572/   1DAAE :                     smpsPSGform macro form
(2)  573/   1DAAE :                     	dc.b	$F3,form
(2)  574/   1DAAE :                     	endm
(2)  575/   1DAAE :                     
(2)  576/   1DAAE :                     ; Turn off Modulation
(2)  577/   1DAAE :                     smpsModOff macro
(2)  578/   1DAAE :                     	if SonicDriverVer>=3
(2)  579/   1DAAE :                     		dc.b	$FA
(2)  580/   1DAAE :                     	else
(2)  581/   1DAAE :                     		dc.b	$F4
(2)  582/   1DAAE :                     	endif
(2)  583/   1DAAE :                     	endm
(2)  584/   1DAAE :                     
(2)  585/   1DAAE :                     ; F5xx - PSG voice to xx
(2)  586/   1DAAE :                     smpsPSGvoice macro voice
(2)  587/   1DAAE :                     	dc.b	$F5,voice
(2)  588/   1DAAE :                     	endm
(2)  589/   1DAAE :                     
(2)  590/   1DAAE :                     ; F6xxxx - Jump to xxxx
(2)  591/   1DAAE :                     smpsJump macro loc
(2)  592/   1DAAE :                     	dc.b	$F6
(2)  593/   1DAAE :                     	if SonicDriverVer<>1
(2)  594/   1DAAE :                     		dc.w	z80_ptr(loc)
(2)  595/   1DAAE :                     	else
(2)  596/   1DAAE :                     		dc.w	loc-*-1
(2)  597/   1DAAE :                     	endif
(2)  598/   1DAAE :                     	endm
(2)  599/   1DAAE :                     
(2)  600/   1DAAE :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  601/   1DAAE :                     smpsLoop macro index,loops,loc
(2)  602/   1DAAE :                     	dc.b	$F7
(2)  603/   1DAAE :                     	dc.b	index,loops
(2)  604/   1DAAE :                     	if SonicDriverVer<>1
(2)  605/   1DAAE :                     		dc.w	z80_ptr(loc)
(2)  606/   1DAAE :                     	else
(2)  607/   1DAAE :                     		dc.w	loc-*-1
(2)  608/   1DAAE :                     	endif
(2)  609/   1DAAE :                     	endm
(2)  610/   1DAAE :                     
(2)  611/   1DAAE :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  612/   1DAAE :                     smpsCall macro loc
(2)  613/   1DAAE :                     	dc.b	$F8
(2)  614/   1DAAE :                     	if SonicDriverVer<>1
(2)  615/   1DAAE :                     		dc.w	z80_ptr(loc)
(2)  616/   1DAAE :                     	else
(2)  617/   1DAAE :                     		dc.w	loc-*-1
(2)  618/   1DAAE :                     	endif
(2)  619/   1DAAE :                     	endm
