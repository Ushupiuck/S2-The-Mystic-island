    1921/    4ACC :                     ; ---------------------------------------------------------------------------
    1922/    4ACC :                     ; Subroutine to perform vertical synchronization
    1923/    4ACC :                     ; ---------------------------------------------------------------------------
    1924/    4ACC :                     
    1925/    4ACC :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1926/    4ACC :                     
    1927/    4ACC :                     ; DelayProgram:
    1928/    4ACC :                     WaitForVint:
    1929/    4ACC : (MACRO)              		enable_ints
    1929/    4ACC : 46FC 2300                           move    #$2300,sr
    1930/    4AD0 :                     
    1931/    4AD0 :                     .wait:
    1932/    4AD0 : 4A38 F662           		tst.b	(v_vbla_routine).w
    1933/    4AD4 : 66FA                		bne.s	.wait
    1934/    4AD6 : 4E75                		rts
    1935/    4AD8 :                     ; End of function WaitForVint
    1936/    4AD8 :                     
    1937/    4AD8 :                     ; ---------------------------------------------------------------------------
    1938/    4AD8 :                     ; Subroutine to generate a pseudo-random number in d0
    1939/    4AD8 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1940/    4AD8 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1941/    4AD8 :                     ; ---------------------------------------------------------------------------
    1942/    4AD8 :                     
    1943/    4AD8 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1944/    4AD8 :                     
    1945/    4AD8 :                     ; PseudoRandomNumber:
    1946/    4AD8 :                     RandomNumber:
    1947/    4AD8 : 2238 F672           		move.l	(v_random).w,d1
    1948/    4ADC : 6606                		bne.s	loc_2C9C
    1949/    4ADE : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1950/    4AE4 :                     
    1951/    4AE4 :                     loc_2C9C:
    1952/    4AE4 :                     		; set the high word of d0 to be the high word of the RNG
    1953/    4AE4 :                     		; and multiply the RNG by 41
    1954/    4AE4 : 2001                		move.l	d1,d0
    1955/    4AE6 : E581                		asl.l	#2,d1
    1956/    4AE8 : D280                		add.l	d0,d1
    1957/    4AEA : E781                		asl.l	#3,d1
    1958/    4AEC : D280                		add.l	d0,d1
    1959/    4AEE :                     
    1960/    4AEE :                     		; add the low word of the RNG to the high word of the RNG
    1961/    4AEE :                     		; and set the low word of d0 to be the result
    1962/    4AEE :                     
    1963/    4AEE : 3001                		move.w	d1,d0
