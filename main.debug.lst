(2)  769/   A76F8 :                     ; Macros for FM instruments
(2)  770/   A76F8 :                     ; Voices - Feedback
(2)  771/   A76F8 :                     smpsVcFeedback macro val
(2)  772/   A76F8 :                     vcFeedback set val
(2)  773/   A76F8 :                     	endm
(2)  774/   A76F8 :                     
(2)  775/   A76F8 :                     ; Voices - Algorithm
(2)  776/   A76F8 :                     smpsVcAlgorithm macro val
(2)  777/   A76F8 :                     vcAlgorithm set val
(2)  778/   A76F8 :                     	endm
(2)  779/   A76F8 :                     
(2)  780/   A76F8 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  781/   A76F8 :                     vcUnusedBits set val
(2)  782/   A76F8 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  783/   A76F8 :                     		set vcD1R1Unk,d1r1<<5
(2)  784/   A76F8 :                     		set vcD1R2Unk,d1r2<<5
(2)  785/   A76F8 :                     		set vcD1R3Unk,d1r3<<5
(2)  786/   A76F8 :                     		set vcD1R4Unk,d1r4<<5
(2)  787/   A76F8 :                     	else
(2)  788/   A76F8 :                     		set vcD1R1Unk,0
(2)  789/   A76F8 :                     		set vcD1R2Unk,0
(2)  790/   A76F8 :                     		set vcD1R3Unk,0
(2)  791/   A76F8 :                     		set vcD1R4Unk,0
(2)  792/   A76F8 :                     	endif
(2)  793/   A76F8 :                     	endm
(2)  794/   A76F8 :                     
(2)  795/   A76F8 :                     ; Voices - Detune
(2)  796/   A76F8 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  797/   A76F8 :                     	set vcDT1,op1
(2)  798/   A76F8 :                     	set vcDT2,op2
(2)  799/   A76F8 :                     	set vcDT3,op3
(2)  800/   A76F8 :                     	set vcDT4,op4
(2)  801/   A76F8 :                     	endm
(2)  802/   A76F8 :                     
(2)  803/   A76F8 :                     ; Voices - Coarse-Frequency
(2)  804/   A76F8 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  805/   A76F8 :                     	set vcCF1,op1
(2)  806/   A76F8 :                     	set vcCF2,op2
(2)  807/   A76F8 :                     	set vcCF3,op3
(2)  808/   A76F8 :                     	set vcCF4,op4
(2)  809/   A76F8 :                     	endm
(2)  810/   A76F8 :                     
(2)  811/   A76F8 :                     ; Voices - Rate Scale
(2)  812/   A76F8 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  813/   A76F8 :                     	set vcRS1,op1
(2)  814/   A76F8 :                     	set vcRS2,op2
(2)  815/   A76F8 :                     	set vcRS3,op3
(2)  816/   A76F8 :                     	set vcRS4,op4
(2)  817/   A76F8 :                     	endm
(2)  818/   A76F8 :                     
(2)  819/   A76F8 :                     ; Voices - Attack Rate
(2)  820/   A76F8 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  821/   A76F8 :                     	set vcAR1,op1
(2)  822/   A76F8 :                     	set vcAR2,op2
(2)  823/   A76F8 :                     	set vcAR3,op3
(2)  824/   A76F8 :                     	set vcAR4,op4
(2)  825/   A76F8 :                     	endm
(2)  826/   A76F8 :                     
(2)  827/   A76F8 :                     ; Voices - Amplitude Modulation
(2)  828/   A76F8 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  829/   A76F8 :                     ; were the Amplitude Modulation.
(2)  830/   A76F8 :                     ; According to several docs, however, it's actually the high bit.
(2)  831/   A76F8 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  832/   A76F8 :                     	if SourceSMPS2ASM==0
(2)  833/   A76F8 :                     		set vcAM1,op1<<5
(2)  834/   A76F8 :                     		set vcAM2,op2<<5
(2)  835/   A76F8 :                     		set vcAM3,op3<<5
(2)  836/   A76F8 :                     		set vcAM4,op4<<5
(2)  837/   A76F8 :                     	else
(2)  838/   A76F8 :                     		set vcAM1,op1<<7
(2)  839/   A76F8 :                     		set vcAM2,op2<<7
(2)  840/   A76F8 :                     		set vcAM3,op3<<7
(2)  841/   A76F8 :                     		set vcAM4,op4<<7
(2)  842/   A76F8 :                     	endif
(2)  843/   A76F8 :                     	endm
(2)  844/   A76F8 :                     
(2)  845/   A76F8 :                     ; Voices - First Decay Rate
(2)  846/   A76F8 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  847/   A76F8 :                     	set vcD1R1,op1
(2)  848/   A76F8 :                     	set vcD1R2,op2
(2)  849/   A76F8 :                     	set vcD1R3,op3
(2)  850/   A76F8 :                     	set vcD1R4,op4
(2)  851/   A76F8 :                     	endm
(2)  852/   A76F8 :                     
(2)  853/   A76F8 :                     ; Voices - Second Decay Rate
(2)  854/   A76F8 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  855/   A76F8 :                     	set vcD2R1,op1
(2)  856/   A76F8 :                     	set vcD2R2,op2
(2)  857/   A76F8 :                     	set vcD2R3,op3
(2)  858/   A76F8 :                     	set vcD2R4,op4
(2)  859/   A76F8 :                     	endm
(2)  860/   A76F8 :                     
(2)  861/   A76F8 :                     ; Voices - Decay Level
(2)  862/   A76F8 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  863/   A76F8 :                     	set vcDL1,op1
(2)  864/   A76F8 :                     	set vcDL2,op2
(2)  865/   A76F8 :                     	set vcDL3,op3
(2)  866/   A76F8 :                     	set vcDL4,op4
(2)  867/   A76F8 :                     	endm
(2)  868/   A76F8 :                     
(2)  869/   A76F8 :                     ; Voices - Release Rate
(2)  870/   A76F8 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  871/   A76F8 :                     	set vcRR1,op1
(2)  872/   A76F8 :                     	set vcRR2,op2
(2)  873/   A76F8 :                     	set vcRR3,op3
(2)  874/   A76F8 :                     	set vcRR4,op4
(2)  875/   A76F8 :                     	endm
(2)  876/   A76F8 :                     
(2)  877/   A76F8 :                     ; Voices - Total Level
(2)  878/   A76F8 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  879/   A76F8 :                     ; but later versions leave it up to the user.
(2)  880/   A76F8 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  881/   A76F8 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  882/   A76F8 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  883/   A76F8 :                     ; SMPS Z80 does the opposite.
(2)  884/   A76F8 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  885/   A76F8 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  886/   A76F8 :                     ; what we do, so we just print a warning.
(2)  887/   A76F8 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  888/   A76F8 :                     	set vcTL1,op1
(2)  889/   A76F8 :                     	set vcTL2,op2
(2)  890/   A76F8 :                     	set vcTL3,op3
(2)  891/   A76F8 :                     	set vcTL4,op4
(2)  892/   A76F8 :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  893/   A76F8 :                     ;   0     1     2     3     4     5     6     7
(2)  894/   A76F8 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  895/   A76F8 :                     	if SourceSMPS2ASM==0
(2)  896/   A76F8 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  897/   A76F8 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  898/   A76F8 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  899/   A76F8 :                     		set vcTLMask1,$80
(2)  900/   A76F8 :                     	else
(2)  901/   A76F8 :                     		set vcTLMask4,0
(2)  902/   A76F8 :                     		set vcTLMask3,0
(2)  903/   A76F8 :                     		set vcTLMask2,0
(2)  904/   A76F8 :                     		set vcTLMask1,0
(2)  905/   A76F8 :                     	endif
(2)  906/   A76F8 :                     
(2)  907/   A76F8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  908/   A76F8 :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  909/   A76F8 :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  910/   A76F8 :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  911/   A76F8 :                     		set vcTLMask1,$80
(2)  912/   A76F8 :                     		set vcTL1,vcTL1&$7F
(2)  913/   A76F8 :                     		set vcTL2,vcTL2&$7F
(2)  914/   A76F8 :                     		set vcTL3,vcTL3&$7F
(2)  915/   A76F8 :                     		set vcTL4,vcTL4&$7F
(2)  916/   A76F8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&$80)<>$80)||(((vcTL2|vcTLMask2)&$80)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&$80)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&$80)<>((vcAlgorithm==7)<<7)))
(2)  917/   A76F8 :                     		if MOMPASS=1
(2)  918/   A76F8 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  919/   A76F8 :                     		endif
(2)  920/   A76F8 :                     	endif
(2)  921/   A76F8 :                     
(2)  922/   A76F8 :                     	if SonicDriverVer==2
(2)  923/   A76F8 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  924/   A76F8 :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  925/   A76F8 :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  926/   A76F8 :                     		dc.b	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  927/   A76F8 :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  928/   A76F8 :                     		dc.b	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  929/   A76F8 :                     	else
(2)  930/   A76F8 :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  931/   A76F8 :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  932/   A76F8 :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  933/   A76F8 :                     		dc.b	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  934/   A76F8 :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  935/   A76F8 :                     		dc.b	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  936/   A76F8 :                     	endif
(2)  937/   A76F8 :                     	endm
(2)  938/   A76F8 :                     
(2)  939/   A76F8 :                     
(1) 2493/   A76F8 :                     
(1) 2494/   A76F8 :                     ; ---------------------------------------------------------------------------
(1) 2495/   A76F8 :                     ; Music data
(1) 2496/   A76F8 :                     ; ---------------------------------------------------------------------------
(1) 2497/   A76F8 :                     Music81:	include "sound/music/Mus81 - GHZ.asm"
(2)    1/   A76F8 :                     Mus81_GHZ_Header:
(2)    2/   A76F8 : (MACRO)              	smpsHeaderStartSong 1
(2)    2/   A76F8 :                     
(2)    2/   A76F8 : =$1                  SourceDriver set 1
(2)    2/   A76F8 :                     
(2)    2/   A76F8 : =>FALSE                      if (""<>"")
(2)    2/   A76F8 :                                     set SourceSMPS2ASM,
(2)    2/   A76F8 : =>TRUE                       else
(2)    2/   A76F8 : =$0                                  set SourceSMPS2ASM,0
(2)    2/   A76F8 : [2]                          endif
(2)    2/   A76F8 :                     
(2)    2/   A76F8 : =$A76F8              songStart set *
(2)    2/   A76F8 :                     
(2)    2/   A76F8 : =>FALSE                      if MOMPASS=1
(2)    2/   A76F8 :                                     if SMPS2ASMVer < SourceSMPS2ASM
(2)    2/   A76F8 :                                             message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)    2/   A76F8 : [2]                                  endif
(2)    2/   A76F8 : [2]                          endif
(2)    2/   A76F8 :                     
(2)    3/   A76F8 : (MACRO)              	smpsHeaderVoice     Mus81_GHZ_Voices
(2)    3/   A76F8 : =>FALSE                      if songStart<>*
(2)    3/   A76F8 :                                     fatal "Missing smpsHeaderStartSong"
(2)    3/   A76F8 : [3]                          endif
(2)    3/   A76F8 : =>FALSE                      if SonicDriverVer<>1
(2)    3/   A76F8 :                                     dc.w    z80_ptr(Mus81_GHZ_Voices)
(2)    3/   A76F8 : =>TRUE                       else
(2)    3/   A76F8 : =>FALSE                              if (MOMPASS=1)&&(DEFINED(Mus81_GHZ_Voices))
(2)    3/   A76F8 :                                             fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)    3/   A76F8 : [3]                                  endif
(2)    3/   A76F8 : 0687                                dc.w    Mus81_GHZ_Voices-songStart
(2)    3/   A76FA : [3]                          endif
(2)    4/   A76FA : (MACRO)              	smpsHeaderChan      $06, $03
(2)    4/   A76FA : 0603                        dc.b    $06,$03
(2)    5/   A76FC : (MACRO)              	smpsHeaderTempo     $01, $03
(2)    5/   A76FC : 01                          dc.b    $01
(2)    5/   A76FD :  (MACRO-2)                   convertMainTempoMod $03
(2)    5/   A76FD : =>TRUE                       if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)    5/   A76FD : 03                                  dc.b    $03
(2)    5/   A76FE : =>FALSE                      elseif SourceDriver==1
(2)    5/   A76FE :                                     if $03==1
(2)    5/   A76FE :                                             fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)    5/   A76FE : [5]                                  endif
(2)    5/   A76FE :                                     if SonicDriverVer==2
(2)    5/   A76FE :                                             dc.b    s1TempotoS2($03)
(2)    5/   A76FE :                                     else;if SonicDriverVer>=3
(2)    5/   A76FE :                                             dc.b    s1TempotoS3($03)
(2)    5/   A76FE : [5]                                  endif
(2)    5/   A76FE : =>FALSE                      elseif SourceDriver==2
(2)    5/   A76FE :                                     if $03==0
(2)    5/   A76FE :                                             fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)    5/   A76FE : [5]                                  endif
(2)    5/   A76FE :                                     if SonicDriverVer==1
(2)    5/   A76FE :                                             dc.b    s2TempotoS1($03)
(2)    5/   A76FE :                                     else;if SonicDriverVer>=3
(2)    5/   A76FE :                                             dc.b    s2TempotoS3($03)
(2)    5/   A76FE : [5]                                  endif
