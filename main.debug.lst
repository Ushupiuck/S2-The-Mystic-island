(2)  769/   1DAAE :                     ; Macros for FM instruments
(2)  770/   1DAAE :                     ; Voices - Feedback
(2)  771/   1DAAE :                     smpsVcFeedback macro val
(2)  772/   1DAAE :                     vcFeedback set val
(2)  773/   1DAAE :                     	endm
(2)  774/   1DAAE :                     
(2)  775/   1DAAE :                     ; Voices - Algorithm
(2)  776/   1DAAE :                     smpsVcAlgorithm macro val
(2)  777/   1DAAE :                     vcAlgorithm set val
(2)  778/   1DAAE :                     	endm
(2)  779/   1DAAE :                     
(2)  780/   1DAAE :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  781/   1DAAE :                     vcUnusedBits set val
(2)  782/   1DAAE :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  783/   1DAAE :                     		set vcD1R1Unk,d1r1<<5
(2)  784/   1DAAE :                     		set vcD1R2Unk,d1r2<<5
(2)  785/   1DAAE :                     		set vcD1R3Unk,d1r3<<5
(2)  786/   1DAAE :                     		set vcD1R4Unk,d1r4<<5
(2)  787/   1DAAE :                     	else
(2)  788/   1DAAE :                     		set vcD1R1Unk,0
(2)  789/   1DAAE :                     		set vcD1R2Unk,0
(2)  790/   1DAAE :                     		set vcD1R3Unk,0
(2)  791/   1DAAE :                     		set vcD1R4Unk,0
(2)  792/   1DAAE :                     	endif
(2)  793/   1DAAE :                     	endm
