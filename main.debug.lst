    8727/    D372 : 227B 002C           		movea.l	Obj_Index-4(pc,d0.w),a1		; load the address of the object's code
    8728/    D376 : 4E91                		jsr	(a1)				; dynamic call! to one of the the entries in Obj_Index
    8729/    D378 : 7000                		moveq	#0,d0
    8730/    D37A :                     
    8731/    D37A :                     loc_CB54:
    8732/    D37A : 41E8 0040           		lea	object_size(a0),a0		; load obj address
    8733/    D37E : 51CF FFEA           		dbf	d7,RunObject
    8734/    D382 : 4E75                		rts
