   23907/   1C5F4 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1C5F4 :                     ; ---------------------------------------------------------------------------
(1)    2/   1C5F4 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1C5F4 :                     ;
(1)    4/   1C5F4 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1C5F4 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1C5F4 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1C5F4 :                     ; bits). The assembled data looks something like this:
(1)    8/   1C5F4 :                     ;
(1)    9/   1C5F4 :                     ; aaBBBBBB
(1)   10/   1C5F4 :                     ; ccDDDDDD
(1)   11/   1C5F4 :                     ; EEEEEE
(1)   12/   1C5F4 :                     ; ffgghhii
(1)   13/   1C5F4 :                     ;
(1)   14/   1C5F4 :                     ; aa = index for primary pattern load request list
(1)   15/   1C5F4 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1C5F4 :                     ; cc = index for secondary pattern load request list
(1)   17/   1C5F4 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1C5F4 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1C5F4 :                     ; ff = unused, always 0
(1)   20/   1C5F4 :                     ; gg = unused, music track
(1)   21/   1C5F4 :                     ; hh = unused, palette
(1)   22/   1C5F4 :                     ; ii = palette
(1)   23/   1C5F4 :                     ;
(1)   24/   1C5F4 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1C5F4 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1C5F4 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1C5F4 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1C5F4 :                     ; ---------------------------------------------------------------------------
(1)   29/   1C5F4 :                     
(1)   30/   1C5F4 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1C5F4 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1C5F4 :                     	dc.l (plc1<<24)|art
(1)   33/   1C5F4 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1C5F4 :                     	dc.l map128x128
(1)   35/   1C5F4 :                     	dc.b 0,music,palette,palette
(1)   36/   1C5F4 :                     	endm
(1)   37/   1C5F4 :                     
(1)   38/   1C5F4 :                     ; MainLoadBlocks:
(1)   39/   1C5F4 :                     LevelArtPointers:
(1)   40/   1C5F4 : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Kosp_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ    ; GHZ  ; GREEN HILL ZONE
(1)   40/   1C5F4 : 0404 F6AA                   dc.l (plcid_GHZ<<24)|Kosp_GHZ
(1)   40/   1C5F8 : 0504 E8F2                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1C5FC : 0005 1C30                   dc.l Map128_GHZ
(1)   40/   1C600 : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1C604 : (MACRO)              		levartptrs plcid_LZ,  plcid_LZ2,  Kosp_CPZ, Map16_CPZ, Map128_CPZ, bgm_LZ,  palid_LZ     ; LZ   ; LABYRINTH ZONE
(1)   41/   1C604 : 0605 93BE                   dc.l (plcid_LZ<<24)|Kosp_CPZ
(1)   41/   1C608 : 0705 7BBE                   dc.l (plcid_LZ2<<24)|Map16_CPZ
(1)   41/   1C60C : 0005 BE5E                   dc.l Map128_CPZ
(1)   41/   1C610 : 0082 0505                   dc.b 0,bgm_LZ,palid_LZ,palid_LZ
(1)   42/   1C614 : (MACRO)              		levartptrs plcid_CPZ, plcid_CPZ2, Kosp_CPZ, Map16_CPZ, Map128_CPZ, bgm_MZ,  palid_CPZ    ; CPZ  ; CHEMICAL PLANT ZONE
(1)   42/   1C614 : 0805 93BE                   dc.l (plcid_CPZ<<24)|Kosp_CPZ
(1)   42/   1C618 : 0905 7BBE                   dc.l (plcid_CPZ2<<24)|Map16_CPZ
(1)   42/   1C61C : 0005 BE5E                   dc.l Map128_CPZ
(1)   42/   1C620 : 0083 0606                   dc.b 0,bgm_MZ,palid_CPZ,palid_CPZ
(1)   43/   1C624 : (MACRO)              		levartptrs plcid_EHZ, plcid_EHZ2, Kosp_EHZ, Map16_EHZ, Map128_EHZ, bgm_SLZ, palid_EHZ    ; EHZ  ; EMERALD HILL ZONE
(1)   43/   1C624 : 0A06 3FE4                   dc.l (plcid_EHZ<<24)|Kosp_EHZ
(1)   43/   1C628 : 0B06 3044                   dc.l (plcid_EHZ2<<24)|Map16_EHZ
(1)   43/   1C62C : 0006 676C                   dc.l Map128_EHZ
(1)   43/   1C630 : 0084 0707                   dc.b 0,bgm_SLZ,palid_EHZ,palid_EHZ
(1)   44/   1C634 : (MACRO)              		levartptrs plcid_HPZ, plcid_HPZ2, Kosp_HPZ, Map16_HPZ, Map128_HPZ, bgm_SYZ, palid_HPZ    ; HPZ  ; HIDDEN PALACE ZONE
(1)   44/   1C634 : 0C05 EA5C                   dc.l (plcid_HPZ<<24)|Kosp_HPZ
(1)   44/   1C638 : 0D05 D47C                   dc.l (plcid_HPZ2<<24)|Map16_HPZ
(1)   44/   1C63C : 0006 151C                   dc.l Map128_HPZ
(1)   44/   1C640 : 0085 0808                   dc.b 0,bgm_SYZ,palid_HPZ,palid_HPZ
(1)   45/   1C644 : (MACRO)              		levartptrs plcid_HTZ, plcid_HTZ2, Kosp_HTZ, Map16_HTZ, Map128_HTZ, bgm_SBZ, palid_HTZ1   ; HTZ  ; HILL TOP ZONE
(1)   45/   1C644 : 0E06 AEBC                   dc.l (plcid_HTZ<<24)|Kosp_HTZ
(1)   45/   1C648 : 0F06 96BC                   dc.l (plcid_HTZ2<<24)|Map16_HTZ
(1)   45/   1C64C : 0006 D436                   dc.l Map128_HTZ
(1)   45/   1C650 : 0086 0909                   dc.b 0,bgm_SBZ,palid_HTZ1,palid_HTZ1
(1)   46/   1C654 : (MACRO)              		levartptrs 0,         0,          Kosp_GHZ, Map16_GHZ, Map128_GHZ, bgm_SBZ, palid_Ending ; LEV6 ; LEVEL 6 (UNUSED, SONIC 1 ENDING)
(1)   46/   1C654 : 0004 F6AA                   dc.l (0<<24)|Kosp_GHZ
(1)   46/   1C658 : 0004 E8F2                   dc.l (0<<24)|Map16_GHZ
(1)   46/   1C65C : 0005 1C30                   dc.l Map128_GHZ
(1)   46/   1C660 : 0086 1313                   dc.b 0,bgm_SBZ,palid_Ending,palid_Ending
   23908/   1C664 :                     		include	"_inc/Pattern Load Cues.asm"
(1)    1/   1C664 :                     ; ---------------------------------------------------------------------------
(1)    2/   1C664 :                     ; PATTERN LOAD REQUEST LISTS
(1)    3/   1C664 :                     ;
(1)    4/   1C664 :                     ; Pattern load request lists are simple structures used to load
(1)    5/   1C664 :                     ; Nemesis-compressed art for sprites.
(1)    6/   1C664 :                     ;
(1)    7/   1C664 :                     ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
(1)    8/   1C664 :                     ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
(1)    9/   1C664 :                     ;
(1)   10/   1C664 :                     
(1)   11/   1C664 :                     ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
(1)   12/   1C664 :                     ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
(1)   13/   1C664 :                     ; overflow and completely screw up the variables stored directly after the queue buffer.
(1)   14/   1C664 :                     ; (in my experience this is a guaranteed crash or hang)
(1)   15/   1C664 :                     ;
(1)   16/   1C664 :                     ; Many levels queue more than 16 items overall, but they don't exceed the limit because
(1)   17/   1C664 :                     ; their PLRs are split into multiple parts (like PLC_GHZ and PLC_GHZ2) and they fully
(1)   18/   1C664 :                     ; process the first part before requesting the rest.
(1)   19/   1C664 :                     ; ---------------------------------------------------------------------------
(1)   20/   1C664 :                     
(1)   21/   1C664 :                     ;---------------------------------------------------------------------------------------
(1)   22/   1C664 :                     ; Table of pattern load request lists. Remember to use word-length data when adding lists
(1)   23/   1C664 :                     ; otherwise you'll break the array.
(1)   24/   1C664 :                     ;---------------------------------------------------------------------------------------
(1)   25/   1C664 :                     ArtLoadCues:
(1)   26/   1C664 :                     
(1)   27/   1C664 : 0040                ptr_PLC_Main:		dc.w PLC_Main-ArtLoadCues
(1)   28/   1C666 : 0054                ptr_PLC_Main2:		dc.w PLC_Main2-ArtLoadCues
(1)   29/   1C668 : 0074                ptr_PLC_Explode:	dc.w PLC_Explode-ArtLoadCues
(1)   30/   1C66A : 007C                ptr_PLC_GameOver:	dc.w PLC_GameOver-ArtLoadCues
