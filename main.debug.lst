(2)  822/   1DAAE :                     	set vcAR2,op2
(2)  823/   1DAAE :                     	set vcAR3,op3
(2)  824/   1DAAE :                     	set vcAR4,op4
(2)  825/   1DAAE :                     	endm
(2)  826/   1DAAE :                     
(2)  827/   1DAAE :                     ; Voices - Amplitude Modulation
(2)  828/   1DAAE :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  829/   1DAAE :                     ; were the Amplitude Modulation.
(2)  830/   1DAAE :                     ; According to several docs, however, it's actually the high bit.
(2)  831/   1DAAE :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  832/   1DAAE :                     	if SourceSMPS2ASM==0
(2)  833/   1DAAE :                     		set vcAM1,op1<<5
(2)  834/   1DAAE :                     		set vcAM2,op2<<5
(2)  835/   1DAAE :                     		set vcAM3,op3<<5
(2)  836/   1DAAE :                     		set vcAM4,op4<<5
(2)  837/   1DAAE :                     	else
(2)  838/   1DAAE :                     		set vcAM1,op1<<7
(2)  839/   1DAAE :                     		set vcAM2,op2<<7
(2)  840/   1DAAE :                     		set vcAM3,op3<<7
(2)  841/   1DAAE :                     		set vcAM4,op4<<7
(2)  842/   1DAAE :                     	endif
(2)  843/   1DAAE :                     	endm
(2)  844/   1DAAE :                     
(2)  845/   1DAAE :                     ; Voices - First Decay Rate
