(2)    5/   1DAB4 :                                     else;if SonicDriverVer==2
(2)    5/   1DAB4 :                                             dc.b    s3TempotoS2($03)
(2)    5/   1DAB4 : [5]                                  endif
(2)    5/   1DAB4 : [5]                          endif
