   22563/   1B312 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; LZ
   22564/   1B314 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; LZ
   22565/   1B316 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; CPZ
