(1) 1664/   1BC64 :                     ; ---------------------------------------------------------------------------
(1) 1665/   1BC64 :                     ; FM Note Values: b-0 to a#8
(1) 1666/   1BC64 :                     ;
(1) 1667/   1BC64 :                     ; Each row is an octave, starting with B and ending with A-sharp/B-flat.
(1) 1668/   1BC64 :                     ; Notably, this differs from the PSG frequency table, which starts with C and
(1) 1669/   1BC64 :                     ; ends with B. This is caused by 'FMSetFreq' subtracting $80 from the note
(1) 1670/   1BC64 :                     ; instead of $81, meaning that the first frequency in the table ironically
(1) 1671/   1BC64 :                     ; corresponds to the 'rest' note. The only way to use this frequency in a
(1) 1672/   1BC64 :                     ; real note is to transpose the channel to a lower semitone.
(1) 1673/   1BC64 :                     ;
(1) 1674/   1BC64 :                     ; Rather than use a complete lookup table, other SMPS drivers such as
(1) 1675/   1BC64 :                     ; Sonic 3's compute the octave, and only store a single octave's worth of
(1) 1676/   1BC64 :                     ; notes in the table.
(1) 1677/   1BC64 :                     ;
(1) 1678/   1BC64 :                     ; Invalid transposition values will cause this table to be overflowed,
(1) 1679/   1BC64 :                     ; resulting in garbage data being used as frequency values. In drivers that
(1) 1680/   1BC64 :                     ; compute the octave instead, invalid transposition values merely cause the
(1) 1681/   1BC64 :                     ; notes to wrap-around (the note below the lowest note will be the highest
(1) 1682/   1BC64 :                     ; note). It's important to keep this in mind when porting buggy songs.
(1) 1683/   1BC64 :                     ; ---------------------------------------------------------------------------
(1) 1684/   1BC64 :                     ; word_72790: FM_Notes:
(1) 1685/   1BC64 :                     FMFrequencies:
(1) 1686/   1BC64 : 025E 0284 02AB      		dc.w $025E,$0284,$02AB,$02D3,$02FE,$032D,$035C,$038F,$03C5,$03FF,$043C,$047C
            1BC6A : 02D3 02FE 032D 
            1BC70 : 035C 038F 03C5 
            1BC76 : 03FF 043C 047C    
(1) 1687/   1BC7C : 0A5E 0A84 0AAB      		dc.w $0A5E,$0A84,$0AAB,$0AD3,$0AFE,$0B2D,$0B5C,$0B8F,$0BC5,$0BFF,$0C3C,$0C7C
            1BC82 : 0AD3 0AFE 0B2D 
            1BC88 : 0B5C 0B8F 0BC5 
            1BC8E : 0BFF 0C3C 0C7C    
(1) 1688/   1BC94 : 125E 1284 12AB      		dc.w $125E,$1284,$12AB,$12D3,$12FE,$132D,$135C,$138F,$13C5,$13FF,$143C,$147C
            1BC9A : 12D3 12FE 132D 
            1BCA0 : 135C 138F 13C5 
            1BCA6 : 13FF 143C 147C    
