(2)   15/   A72D8 :                     
(2)   16/   A72D8 : =$1                  SMPS2ASMVer	= 1
(2)   17/   A72D8 :                     
(2)   18/   A72D8 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   A72D8 : =$C                  psgdelta	EQU 12
(2)   20/   A72D8 :                     ; ---------------------------------------------------------------------------
(2)   21/   A72D8 :                     ; Standard Octave Pitch Equates
(2)   22/   A72D8 :                     	enumconf	$C
(2)   23/   A72D8 : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   A72D8 : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   A72D8 : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   A72D8 : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   A72D8 : =$78                 	nextenum	smpsPitch10hi
(2)   28/   A72D8 :                     	enumconf	1
(2)   29/   A72D8 :                     ; ---------------------------------------------------------------------------
(2)   30/   A72D8 :                     ; Note Equates
(2)   31/   A72D8 : =$80..$8F            	enum		nRst=$80,nC0,nCs0,nD0,nEb0,nE0,nF0,nFs0,nG0,nAb0,nA0,nBb0,nB0,nC1,nCs1,nD1
(2)   32/   A72D8 : =$90..$9F            	nextenum	nEb1,nE1,nF1,nFs1,nG1,nAb1,nA1,nBb1,nB1,nC2,nCs2,nD2,nEb2,nE2,nF2,nFs2
(2)   33/   A72D8 : =$A0..$AF            	nextenum	nG2,nAb2,nA2,nBb2,nB2,nC3,nCs3,nD3,nEb3,nE3,nF3,nFs3,nG3,nAb3,nA3,nBb3
(2)   34/   A72D8 : =$B0..$BF            	nextenum	nB3,nC4,nCs4,nD4,nEb4,nE4,nF4,nFs4,nG4,nAb4,nA4,nBb4,nB4,nC5,nCs5,nD5
(2)   35/   A72D8 : =$C0..$CF            	nextenum	nEb5,nE5,nF5,nFs5,nG5,nAb5,nA5,nBb5,nB5,nC6,nCs6,nD6,nEb6,nE6,nF6,nFs6
(2)   36/   A72D8 : =$D0..$DF            	nextenum	nG6,nAb6,nA6,nBb6,nB6,nC7,nCs7,nD7,nEb7,nE7,nF7,nFs7,nG7,nAb7,nA7,nBb7
(2)   37/   A72D8 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   38/   A72D8 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   39/   A72D8 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   40/   A72D8 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   41/   A72D8 : =>TRUE               	if SonicDriverVer<=2
(2)   42/   A72D8 : =$C6                 nMaxPSG				EQU nA5
(2)   43/   A72D8 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   44/   A72D8 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   45/   A72D8 : =>FALSE              	else
(2)   46/   A72D8 :                     nMaxPSG				EQU nBb6-psgdelta
(2)   47/   A72D8 :                     nMaxPSG1			EQU nBb6
(2)   48/   A72D8 :                     nMaxPSG2			EQU nB6
(2)   49/   A72D8 : [41]                 	endif
(2)   50/   A72D8 :                     ; ---------------------------------------------------------------------------
(2)   51/   A72D8 :                     ; PSG volume envelope equates
(2)   52/   A72D8 : =$1                  	switch SonicDriverVer
(2)   53/   A72D8 : =>TRUE               		case 1
(2)   54/   A72D8 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   55/   A72D8 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   56/   A72D8 : =>FALSE              		case 2
(2)   57/   A72D8 :                     			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   58/   A72D8 :                     			nextenum	fTone_07,fTone_08,fTone_09,fTone_0A,fTone_0B,fTone_0C
(2)   59/   A72D8 :                     			nextenum	fTone_0D
(2)   60/   A72D8 : =>FALSE              		elsecase;SonicDriverVer>=3
(2)   61/   A72D8 :                     			enum		sTone_01=$01,sTone_02,sTone_03,sTone_04,sTone_05,sTone_06
(2)   62/   A72D8 :                     			nextenum	sTone_07,sTone_08,sTone_09,sTone_0A,sTone_0B,sTone_0C
(2)   63/   A72D8 :                     			nextenum	sTone_0D,sTone_0E,sTone_0F,sTone_10,sTone_11,sTone_12
(2)   64/   A72D8 :                     			nextenum	sTone_13,sTone_14,sTone_15,sTone_16,sTone_17,sTone_18
(2)   65/   A72D8 :                     			nextenum	sTone_19,sTone_1A,sTone_1B,sTone_1C,sTone_1D,sTone_1E
(2)   66/   A72D8 :                     			nextenum	sTone_1F,sTone_20,sTone_21,sTone_22,sTone_23,sTone_24
(2)   67/   A72D8 :                     			nextenum	sTone_25,sTone_26,sTone_27
(2)   68/   A72D8 :                     			; For conversions:
(2)   69/   A72D8 :                     			if SonicDriverVer>=5
(2)   70/   A72D8 :                     				nextenum	fTone_01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   71/   A72D8 :                     				nextenum	fTone_07,fTone_08,fTone_09,fTone_0A,fTone_0B,fTone_0C
(2)   72/   A72D8 :                     				nextenum	fTone_0D
(2)   73/   A72D8 : [69]                 			endif
(2)   74/   A72D8 : [52]                 	endcase
(2)   75/   A72D8 :                     ; ---------------------------------------------------------------------------
(2)   76/   A72D8 :                     ; DAC Equates
(2)   77/   A72D8 : =$1                  	switch SonicDriverVer
(2)   78/   A72D8 : =>TRUE               		case 1
(2)   79/   A72D8 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   80/   A72D8 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)   81/   A72D8 : =>FALSE              		case 2
