   22569/   1B31E : 0044                		dc.w Dynamic_Normal-DynArtCue_Index	; HPZ
   22570/   1B320 : 010E                		dc.w AnimCue_HPZ-DynArtCue_Index	; HPZ
   22571/   1B322 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index	; HTZ
   22572/   1B324 : 00B0                		dc.w AnimCue_EHZ-DynArtCue_Index	; HTZ
   22573/   1B326 : 0040                		dc.w Dynamic_Null-DynArtCue_Index	; 06
