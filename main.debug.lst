    5437/    73AC :                     ScrollHoriz:
    5438/    73AC : =>TRUE               	if FixBugs
    5439/    73AC :                     		; To prevent the bug that is described below, this caps the position
    5440/    73AC :                     		; array index offset so that it does not access position data from
    5441/    73AC :                     		; before the spin dash was performed. Note that this required
    5442/    73AC :                     		; modifications to 'Sonic_UpdateSpindash' and 'Tails_UpdateSpindash'.
    5443/    73AC : 1215                		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5444/    73AE : 6722                		beq.s	.scrollNotDelayed				; if not, branch
    5445/    73B0 : E509                		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5446/    73B2 : 5315                		subq.b	#1,Horiz_scroll_delay_val-Camera_Delay(a5)	; reduce delay value
    5447/    73B4 : 102D 0003           		move.b	Sonic_Pos_Record_Index+1-Camera_Delay(a5),d0
    5448/    73B8 : 902D 0001           		sub.b	Horiz_scroll_delay_val+1-Camera_Delay(a5),d0
    5449/    73BC : B200                		cmp.b	d0,d1
    5450/    73BE : 6502                		blo.s	.doNotCap
    5451/    73C0 : 1200                		move.b	d0,d1
    5452/    73C2 :                     .doNotCap:
    5453/    73C2 : =>FALSE              	else
    5454/    73C2 :                     		; The intent of this code is to make the camera briefly lag behind the
    5455/    73C2 :                     		; player right after releasing a spin dash, however it does this by
    5456/    73C2 :                     		; simply making the camera use position data from previous frames. This
    5457/    73C2 :                     		; means that if the camera had been moving recently enough, then
    5458/    73C2 :                     		; releasing a spin dash will cause the camera to jerk around instead of
    5459/    73C2 :                     		; remain still. This can be encountered by running into a wall, and
    5460/    73C2 :                     		; quickly turning around and spin dashing away. Sonic 3 would have had
    5461/    73C2 :                     		; this same issue with the Fire Shield's dash abiliity, but it shoddily
    5462/    73C2 :                     		; works around the issue by resetting the old position values to the
    5463/    73C2 :                     		; current position (see 'Reset_Player_Position_Array').
    5464/    73C2 :                     		move.w	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5465/    73C2 :                     		beq.s	.scrollNotDelayed				; if not, branch
    5466/    73C2 :                     		subi.w	#$100,d1					; reduce delay value
    5467/    73C2 :                     		move.w	d1,Horiz_scroll_delay_val-Camera_Delay(a5)
    5468/    73C2 :                     		moveq	#0,d1
    5469/    73C2 :                     		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; get delay value
    5470/    73C2 :                     		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5471/    73C2 :                     		addq.b	#4,d1
    5472/    73C2 : [5438]               	endif
