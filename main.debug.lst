   23960/   1FA70 : (MACRO)              		align $20
   23960/   1FA70 :  (MACRO-2)                   cnop 0,$20
   23960/   1FA70 : =>TRUE                       if notZ80(MOMCPU)
   23960/   1FA70 :   (MACRO-3)                          org (*-1+($20)-((*-1+(-(0)))#($20)))
   23960/   1FA70 : =>TRUE                       if notZ80(MOMCPU)
   23960/   1FA70 : =>FALSE                              if (*-1+($20)-((*-1+(-(0)))#($20))) < *
   23960/   1FA70 :                                             error "too much stuff before org $\{(*-1+($20)-((*-1+(-(0)))#($20)))} ($\{(*-(*-1+($20)-((*-1+(-(0)))#($20))))} bytes)"
