    1250/    1666 :                     		include "_inc/DMA Queue.asm"
(1)    1/    1666 :                     ; ---------------------------------------------------------------------------
(1)    2/    1666 :                     ; MACRO ResetDMAQueue
(1)    3/    1666 :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    1666 :                     ; ---------------------------------------------------------------------------
(1)    5/    1666 :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    1666 :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    1666 :                     ;
(1)    8/    1666 :                     ; Output:
(1)    9/    1666 :                     ; 	a1,a5	trashed
(1)   10/    1666 :                     ; ---------------------------------------------------------------------------
(1)   11/    1666 :                     ; ROUTINE InitDMAQueue
(1)   12/    1666 :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    1666 :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    1666 :                     ; write to this region of RAM.
(1)   15/    1666 :                     ;
(1)   16/    1666 :                     ; Output:
(1)   17/    1666 :                     ; 	a0,d0,d1	trashed
(1)   18/    1666 :                     ; ---------------------------------------------------------------------------
(1)   19/    1666 :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    1666 :                     ; Queues a DMA with parameters given in registers.
(1)   21/    1666 :                     ;
(1)   22/    1666 :                     ; Options:
(1)   23/    1666 :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    1666 :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    1666 :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    1666 :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    1666 :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    1666 :                     ; Input:
(1)   29/    1666 :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    1666 :                     ; 		set to 0)
(1)   31/    1666 :                     ; 	d2	Destination address
(1)   32/    1666 :                     ; 	d3	Transfer length (in words)
(1)   33/    1666 :                     ; Output:
(1)   34/    1666 :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    1666 :                     ;
(1)   36/    1666 :                     ; With the default settings, runs in:
(1)   37/    1666 :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    1666 :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    1666 :                     ;
(1)   40/    1666 :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    1666 :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    1666 :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    1666 :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    1666 :                     ;   fills the queue (second piece is discarded)
(1)   45/    1666 :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    1666 :                     ;   space for both pieces (both pieces queued)
(1)   47/    1666 :                     ;
(1)   48/    1666 :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    1666 :                     ;
(1)   50/    1666 :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    1666 :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    1666 :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    1666 :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    1666 :                     ;
(1)   55/    1666 :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    1666 :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    1666 :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    1666 :                     ; in the correct form.
(1)   59/    1666 :                     ; ---------------------------------------------------------------------------
(1)   60/    1666 :                     ; MACRO QueueStaticDMA
(1)   61/    1666 :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    1666 :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    1666 :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    1666 :                     ;
(1)   65/    1666 :                     ; The destination parameter can be either:
(1)   66/    1666 :                     ; * a VRAM address literal;
(1)   67/    1666 :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    1666 :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    1666 :                     ;
(1)   70/    1666 :                     ; Options:
(1)   71/    1666 :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    1666 :                     ; Input:
(1)   73/    1666 :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    1666 :                     ; Output:
(1)   75/    1666 :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    1666 :                     ;
(1)   77/    1666 :                     ; With the default settings, runs in:
(1)   78/    1666 :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    1666 :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    1666 :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    1666 :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    1666 :                     ;
(1)   83/    1666 :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    1666 :                     ; ===========================================================================
(1)   85/    1666 :                     ; option: AssumeSourceAddressInBytes
(1)   86/    1666 :                     ;
(1)   87/    1666 :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    1666 :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    1666 :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    1666 : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    1666 :                     ; ===========================================================================
(1)   92/    1666 :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    1666 :                     ;
(1)   94/    1666 :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    1666 :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    1666 :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    1666 :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    1666 : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    1666 :                     ; ===========================================================================
(1)  100/    1666 :                     ; option: UseRAMSourceSafeDMA
(1)  101/    1666 :                     ;
(1)  102/    1666 :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    1666 :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    1666 :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    1666 : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    1666 :                     ; ===========================================================================
(1)  107/    1666 :                     ; option: Use128kbSafeDMA
(1)  108/    1666 :                     ;
(1)  109/    1666 :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    1666 :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    1666 :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    1666 :                     ; the job in situations where you can't align it in ROM.
(1)  113/    1666 : =$1                  Use128kbSafeDMA = 1
(1)  114/    1666 :                     ; ===========================================================================
(1)  115/    1666 :                     ; option UseVIntSafeDMA
(1)  116/    1666 :                     ;
(1)  117/    1666 :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    1666 :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    1666 :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    1666 :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    1666 :                     ; restore interrupts after.
(1)  122/    1666 : =$1                  UseVIntSafeDMA = 1
(1)  123/    1666 :                     ; ===========================================================================
(1)  124/    1666 :                     ; Convenience macros, for increased maintainability of the code.
(1)  125/    1666 : =>DEFINED            	ifndef DMA
(1)  126/    1666 :                     		equ	DMA,%100111
(1)  127/    1666 : [125]                	endif
(1)  128/    1666 : =>DEFINED            	ifndef VRAM
(1)  129/    1666 :                     		equ	VRAM,%100001
(1)  130/    1666 : [128]                	endif
(1)  131/    1666 : =>UNDEFINED          	ifndef vdpCommReg_defined
(1)  132/    1666 :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    1666 : =$1                  vdpCommReg_defined = 1
(1)  134/    1666 :                     vdpCommReg macro reg,type,rwd,clr
(1)  135/    1666 :                     	lsl.l	#2,reg							; Move high bits into (word-swapped) position, accidentally moving everything else
(1)  136/    1666 :                     	set .upperbits,(type&rwd)&3
(1)  137/    1666 :                     	if .upperbits<>0
(1)  138/    1666 :                     		addq.w	#.upperbits,reg				; Add upper access type bits
(1)  139/    1666 :                     	endif
(1)  140/    1666 :                     	ror.w	#2,reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
(1)  141/    1666 :                     	swap	reg								; Put all bits in proper places
(1)  142/    1666 :                     	if clr <> 0
(1)  143/    1666 :                     		andi.w	#3,reg						; Strip whatever junk was in upper word of reg
(1)  144/    1666 :                     	endif
(1)  145/    1666 :                     	set .lowerbits,(type&rwd)&$FC
(1)  146/    1666 :                     	if .lowerbits==$20
(1)  147/    1666 :                     		tas.b	reg							; Add in the DMA flag -- tas fails on memory, but works on registers
(1)  148/    1666 :                     	elseif .lowerbits<>0
(1)  149/    1666 :                     		ori.w	#(.lowerbits<<2),reg		; Add in missing access type bits
(1)  150/    1666 :                     	endif
(1)  151/    1666 :                     	endm
(1)  152/    1666 : [131]                	endif
(1)  153/    1666 :                     ; ---------------------------------------------------------------------------
