   22993/   19B62 :                     ; Subroutine to draw the HUD
   22994/   19B62 :                     ; ---------------------------------------------------------------------------
   22995/   19B62 :                     
   22996/   19B62 : =$2                  hud_letter_num_tiles = 2
   22997/   19B62 : =$400000             hud_letter_vdp_delta = vdpCommDelta(tiles_to_bytes(hud_letter_num_tiles))
   22998/   19B62 :                     
