(2)  158/   A76F8 :                     ; ---------------------------------------------------------------------------
(2)  159/   A76F8 :                     ; Channel IDs for SFX
(2)  160/   A76F8 : =$80                 cPSG1				EQU $80
(2)  161/   A76F8 : =$A0                 cPSG2				EQU $A0
(2)  162/   A76F8 : =$C0                 cPSG3				EQU $C0
(2)  163/   A76F8 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  164/   A76F8 : =$2                  cFM3				EQU $02
(2)  165/   A76F8 : =$4                  cFM4				EQU $04
(2)  166/   A76F8 : =$5                  cFM5				EQU $05
(2)  167/   A76F8 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  168/   A76F8 :                     ; ---------------------------------------------------------------------------
(2)  169/   A76F8 :                     ; Conversion macros and functions
(2)  170/   A76F8 :                     
(2)  171/   A76F8 :                     conv0To256  function n,((n==0)<<8)|n
(2)  172/   A76F8 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  173/   A76F8 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  174/   A76F8 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  175/   A76F8 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  176/   A76F8 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  177/   A76F8 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  178/   A76F8 :                     
(2)  179/   A76F8 :                     convertMainTempoMod macro mod
(2)  180/   A76F8 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  181/   A76F8 :                     		dc.b	mod
(2)  182/   A76F8 :                     	elseif SourceDriver==1
(2)  183/   A76F8 :                     		if mod==1
(2)  184/   A76F8 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  185/   A76F8 :                     		endif
(2)  186/   A76F8 :                     		if SonicDriverVer==2
(2)  187/   A76F8 :                     			dc.b	s1TempotoS2(mod)
(2)  188/   A76F8 :                     		else;if SonicDriverVer>=3
(2)  189/   A76F8 :                     			dc.b	s1TempotoS3(mod)
(2)  190/   A76F8 :                     		endif
(2)  191/   A76F8 :                     	elseif SourceDriver==2
(2)  192/   A76F8 :                     		if mod==0
(2)  193/   A76F8 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  194/   A76F8 :                     		endif
(2)  195/   A76F8 :                     		if SonicDriverVer==1
(2)  196/   A76F8 :                     			dc.b	s2TempotoS1(mod)
(2)  197/   A76F8 :                     		else;if SonicDriverVer>=3
(2)  198/   A76F8 :                     			dc.b	s2TempotoS3(mod)
(2)  199/   A76F8 :                     		endif
(2)  200/   A76F8 :                     	else;if SourceDriver>=3
(2)  201/   A76F8 :                     		if mod==0
(2)  202/   A76F8 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  203/   A76F8 :                     		endif
(2)  204/   A76F8 :                     		if SonicDriverVer==1
(2)  205/   A76F8 :                     			dc.b	s3TempotoS1(mod)
(2)  206/   A76F8 :                     		else;if SonicDriverVer==2
(2)  207/   A76F8 :                     			dc.b	s3TempotoS2(mod)
(2)  208/   A76F8 :                     		endif
(2)  209/   A76F8 :                     	endif
(2)  210/   A76F8 :                     	endm
(2)  211/   A76F8 :                     
(2)  212/   A76F8 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  213/   A76F8 :                     PSGPitchConvert macro pitch
(2)  214/   A76F8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  215/   A76F8 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  216/   A76F8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  217/   A76F8 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  218/   A76F8 :                     	else
(2)  219/   A76F8 :                     		dc.b	pitch
(2)  220/   A76F8 :                     	endif
(2)  221/   A76F8 :                     	endm
(2)  222/   A76F8 :                     
(2)  223/   A76F8 :                     CheckedChannelPointer macro loc
(2)  224/   A76F8 :                     	if SonicDriverVer<>1
(2)  225/   A76F8 :                     		dc.w	z80_ptr(loc)
(2)  226/   A76F8 :                     	else
(2)  227/   A76F8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  228/   A76F8 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  229/   A76F8 :                     		endif
(2)  230/   A76F8 :                     		dc.w	loc-songStart
(2)  231/   A76F8 :                     	endif
(2)  232/   A76F8 :                     	endm
(2)  233/   A76F8 :                     ; ---------------------------------------------------------------------------
(2)  234/   A76F8 :                     ; Header Macros
(2)  235/   A76F8 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  236/   A76F8 :                     
(2)  237/   A76F8 :                     SourceDriver set ver
(2)  238/   A76F8 :                     
(2)  239/   A76F8 :                     	if ("sourcesmps2asmver"<>"")
(2)  240/   A76F8 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  241/   A76F8 :                     	else
(2)  242/   A76F8 :                     		set SourceSMPS2ASM,0
(2)  243/   A76F8 :                     	endif
(2)  244/   A76F8 :                     
(2)  245/   A76F8 :                     songStart set *
(2)  246/   A76F8 :                     
(2)  247/   A76F8 :                     	if MOMPASS=1
(2)  248/   A76F8 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  249/   A76F8 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  250/   A76F8 :                     		endif
(2)  251/   A76F8 :                     	endif
(2)  252/   A76F8 :                     
(2)  253/   A76F8 :                     	endm
(2)  254/   A76F8 :                     
(2)  255/   A76F8 :                     smpsHeaderVoiceNull macro
(2)  256/   A76F8 :                     	if songStart<>*
(2)  257/   A76F8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  258/   A76F8 :                     	endif
(2)  259/   A76F8 :                     	dc.w	$0000
(2)  260/   A76F8 :                     	endm
(2)  261/   A76F8 :                     
(2)  262/   A76F8 :                     ; Header - Set up Voice Location
(2)  263/   A76F8 :                     ; Common to music and SFX
(2)  264/   A76F8 :                     smpsHeaderVoice macro loc
(2)  265/   A76F8 :                     	if songStart<>*
(2)  266/   A76F8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  267/   A76F8 :                     	endif
(2)  268/   A76F8 :                     	if SonicDriverVer<>1
(2)  269/   A76F8 :                     		dc.w	z80_ptr(loc)
(2)  270/   A76F8 :                     	else
(2)  271/   A76F8 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  272/   A76F8 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  273/   A76F8 :                     		endif
(2)  274/   A76F8 :                     		dc.w	loc-songStart
(2)  275/   A76F8 :                     	endif
(2)  276/   A76F8 :                     	endm
(2)  277/   A76F8 :                     
(2)  278/   A76F8 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  279/   A76F8 :                     ; Common to music and SFX
(2)  280/   A76F8 :                     smpsHeaderVoiceUVB macro
(2)  281/   A76F8 :                     	if songStart<>*
(2)  282/   A76F8 :                     		fatal "Missing smpsHeaderStartSong"
(2)  283/   A76F8 :                     	endif
(2)  284/   A76F8 :                     	if SonicDriverVer>=5
(2)  285/   A76F8 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  286/   A76F8 :                     	elseif SonicDriverVer>=3
(2)  287/   A76F8 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  288/   A76F8 :                     	else
(2)  289/   A76F8 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  290/   A76F8 :                     	endif
(2)  291/   A76F8 :                     	endm
(2)  292/   A76F8 :                     
(2)  293/   A76F8 :                     ; Header macros for music (not for SFX)
(2)  294/   A76F8 :                     ; Header - Set up Channel Usage
(2)  295/   A76F8 :                     smpsHeaderChan macro fm,psg
(2)  296/   A76F8 :                     	dc.b	fm,psg
(2)  297/   A76F8 :                     	endm
(2)  298/   A76F8 :                     
(2)  299/   A76F8 :                     ; Header - Set up Tempo
(2)  300/   A76F8 :                     smpsHeaderTempo macro div,mod
(2)  301/   A76F8 :                     	dc.b	div
(2)  302/   A76F8 :                     	convertMainTempoMod mod
(2)  303/   A76F8 :                     	endm
(2)  304/   A76F8 :                     
(2)  305/   A76F8 :                     ; Header - Set up DAC Channel
(2)  306/   A76F8 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  307/   A76F8 :                     	CheckedChannelPointer loc
(2)  308/   A76F8 :                     	if ("pitch"<>"")
(2)  309/   A76F8 :                     		dc.b	pitch
(2)  310/   A76F8 :                     		if ("vol"<>"")
(2)  311/   A76F8 :                     			dc.b	vol
(2)  312/   A76F8 :                     		else
(2)  313/   A76F8 :                     			dc.b	$00
(2)  314/   A76F8 :                     		endif
(2)  315/   A76F8 :                     	else
(2)  316/   A76F8 :                     		dc.w	$00
(2)  317/   A76F8 :                     	endif
(2)  318/   A76F8 :                     	endm
(2)  319/   A76F8 :                     
(2)  320/   A76F8 :                     ; Header - Set up FM Channel
(2)  321/   A76F8 :                     smpsHeaderFM macro loc,pitch,vol
(2)  322/   A76F8 :                     	CheckedChannelPointer loc
(2)  323/   A76F8 :                     	dc.b	pitch,vol
(2)  324/   A76F8 :                     	endm
(2)  325/   A76F8 :                     
(2)  326/   A76F8 :                     ; Header - Set up PSG Channel
(2)  327/   A76F8 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  328/   A76F8 :                     	CheckedChannelPointer loc
(2)  329/   A76F8 :                     	PSGPitchConvert pitch
(2)  330/   A76F8 :                     	dc.b	vol
(2)  331/   A76F8 :                     	; Frequency envelope
(2)  332/   A76F8 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  333/   A76F8 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  334/   A76F8 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  335/   A76F8 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  336/   A76F8 :                     		dc.b	0
(2)  337/   A76F8 :                     	else
(2)  338/   A76F8 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  339/   A76F8 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  340/   A76F8 :                     		endif
(2)  341/   A76F8 :                     		dc.b	mod
(2)  342/   A76F8 :                     	endif
(2)  343/   A76F8 :                     	; Volume envelope
(2)  344/   A76F8 :                     	dc.b	voice
(2)  345/   A76F8 :                     	endm
(2)  346/   A76F8 :                     
(2)  347/   A76F8 :                     ; Header macros for SFX (not for music)
(2)  348/   A76F8 :                     ; Header - Set up Tempo
(2)  349/   A76F8 :                     smpsHeaderTempoSFX macro div
(2)  350/   A76F8 :                     	dc.b	div
(2)  351/   A76F8 :                     	endm
(2)  352/   A76F8 :                     
(2)  353/   A76F8 :                     ; Header - Set up Channel Usage
(2)  354/   A76F8 :                     smpsHeaderChanSFX macro chan
(2)  355/   A76F8 :                     	dc.b	chan
(2)  356/   A76F8 :                     	endm
(2)  357/   A76F8 :                     
(2)  358/   A76F8 :                     ; Header - Set up FM Channel
(2)  359/   A76F8 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  360/   A76F8 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  361/   A76F8 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  362/   A76F8 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  363/   A76F8 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  364/   A76F8 :                     	endif
(2)  365/   A76F8 :                     	dc.b	$80,chanid
(2)  366/   A76F8 :                     	CheckedChannelPointer loc
(2)  367/   A76F8 :                     	if (chanid&$80)<>0
(2)  368/   A76F8 :                     		PSGPitchConvert pitch
(2)  369/   A76F8 :                     	else
(2)  370/   A76F8 :                     		dc.b	pitch
(2)  371/   A76F8 :                     	endif
(2)  372/   A76F8 :                     	dc.b	vol
(2)  373/   A76F8 :                     	endm
(2)  374/   A76F8 :                     ; ---------------------------------------------------------------------------
(2)  375/   A76F8 :                     ; Co-ord Flag Macros and Equates
(2)  376/   A76F8 :                     ; E0xx - Panning, AMS, FMS
(2)  377/   A76F8 :                     smpsPan macro direction,amsfms
(2)  378/   A76F8 :                     panNone set $00
(2)  379/   A76F8 :                     panRight set $40
(2)  380/   A76F8 :                     panLeft set $80
(2)  381/   A76F8 :                     panCentre set $C0
(2)  382/   A76F8 :                     panCenter set $C0 ; silly Americans :U
(2)  383/   A76F8 :                     	dc.b $E0,direction+amsfms
(2)  384/   A76F8 :                     	endm
(2)  385/   A76F8 :                     
(2)  386/   A76F8 :                     ; E1xx - Set channel detune to val
(2)  387/   A76F8 :                     smpsDetune macro val
(2)  388/   A76F8 :                     	dc.b	$E1,val
(2)  389/   A76F8 :                     	endm
(2)  390/   A76F8 :                     
(2)  391/   A76F8 :                     ; E2xx - Useless
(2)  392/   A76F8 :                     smpsNop macro val
(2)  393/   A76F8 :                     	if SonicDriverVer<3
(2)  394/   A76F8 :                     		dc.b	$E2,val
(2)  395/   A76F8 :                     	endif
(2)  396/   A76F8 :                     	endm
(2)  397/   A76F8 :                     
(2)  398/   A76F8 :                     ; Return (used after smpsCall)
(2)  399/   A76F8 :                     smpsReturn macro val
(2)  400/   A76F8 :                     	if SonicDriverVer>=3
(2)  401/   A76F8 :                     		dc.b	$F9
(2)  402/   A76F8 :                     	else
(2)  403/   A76F8 :                     		dc.b	$E3
(2)  404/   A76F8 :                     	endif
(2)  405/   A76F8 :                     	endm
(2)  406/   A76F8 :                     
(2)  407/   A76F8 :                     ; Fade in previous song (ie. 1-Up)
(2)  408/   A76F8 :                     smpsFade macro val
(2)  409/   A76F8 :                     	if SonicDriverVer>=3
(2)  410/   A76F8 :                     		dc.b	$E2
(2)  411/   A76F8 :                     		if ("val"<>"")
(2)  412/   A76F8 :                     			dc.b	val
(2)  413/   A76F8 :                     		else
(2)  414/   A76F8 :                     			dc.b	$FF
(2)  415/   A76F8 :                     		endif
(2)  416/   A76F8 :                     		if SourceDriver<3
(2)  417/   A76F8 :                     			smpsStop
(2)  418/   A76F8 :                     		endif
(2)  419/   A76F8 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  420/   A76F8 :                     		; This is one of those weird S3+ "fades" that we don't need
(2)  421/   A76F8 :                     	else
(2)  422/   A76F8 :                     		dc.b	$E4
(2)  423/   A76F8 :                     	endif
(2)  424/   A76F8 :                     	endm
(2)  425/   A76F8 :                     
(2)  426/   A76F8 :                     ; E5xx - Set channel tempo divider to xx
(2)  427/   A76F8 :                     smpsChanTempoDiv macro val
(2)  428/   A76F8 :                     	if SonicDriverVer>=5
(2)  429/   A76F8 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  430/   A76F8 :                     		dc.b	$FF,$08,val
(2)  431/   A76F8 :                     	elseif SonicDriverVer==3
(2)  432/   A76F8 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  433/   A76F8 :                     	else
(2)  434/   A76F8 :                     		dc.b	$E5,val
(2)  435/   A76F8 :                     	endif
(2)  436/   A76F8 :                     	endm
(2)  437/   A76F8 :                     
(2)  438/   A76F8 :                     ; E6xx - Alter Volume by xx
(2)  439/   A76F8 :                     smpsAlterVol macro val
(2)  440/   A76F8 :                     	dc.b	$E6,val
(2)  441/   A76F8 :                     	endm
(2)  442/   A76F8 :                     
(2)  443/   A76F8 :                     ; E7 - Prevent attack of next note
(2)  444/   A76F8 : =$E7                 smpsNoAttack	EQU $E7
(2)  445/   A76F8 :                     
(2)  446/   A76F8 :                     ; E8xx - Set note fill to xx
(2)  447/   A76F8 :                     smpsNoteFill macro val
(2)  448/   A76F8 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  449/   A76F8 :                     		; Unique to Flamewing's modified driver
(2)  450/   A76F8 :                     		dc.b	$FF,$0A,val
(2)  451/   A76F8 :                     	else
(2)  452/   A76F8 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  453/   A76F8 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  454/   A76F8 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  455/   A76F8 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  456/   A76F8 :                     		endif
(2)  457/   A76F8 :                     		dc.b	$E8,val
(2)  458/   A76F8 :                     	endif
(2)  459/   A76F8 :                     	endm
(2)  460/   A76F8 :                     
(2)  461/   A76F8 :                     ; Add xx to channel pitch
(2)  462/   A76F8 :                     smpsChangeTransposition macro val
(2)  463/   A76F8 :                     	if SonicDriverVer>=3
(2)  464/   A76F8 :                     		dc.b	$FB,val
(2)  465/   A76F8 :                     	else
(2)  466/   A76F8 :                     		dc.b	$E9,val
(2)  467/   A76F8 :                     	endif
(2)  468/   A76F8 :                     	endm
(2)  469/   A76F8 :                     
(2)  470/   A76F8 :                     ; Set music tempo modifier to xx
(2)  471/   A76F8 :                     smpsSetTempoMod macro mod
(2)  472/   A76F8 :                     	if SonicDriverVer>=3
(2)  473/   A76F8 :                     		dc.b	$FF,$00
(2)  474/   A76F8 :                     	else
(2)  475/   A76F8 :                     		dc.b	$EA
(2)  476/   A76F8 :                     	endif
(2)  477/   A76F8 :                     	convertMainTempoMod mod
(2)  478/   A76F8 :                     	endm
(2)  479/   A76F8 :                     
(2)  480/   A76F8 :                     ; Set music tempo divider to xx
(2)  481/   A76F8 :                     smpsSetTempoDiv macro val
(2)  482/   A76F8 :                     	if SonicDriverVer>=3
(2)  483/   A76F8 :                     		dc.b	$FF,$04,val
(2)  484/   A76F8 :                     	else
(2)  485/   A76F8 :                     		dc.b	$EB,val
(2)  486/   A76F8 :                     	endif
(2)  487/   A76F8 :                     	endm
(2)  488/   A76F8 :                     
(2)  489/   A76F8 :                     ; ECxx - Set Volume to xx
(2)  490/   A76F8 :                     smpsSetVol macro val
(2)  491/   A76F8 :                     	if SonicDriverVer>=3
(2)  492/   A76F8 :                     		dc.b	$E4,val
(2)  493/   A76F8 :                     	else
(2)  494/   A76F8 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  495/   A76F8 :                     	endif
(2)  496/   A76F8 :                     	endm
(2)  497/   A76F8 :                     
(2)  498/   A76F8 :                     ; Works on all drivers
(2)  499/   A76F8 :                     smpsPSGAlterVol macro vol
(2)  500/   A76F8 :                     	dc.b	$EC,vol
(2)  501/   A76F8 :                     	endm
(2)  502/   A76F8 :                     
(2)  503/   A76F8 :                     smpsPSGAlterVolS2 macro vol
(2)  504/   A76F8 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  505/   A76F8 :                     	if SonicDriverVer==2
(2)  506/   A76F8 :                     		smpsAlterVol vol
(2)  507/   A76F8 :                     	else
(2)  508/   A76F8 :                     		smpsPSGAlterVol vol
(2)  509/   A76F8 :                     	endif
(2)  510/   A76F8 :                     	endm
(2)  511/   A76F8 :                     
(2)  512/   A76F8 :                     ; Clears pushing sound flag in S1
(2)  513/   A76F8 :                     smpsClearPush macro
(2)  514/   A76F8 :                     	if SonicDriverVer==1
(2)  515/   A76F8 :                     		dc.b	$ED
(2)  516/   A76F8 :                     	else
(2)  517/   A76F8 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  518/   A76F8 :                     	endif
(2)  519/   A76F8 :                     	endm
(2)  520/   A76F8 :                     
(2)  521/   A76F8 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  522/   A76F8 :                     smpsStopSpecial macro
(2)  523/   A76F8 :                     	if SonicDriverVer==1
(2)  524/   A76F8 :                     		dc.b	$EE
(2)  525/   A76F8 :                     	else
(2)  526/   A76F8 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  527/   A76F8 :                     		smpsStop
(2)  528/   A76F8 :                     	endif
(2)  529/   A76F8 :                     	endm
(2)  530/   A76F8 :                     
(2)  531/   A76F8 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  532/   A76F8 :                     smpsFMvoice macro voice,songID
(2)  533/   A76F8 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  534/   A76F8 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  535/   A76F8 :                     	else
(2)  536/   A76F8 :                     		dc.b	$EF,voice
(2)  537/   A76F8 :                     	endif
(2)  538/   A76F8 :                     	endm
(2)  539/   A76F8 :                     
(2)  540/   A76F8 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  541/   A76F8 :                     smpsModSet macro wait,speed,change,step
(2)  542/   A76F8 :                     	dc.b	$F0
(2)  543/   A76F8 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  544/   A76F8 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  545/   A76F8 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  546/   A76F8 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  547/   A76F8 :                     	else
(2)  548/   A76F8 :                     		dc.b	wait,speed,change,step
(2)  549/   A76F8 :                     	endif
(2)  550/   A76F8 :                     	;dc.b	speed,change,step
(2)  551/   A76F8 :                     	endm
(2)  552/   A76F8 :                     
(2)  553/   A76F8 :                     ; Turn on Modulation
(2)  554/   A76F8 :                     smpsModOn macro type
(2)  555/   A76F8 :                     	if SonicDriverVer>=3
(2)  556/   A76F8 :                     		if "type"<>""
(2)  557/   A76F8 :                     			dc.b	$F4,type
(2)  558/   A76F8 :                     		else
(2)  559/   A76F8 :                     			dc.b	$F4,$80
(2)  560/   A76F8 :                     		endif
(2)  561/   A76F8 :                     	else
(2)  562/   A76F8 :                     		dc.b	$F1
(2)  563/   A76F8 :                     	endif
(2)  564/   A76F8 :                     	endm
(2)  565/   A76F8 :                     
(2)  566/   A76F8 :                     ; F2 - End of channel
(2)  567/   A76F8 :                     smpsStop macro
(2)  568/   A76F8 :                     	dc.b	$F2
(2)  569/   A76F8 :                     	endm
(2)  570/   A76F8 :                     
(2)  571/   A76F8 :                     ; F3xx - PSG waveform to xx
(2)  572/   A76F8 :                     smpsPSGform macro form
(2)  573/   A76F8 :                     	dc.b	$F3,form
(2)  574/   A76F8 :                     	endm
(2)  575/   A76F8 :                     
(2)  576/   A76F8 :                     ; Turn off Modulation
(2)  577/   A76F8 :                     smpsModOff macro
(2)  578/   A76F8 :                     	if SonicDriverVer>=3
(2)  579/   A76F8 :                     		dc.b	$FA
(2)  580/   A76F8 :                     	else
(2)  581/   A76F8 :                     		dc.b	$F4
(2)  582/   A76F8 :                     	endif
(2)  583/   A76F8 :                     	endm
(2)  584/   A76F8 :                     
(2)  585/   A76F8 :                     ; F5xx - PSG voice to xx
(2)  586/   A76F8 :                     smpsPSGvoice macro voice
(2)  587/   A76F8 :                     	dc.b	$F5,voice
(2)  588/   A76F8 :                     	endm
(2)  589/   A76F8 :                     
(2)  590/   A76F8 :                     ; F6xxxx - Jump to xxxx
(2)  591/   A76F8 :                     smpsJump macro loc
(2)  592/   A76F8 :                     	dc.b	$F6
(2)  593/   A76F8 :                     	if SonicDriverVer<>1
(2)  594/   A76F8 :                     		dc.w	z80_ptr(loc)
(2)  595/   A76F8 :                     	else
(2)  596/   A76F8 :                     		dc.w	loc-*-1
(2)  597/   A76F8 :                     	endif
(2)  598/   A76F8 :                     	endm
(2)  599/   A76F8 :                     
(2)  600/   A76F8 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  601/   A76F8 :                     smpsLoop macro index,loops,loc
(2)  602/   A76F8 :                     	dc.b	$F7
(2)  603/   A76F8 :                     	dc.b	index,loops
(2)  604/   A76F8 :                     	if SonicDriverVer<>1
(2)  605/   A76F8 :                     		dc.w	z80_ptr(loc)
(2)  606/   A76F8 :                     	else
(2)  607/   A76F8 :                     		dc.w	loc-*-1
(2)  608/   A76F8 :                     	endif
(2)  609/   A76F8 :                     	endm
(2)  610/   A76F8 :                     
(2)  611/   A76F8 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  612/   A76F8 :                     smpsCall macro loc
(2)  613/   A76F8 :                     	dc.b	$F8
(2)  614/   A76F8 :                     	if SonicDriverVer<>1
(2)  615/   A76F8 :                     		dc.w	z80_ptr(loc)
(2)  616/   A76F8 :                     	else
(2)  617/   A76F8 :                     		dc.w	loc-*-1
(2)  618/   A76F8 :                     	endif
(2)  619/   A76F8 :                     	endm
