(2)  590/   A6FA4 :                     ; F6xxxx - Jump to xxxx
(2)  591/   A6FA4 :                     smpsJump macro loc
(2)  592/   A6FA4 :                     	dc.b	$F6
(2)  593/   A6FA4 :                     	if SonicDriverVer<>1
(2)  594/   A6FA4 :                     		dc.w	z80_ptr(loc)
(2)  595/   A6FA4 :                     	else
