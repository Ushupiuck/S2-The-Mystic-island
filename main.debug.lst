(2)  806/   1DAAE :                     	set vcCF2,op2
(2)  807/   1DAAE :                     	set vcCF3,op3
(2)  808/   1DAAE :                     	set vcCF4,op4
(2)  809/   1DAAE :                     	endm
(2)  810/   1DAAE :                     
