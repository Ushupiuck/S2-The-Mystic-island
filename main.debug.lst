    9077/    EFC8 :                     ; ---------------------------------------------------------------------------
    9078/    EFC8 :                     ; Subroutine to make an object move and fall downward increasingly fast
    9079/    EFC8 :                     ; This moves the object horizontally and vertically
    9080/    EFC8 :                     ; and also applies gravity to its speed
    9081/    EFC8 :                     ; ---------------------------------------------------------------------------
    9082/    EFC8 :                     
    9083/    EFC8 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    9084/    EFC8 :                     
    9085/    EFC8 :                     ObjectFall:
    9086/    EFC8 :                     ObjectMoveAndFall:
    9087/    EFC8 : 3028 0010           		move.w	obVelX(a0),d0	; load x speed
    9088/    EFCC : 48C0                		ext.l	d0
    9089/    EFCE : E188                		lsl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
    9090/    EFD0 : D1A8 0008           		add.l	d0,obX(a0)	; add x speed to x position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
    9091/    EFD4 : 3028 0012           		move.w	obVelY(a0),d0	; load y speed
