(1)  208/    3814 :                     		endif
(1)  209/    3814 :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    3814 :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
