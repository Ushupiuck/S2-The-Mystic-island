   10684/   10E9E :                     ; d1 = object width
   10685/   10E9E :                     ; d2 = object height / 2 (when jumping)
   10686/   10E9E :                     ; d3 = object height / 2 (when walking)
   10687/   10E9E :                     ; d4 = object x-axis position
   10688/   10E9E :                     ;
   10689/   10E9E :                     ; address registers:
   10690/   10E9E :                     ; a0 = the object to check collision with
