(1) 2487/   A76F8 :                     ; ---------------------------------------------------------------------------
(1) 2488/   A76F8 :                     ; SMPS2ASM - A collection of macros that make SMPS's bytecode human-readable.
(1) 2489/   A76F8 :                     ; ---------------------------------------------------------------------------
(1) 2490/   A76F8 : =$1                  FixMusicAndSFXDataBugs = FixBugs
(1) 2491/   A76F8 : =$1                  SonicDriverVer = 1 ; Tell SMPS2ASM that we're using Sonic 1's driver.
(1) 2492/   A76F8 :                     		include "sound/_smps2asm_inc.asm"
