(2)  123/      7E : C6 22               	add	a,zDACDecodeTbl&0FFh	; 7	; Add in low byte of offset into decode table
(2)  124/      80 : 6F                  	ld	l,a			; 4	; hl = pointer to nibble entry in JMan2050 table
(2)  125/      81 : 7E                  	ld	a,(hl)			; 7	; a = JMan2050 entry for current nibble
