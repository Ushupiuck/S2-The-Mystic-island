   23923/   1C568 :                     		include	"_inc/Pattern Load Cues.asm"
(1)    1/   1C568 :                     ; ---------------------------------------------------------------------------
(1)    2/   1C568 :                     ; PATTERN LOAD REQUEST LISTS
(1)    3/   1C568 :                     ;
(1)    4/   1C568 :                     ; Pattern load request lists are simple structures used to load
(1)    5/   1C568 :                     ; Nemesis-compressed art for sprites.
(1)    6/   1C568 :                     ;
(1)    7/   1C568 :                     ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
(1)    8/   1C568 :                     ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
(1)    9/   1C568 :                     ;
(1)   10/   1C568 :                     
(1)   11/   1C568 :                     ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
(1)   12/   1C568 :                     ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
(1)   13/   1C568 :                     ; overflow and completely screw up the variables stored directly after the queue buffer.
(1)   14/   1C568 :                     ; (in my experience this is a guaranteed crash or hang)
(1)   15/   1C568 :                     ;
(1)   16/   1C568 :                     ; Many levels queue more than 16 items overall, but they don't exceed the limit because
(1)   17/   1C568 :                     ; their PLRs are split into multiple parts (like PLC_GHZ and PLC_GHZ2) and they fully
(1)   18/   1C568 :                     ; process the first part before requesting the rest.
(1)   19/   1C568 :                     ; ---------------------------------------------------------------------------
(1)   20/   1C568 :                     
(1)   21/   1C568 :                     ;---------------------------------------------------------------------------------------
(1)   22/   1C568 :                     ; Table of pattern load request lists. Remember to use word-length data when adding lists
(1)   23/   1C568 :                     ; otherwise you'll break the array.
(1)   24/   1C568 :                     ;---------------------------------------------------------------------------------------
