     960/    1372 :                     ; Subroutine to transfer a plane map to VRAM
     961/    1372 :                     ; ---------------------------------------------------------------------------
     962/    1372 :                     
     963/    1372 :                     ; control register:
     964/    1372 :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
     965/    1372 :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
     966/    1372 :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
     967/    1372 :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
     968/    1372 :                     ;
     969/    1372 :                     ;	A00-A15 - address
     970/    1372 :                     ;	CD0-CD3 - code
     971/    1372 :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
     972/    1372 :                     ;	CD5 - DMA operation
     973/    1372 :                     ;
     974/    1372 :                     ;	Bits CD3-CD0:
     975/    1372 :                     ;	0000 - VRAM read
     976/    1372 :                     ;	0001 - VRAM write
     977/    1372 :                     ;	0011 - CRAM write
     978/    1372 :                     ;	0100 - VSRAM read
     979/    1372 :                     ;	0101 - VSRAM write
     980/    1372 :                     ;	1000 - CRAM read
     981/    1372 :                     ;
     982/    1372 :                     ; d0 = control register
     983/    1372 :                     ; d1 = width
     984/    1372 :                     ; d2 = heigth
     985/    1372 :                     ; a1 = source address
     986/    1372 :                     
     987/    1372 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
