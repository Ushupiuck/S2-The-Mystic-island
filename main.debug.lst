    5449/    8E98 :                     ScrollHoriz:
    5450/    8E98 : =>TRUE               	if FixBugs
    5451/    8E98 :                     		; To prevent the bug that is described below, this caps the position
    5452/    8E98 :                     		; array index offset so that it does not access position data from
    5453/    8E98 :                     		; before the spin dash was performed. Note that this required
    5454/    8E98 :                     		; modifications to 'Sonic_UpdateSpindash' and 'Tails_UpdateSpindash'.
    5455/    8E98 : 1215                		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5456/    8E9A : 6722                		beq.s	.scrollNotDelayed				; if not, branch
    5457/    8E9C : E509                		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5458/    8E9E : 5315                		subq.b	#1,Horiz_scroll_delay_val-Camera_Delay(a5)	; reduce delay value
    5459/    8EA0 : 102D 0003           		move.b	Sonic_Pos_Record_Index+1-Camera_Delay(a5),d0
    5460/    8EA4 : 902D 0001           		sub.b	Horiz_scroll_delay_val+1-Camera_Delay(a5),d0
    5461/    8EA8 : B200                		cmp.b	d0,d1
    5462/    8EAA : 6502                		blo.s	.doNotCap
    5463/    8EAC : 1200                		move.b	d0,d1
    5464/    8EAE :                     .doNotCap:
    5465/    8EAE : =>FALSE              	else
    5466/    8EAE :                     		; The intent of this code is to make the camera briefly lag behind the
    5467/    8EAE :                     		; player right after releasing a spin dash, however it does this by
    5468/    8EAE :                     		; simply making the camera use position data from previous frames. This
    5469/    8EAE :                     		; means that if the camera had been moving recently enough, then
    5470/    8EAE :                     		; releasing a spin dash will cause the camera to jerk around instead of
    5471/    8EAE :                     		; remain still. This can be encountered by running into a wall, and
    5472/    8EAE :                     		; quickly turning around and spin dashing away. Sonic 3 would have had
    5473/    8EAE :                     		; this same issue with the Fire Shield's dash abiliity, but it shoddily
    5474/    8EAE :                     		; works around the issue by resetting the old position values to the
    5475/    8EAE :                     		; current position (see 'Reset_Player_Position_Array').
    5476/    8EAE :                     		move.w	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; should scrolling be delayed?
    5477/    8EAE :                     		beq.s	.scrollNotDelayed				; if not, branch
    5478/    8EAE :                     		subi.w	#$100,d1					; reduce delay value
    5479/    8EAE :                     		move.w	d1,Horiz_scroll_delay_val-Camera_Delay(a5)
    5480/    8EAE :                     		moveq	#0,d1
    5481/    8EAE :                     		move.b	Horiz_scroll_delay_val-Camera_Delay(a5),d1	; get delay value
    5482/    8EAE :                     		lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
    5483/    8EAE :                     		addq.b	#4,d1
    5484/    8EAE : [5450]               	endif
    5485/    8EAE : 302D 0002           		move.w	Sonic_Pos_Record_Index-Camera_Delay(a5),d0
