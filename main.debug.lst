   10857/   11028 :                     ; loc_F598:
   10858/   11028 :                     SolidObject_cont:
   10859/   11028 :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
   10860/   11028 :                     		; coordinate system where the x origin is at the object's left edge.
   10861/   11028 : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
   10862/   1102C : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
   10863/   11030 : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
   10864/   11032 : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
   10865/   11036 : 3601                		move.w	d1,d3
   10866/   11038 : D643                		add.w	d3,d3				; calculate object's width
   10867/   1103A : B043                		cmp.w	d3,d0
   10868/   1103C : 6200 00BA           		bhi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's right edge
   10869/   11040 :                     		; We now perform the y portion of a bounding box check.  To do this, we assume a
   10870/   11040 :                     		; coordinate system where the y origin is at the highest y position relative to the object
   10871/   11040 :                     		; at which Sonic would still collide with it.  This point is
   10872/   11040 :                     		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
   10873/   11040 :                     		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
   10874/   11040 :                     		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
   10875/   11040 : 1629 0016           		move.b	obHeight(a1),d3			; load Sonic's y radius
   10876/   11044 : 4883                		ext.w	d3
   10877/   11046 : D443                		add.w	d3,d2				; calculate maximum distance for a top collision
   10878/   11048 : 3629 000C           		move.w	obY(a1),d3			; load Sonic's y position
   10879/   1104C : 9668 000C           		sub.w	obY(a0),d3			; ... and calculate his y position relative to the object
   10880/   11050 : 5843                		addq.w	#4,d3				; assume a slightly lower position for Sonic
   10881/   11052 : D642                		add.w	d2,d3				; assume the highest position where Sonic would still be colliding with the object to be (0,0)
   10882/   11054 : 6B00 00A2           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is above this point
   10883/   11058 : 3802                		move.w	d2,d4
   10884/   1105A : D844                		add.w	d4,d4				; calculate minimum distance for a bottom collision
   10885/   1105C : B644                		cmp.w	d4,d3
   10886/   1105E : 6400 0098           		bhs.w	SolidObject_TestClearPush	; branch, if Sonic is below this point
