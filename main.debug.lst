(2)  864/   A6FA4 :                     	set vcDL2,op2
(2)  865/   A6FA4 :                     	set vcDL3,op3
(2)  866/   A6FA4 :                     	set vcDL4,op4
(2)  867/   A6FA4 :                     	endm
(2)  868/   A6FA4 :                     
