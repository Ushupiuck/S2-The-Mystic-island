     392/     37E :                     ErrorText:
     393/     37E :                     		dc.w .exception-ErrorText	; $00
     394/     37E :                     		dc.w .bus-ErrorText		; $02
     395/     37E :                     		dc.w .address-ErrorText		; $04
     396/     37E :                     		dc.w .illinstruct-ErrorText	; $06
     397/     37E :                     		dc.w .zerodivide-ErrorText	; $08
     398/     37E :                     		dc.w .chkinstruct-ErrorText	; $0A
     399/     37E :                     		dc.w .trapv-ErrorText		; $0C
     400/     37E :                     		dc.w .privilege-ErrorText	; $0E
     401/     37E :                     		dc.w .trace-ErrorText		; $10
     402/     37E :                     		dc.w .line1010-ErrorText	; $12
     403/     37E :                     		dc.w .line1111-ErrorText	; $14
     404/     37E :                     .exception:	dc.b "ERROR EXCEPTION    "
     405/     37E :                     .bus:		dc.b "BUS ERROR          "
     406/     37E :                     .address:	dc.b "ADDRESS ERROR      "
     407/     37E :                     .illinstruct:	dc.b "ILLEGAL INSTRUCTION"
     408/     37E :                     .zerodivide:	dc.b "@ERO DIVIDE        "
     409/     37E :                     .chkinstruct:	dc.b "CHK INSTRUCTION    "
     410/     37E :                     .trapv:		dc.b "TRAPV INSTRUCTION  "
     411/     37E :                     .privilege:	dc.b "PRIVILEGE VIOLATION"
     412/     37E :                     .trace:		dc.b "TRACE              "
     413/     37E :                     .line1010:	dc.b "LINE 1010 EMULATOR "
     414/     37E :                     .line1111:	dc.b "LINE 1111 EMULATOR "
