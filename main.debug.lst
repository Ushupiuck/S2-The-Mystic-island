(2)  115/   A6FA4 :                     			nextenum	dBassHey,dDanceStyleKick,dHipHopHitKick2,dHipHopHitKick3
(2)  116/   A6FA4 :                     			nextenum	dReverseFadingWind,dScratchS3,dLooseSnareNoise,dPowerKick2
(2)  117/   A6FA4 :                     			nextenum	dCrashingNoiseWoo,dQuickHit,dKickHey,dPowerKickHit
(2)  118/   A6FA4 :                     			nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  119/   A6FA4 : =>FALSE              		elsecase;SonicDriverVer>=5
(2)  120/   A6FA4 :                     			if (use_s3_samples<>0)||(use_sk_samples<>0)||(use_s3d_samples<>0)
(2)  121/   A6FA4 :                     				enum		dSnareS3=$81,dHighTom,dMidTomS3,dLowTomS3,dFloorTomS3,dKickS3,dMuffledSnare
(2)  122/   A6FA4 :                     				nextenum	dCrashCymbal,dRideCymbal,dLowMetalHit,dMetalHit,dHighMetalHit
(2)  123/   A6FA4 :                     				nextenum	dHigherMetalHit,dMidMetalHit,dClapS3,dElectricHighTom
(2)  124/   A6FA4 :                     				nextenum	dElectricMidTom,dElectricLowTom,dElectricFloorTom
(2)  125/   A6FA4 :                     				nextenum	dTightSnare,dMidpitchSnare,dLooseSnare,dLooserSnare
(2)  126/   A6FA4 :                     				nextenum	dHiTimpaniS3,dLowTimpaniS3,dMidTimpaniS3,dQuickLooseSnare
(2)  127/   A6FA4 :                     				nextenum	dClick,dPowerKick,dQuickGlassCrash
(2)  128/   A6FA4 : [120]                			endif
(2)  129/   A6FA4 :                     			if (use_s3_samples<>0)||(use_sk_samples<>0)
(2)  130/   A6FA4 :                     				nextenum	dGlassCrashSnare,dGlassCrash,dGlassCrashKick,dQuietGlassCrash
(2)  131/   A6FA4 :                     				nextenum	dOddSnareKick,dKickExtraBass,dComeOn,dDanceSnare,dLooseKick
(2)  132/   A6FA4 :                     				nextenum	dModLooseKick,dWoo,dGo,dSnareGo,dPowerTom,dHiWoodBlock,dLowWoodBlock
(2)  133/   A6FA4 :                     				nextenum	dHiHitDrum,dLowHitDrum,dMetalCrashHit,dEchoedClapHit
(2)  134/   A6FA4 :                     				nextenum	dLowerEchoedClapHit,dHipHopHitKick,dHipHopHitPowerKick
(2)  135/   A6FA4 :                     				nextenum	dBassHey,dDanceStyleKick,dHipHopHitKick2,dHipHopHitKick3
(2)  136/   A6FA4 :                     				nextenum	dReverseFadingWind,dScratchS3,dLooseSnareNoise,dPowerKick2
(2)  137/   A6FA4 :                     				nextenum	dCrashingNoiseWoo,dQuickHit,dKickHey,dPowerKickHit
(2)  138/   A6FA4 :                     				nextenum	dLowPowerKickHit,dLowerPowerKickHit,dLowestPowerKickHit
(2)  139/   A6FA4 : [129]                			endif
(2)  140/   A6FA4 :                     			; For conversions:
(2)  141/   A6FA4 :                     			if (use_s2_samples<>0)
(2)  142/   A6FA4 :                     				if (use_s3_samples<>0)||(use_sk_samples<>0)||(use_s3d_samples<>0)
(2)  143/   A6FA4 :                     					nextenum	dKick
(2)  144/   A6FA4 :                     				else
