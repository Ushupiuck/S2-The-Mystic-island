   10900/   11084 : 9041                		sub.w	d1,d0
   10901/   11086 : 3A00                		move.w	d0,d5				; calculate Sonic's distance to the object's right edge...
   10902/   11088 : 4445                		neg.w	d5				; ... and calculate the absolute value
   10903/   1108A :                     
