   23003/   19B62 : 7200                		moveq	#0,d1			; Reset HUD frame index
   23004/   19B64 : 0838 0003 FD33      		btst	#3,(Timer_frames+1).w	; Only blink on certain frames
   23005/   19B6A : 6612                		bne.s	.skipBlink
   23006/   19B6C : 4A78 FD4C           		tst.w	(v_rings).w		; No rings?
   23007/   19B70 : 6602                		bne.s	.checkTime
   23008/   19B72 : 5241                		addq.w	#1,d1			; +1 = RING blink frame
   23009/   19B74 :                     
   23010/   19B74 :                     .checkTime:
   23011/   19B74 : 0C38 0009 FD4F      		cmpi.b	#9,(v_timemin).w	; 9:00 reached?
   23012/   19B7A : 6602                		bne.s	.skipBlink
   23013/   19B7C : 5441                		addq.w	#2,d1			; +2 = TIME blink frame
   23014/   19B7E :                     
   23015/   19B7E :                     .skipBlink:
   23016/   19B7E :                     	;	move.b	(Level_started_flag).w,d3
   23017/   19B7E :                     	;	ext.w	d3
   23018/   19B7E :                     	;	bpl.s	+
   23019/   19B7E :                     	;	addq.w	#2,d3
   23020/   19B7E :                     	;	move.b	d3,(Level_started_flag).w
   23021/   19B7E :                     +
   23022/   19B7E : 363C 0090           		move.w	#128+16,d3		; HUD X pos
   23023/   19B82 : 343C 0108           		move.w	#128+136,d2		; HUD Y pos
   23024/   19B86 : 43FA 001A           		lea	Map_obj21(pc),a1	; Map data base
   23025/   19B8A : 367C 06CA           		movea.w	#make_art_tile(ArtTile_HUD,0,0),a3 ; Art tile setup
   23026/   19B8E : D241                		add.w	d1,d1			; Word offset (2 bytes per entry)
   23027/   19B90 : D2F1 1000           		adda.w	(a1,d1.w),a1		; Advance to correct HUD frame
   23028/   19B94 : 3219                		move.w	(a1)+,d1
   23029/   19B96 : 5341                		subq.w	#1,d1
   23030/   19B98 : 6B06                		bmi.s	+
