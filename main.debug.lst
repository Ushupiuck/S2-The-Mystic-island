(1) 1664/   A548E :                     ; ---------------------------------------------------------------------------
(1) 1665/   A548E :                     ; FM Note Values: b-0 to a#8
(1) 1666/   A548E :                     ;
(1) 1667/   A548E :                     ; Each row is an octave, starting with B and ending with A-sharp/B-flat.
(1) 1668/   A548E :                     ; Notably, this differs from the PSG frequency table, which starts with C and
(1) 1669/   A548E :                     ; ends with B. This is caused by 'FMSetFreq' subtracting $80 from the note
(1) 1670/   A548E :                     ; instead of $81, meaning that the first frequency in the table ironically
(1) 1671/   A548E :                     ; corresponds to the 'rest' note. The only way to use this frequency in a
(1) 1672/   A548E :                     ; real note is to transpose the channel to a lower semitone.
(1) 1673/   A548E :                     ;
(1) 1674/   A548E :                     ; Rather than use a complete lookup table, other SMPS drivers such as
(1) 1675/   A548E :                     ; Sonic 3's compute the octave, and only store a single octave's worth of
(1) 1676/   A548E :                     ; notes in the table.
(1) 1677/   A548E :                     ;
(1) 1678/   A548E :                     ; Invalid transposition values will cause this table to be overflowed,
(1) 1679/   A548E :                     ; resulting in garbage data being used as frequency values. In drivers that
(1) 1680/   A548E :                     ; compute the octave instead, invalid transposition values merely cause the
(1) 1681/   A548E :                     ; notes to wrap-around (the note below the lowest note will be the highest
(1) 1682/   A548E :                     ; note). It's important to keep this in mind when porting buggy songs.
(1) 1683/   A548E :                     ; ---------------------------------------------------------------------------
(1) 1684/   A548E :                     ; word_72790: FM_Notes:
(1) 1685/   A548E :                     FMFrequencies:
(1) 1686/   A548E : 025E 0284 02AB      		dc.w $025E,$0284,$02AB,$02D3,$02FE,$032D,$035C,$038F,$03C5,$03FF,$043C,$047C
            A5494 : 02D3 02FE 032D 
            A549A : 035C 038F 03C5 
            A54A0 : 03FF 043C 047C    
(1) 1687/   A54A6 : 0A5E 0A84 0AAB      		dc.w $0A5E,$0A84,$0AAB,$0AD3,$0AFE,$0B2D,$0B5C,$0B8F,$0BC5,$0BFF,$0C3C,$0C7C
            A54AC : 0AD3 0AFE 0B2D 
            A54B2 : 0B5C 0B8F 0BC5 
            A54B8 : 0BFF 0C3C 0C7C    
(1) 1688/   A54BE : 125E 1284 12AB      		dc.w $125E,$1284,$12AB,$12D3,$12FE,$132D,$135C,$138F,$13C5,$13FF,$143C,$147C
            A54C4 : 12D3 12FE 132D 
            A54CA : 135C 138F 13C5 
            A54D0 : 13FF 143C 147C    
