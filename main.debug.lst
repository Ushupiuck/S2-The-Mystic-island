   22681/   1B2C2 :                     ; ZONE ANIMATION SCRIPTS
   22682/   1B2C2 :                     ;
   22683/   1B2C2 :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
   22684/   1B2C2 :                     ; thus animating them. All the relevant art must be uncompressed, because
   22685/   1B2C2 :                     ; otherwise the subroutine would spend so much time waiting for the art to be
   22686/   1B2C2 :                     ; decompressed that the VBLANK window would close before all the animating was done.
   22687/   1B2C2 :                     ;
   22688/   1B2C2 :                     ;    zoneanimdecl -1, Art_Flowers1, ArtTile_Art_Flowers1, 6, 2
   22689/   1B2C2 :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
   22690/   1B2C2 :                     ;	ArtUnc_Flowers1		Source address
   22691/   1B2C2 :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
   22692/   1B2C2 :                     ;	6			Number of frames
   22693/   1B2C2 :                     ;	2			Number of tiles to load into VRAM for each frame
   22694/   1B2C2 :                     ;
   22695/   1B2C2 :                     ;    dc.b   0,$7F		; Start of the script proper
   22696/   1B2C2 :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
   22697/   1B2C2 :                     ;	$7F			Frame duration. Only here if global duration is -1
   22698/   1B2C2 :                     
   22699/   1B2C2 :                     
