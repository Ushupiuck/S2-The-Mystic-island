   10899/   11362 :                     		; We now perform the y portion of a bounding box check.  To do this, we assume a
   10900/   11362 :                     		; coordinate system where the y origin is at the highest y position relative to the object
   10901/   11362 :                     		; at which Sonic would still collide with it.  This point is
   10902/   11362 :                     		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
   10903/   11362 :                     		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
   10904/   11362 :                     		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
   10905/   11362 : 1629 0016           		move.b	obHeight(a1),d3			; load Sonic's y radius
