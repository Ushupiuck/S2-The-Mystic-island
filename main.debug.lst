(1)   22/    194C :                     ; 	Kosinski+ Decompressor
(1)   23/    194C :                     ;
(1)   24/    194C :                     ; INPUT:
(1)   25/    194C :                     ; 	a0	Source address
(1)   26/    194C :                     ; 	a1	Destination address
