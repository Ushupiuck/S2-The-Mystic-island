   10102/    F8EC :                     ; Objects Manager
   10103/    F8EC :                     ; Subroutine that keeps track of any objects that need to remember
   10104/    F8EC :                     ; their state, such as monitors or enemies.
   10105/    F8EC :                     ;
   10106/    F8EC :                     ; input variables:
   10107/    F8EC :                     ;  -none-
   10108/    F8EC :                     ;
   10109/    F8EC :                     ; writes:
   10110/    F8EC :                     ;  d0, d1
   10111/    F8EC :                     ;  d2 = respawn index of object to load
   10112/    F8EC :                     ;  d6 = camera position
   10113/    F8EC :                     ;
   10114/    F8EC :                     ;  a0 = address in object placement list
   10115/    F8EC :                     ;  a2 = respawn table
   10116/    F8EC :                     ; ---------------------------------------------------------------------------
