(2)    5/   1FBBC : [5]                                  endif
(2)    5/   1FBBC : =>FALSE                      else;if SourceDriver>=3
(2)    5/   1FBBC :                                     if $08==0
(2)    5/   1FBBC :                                             message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)    5/   1FBBC : [5]                                  endif
(2)    5/   1FBBC :                                     if SonicDriverVer==1
(2)    5/   1FBBC :                                             dc.b    s3TempotoS1($08)
(2)    5/   1FBBC :                                     else;if SonicDriverVer==2
(2)    5/   1FBBC :                                             dc.b    s3TempotoS2($08)
(2)    5/   1FBBC : [5]                                  endif
(2)    5/   1FBBC : [5]                          endif
