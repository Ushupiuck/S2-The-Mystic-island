    1043/    13EE : 60F8                		bra.s	.Loop
    1044/    13F0 :                     
    1045/    13F0 :                     .FoundFree:
    1046/    13F0 : 3019                		move.w	(a1)+,d0		; Get number of PLC entries
    1047/    13F2 : 6B0E                		bmi.s	.End			; If it's 0 (or less), branch
    1048/    13F4 :                     
    1049/    13F4 :                     .Load:
