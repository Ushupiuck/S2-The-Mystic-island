(2)  814/   1DAAE :                     	set vcRS2,op2
(2)  815/   1DAAE :                     	set vcRS3,op3
(2)  816/   1DAAE :                     	set vcRS4,op4
(2)  817/   1DAAE :                     	endm
(2)  818/   1DAAE :                     
(2)  819/   1DAAE :                     ; Voices - Attack Rate
(2)  820/   1DAAE :                     smpsVcAttackRate macro op1,op2,op3,op4
