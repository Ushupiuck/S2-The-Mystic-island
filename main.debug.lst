     365/     37E :                     ShowErrorMsg:
     366/     37E :                     		lea	(vdp_data_port).l,a6
     367/     37E :                     		locVRAM	ArtTile_Error_Handler_Font*tile_size
     368/     37E :                     		lea	(Art_Text).l,a0
