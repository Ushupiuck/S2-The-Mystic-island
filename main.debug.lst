    1911/    2CF6 :                     ; Subroutine to generate a pseudo-random number in d0
    1912/    2CF6 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1913/    2CF6 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1914/    2CF6 :                     ; ---------------------------------------------------------------------------
    1915/    2CF6 :                     
    1916/    2CF6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1917/    2CF6 :                     
    1918/    2CF6 :                     ; PseudoRandomNumber:
    1919/    2CF6 :                     RandomNumber:
    1920/    2CF6 : 2238 F672           		move.l	(v_random).w,d1
    1921/    2CFA : 6606                		bne.s	loc_2C9C
    1922/    2CFC : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1923/    2D02 :                     
    1924/    2D02 :                     loc_2C9C:
    1925/    2D02 :                     		; set the high word of d0 to be the high word of the RNG
    1926/    2D02 :                     		; and multiply the RNG by 41
    1927/    2D02 : 2001                		move.l	d1,d0
    1928/    2D04 : E581                		asl.l	#2,d1
    1929/    2D06 : D280                		add.l	d0,d1
    1930/    2D08 : E781                		asl.l	#3,d1
    1931/    2D0A : D280                		add.l	d0,d1
    1932/    2D0C :                     
    1933/    2D0C :                     		; add the low word of the RNG to the high word of the RNG
    1934/    2D0C :                     		; and set the low word of d0 to be the result
    1935/    2D0C :                     
    1936/    2D0C : 3001                		move.w	d1,d0
    1937/    2D0E : 4841                		swap	d1
    1938/    2D10 : D041                		add.w	d1,d0
    1939/    2D12 : 3200                		move.w	d0,d1
    1940/    2D14 : 4841                		swap	d1
    1941/    2D16 :                     
    1942/    2D16 :                     ;		move.w	d1,d0
    1943/    2D16 :                     ;		abcd	d0,d1
    1944/    2D16 :                     ;		addx.w	d1,d0
    1945/    2D16 :                     ;		move.w	d0,d1
    1946/    2D16 :                     ;		swap	d1
    1947/    2D16 : 21C1 F672           		move.l	d1,(v_random).w
    1948/    2D1A : 4E75                		rts
    1949/    2D1C :                     ; End of function RandomNumber
