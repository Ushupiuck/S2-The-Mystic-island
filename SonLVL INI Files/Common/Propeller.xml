<?xml version="1.0" encoding="utf-8"?>
<ObjDef xmlns="http://www.sonicretro.org" Name="MM propeller obstacle" Image="mast">
	<Images>
		<ImageFromMappings id="mast">
			<ArtFile filename="../art/nemesis/MM Propeller.nem" />
			<MapFile type="Binary" filename="../mappings/sprite/MM Propeller base.bin" frame="0" startpal="0" />
		</ImageFromMappings>
		<ImageFromMappings id="upper">
			<ArtFile filename="../art/nemesis/MM Propeller.nem" />
			<MapFile type="Binary" filename="../mappings/sprite/MM Propeller blade.bin" frame="0" startpal="0" />
		</ImageFromMappings>
		<ImageFromMappings id="lower">
			<ArtFile filename="../art/nemesis/MM Propeller.nem" />
			<MapFile type="Binary" filename="../mappings/sprite/MM Propeller blade.bin" frame="7" startpal="0" />
		</ImageFromMappings>
	</Images>
	<DefaultImage>
		<ImageRef image="mast" xflip="NeverFlip" yflip="NeverFlip" />
		<ImageRef image="upper" xflip="NeverFlip" yflip="NeverFlip">
			<Offset X="0" Y="-44" />
		</ImageRef>
		<ImageRef image="lower" xflip="NeverFlip" yflip="AlwaysFlip">
			<Offset X="0" Y="20" />
		</ImageRef>
	</DefaultImage>
	<Subtypes>
		<Subtype id="00" name="Alternating blades">
			<ImageRef image="mast" xflip="NeverFlip" yflip="NeverFlip" />
			<ImageRef image="upper" xflip="NeverFlip" yflip="NeverFlip">
				<Offset X="0" Y="-44" />
			</ImageRef>
			<ImageRef image="lower" xflip="NeverFlip" yflip="AlwaysFlip">
				<Offset X="0" Y="20" />
			</ImageRef>
		</Subtype>
	</Subtypes>
	<!-- Subtype is unused. Placement X flip reverses the initial patrol;
	     placement Y flip does not invert the upright obstacle. -->
</ObjDef>
