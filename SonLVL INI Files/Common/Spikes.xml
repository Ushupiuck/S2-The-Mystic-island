  <Properties>
    <CustomProperty name="Count" type="int">
      <get><![CDATA[return ((obj.SubType & 0x30) >> 4) + 1;]]></get>
      <set><![CDATA[value = System.Math.Max(1, System.Math.Min(4, value)); obj.SubType = (byte)((obj.SubType & ~0x30) | ((value - 1) << 4));]]></set>
    </CustomProperty>
    <BitsProperty name="Movement" type="SpikeMovement" startbit="0" length="2" />
    <BitsProperty name="Direction" type="SpikeDirection" startbit="6" length="1" />
